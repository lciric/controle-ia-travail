  try {
    const themeMatch = document.cookie.match(/(?:^|;\s*)alpha_theme=([^;]*)/);
    const legacyMatch = document.cookie.match(/(?:^|;\s*)alpha_dark_mode=([^;]*)/);
    const raw = themeMatch ? decodeURIComponent(themeMatch[1]) : legacyMatch ? decodeURIComponent(legacyMatch[1]) : "";
    const theme = raw === "true" ? "dark" : raw;
    if (theme === "dark") document.documentElement.classList.add("dark");
    else if (theme === "light") document.documentElement.classList.add("light");
  } catch {}
})();</script></head><body class="min-h-dvh bg-bg text-text"><!--$--><div class="min-h-dvh min-w-0" style="--workspace-room-left:0px;--workspace-room-right:0px;--workspace-corner-left:24px;--workspace-corner-right:24px"><!--$--><!--$--><div data-paper-shell="" class="flex min-h-dvh flex-col sm:flex-row sm:bg-panel-alt"><div class="sticky top-0 hidden h-dvh flex-none sm:block"><nav aria-label="Main" data-navigation-sidebar="" class="group h-full w-[var(--nav-rail-width)] flex-col overflow-hidden border-r border-border bg-panel-alt py-4 duration-300 ease-in-out hidden sm:flex border-r-transparent transition-[width]"><div class="mb-4 flex flex-none items-center gap-3 overflow-hidden rounded-full px-4 text-lg transition-opacity duration-100 ease-in-out"><a class="mr-auto flex items-center gap-3" href="/"><div class="flex size-11 shrink-0 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 718.41 504.47" width="718.41" height="504.47" class="size-8 text-custom-red"><polygon fill="currentColor" points="591.15 258.54 718.41 385.73 663.72 440.28 536.57 313.62 591.15 258.54"></polygon><path fill="currentColor" d="M273.86.3c34.56-2.41,67.66,9.73,92.51,33.54l94.64,94.63-55.11,54.55-96.76-96.55c-16.02-12.7-37.67-12.1-53.19,1.11L54.62,288.82,0,234.23,204.76,29.57C223.12,13.31,249.27,2.02,273.86.3Z"></path><path fill="currentColor" d="M663.79,1.29l54.62,54.58-418.11,417.9c-114.43,95.94-263.57-53.49-167.05-167.52l160.46-160.33,54.62,54.58-157.88,157.77c-33.17,40.32,18.93,91.41,58.66,57.48L663.79,1.29Z"></path></svg></div></a></div><div class="flex flex-col px-4 pb-4"><div class="flex w-full items-center" data-state="closed"><a class="flex w-full cursor-pointer items-center rounded-full text-lg transition-colors text-text" aria-label="Explore" href="/"><div class="interactable-overlay bg-overlay"></div><div class="flex items-center justify-center p-3"><span class="relative size-5 text-center"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="2