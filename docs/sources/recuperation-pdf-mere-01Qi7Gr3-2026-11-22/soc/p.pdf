.com/Ipouyall","https://twitter.com/Ipouyall"]},{"@type":"Person","name":"Arth Singh","url":"https://www.alphaxiv.org/@arth-singh","affiliation":{"@type":"Organization","name":"Research Scientist, AI Safety at AIM Intelligence, South Korea"},"sameAs":["https://scholar.google.com/citations?user=-vg5SOMAAAAJ","https://www.linkedin.com/in/arthsingh7in/","https://www.linkedin.com/in/arthsingh7in"]},{"@type":"Person","name":"Manan Tayal","url":"https://www.alphaxiv.org/@manan-tayal","affiliation":{"@type":"Organization","name":"Research Scientist, Emergence AI"},"sameAs":["https://scholar.google.com/citations?user=jWWQhY8AAAAJ","https://manantayal.com/","https://www.linkedin.com/in/manan-tayal","https://github.com/tayalmanan28","https://huggingface.co/tayalmanan","https://openreview.net/profile?id=%7EManan_Tayal1","https://x.com/manantayal_"]},{"@type":"Person","name":"Tao Tu","url":"https://www.alphaxiv.org/@tao-tu","affiliation":{"@type":"Organization","name":"Columbia University, Google"},"sameAs":["https://scholar.google.com/citations?user=VlR6u4AAAAAJ"]},{"@type":"Person","name":"Lino Le Van","url":"https://www.alphaxiv.org/@lino-le-van","affiliation":{"@type":"Organization","name":"Berkeley"},"sameAs":["https://scholar.google.com/citations?user=Hyt0j08AAAAJ","https://www.linkedin.com/in/linolevan/","https://github.com/lino-levan","https://bsky.app/profile/linolevan.com"]},{"@type":"Person","name":"Abdul Waheed","url":"https://www.alphaxiv.org/@abdul-waheed","affiliation":{"@type":"Organization","name":"Carnegie Mellon University"},"sameAs":["https://scholar.google.com/citations?user=I0hRiBYAAAAJ","https://www.cs.cmu.edu/~abdulw/","https://github.com/macabdul9","https://twitter.com/MacAbdul9"]},{"@type":"Person","name":"Fiona Y. Wang","url":"https://www.alphaxiv.org/@fiona-y-wang","affiliation":{"@type":"Organization","name":"Graduate Student, MIT"},"sameAs":["https://scholar.google.com/citations?user=oLRVCbUAAAAJ","https://www.linkedin.com/in/fionawang108/","https://x.com/fwang108_"]},{"@type":"Person","name":"Lukas Weidener","url":"https://www.alphaxiv.org/@lukas-weidener","affiliation":{"@type":"Organization","name":"Applied Scientific Intelligence, Inc."},"sameAs":["https://scholar.google.com/citations?user=YIlZncQAAAAJ"]},{"@type":"Person","name":"Zhen Wu"},{"@type":"Person","name":"Xuhai “Orson” Xu","url":"https://www.alphaxiv.org/@xuhai-orson-xu","affiliation":{"@type":"Organization","name":"Assistant Professor, Columbia University | Google"},"sameAs":["https://scholar.google.com/citations?user=MtX5Ij8AAAAJ","https://orsonxu.com/","https://www.linkedin.com/in/orson-xuhai-xu","https://github.com/OrsonXu","https://orcid.org/0000-0001-5930-3899","https://twitter.com/Orson_Xu"]},{"@type":"Person","name":"Dingling Yao","url":"https://www.alphaxiv.org/@dingling-yao","affiliation":{"@type":"Organization","name":"PhD student at IST Austria & MPI-IS, Germany"},"sameAs":["https://scholar.google.com/citations?user=vOJUvb0AAAAJ","https://dinglingyao.github.io/","https://www.linkedin.com/in/dingling-yao"]},{"@type":"Person","name":"Rojin Ziaei","url":"https://www.alphaxiv.org/@rojin-ziaei","affiliation":{"@type":"Organization","name":"Researcher@Stanford"},"sameAs":["https://scholar.google.com/citations?user=hhXu6jkAAAAJ","https://rojinziaei.github.io/","https://www.linkedin.com/in/rojin-ziaei-549725a5","https://github.com/RojinZiaei","https://twitter.com/rojin_ziaei"]},{"@type":"Person","name":"Boyang Zhong","url":"https://www.alphaxiv.org/@boyang-zhong","affiliation":{"@type":"Organization","name":"Technical University of Munich (TUM)"},"sameAs":["https://scholar.google.com/citations?user=VI0i7c0AAAAJ","https://andzy324.github.io/","https://www.linkedin.com/in/boyang-zhong/","https://github.com/Andzy324","https://huggingface.co/AndZHONG","https://openreview.net/profile?id=%7EBoyang_ZHONG3","https://orcid.org/0009-0003-7827-7958"]},{"@type":"Person","name":"Haotian Zong","url":"https://www.alphaxiv.org/@haotian-zong","affiliation":{"@type":"Organization","name":"Johns Hopkins University, Department of Applied Mathematics and Statistics"},"sameAs":["https://scholar.google.com/citations?user=RpKB-1IAAAAJ"]},{"@type":"Person","name":"Markus J. Buehler","url":"https://www.alphaxiv.org/@markus-j-buehler","affiliation":{"@type":"Organization","name":"Massachusetts Institute of Technology"},"sameAs":["https://scholar.google.com/citations?user=hWBTSksAAAAJ","https://meche.mit.edu/people/faculty/mbuehler@mit.edu","https://www.linkedin.com/in/markus-j-buehler-2245682","https://orcid.org/0000-0002-4173-9659","https://twitter.com/ProfBuehlerMIT"]},{"@type":"Person","name":"Samuel Schmidgall","url":"https://www.alphaxiv.org/@samuel-schmidgall","affiliation":{"@type":"Organization","name":"Google DeepMind"},"sameAs":["https://scholar.google.com/citations?user=bQDooZEAAAAJ","https://samuelschmidgall.github.io/","https://www.linkedin.com/in/samuel-schmidgall-288632162","https://github.com/SamuelSchmidgall","https://twitter.com/SRSchmidgall"]}],"datePublished":"2026-11-21T00:00:00.000Z","url":"https://www.alphaxiv.org/abs/2611.society-ai-scientists","citation":{"@type":"CreativeWork","identifier":"2611.society-ai-scientists"},"publisher":{"@type":"Organization","name":"arXiv"},"discussionUrl":"https://www.alphaxiv.org/abs/2611.society-ai-scientists","interactionStatistic":[{"@type":"InteractionCounter","interactionType":{"@type":"ViewAction","url":"https://schema.org/ViewAction"},"userInteractionCount":26714},{"@type":"InteractionCounter","interactionType":{"@type":"LikeAction","url":"https://schema.org/LikeAction"},"userInteractionCount":582}],"commentCount":8,"comment":[{"@type":"Comment","text":"fantastical work. excited to dig through it. I would actually wonder what a comparative study for a large number of researchers working together and doing... a research-athon? would look like next to the patterns and behaviors seen in the more agent-only scenarios.","dateCreated":"2026-11-20T11:07:43.876Z","author":{"@type":"Person","name":"Hyunjun Han"},"upvoteCount":1},{"@type":"Comment","text":"You missed a spot!\n\nA twelve-week archive of agents doing science together, and nobody kept the record of what each agent relied on, when it relied on it, and why it changed its mind. Verification, self-correction, citation, all three need a record underneath them, or they are just claims about claims.\n\nI wrote the missing piece: A Record for Agent Societies: ","dateCreated":"2026-11-20T18:49:39.491Z","author":{"@type":"Person","name":"Darren Hall"},"upvoteCount":0},{"@type":"Comment","text":"Ok, 936 papers in 12 weeks by a swarm of AI agents! But they don't beat me with over 5,000 papers in the last 12 weeks based on an original idea- Ram Calculus - with wide applications, assisted by ChatGPT/Fable. Check out [www.integralresearch.net](http://www.integralresearch.net)! Let that swarm work on my idea, and there can be 25,000 new papers in 4 weeks! Some one fund me, and I will do it!","dateCreated":"2026-11-20T04:49:27.891Z","author":{"@type":"Person","name":"Muralidhara Subbarao"},"upvoteCount":0,"comment":[{"@type":"Comment","text":"Anyone can ask an AI model like Astra/Fable to  \"carefully and thoroughly examine the partial research results posted on [www.integralresearch.net](http://www.integralresearch.net) and give a summary of any scientific value in the results and give a list of substantive faults in the core theoretical results posted there\" and post their response here. Thank you.","dateCreated":"2026-11-20T20:21:14.213Z","author":{"@type":"Person","name":"Muralidhara Subbarao"},"upvoteCount":0}]}]}</script><div class="flex h-full min-w-0 flex-1"><div class="Viewer relative flex h-full w-full flex-1 flex-col sm:my-2 sm:mr-2 sm:overflow-hidden sm:rounded-3xl sm:border sm:h-auto sm:bg-bg sm:rounded-l-(--workspace-corner-left) sm:rounded-r-(--workspace-corner-right)"><div class="relative hidden h-11 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-4 sm:grid px-1.5"><div