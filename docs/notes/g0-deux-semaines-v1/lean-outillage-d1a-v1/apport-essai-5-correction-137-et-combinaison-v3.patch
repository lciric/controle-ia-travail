+def _h1(p):   # code 1, statut non conforme, conforme faux, aucun cas en échec
+    _epreuve(p)["statut"], _epreuve(p)["conforme"] = "non conforme", False
+
+
+def _h2(p):   # conforme faux seul
+    _epreuve(p)["conforme"] = False
+
+
+def _h3(p):   # un genre non conforme, cas tous tenus
+    _epreuve(p)["genres"]["Python"] = "non conforme"
+
+
+def _h10(p):  # ok vrai avec des écarts non vides
+    _epreuve(p)["cas"][2]["ecarts"] = ["écart laissé sur un cas à ok vrai"]
+
+
+def _h17(p):  # témoin sain faux, statut conforme
+    _epreuve(p)["sains"]["Python"] = False
+
+
+B1 = [("H1 code 1 sans cas en échec", _h1, 1), ("H2 conforme faux seul", _h2, 0),
+      ("H3 genre non conforme, cas tenus", _h3, 0), ("H10 ok vrai avec écarts", _h10, 0),
+      ("H17 témoin sain faux", _h17, 0)]
