+"""Essais de l'épreuve d'isolement v9, des attendus v8 et de l'artefact `limite_code137_v2.py` (essai Lean D-1a, cinquième
+essai ; cas 137 du quatrième essai, R-4687, R-4716).
+
+R5 de la correction : l'artefact v1 (cas « artefact ») et l'artefact v2 (cas sain) passent par le **vrai** exécuteur v8
+(`Bac.executer_python`, lanceur hors machine `LanceurEssaiLocal`, sortie standard redirigée vers un fichier comme dans le bac)
+puis par le **vrai** jugement de l'épreuve v9 (`juger_python`, attendu du cas 137 des attendus v8). La v1 rejoue le défaut
+du quatrième essai (« stdout sans « SORTIE 137 » ») ; la v2 passe. Interprètes : celui des essais et, s'ils sont là, 3.11 et
+3.12 (la machine a 3.12.3).
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from controle_ia.lean_essai import epreuve_isolement_v8 as E8
+from controle_ia.lean_essai import epreuve_isolement_v9 as E
+from controle_ia.lean_essai import executeur_bac_v8 as X
+from test_lean_essai_epreuve_v8 import BacFactice as BacFacticeV8
+
+RACINE = Path(__file__).resolve().parents[1]
+ART = RACINE / "scripts" / "lean_essai_d1a_v4" / "artefacts_r5_v4"
+ATT7 = json.loads((ART / "attendus-v7.json").read_text(encoding="utf-8"))
+ATT8 = json.loads((ART / "attendus-v8.json").read_text(encoding="utf-8"))
+NOM_137 = "sortie de lui-même en code 137, sans consommer la limite (5 s)"
+INTERPRETES = [sys.executable] + [p for p in ("/usr/bin/python3.11", "/usr/bin/python3.12") if os.path.exists(p)]
+
+
+def cas_137(attendus):
+    (c,) = [c for c in attendus["limites_python"] if c["nom"] == NOM_137]
+    return c
+
+
+# ---- copie déclarée ---------------------------------------------------------------------------------------------------------
+
+def _corps(module_path: Path) -> str:
+    texte = module_path.read_text(encoding="utf-8")
+    assert texte.startswith('"""')
+    return texte[texte.index('"""', 3) + 3:]
+
+
+def test_v9_est_la_v8_plus_les_seuls_changements_declares():
+    v8 = _corps(Path(E8.__file__))
+    v9 = _corps(Path(E.__file__))
+    retour = (v9.replace('VERSION = "epreuve_isolement_v9"\nATTENDUS = "attendus-v8.json"\n'
+                         'EXTRAIT_LIMITES = 600                       # v9 : sortie standard des cas « limites », bornée\n',
+                         'VERSION = "epreuve_isolement_v8"\nATTENDUS = "attendus-v7.json"\n')
+              .replace('''def extrait_limites(res: dict) -> dict:
+    """v9 : sortie standard d'un cas du genre « limites », bornée, pour le JSON ; aucun jugement n'en dépend."""
+    so = res.get("stdout") or ""
+    return {"stdout_extrait": so[:EXTRAIT_LIMITES],
+            "stdout_tronque": bool(res.get("stdout_tronque")) or len(so) > EXTRAIT_LIMITES}
+
+
+''', "")
+              .replace('juger_python(cas, res), extrait_limites(res))', 'juger_python(cas, res))'))
+    assert retour == v8
+    assert E.VERSION == "epreuve_isolement_v9" and E.ATTENDUS == "attendus-v8.json" and E.X is X
+
+
+def test_attendus_v8_changements_declares():
+    assert ATT8["version"] == "attendus-v8"
+    assert sorted(k for k in set(ATT7) | set(ATT8) if ATT7.get(k) != ATT8.get(k)) == ["limites_python", "note v8", "version"]
+    l7, l8 = ATT7["limites_python"], ATT8["limites_python"]
+    assert [c for c in l7 if c["nom"] != NOM_137] == [c for c in l8 if c["nom"] != NOM_137]
+    assert cas_137(ATT7) == {**cas_137(ATT8), "fichier": "limite_code137_v1.py"}
+    assert cas_137(ATT8) == {"nom": NOM_137, "fichier": "limite_code137_v2.py", "code": 137,
+                             "stdout_contient": ["SORTIE 137"], "incident_attendu": None}
+    for groupe in ("isolement_lean", "python", "limites_python", "limites_lean", "lean", "noyau"):
+        for c in ATT8[groupe]:
+            assert (ART / c["fichier"]).is_file(), c["fichier"]
+
+
+def test_artefact_v2_est_la_v1_avec_la_sortie_videe():
+    v1 = [l for l in (ART / "limite_code137_v1.py").read_text(encoding="utf-8").splitlines() if not l.startswith("#")]
+    v2 = [l for l in (ART / "limite_code137_v2.py").read_text(encoding="utf-8").splitlines() if not l.startswith("#")]
+    assert v1 == ["import os", 'print("SORTIE 137")', "os._exit(137)"]
+    assert v2 == ["import os", "import sys", "", 'sys.stdout.write("SORTIE 137\\n")', "sys.stdout.flush()", "os._exit(137)"]
+
+
+# ---- R5 : vrai exécuteur, vrai jugement -------------------------------------------------------------------------------------
+
+def _bac_local(tmp_path, python):
+    for n in ("items", "sorties"):
+        (tmp_path / n).mkdir(exist_ok=True)
+    cfg = X.Config(lean="/inutile", lean_path="/inutile", verificateur_sha256="x", python=python, mode="essai-local",
+                   racine_items=tmp_path / "items", racine_sorties=tmp_path / "sorties", duree_max_s=60)
+    return X.Bac(cfg, X.LanceurEssaiLocal(cfg))
+
+
+@pytest.mark.parametrize("python", INTERPRETES)
+def test_r5_artefact_v1_rejoue_le_defaut_du_quatrieme_essai(tmp_path, python):
+    res = _bac_local(tmp_path, python).executer_python(X.nouvel_item(), (ART / "limite_code137_v1.py").read_text("utf-8"))
+    assert res["execution"]["code"] == 137 and res["stdout"] == "" and res["incident_bac"] is None
+    assert E.juger_python(cas_137(ATT7), res) == ["stdout sans « SORTIE 137 »"]   # le défaut vu sur la machine
+
+
+@pytest.mark.parametrize("python", INTERPRETES)
+def test_r5_artefact_v2_cas_sain(tmp_path, python):
+    res = _bac_local(tmp_path, python).executer_python(X.nouvel_item(), (ART / "limite_code137_v2.py").read_text("utf-8"))
+    assert res["execution"]["code"] == 137 and res["stdout"] == "SORTIE 137\n" and res["incident_bac"] is None
+    assert E.juger_python(cas_137(ATT8), res) == []
+    assert res["dossiers_restants"] == [] and res["processus_residuels"] == []
+
+
+@pytest.mark.parametrize("fichier,attendu", [("limite_code137_v1.py", b""), ("limite_code137_v2.py", b"SORTIE 137\n")])
+def test_r5_artefacts_sous_un_tube(fichier, attendu):
+    """Même lecture quand la sortie standard est un tube (le tampon par blocs vaut pour tout ce qui n'est pas un terminal)."""
+    p = subprocess.run([sys.executable, "-I", "-B", str(ART / fichier)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    assert p.returncode == 137 and p.stdout == attendu and p.stderr == b""
+
+
+def test_r5_le_jugement_refuse_toujours_un_137_muet():
+    """L'attente n'est pas affaiblie : un 137 sans la ligne reste un écart sous les attendus v8."""
+    res = {"execution": {"code": 137, "duree_murale_s": 0.1}, "stdout": "", "stderr": "", "incident_bac": None}
+    assert E.juger_python(cas_137(ATT8), res) == ["stdout sans « SORTIE 137 »"]
+    res2 = dict(res, stdout="SORTIE 137\n", incident_bac="délai")
+    assert E.juger_python(cas_137(ATT8), res2) == ["incident du bac 'délai', None attendu"]
+
+
+# ---- extrait de la sortie standard des cas « limites » ------------------------------------------------------------------------
+
+class BacFactice(BacFacticeV8):
+    pass
+
+
+@pytest.fixture
+def epreuve_factice(tmp_path, monkeypatch):
+    import test_lean_essai_epreuve_v8 as T8
+    monkeypatch.setattr(E, "LEURRE", tmp_path / "leurre" / "leurre-v1.txt")
+    monkeypatch.setattr(E, "manifeste", lambda racines=None: "m")
+    monkeypatch.setattr(E, "PIEGES_HOTE", ())
+    monkeypatch.setattr(E.subprocess, "run", lambda *a, **k: subprocess.CompletedProcess(a, 0, "", ""))
+    monkeypatch.setattr(E.X, "Bac", BacFactice)
+    monkeypatch.setattr(T8, "ART", ART)
+    BacFactice.attendus, BacFactice.casser = ATT8, set()
+    for n in ("items", "sorties"):
+        (tmp_path / n).mkdir()
+    cfg = E.X.Config(lean="/l", lean_path="/p", verificateur_sha256="x", mode="bac", racine_items=tmp_path / "items",
+                     racine_sorties=tmp_path / "sorties")
+    return lambda: E.epreuve(cfg, ART)
+
+
+def test_epreuve_v9_cas_sain_conforme_et_extraits(epreuve_factice):
+    r = epreuve_factice()
+    assert r["statut"] == "conforme" and r["conforme"] and r["version"] == "epreuve_isolement_v9"
+    assert len(r["cas"]) == 21 + 5 + 4 + 5 + 1
+    lim = [c for c in r["cas"] if c["genre"] == "limites"]
+    assert len(lim) == 5 and all("stdout_extrait" in c and c["stdout_tronque"] is False for c in lim)
+    assert [c["stdout_extrait"] for c in lim if c["nom"] == NOM_137] == ["SORTIE 137"]
+    assert not any("stdout_extrait" in c for c in r["cas"] if c["genre"] != "limites")
+
+
+def test_extrait_limites_borne():
+    assert E.extrait_limites({"stdout": "x" * 700}) == {"stdout_extrait": "x" * 600, "stdout_tronque": True}
+    assert E.extrait_limites({"stdout": "ab", "stdout_tronque": True})["stdout_tronque"] is True
+    assert E.extrait_limites({}) == {"stdout_extrait": "", "stdout_tronque": False}
