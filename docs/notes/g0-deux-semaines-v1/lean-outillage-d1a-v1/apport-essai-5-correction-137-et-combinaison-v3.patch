+    ("noyau non conforme, pilote apres en code 0", lambda p: (_mut(["premier-pas-noyau-v6.json", "conforme"], False)(p),
+                                      _mut(["premier-pas-noyau-v6.json", "cas", 0, "ok"], False)(p)), 0, "non établi"),
+    ("noyau contradictoire", _mut(["premier-pas-noyau-v6.json", "cas", 0, "ok"], False), 0, "non établi"),
