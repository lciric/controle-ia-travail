+    r4 = C.combiner(ESSAI4, ESSAI4 / "pilote-avant-code-v1.txt", ESSAI4 / "pilote-apres-code-v1.txt")
+    assert not any("introuvable" in m for x in r4["lectures"] for m in x["motifs"])
+
