+    ("un cas en échec, code 1", lambda p: (_cas(3, "ok", False)(p), _cas(3, "ecarts", ["x"])(p),
+                                           _mut(["epreuve-isolement-v6.json", "statut"], "non conforme")(p),
+                                           _mut(["epreuve-isolement-v6.json", "conforme"], False)(p)), 1, "non conforme"),
+    ("code 0, statut non conforme", _mut(["epreuve-isolement-v6.json", "statut"], "non conforme"), 0, "non établi"),
+    ("code 1, statut conforme", lambda p: None, 1, "non établi"),
+    ("épreuve morte", lambda p: (_mut(["epreuve-isolement-v6.json", "statut"], "épreuve morte")(p),
+                                 _mut(["epreuve-isolement-v6.json", "genres_morts"], ["Python"])(p),
