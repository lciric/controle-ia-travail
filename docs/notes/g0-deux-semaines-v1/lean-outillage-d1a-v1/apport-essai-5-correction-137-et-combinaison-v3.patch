+def test_v3_est_la_v2_plus_les_seuls_changements_nommes():
+    """Garde (v3) : la v3 garde les noms, les pièces, les codes et la règle des issues de la v1 et de la v2."""
+    from controle_ia.lean_essai import conformite_outillage_v1 as C1
+    from controle_ia.lean_essai import conformite_outillage_v2 as C2
+    for X in (C1, C2):
+        assert C.PIECES == X.PIECES and C.GENRES == X.GENRES and C.VERIFICATEUR_SHA256 == X.VERIFICATEUR_SHA256
+        assert C.VERSION_EPREUVE == X.VERSION_EPREUVE and C.RANG == X.RANG and C.NON_LANCE == X.NON_LANCE
+        assert C.RE_TENTATIVE.pattern == X.RE_TENTATIVE.pattern and C.RE_CODE_EPREUVE.pattern == X.RE_CODE_EPREUVE.pattern
+    assert C.PASSAGES_NOYAU == C2.PASSAGES_NOYAU and C.STATUTS == C2.STATUTS
+    assert C.VERSION == "conformite_outillage_v3" and "v15" in C.REGLE
+    assert C.TENTATIVES_RESEAU == ("reseau-curl-ip", "reseau-python-tcp", "reseau-dns")
+    assert C.CODES_AVANT_NON_ETABLIS == (124, 255)
+
+
+# ---- v3 : changements de code de la relecture de Claude Fable 5.2 (points 2, 5, 6 et 7) --------------------------------------
+
+def _v2_sur(tmp_path):
+    """Témoin : la règle v2 rejouée sur le dossier que `_jouer` vient d'écrire."""
+    from controle_ia.lean_essai import conformite_outillage_v2 as C2
+    return C2.combiner(tmp_path / "sorties", tmp_path / "pilote-avant-code-v1.txt", tmp_path / "pilote-apres-code-v1.txt")
+
+
+def _sans_tentative(nom):
+    def f(p):
+        for c in p["epreuve-isolement-v6.json"]["cas"]:
+            if isinstance(c.get("sortie_compilation_extrait"), str):
+                c["sortie_compilation_extrait"] = c["sortie_compilation_extrait"].replace(f"ISOLEMENT {nom} ", "ISOLEMENT autre ")
+    return f
+
+
+def _sans_extraits(p):
+    for c in p["epreuve-isolement-v6.json"]["cas"]:
+        c.pop("sortie_compilation_extrait", None)
+
+
+def _extraits_tronques(p):
+    for c in p["epreuve-isolement-v6.json"]["cas"]:
+        if isinstance(c.get("sortie_compilation_extrait"), str):
+            c["sortie_compilation_extrait"] = c["sortie_compilation_extrait"][:40]
+
+
+P2 = [("sans reseau-curl-ip", _sans_tentative("reseau-curl-ip"), ["reseau-curl-ip"]),
+      ("sans reseau-python-tcp", _sans_tentative("reseau-python-tcp"), ["reseau-python-tcp"]),
+      ("sans reseau-dns", _sans_tentative("reseau-dns"), ["reseau-dns"]),
+      ("extraits absents", _sans_extraits, list(C.TENTATIVES_RESEAU)),
+      ("extraits tronqués", _extraits_tronques, list(C.TENTATIVES_RESEAU))]
+
+
+@pytest.mark.parametrize("nom,muter,manquantes", P2, ids=[x[0] for x in P2])
+def test_fable2_tentative_reseau_introuvable_non_etabli(tmp_path, nom, muter, manquantes):
