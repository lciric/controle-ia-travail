+def test_artefact_quatrieme_essai_le_seul_cas_137_repare_suffit(tmp_path):
+    """Contre-épreuve : sur les pièces de l'essai 4, réparer le seul cas 137 (et la version) rend « conforme » ; rien
+    d'autre n'est caché derrière ce cas."""
+    assert _jouer(tmp_path, _sain())["outillage"] == "conforme"
