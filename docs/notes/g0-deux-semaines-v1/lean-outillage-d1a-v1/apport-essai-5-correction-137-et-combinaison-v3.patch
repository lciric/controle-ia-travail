+"""Mutations de conformite_outillage_v2 : chaque mutation doit être tuée par un essai de test_lean_essai_conformite_v2."""
+import subprocess, shutil, sys, os
+from pathlib import Path
+A = Path(sys.argv[1]).resolve(); M = Path(sys.argv[2]).resolve()
+src = (A/"src/controle_ia/lean_essai/conformite_outillage_v2.py").read_text(encoding="utf-8")
+muts = {
+ "B1 retiré": ("    if manques and l.issue != NON_TENU:", "    if False:"),
+ "B1 code ignoré": ("    if code != 0:\n        manques", "    if False:\n        manques"),
+ "B1 statut ignoré": ('    if d["statut"] != CONFORME:\n        manques', '    if False:\n        manques'),
+ "B1 conforme ignoré": ('    if d["conforme"] is not True:\n        manques', '    if False:\n        manques'),
+ "B1 genres ignorés": ("    if pas_conformes:\n        manques", "    if False:\n        manques"),
+ "B1 écarts ignorés": (' or c["ecarts"]]\n    if pas_tenus', ']\n    if pas_tenus'),
+ "B1 témoins ignorés": ("    if temoins:\n        manques", "    if False:\n        manques"),
+ "B2 objet": ("    if not isinstance(d, dict):\n        l.marquer", "    if False:\n        l.marquer"),
+ "B2 éléments": ("    mauvais = [i for i, x in enumerate(v) if not isinstance(x, dict)]", "    mauvais = []"),
+ "B2 types de cas": ("    mauvais = [i for i, c in enumerate(cas) if not isinstance(c.get(\"ok\"), bool) or not isinstance(c.get(\"ecarts\"), list)]", "    mauvais = []"),
+ "B2 formes": ("    mal = [f\"`{nom}` n'est pas {quoi}\" for v, t, nom, quoi in formes if not isinstance(v, t)]", "    mal = []"),
+ "B2 filet de main": ("    except Exception as exc:", "    except ZeroDivisionError as exc:"),
+ "B2 message au lieu du type": ('"erreur": type(exc).__name__,', '"erreur": str(exc),'),
+ "NB7 noms": ("    if lus != attendus_paires:", "    if len(lus) != len(attendus_paires):"),
+ "NB7 passages": ('lus = sorted((str(c.get("genre")), str(c.get("nom"))) for c in cas)', 'lus = sorted((attendus_paires[0][0] if i < 9 else attendus_paires[-1][0], str(c.get("nom"))) for i, c in enumerate(sorted(cas, key=lambda c: str(c.get("genre")))))'),
+ "NB7 H8": ("dementi_par_apres=noyau_non_conforme and apres == 0", "dementi_par_apres=False"),
+ "NB7 H8 inversé": ("dementi_par_apres=noyau_non_conforme and apres == 0", "dementi_par_apres=noyau_non_conforme"),
+ "NB7 H12": ("    if compte and not all(_passage_sain(p) for p in par):", "    if False:"),
+ "noyau écarts": ("    if dementis:", "    if False:"),
+ "extrait non texte": ("    if not isinstance(texte, str):\n        l.marquer", "    if False:\n        l.marquer"),
+}
+def jouer(texte):
+    d = M / "m"; shutil.rmtree(d, ignore_errors=True)
+    shutil.copytree(A/"src/controle_ia", d/"src/controle_ia", ignore=shutil.ignore_patterns("__pycache__"))
+    (d/"scripts").symlink_to(A/"scripts")
+    (d/"src/controle_ia/lean_essai/conformite_outillage_v2.py").write_text(texte, encoding="utf-8")
+    env = dict(os.environ, PYTHONPATH=str(d/"src"), PYTHONDONTWRITEBYTECODE="1")
+    p = subprocess.run([sys.executable, "-m", "pytest", "-q", "-x", "-p", "no:cacheprovider", "-o", "pythonpath=",
+                        str(A/"tests/test_lean_essai_conformite_v2.py")], capture_output=True, text=True, env=env, cwd=A)
+    return p
+p0 = jouer(src)
+print("témoin sans mutation : code", p0.returncode, "|", p0.stdout.strip().splitlines()[-1])
+assert p0.returncode == 0
+res = {}
+for nom, (a, b) in muts.items():
+    assert src.count(a) == 1, nom
+    p = jouer(src.replace(a, b))
+    res[nom] = "tuée" if p.returncode == 1 else ("SURVIT" if p.returncode == 0 else f"code {p.returncode}")
+    tueur = [x for x in p.stdout.splitlines() if x.startswith("FAILED")][:1]
+    print(f"{nom} : {res[nom]} {tueur}")
+shutil.rmtree(M/"m", ignore_errors=True)
+print(f"{sum(v=='tuée' for v in res.values())}/{len(res)} tuées")
