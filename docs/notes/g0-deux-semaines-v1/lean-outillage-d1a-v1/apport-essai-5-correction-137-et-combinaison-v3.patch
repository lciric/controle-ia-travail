+    assert all(_lecture(r, n)["issue"] == "non établi" for n in ("noyau", "épreuve", "sondes réseau", "mesures"))
+    assert _lecture(r, "épreuve")["tentatives_reseau"] == {}   # rien n'est lu après lui
+    assert all(x["motifs"] == ["non établi : non lu : le pilote s'est arrêté avant"]
+               for x in r["lectures"] if x["lecture"] in ("épreuve", "sondes réseau", "mesures"))
+    assert _v2_sur(tmp_path)["outillage"] == "non conforme"   # témoin : la v2 lisait « non conforme »
