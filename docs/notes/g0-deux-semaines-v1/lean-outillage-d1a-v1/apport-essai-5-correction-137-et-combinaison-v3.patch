+    q = subprocess.run(args[:4] + ["--sorties", str(ESSAI4), "--pilote-avant-code", str(ESSAI4 / "pilote-avant-code-v1.txt"),
+                                   "--pilote-apres-code", str(ESSAI4 / "pilote-apres-code-v1.txt")],
+                       capture_output=True, text=True, env=env, cwd=RACINE)
+    assert q.returncode == 1 and json.loads(q.stdout)["outillage"] == "non conforme"
+    (d / "mesures-v6.json").unlink()
+    assert subprocess.run(args, capture_output=True, text=True, env=env, cwd=RACINE).returncode == 3
