+# ---- une pièce cassée à la fois -------------------------------------------------------------------------------------------
+
+def _mut(chemin, valeur):
+    def f(p):
+        o = p
+        for k in chemin[:-1]:
+            o = o[k]
+        o[chemin[-1]] = valeur(o[chemin[-1]]) if callable(valeur) else valeur
+    return f
+
+
+def _cas(i, champ, valeur):
+    return lambda p: p["epreuve-isolement-v6.json"]["cas"][i].__setitem__(champ, valeur)
+
