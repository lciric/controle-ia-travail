+"""Pilote du poste v13 (essai Lean D-1a, cinquième essai) : copie du v12 dont seule change l'épreuve v9 dans la phase
+« apres », et l'en-tête."""
+import subprocess
+from pathlib import Path
+
+RACINE = Path(__file__).resolve().parents[1]
+V12 = RACINE / "scripts" / "lean_essai_d1a_v12" / "piloter_poste_v12.sh"
+V13 = RACINE / "scripts" / "lean_essai_d1a_v13" / "piloter_poste_v13.sh"
+
+
+def corps(p):
+    return [l for l in p.read_text(encoding="utf-8").splitlines() if not l.startswith("#")]
+
+
+def test_pilote_v13_rien_d_autre():
+    assert corps(V13) == [l.replace("epreuve_isolement_v8.py", "epreuve_isolement_v9.py") for l in corps(V12)]
+
+
+def test_pilote_v13_lance_la_v9():
+    code = V13.read_text(encoding="utf-8")
+    assert '"$PAQ/executeur_bac_v8.py" "$PAQ/epreuve_isolement_v9.py"' in code
+    assert code.count("python3 -B /opt/harnais/epreuve_isolement_v9.py") == 4
+    assert "epreuve_isolement_v8" not in "\n".join(corps(V13))
+    assert "verificateur_noyau_v6.lean" in code and '"$V4"/artefacts_r5_v4/*' in code
+    assert code.splitlines()[0] == "#!/usr/bin/env bash" and "# Texte du v12 :" in code
+    assert V13.stat().st_mode & 0o111
+    assert subprocess.run(["bash", "-n", str(V13)]).returncode == 0
