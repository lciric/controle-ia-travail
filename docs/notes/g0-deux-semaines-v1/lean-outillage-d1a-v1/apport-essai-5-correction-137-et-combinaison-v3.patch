+    e = _lecture(r, "épreuve")
+    assert r["outillage"] == "non établi" and e["issue"] == "non établi", json.dumps(r, ensure_ascii=False)[:2000]
+    for t in manquantes:
+        assert any(m.startswith(f"non établi : tentative {t} introuvable") for m in e["motifs"]), e["motifs"]
+    assert not [m for m in e["motifs"] if m.startswith("non tenu")]
+    assert _v2_sur(tmp_path)["outillage"] == "conforme"   # témoin : la v2 lisait ce silence « conforme »
