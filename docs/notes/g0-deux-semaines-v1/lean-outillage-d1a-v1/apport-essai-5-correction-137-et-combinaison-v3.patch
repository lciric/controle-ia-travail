+def _un_cas_en_echec(statut, conforme):
+    def f(p):
+        e = p["epreuve-isolement-v6.json"]
+        e["cas"][3]["ok"], e["cas"][3]["ecarts"] = False, ["écart planté"]
+        e["statut"], e["conforme"] = statut, conforme
+    return f
+
+
+P6_INCOHERENTES = [
+    ("code 0, non conforme, conforme faux", _un_cas_en_echec("non conforme", False), 0),
+    ("code 124, non conforme, conforme faux", _un_cas_en_echec("non conforme", False), 124),
+    ("code 2, non conforme, conforme faux", _un_cas_en_echec("non conforme", False), 2),
+    ("code absent, non conforme, conforme faux", _un_cas_en_echec("non conforme", False), None),
+    ("code 1, épreuve morte, conforme faux", _un_cas_en_echec("épreuve morte", False), 1),
+    ("code 3, non conforme, conforme faux", _un_cas_en_echec("non conforme", False), 3),
+    ("code 1, non conforme, conforme vrai", _un_cas_en_echec("non conforme", True), 1),
+]
