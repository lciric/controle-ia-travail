+"""Essais de la règle de combinaison de la conformité de l'outillage Lean D-1a (`conformite_outillage_v2`, procédure du
+poste local v14, § 8.7). Copie des essais de la v1 (`test_lean_essai_conformite_v1.py`, gardés tels quels, R12), plus les
+essais des corrections de la contre-lecture : B1 (H1, H2, H3, H10, H17), B2 (pièces et éléments qui ne sont pas des objets,
+genres en liste, mesures valant [1, 2], erreur inattendue en code 3) et la non bloquante 7 (noms des 18 cas du noyau, H8,
+H12).
+
+R5 : le cas sain est fabriqué à partir des **vraies pièces du quatrième essai** (serveur 177109613, jeton `fae70647f54e`,
+copiées sous `tests/donnees_conformite_outillage_v1/`, empreintes égales au manifeste `da2044df…` de la branche
+`donnees/lean-outillage-d1a-poste-local-v6`), le seul cas 137 réparé et la version portée à v9 ; il sort « conforme ».
+L'artefact principal est ces mêmes pièces telles quelles : la règle les lit « non conforme » sur le seul cas 137 et ne
+tolère rien d'elle-même. Puis une pièce cassée à la fois.
+"""
+import copy
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from controle_ia.lean_essai import conformite_outillage_v2 as C
+
+RACINE = Path(__file__).resolve().parents[1]
+DONNEES = RACINE / "tests" / "donnees_conformite_outillage_v1"
+ESSAI4 = DONNEES / "essai4-fae70647f54e"
+NOM_137 = "sortie de lui-même en code 137, sans consommer la limite (5 s)"
+
+
+def test_pieces_du_quatrieme_essai_intactes():
+    lignes = (DONNEES / "empreintes-essai4-fae70647f54e-v1.sha256").read_text(encoding="utf-8").split("\n")
+    vus = 0
+    for l in filter(None, lignes):
+        h, nom = l.split("  ")
+        assert hashlib.sha256((DONNEES / nom).read_bytes()).hexdigest() == h, nom
+        vus += 1
+    assert vus == 9
+
+
+def _ecrire(dossier: Path, nom: str, obj) -> None:
+    (dossier / nom).write_text(obj if isinstance(obj, str) else json.dumps(obj, ensure_ascii=False, indent=1) + "\n",
+                               encoding="utf-8")
+
+
+def _charger():
+    return {n: json.loads((ESSAI4 / n).read_text(encoding="utf-8")) for n in (
+        "premier-pas-noyau-v6.json", "epreuve-isolement-v6.json", "mesures-v6.json", "sonde-apres-coupure-v6.json",
+        "sonde-fin-v6.json", "verificateur-epingle-v6.json")}
+
+
+def _sain():
+    p = _charger()
+    for n in ("premier-pas-noyau-v6.json", "epreuve-isolement-v6.json", "mesures-v6.json"):
+        p[n]["version"] = "epreuve_isolement_v9"
+    e = p["epreuve-isolement-v6.json"]
+    for c in e["cas"]:
+        if c["nom"] == NOM_137:
+            c["ok"], c["ecarts"] = True, []
+    e["genres"]["limites"], e["statut"], e["conforme"] = "conforme", "conforme", True
+    return p
+
+
+CODE_EPREUVE = "code de sortie de l'épreuve : {} (0 = conforme ; 1 = non conforme ; 3 = épreuve morte ; 124 = borne de temps atteinte)\n"
+
+
+def _jouer(tmp_path, pieces, code_epreuve=0, avant="0\n", apres="0\n"):
+    d = tmp_path / "sorties"
+    d.mkdir(parents=True, exist_ok=True)
+    for n, obj in pieces.items():
+        if obj is not None:
+            _ecrire(d, n, obj)
+    if code_epreuve is not None:
+        _ecrire(d, "epreuve-code-v6.txt", CODE_EPREUVE.format(code_epreuve))
+    ca, cp = tmp_path / "pilote-avant-code-v1.txt", tmp_path / "pilote-apres-code-v1.txt"
+    for f, v in ((ca, avant), (cp, apres)):
+        if v is not None:
+            f.write_text(v, encoding="utf-8")
+    return C.combiner(d, ca, cp)
+
+
+def _lecture(r, nom):
+    (x,) = [x for x in r["lectures"] if x["lecture"] == nom]
+    return x
+
+
+# ---- cas sain -------------------------------------------------------------------------------------------------------------
+
+def test_cas_sain_conforme_trois_en_parallele(tmp_path):
+    r = _jouer(tmp_path, _sain())
+    assert r["outillage"] == "conforme" and r["usage"] == "trois en parallèle", r
+    assert all(x["issue"] == "tenu" and x["motifs"] == [] for x in r["lectures"])
+    assert set(_lecture(r, "épreuve")["tentatives_reseau"]) == {"reseau-curl-ip", "reseau-python-tcp", "reseau-dns"}
+
+
+def test_cas_sain_parallele_non_compte_reste_conforme_un_a_la_fois(tmp_path):
+    p = _sain()
+    p["mesures-v6.json"]["parallele_3_compte"] = False
+    p["mesures-v6.json"]["parallele_3_motifs"] = ["critère 5 : pic de la tranche au-delà de la moitié"]
+    r = _jouer(tmp_path, p)
+    assert r["outillage"] == "conforme" and r["usage"] == "un à la fois"
+
+
+# ---- artefact principal : le quatrième essai tel quel ---------------------------------------------------------------------
+
+def test_artefact_quatrieme_essai_tel_quel(tmp_path):
+    r = C.combiner(ESSAI4, ESSAI4 / "pilote-avant-code-v1.txt", ESSAI4 / "pilote-apres-code-v1.txt")
+    assert r["outillage"] == "non conforme" and r["usage"] is None
+    e = _lecture(r, "épreuve")
+    assert e["issue"] == "non tenu"
+    non_tenus = [m for m in e["motifs"] if m.startswith("non tenu")]
+    assert non_tenus == [f"non tenu : cas « {NOM_137} » (limites) en échec : ['stdout sans « SORTIE 137 »']"]
+    assert any("epreuve_isolement_v8" in m for m in e["motifs"])   # version de l'essai 4, dite
+    assert _lecture(r, "noyau")["issue"] == "non établi"            # version seule ; les 18 cas tiennent
+    assert [m for m in _lecture(r, "noyau")["motifs"] if "version" not in m] == []
+    assert _lecture(r, "sondes réseau")["issue"] == "tenu" and _lecture(r, "pilotes")["issue"] == "tenu"
+
