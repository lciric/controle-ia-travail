{"data":{"id":"10.25493/8cqn-y8s","type":"dois","attributes":{"doi":"10.25493/8cqn-y8s","prefix":"10.25493","suffix":"8cqn-y8s","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Arena, A.","nameType":"Personal","givenName":"A.","familyName":"Arena","affiliation":[],"nameIdentifiers":[]},{"name":"S. Nilsen., Andre","nameType":"Personal","givenName":"Andre","familyName":"S. Nilsen.","affiliation":[],"nameIdentifiers":[]},{"name":"Thon, S.","nameType":"Personal","givenName":"S.","familyName":"Thon","affiliation":[],"nameIdentifiers":[]},{"name":"Storm, J.","nameType":"Personal","givenName":"J.","familyName":"Storm","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test of consciousness metrics in rodents"}],"publisher":"EBRAINS","container":{},"publicationYear":2020,"subjects":[{"subject":"Neuroscience"}],"contributors":[{"name":"Storm, Johan","nameType":"Personal","givenName":"Johan","familyName":"Storm","affiliation":[],"contributorType":"ContactPerson","nameIdentifiers":[]}],"dates":[{"date":"2020-03-27","dateType":"Issued"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The aim of this task is to test and compare proposed measures of level of consciousness based on spontaneous EEG activity. These measures include metrics of signal diversity like Lempel Ziv complexity, amplitude coalition entropy, synchrony coalition entropy (Schartner et al., 2015) and metrics of integrated information, like Phi* and PhiG from the practical Phi toolbox published in https://figshare.com/articles/phi_toolbox_zip/3203326 Data report multichannel spontaneous EEG activity (16 epidural electrodes covering most of the cortex) from rats during wakefulness and during general anaesthesia induced by 3 different anaesthetics (propofol, sevoflurane, ketamine). The reported spontaneous data preceded an electrical stimulation to right secondary motor cortex used to induce evoked responses with the purpose to calculate the “Perturbational Complexity Index state transition”, another promising consciousness measure based on perturbed activation (Comolatti et al., 2019). This dataset (in conjunction with dataset at DOI: 10.25493/S0DM-BK5) allows comparison between proposed consciousness measures based on spontaneous activity and metric based on evoked activity from the same rats and conditions.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://kg.ebrains.eu/search/instances/Dataset/1ec84aaa-90c7-41fd-9dca-dc249cb2876b","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2020-03-27T02:06:51.000Z","registered":"2020-03-27T02:06:52.000Z","published":"2020","updated":"2021-07-20T00:33:50.000Z"},"relationships":{"client":{"data":{"id":"hbp.neuroinf","type":"clients"}},"provider":{"data":{"id":"hbp","type":"providers"}},"media":{"data":{"id":"10.25493/8cqn-y8s","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}