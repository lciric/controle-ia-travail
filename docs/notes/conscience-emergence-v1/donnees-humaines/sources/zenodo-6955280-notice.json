{"created": "2022-08-03T04:06:38.157598+00:00", "modified": "2022-09-01T00:02:01.177408+00:00", "id": 6955280, "conceptrecid": "6955279", "doi": "10.5281/zenodo.6955280", "conceptdoi": "10.5281/zenodo.6955279", "doi_url": "https://doi.org/10.5281/zenodo.6955280", "metadata": {"title": "Brain functional connectivity data in anesthetized participants and patients with neuropathological or psychiatric diagnoses", "doi": "10.5281/zenodo.6955280", "publication_date": "2022-08-03", "description": "<p>Five fMRI datasets were collected from&nbsp;independent research sites including: propofol deep sedation (PDS; drug effect site concentration= ~2.4 &mu;g/ml) in Dataset-1, propofol general anesthesia (PGA; drug effect site concentration= 4.0 &mu;g/ml) in Dataset-2, ketamine anesthesia (KA) in Dataset-3, unresponsive wakefulness syndrome (UWS) in Dataset-4, and schizophrenia (SCHZ), bipolar disorder (BD), and attentional deficit hyperactivity disorder (ADHD) in Dataset-5.&nbsp;Following fMRI data preprocessing, the fMRI time courses were extracted from 400 cortical areas&nbsp;according to a well-established brain parcellation scheme (Schaefer&#39;s 400 ROIs). A connectivity matrix was then calculated using Pearson correlation resulting in a 400x400 connectivity matrix for each participant and each condition.</p>", "access_right": "open", "creators": [{"name": "Zirui Huang", "affiliation": "University of Michigan"}], "keywords": ["Functional Connectivity"], "version": "1", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "6955279"}}]}}, "title": "Brain functional connectivity data in anesthetized participants and patients with neuropathological or psychiatric diagnoses", "links": {"self": "https://zenodo.org/api/records/6955280", "self_html": "https://zenodo.org/records/6955280", "preview_html": "https://zenodo.org/records/6955280?preview=1", "doi": "https://doi.org/10.5281/zenodo.6955280", "self_doi": "https://doi.org/10.5281/zenodo.6955280", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.6955280", "reserve_doi": "https://zenodo.org/api/records/6955280/draft/pids/doi", "parent": "https://zenodo.org/api/records/6955279", "parent_html": "https://zenodo.org/records/6955279", "parent_doi": "https://doi.org/10.5281/zenodo.6955279", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.6955279", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:6955280/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:6955280/sequence/default", "files": "https://zenodo.org/api/records/6955280/files", "media_files": "https://zenodo.org/api/records/6955280/media-files", "latest": "https://zenodo.org/api/records/6955280/versions/latest", "latest_html": "https://zenodo.org/records/6955280/latest", "versions": "https://zenodo.org/api/records/6955280/versions", "draft": "https://zenodo.org/api/records/6955280/draft", "access_links": "https://zenodo.org/api/records/6955280/access/links", "access_grants": "https://zenodo.org/api/records/6955280/access/grants", "access_users": "https://zenodo.org/api/records/6955280/access/users", "access_request": "https://zenodo.org/api/records/6955280/access/request", "access": "https://zenodo.org/api/records/6955280/access", "communities": "https://zenodo.org/api/records/6955280/communities", "communities-suggestions": "https://zenodo.org/api/records/6955280/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/6955280/request-deletion", "file_modification": "https://zenodo.org/api/records/6955280/file-modification", "quota_increase": "https://zenodo.org/api/records/6955280/quota-increase", "requests": "https://zenodo.org/api/records/6955280/requests"}, "updated": "2022-09-01T00:02:01.177408+00:00", "recid": "6955280", "revision": 3, "files": [{"id": "074ed439-820b-41db-9b20-a956da2b45f2", "key": "Functional Connectivity Data.rar