+def neuronpedia_lens(filename: str) -> dict:
+    """A Neuronpedia lens file's Jacobians by layer, refused unless it is ``{"J": {int: square matrix}}``."""
+    payload = torch.load(hf_hub_download(NEURONPEDIA_REPO, filename), map_location="cpu", weights_only=True)
+    J = payload.get("J") if isinstance(payload, dict) else None
+    if not isinstance(J, dict) or not J or not all(
+            isinstance(l, int) and isinstance(m, torch.Tensor) and m.ndim == 2 and m.shape[0] == m.shape[1]
+            for l, m in J.items()):
+        keys = sorted(payload) if isinstance(payload, dict) else type(payload).__name__
+        raise ValueError(f"{filename}: not a J-lens layout ({keys})")
+    return J
 
 
