+def verifier_variables_de_chemin_non_posees():
+    """Additif 2, § 7, point 2 (repris par l'additif 3, § 5, point 6) : variables d'environnement de chemin non posées."""
+    posees = [nom for nom in VARIABLES_DE_CHEMIN_INTERDITES if os.environ.get(nom) is not None]
+    if posees:
+        raise RefusExecution(f"variables d'environnement de chemin posées : {posees}")
