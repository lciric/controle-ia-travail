+def comptes_gagnes(cellule):
+    """Compte entier de répliques gagnées par comparaison, relu sur la puissance (part des répliques gagnées) ; une
+    puissance qui n'est pas k / R exactement est une faute du banc."""
+    R = cellule["repliques"]
+    comptes = {}
+    for nom in NOMS_DES_COMPARAISONS:
+        p = cellule["puissance_par_comparaison"][nom]
+        k = int(round(p * R))
+        if not (0 <= k <= R) or k / R != p:
+            raise BancInvalide(f"compte de répliques gagnées illisible : {nom}, {p} sur {R}")
+        comptes[nom] = k
+    return comptes
+
