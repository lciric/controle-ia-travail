+def criteres_portee_200(cellules, repliques):
+    """Aide `criteres_mecaniques.puissance` (additif 3, § 5, point 8), jamais le verdict (règle R13) : puissance qui
+    décide et sa ou ses cellules, avec leur compte ; minima par comparaison ; comparaisons sans cellule faisable ;
+    issue A ou B du § 3, lue sur les comptes entiers ; mention « près du seuil » ; et, pour contrôle, la lecture du
+    banc v3 (`puissance_qui_decide`) sur les mêmes cellules."""
+    par_comparaison = {nom: [] for nom in NOMS_DES_COMPARAISONS}
+    for rang, c in enumerate(cellules):
+        if not c.get("faisable") or abs(c["ecart_vise"] - ECART_QUI_DECIDE) > EPS or c["loi"] not in (1, 3):
+            continue
+        for nom in COMPARAISONS_DU_MONDE[c["comparaison"]]:
+            par_comparaison[nom].append((c["repliques_gagnees_par_comparaison"][nom], rang))
+    sans = [nom for nom, v in par_comparaison.items() if not v]
+    minima_comptes = {nom: (min(k for k, _ in v) if v else None) for nom, v in par_comparaison.items()}
+    minima = {nom: (k / repliques if k is not None else None) for nom, k in minima_comptes.items()}
+    cellules_faisables = {nom: len(v) for nom, v in par_comparaison.items()}
+    if sans:
+        minimum, au_minimum = None, []
+    else:
+        minimum = min(minima_comptes.values())
+        au_minimum = [{"rang": rang, "comparaison_du_test": nom, "comparaison_du_monde": cellules[rang]["comparaison"],
+                       "loi": cellules[rang]["loi"], "rho": cellules[rang]["rho"],
+                       "rho_prime": cellules[rang]["rho_prime"], "repliques_gagnees": k, "repliques": repliques}
+                      for nom, v in par_comparaison.items() for (k, rang) in v if k == minimum]
+    issue = issue_de_la_regle_de_lecture(minimum, repliques, sans)
+    pres = (minimum is not None and 1000 * minimum >= PRES_DU_SEUIL_MILLIEMES[0] * repliques
+            and 1000 * minimum <= PRES_DU_SEUIL_MILLIEMES[1] * repliques)
+    lecture_v3 = puissance_qui_decide(cellules, ecart=ECART_QUI_DECIDE)
+    return {
+        "nature": ("aide calculée par le code (additif 3, § 5, point 8), jamais le verdict : l'agent neuf qui prononce "
+                   "(règle R13) applique lui-même le § 3 aux comptes, contrôle d'abord la faute du banc (§ 6), puis "
+                   "compare à cette aide."),
+        "ecart_qui_decide": ECART_QUI_DECIDE,
+        "repliques_par_cellule": repliques,
+        "puissance_qui_decide": (minimum / repliques if minimum is not None else None),
+        "repliques_gagnees_dans_la_cellule_la_plus_basse": minimum,
+        "cellules_au_minimum": au_minimum,
+        "minima_par_comparaison": minima,
+        "minima_par_comparaison_en_repliques_gagnees": minima_comptes,
+        "cellules_faisables_lues_par_comparaison": cellules_faisables,
+        "comparaisons_sans_cellule_faisable": sans,
+        "issue": issue,
+        "ce_qu_elle_dit": MOT_ISSUE[issue],
+        "pres_du_seuil": {"vrai": bool(pres),
+                          "regle": "puissance qui décide entre 0,478 et 0,522, bornes comprises (additif 3, § 3)",
+                          "mention": ("rapportée avec cette mention et son compte ; le mot reste celui de la table"
+                                      if pres else None)},
+        "lecture_du_banc_v3_sur_les_memes_cellules": lecture_v3,
+    }
+
