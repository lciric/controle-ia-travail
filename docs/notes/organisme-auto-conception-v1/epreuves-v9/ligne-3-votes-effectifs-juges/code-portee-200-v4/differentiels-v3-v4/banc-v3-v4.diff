+def executer_portee_200(contexte, cfg, dossier_sortie, dossier_du_code=None):
+    """Mesure de la portée à 200 (additif 3, § 1) : le monde de puissance seul, n = 200, une fois. Toutes les gardes
+    passent avant la première dérivation : taille ; configuration gelée (hors essais) ; dossier de sortie neuf ;
+    dossier du code propre ; racines et autorisation ; gardes déterministes. `dossier_du_code` n'est permis qu'en essai
+    (dépôt jetable des essais) ; hors essai, c'est le dossier de ce fichier."""
+    puissance = cfg.get("puissance") if isinstance(cfg, dict) else None
+    n = puissance.get("n") if isinstance(puissance, dict) else None
+    if isinstance(n, bool) or not isinstance(n, int) or n != N_PORTEE_200:
+        raise RefusExecution(f"taille : n = {n!r} au lieu de {N_PORTEE_200} (additif 3, § 1)")
+    if contexte.mode not in ("essais", "portee_200"):
+        raise RefusExecution(f"mode {contexte.mode!r} : la mesure se joue en mode « portee_200 » (ou en essai)")
+    if contexte.mode != "essais":
+        if cfg != CONFIGURATION_PORTEE_200:
+            raise RefusExecution("configuration autre que la configuration gelée CONFIGURATION_PORTEE_200")
+        if dossier_du_code is not None:
+            raise RefusExecution("dossier du code donné en argument : permis en essai seulement")
+    dossier = Path(dossier_sortie)
+    if dossier.exists():
+        raise RefusExecution(f"dossier de sortie déjà présent : {dossier} (une exécution par dossier)")
+    code = Path(dossier_du_code) if dossier_du_code is not None else Path(__file__).resolve().parent
+    verifier_dossier_du_code_propre(code, dossier)
+    cellules_p = enumerer_cellules_puissance(puissance)
+    verifier_racine(contexte.racine_tirages, "monde_de_puissance", len(cellules_p), contexte.autorisation)
+    verifier_racine(contexte.racine_reechantillonnage, "reechantillonnage_monde_de_puissance", len(cellules_p),
+                    contexte.autorisation)
+    verifier_gardes_avant_tirage()
+    verifier_gardes_portee_200()
+    debut = datetime.datetime.now(datetime.timezone.utc)
+    R, B = cfg["repliques"], cfg["tirages_reechantillonnage"]
+
+    gt = contexte.tirages("monde_de_puissance", len(cellules_p))
+    gr = contexte.reechantillonnage("reechantillonnage_monde_de_puissance", len(cellules_p))
+    res_p = [cellule_puissance(gt[i], gr[i], comp, ec, loi, rho, rp, R, B, n=puissance["n"])
+             for i, (comp, ec, loi, rho, rp) in enumerate(cellules_p)]
+    for c in res_p:
+        if c.get("faisable"):
+            c["repliques_gagnees_par_comparaison"] = comptes_gagnes(c)
+
+    resultat = {
+        "version": VERSION,
+        "mode": contexte.mode,
+        "mesure": "puissance qui décide de la règle gelée de portée, à n = 200 (additif 3 v3, § 1)",
+        "note": ("Les critères mécaniques ci-dessous sont une aide calculée par le code ; le verdict de la mesure est "
+                 "prononcé par un agent neuf (règle R13), contre-lu, puis scellé par la mère. Aucun mot ne valide, "
+                 "n'écarte ni ne classe une carte."),
+        "criteres_mecaniques": {"puissance": criteres_portee_200(res_p, R)},
+        "monde_de_puissance": res_p,
+    }
+    fin = datetime.datetime.now(datetime.timezone.utc)
+    dossier.mkdir(parents=True, exist_ok=False)
+    chemin_res = dossier / FICHIER_RESULTAT_PORTEE_200
+    ecrire_json_exclusif(chemin_res, resultat)
+    manifeste = construire_manifeste(contexte, cfg, debut, fin, {chemin_res.name: sha256_fichier(chemin_res)},
+                                     dossier_du_code=code)
+    manifeste["additif_qui_fait_foi_sha256"] = EMPREINTE_ADDITIF_3_PORTEE_200
+    ecrire_json_exclusif(dossier / FICHIER_MANIFESTE_PORTEE_200, manifeste)
+    return resultat, manifeste
