+    assert c["juge-argon"]["par_voisins"]["conforme_non_citant"]["compte"] == mauvais_res_vn
+    assert c["juge-opus"]["par_classe"]["bon"]["compte"] == bons_vn and c["juge-argon"]["par_classe"]["bon"]["compte"] == 0
