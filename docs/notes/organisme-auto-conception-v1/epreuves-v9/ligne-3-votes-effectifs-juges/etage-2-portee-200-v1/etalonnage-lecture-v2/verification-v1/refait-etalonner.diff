+def lire_construction(journal_chemin, journal_sha, fragments_chemin, fragments_sha, banque: dict) -> dict:
+    """Rend {témoin: nature du fragment « voisins » employé} (conforme non citant, conforme citant, fautif), tirée du journal
+    de construction (fragments employés par identifiant) et du fichier de fragments (conformes par catégorie, avec leur
+    citation ; fautifs avec leur catégorie), tous deux scellés. Refus nommés : journal d'autres fragments, schéma, témoin
+    du journal différent de la banque (classe, item, niveau, citation, moitié), fragment « voisins » inconnu."""
+    j = lire_json_scelle(journal_chemin, journal_sha, "journal de construction")
+    f = lire_json_scelle(fragments_chemin, fragments_sha, "fichier de fragments")
+    if not isinstance(j, dict) or not isinstance(j.get("temoins"), list):
+        raise Refus("journal de construction : objet {\"temoins\": [...]} attendu")
+    if j.get("fragments_sha256") != fragments_sha:
+        raise Refus("journal de construction : il nomme un fichier de fragments d'une autre empreinte")
+    if not isinstance(f, dict) or f.get("schema") != SCHEMA_FRAGMENTS or not isinstance(f.get("conformes"), dict) \
+            or not isinstance(f.get("fautifs"), list):
+        raise Refus("fichier de fragments : schéma du générateur v3 attendu")
+    nature = {}
+    for x in f["conformes"].get(CATEGORIE_VOISINS) or []:
+        if not isinstance(x, dict) or not isinstance(x.get("id"), str) or not isinstance(x.get("citation"), bool):
+            raise Refus("fichier de fragments : fragment conforme de « voisins » hors forme")
+        nature[x["id"]] = "conforme_citant" if x["citation"] else "conforme_non_citant"
+    for x in f["fautifs"]:
+        if isinstance(x, dict) and x.get("categorie") == CATEGORIE_VOISINS and isinstance(x.get("id"), str):
+            if x["id"] in nature:
+                raise Refus("fichier de fragments : identifiant de « voisins » à la fois conforme et fautif")
+            nature[x["id"]] = "fautif"
+    sortie = {}
+    for e in j["temoins"]:
+        t = e.get("identifiant_interne") if isinstance(e, dict) else None
+        if t not in banque or t in sortie:
+            raise Refus("journal de construction : témoin hors de la banque ou en double")
+        b = banque[t]
+        if any(e.get(k) != b[k] for k in ("classe", "item", "niveau", "citation", "moitie")):
+            raise Refus(f"journal de construction : {t} diffère de la banque (classe, item, niveau, citation ou moitié)")
+        fid = (e.get("fragments") or {}).get(CATEGORIE_VOISINS)
+        if fid not in nature:
+            raise Refus(f"journal de construction : {t} : fragment « voisins » absent du fichier de fragments")
+        sortie[t] = nature[fid]
+    if set(sortie) != set(banque):
+        raise Refus("journal de construction : témoins de la banque manquants")
+    return sortie
+
+
+def compter_reserves_tenues(banque: dict, verdicts: dict, voisins: dict) -> dict:
+    """Moitié « étalonnage », premier rendu de chaque juge, verdict présent : nombre de cartes dont l'item
+    `reserves_tenues` est rendu faux (« tombées »), sur le nombre de verdicts présents ; par classe, par citation, par item
+    planté, par nature du fragment « voisins », et par strate croisée. Rapporté, sans seuil ; aucune décision."""
+    par_temoin = verdicts["par_temoin"]
+    sortie = {"definition": ("premier rendu (bloc A), verdict présent ; « tombée » = item reserves_tenues rendu faux ; "
+                             "un verdict absent n'est pas compté (rapporté à part)"),
+              "decision_de_la_mere": "un fragment « voisins » conforme non citant n'est pas une citation de travail publié",
+              "par_juge": {}}
+    for j in JUGES:
+        marges = {"par_classe": {}, "par_citation": {}, "par_item_plante": {}, "par_voisins": {}}
+        strates, absents = {}, 0
+        for t in sorted(par_temoin):
+            v = par_temoin[t][(j, 1)]["verdict"]
+            if v is None:
+                absents += 1
+                continue
+            b = banque[t]
+            tombee = int(v["items"][ITEM_RESERVES] is False)
+            cles = {"par_classe": b["classe"], "par_citation": "citant" if b["citation"] else "non_citant",
+                    "par_item_plante": b["item"] or "aucun (bon)", "par_voisins": voisins[t]}
+            for m, k in cles.items():
+                c = marges[m].setdefault(k, {"compte": 0, "sur": 0})
+                c["compte"] += tombee
+                c["sur"] += 1
+            s = (b["classe"], cles["par_citation"], cles["par_item_plante"], voisins[t])
+            c = strates.setdefault(s, {"compte": 0, "sur": 0})
+            c["compte"] += tombee
+            c["sur"] += 1
+        sortie["par_juge"][j] = dict(
+            marges, verdicts_absents_exclus=absents,
+            strates=[{"classe": a, "citation": b, "item_plante": c, "voisins": d, **strates[(a, b, c, d)]}
+                     for (a, b, c, d) in sorted(strates)])
+    return sortie
+
