+            continue
+        if str(m) in par_m:
+            doublons.append(m)
+            continue
+        melange = c["comptes_du_melange_plante"]
+        n_sans = melange["suites_sans_changement"]
+        x = c["par_bras"]["B"]["comptes_silence_1"]["suites_sans_changement_en_alarme"]
