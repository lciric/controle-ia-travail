+        b = c["par_bras"]["B"]["comptes_silence_1"]["suites_a_effet_detectees"]
+        d = c["par_bras"]["D"]["comptes_silence_1"]["suites_a_effet_detectees"]
+        lue = m in M_DE_LA_CLAUSE_DETECTION_P6
+        det_atteinte = (b <= d) if lue else None
+        par_m[str(m)] = {
+            "clause_fausse_alarme": {
+                "bras": "B", "suites_sans_changement_en_alarme": int(x), "suites_sans_changement": int(n_sans),
+                "regle": ("atteinte si plus de 0,08 des suites sans changement sont en alarme, strictement "
+                          "(plus de 80 sur 1 000)"),
+                "atteinte": bool(fa_atteinte)},
+            "clause_detection": {
+                "bras": "B", "contre": "D", "suites_a_effet_detectees_bras_B": int(b),
+                "suites_a_effet_detectees_bras_D": int(d), "suites_a_effet": int(melange["suites_a_effet"]),
