+def criteres_alarme_p6(cellules):
+    """Additif 1, silence 2 — aide, jamais le verdict (règle R13). La carte de l'alarme (fcbf4a2dd1a57) ne reçoit aucun
+    mot : « mesurée, sans mot : aucune règle de mot gelée ». La prédiction P6 se lit à la lettre de sa clause de
+    réfutation, sur les comptes entiers, sans intervalle : clause « fausse alarme », à chaque m (10 ; 20 ; 40), atteinte
+    si plus de 0,08 des suites sans changement portent une alarme de la sentinelle (bras B), strictement ; clause
+    « détection », à m = 20 et 40, atteinte si les changements « à effet » détectés par B sont au plus aussi nombreux
+    que ceux du bras apparié (D) ; à m = 10, les deux nombres sont rapportés, hors clause. « P6 réfutée » si une clause
+    est atteinte dans l'une de ses cellules, « P6 non réfutée » sinon ; « incomplet » si une cellule de P6 manque ou est
+    en double, jamais un repli silencieux. Lu sur les cellules déjà calculées : aucun tirage."""
+    par_m = {}
+    doublons = []
+    atteintes = []
+    for c in cellules:
