+def _retirer_ajouts_v3(resultat):
+    r = json.loads(json.dumps(resultat))
+    del r["criteres_mecaniques"][CLE_NEUVE_V3_DES_CRITERES]
+    for c in r["alarme"]:
+        for cle in CLES_NEUVES_V3_PAR_CELLULE_D_ALARME:
+            del c[cle]
+        for bloc in c["par_bras"].values():
+            for cle in CLES_NEUVES_V3_PAR_BRAS:
+                del bloc[cle]
+    return r
