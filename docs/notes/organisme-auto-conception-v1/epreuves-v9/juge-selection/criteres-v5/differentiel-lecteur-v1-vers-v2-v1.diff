+def sans_les_termes(texte, termes):
+    """Retire du texte chaque terme donné, le plus long d'abord ; une barre tient sa place, pour
+    que deux morceaux voisins ne se recollent pas en un terme."""
+    for t in sorted(termes, key=lambda x: (-len(x), x)):
+        texte = texte.replace(t, " | ")
+    return texte
