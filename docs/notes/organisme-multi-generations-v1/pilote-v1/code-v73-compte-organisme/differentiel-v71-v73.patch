+               "--registre-lancements", os.path.join(self.registres, "lancements-ligne-15.jsonl"), "--sortie", os.path.join(self.d, "ligne-15")]
+        r = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", env=self.env, timeout=600)
+        self.assertEqual((r.returncode, "pire cas" in r.stderr), (2, True), r.stderr[-1500:])
+        self.assertFalse(os.path.exists(os.path.join(self.d, "ligne-15")))
+        self.assertFalse(os.path.exists(os.path.join(self.registres, "lancements-ligne-15.jsonl")))
+
+    def test_cout_excessif_arret_et_appel_porte(self):
+        A = ModeReelBoutEnBout.corps_astra
+        self.doublure.surcharge = {("astra", False): A(40000, 100, "46", "stop")}  # 40 000 jetons de sortie : coût > pire cas
+        try:
