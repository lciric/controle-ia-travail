+                       ("jetons cachés", self.u(total=500)), ("total trop court", self.u(total=487)), ("total booléen", self.u(total=True)), ("non objet", None),
+                       ("entrée absente", {"candidatesTokenCount": 3, "totalTokenCount": 3})):
