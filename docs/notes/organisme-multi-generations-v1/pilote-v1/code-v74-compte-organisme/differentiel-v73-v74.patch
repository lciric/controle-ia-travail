+        toutes les conclusions exigées d'Argon vraies sous la v74."""
+        conf, _ = PC.lire_configuration(CONF)
+        f = lambda appel, borne, etat, u, octets: {"proposeur": "argon", "appel": appel, "borne": borne, "statut_amont": 200,
+                                                   "etat": etat, "modele_servi_conforme": True, "usage_brut": u,
+                                                   "octets_visibles": octets, "au_dessus_du_pire_cas": False}
+        faits = [f("borne_gelee", 36000, "complet", self.u(c=419, p=69), 891), f("borne_courte", 256, "tronque", self.u(c=256, p=61), 755)]
+        c = S.conclusions(conf, "argon", faits)
+        self.assertEqual((c["reflexion_sans_effet"], c["verdict_egal_a_la_regle"], c["reflexion_observee"]), (True, False, False))
+        self.assertEqual([k for k in S.conclusions_exigees("gemini") if c[k] is not True], [])
+        self.assertFalse(S.reflexion_sans_effet("gemini", faits[:1]))  # un seul appel ne suffit pas
+        self.assertFalse(S.reflexion_sans_effet("astra", faits))
+
+    def test_regle_contredite_refusee(self):
+        """Artefact : Argon réfléchit (champ présent) et son total dit la réflexion comprise, contre la règle gelée (ajoutée) :
+        ni règle confirmée ni réflexion sans effet ; la conclusion exigée `regle_confirmee_ou_sans_effet` est fausse."""
+        conf, _ = PC.lire_configuration(CONF)
+        f = lambda appel, borne, etat, u: {"proposeur": "argon", "appel": appel, "borne": borne, "statut_amont": 200, "etat": etat,
+                                           "modele_servi_conforme": True, "usage_brut": u, "octets_visibles": 4, "au_dessus_du_pire_cas": False}
+        u = {"promptTokenCount": 10, "candidatesTokenCount": 50, "thoughtsTokenCount": 20, "totalTokenCount": 60}
+        c = S.conclusions(conf, "argon", [f("borne_gelee", 36000, "complet", u), f("borne_courte", 256, "tronque", dict(u))])
+        self.assertEqual((c["verdict_reflexion"], c["reflexion_sans_effet"], c["regle_confirmee_ou_sans_effet"]), ("comprise", False, False))
+        self.assertIn("regle_confirmee_ou_sans_effet", [k for k in S.conclusions_exigees("gemini") if c[k] is not True])
+
+    def test_exigences(self):
+        g = S.conclusions_exigees("gemini")
+        self.assertIn("regle_confirmee_ou_sans_effet", g)
+        self.assertNotIn("verdict_egal_a_la_regle", g)
+        self.assertNotIn("reflexion_observee", g)
+        self.assertEqual(S.conclusions_exigees("astra"), S71.conclusions_exigees("astra") + ("reflexion_observee",))
+        self.assertEqual(S.conclusions_exigees("claude"), S71.conclusions_exigees("claude"))
+
+    def test_champ_de_reflexion_present(self):
+        self.assertFalse(S.champ_de_reflexion_present("gemini", self.u()))
+        self.assertTrue(S.champ_de_reflexion_present("gemini", self.u(thoughts=0)))
+        self.assertTrue(S.champ_de_reflexion_present("astra", {"completion_tokens_details": {"reasoning_tokens": 0}}))
+        self.assertFalse(S.champ_de_reflexion_present("astra", {"completion_tokens": 3}))
+        self.assertFalse(S.champ_de_reflexion_present("claude", {"output_tokens": 3}))
+
+    def test_garde_du_pilote(self):
+        conf, _ = PC.lire_configuration(CONF)
+        d = tempfile.mkdtemp()
+        try:
+            def corps(u):
+                f = os.path.join(d, "corps-relais.json")
+                json.dump({"corps": {"usageMetadata": u}}, open(f, "w", encoding="utf-8"))
+            r = {"jetons": {"entree": 3, "sortie": 5, "reflexion": 0}, "cout_usd": 0.01}
+            corps(self.u())
+            L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])  # sain : aucun champ
+            corps(self.u(thoughts=0))
+            with self.assertRaisesRegex(PR.ArretPilote, "champ de réflexion apparu"):
+                L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])
+            L.garder_reflexion_absente(conf, "argon", d, r, [])  # proposeur non « sans réflexion » : rien
+            corps(self.u())
+            with self.assertRaisesRegex(PR.ArretPilote, "champ de réflexion apparu"):
+                L.garder_reflexion_absente(conf, "argon", d, dict(r, jetons={"reflexion": 3}), ["argon"])
+            open(os.path.join(d, "corps-relais.json"), "w").write("{illisible")
+            with self.assertRaisesRegex(PR.ArretPilote, "illisible"):
+                L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])
+        finally:
+            shutil.rmtree(d)
+
+    def test_garde_du_pilote_total_cache(self):
+        """Jalon 3 (constat 5) : Argon « sans réflexion » dont l'appel du pilote rend un total ≠ entrée + sortie, sans champ :
+        arrêt (jetons cachés possibles) ; total juste : rien."""
+        conf, _ = PC.lire_configuration(CONF)
+        d = tempfile.mkdtemp()
+        try:
+            f = os.path.join(d, "corps-relais.json")
+            r = {"jetons": {"entree": 69, "sortie": 419, "reflexion": 0}, "cout_usd": 0.02}
+            json.dump({"corps": {"usageMetadata": self.u(total=69 + 419 + 5)}}, open(f, "w", encoding="utf-8"))
+            with self.assertRaisesRegex(PR.ArretPilote, "jetons cachés"):
+                L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])
+            json.dump({"corps": {"usageMetadata": self.u()}}, open(f, "w", encoding="utf-8"))
+            L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])
+            json.dump({"corps": {"usageMetadata": self.u(total="absent")}}, open(f, "w", encoding="utf-8"))
+            L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])  # usage sans total (appel en échec) : aucun arrêt (R2)
+            os.remove(f)  # appel en échec, sans corps : la garde ne lève rien si aucune réflexion n'est comptée
+            L.garder_reflexion_absente(conf, "argon", d, r, ["argon"])
+        finally:
+            shutil.rmtree(d)
+
+    def test_lanceur_v74(self):
+        self.assertEqual((L.VERSION, L.LANCEUR), ("lanceur-pilote-mr2-v74", "demonstrations/pilote_mr2_v74.py"))
+        g = set(L.FICHIERS_GELES)
+        for f in ("demonstrations/pilote_mr2_v74.py", "pole/sonde_pilote_v74.py", "pole/sonde_pilote_v72.py", "pole/sonde_pilote_v71.py"):
+            self.assertIn(f, g)
+        self.assertNotIn("demonstrations/pilote_mr2_v73.py", g)
+        self.assertIs(L.S, S)
+        b = L.bloc_gele()
+        self.assertTrue(b.startswith("<!-- empreintes-du-code-pilote-v74 : début -->\n"))
+        self.assertNotIn("claude-", b)
+
+
 if __name__ == "__main__":
     unittest.main()
