+# Mondes publics de l'essai v68 : leurs lois de référence passent le gardien (C-16). Le monde 3 de l'étiquette de l'essai de la
+# mesure (« pilote-v2-essai-developpement ») est l'artefact naturel de C-16 : sa loi « monde sans latente » porte un coefficient
+# de valeur absolue 5,25 > 4 (constat du développeur, rapporté).
+ETIQUETTE_ESSAI = "pilote-v68-essai-developpement"
+
+
+def arbre(k, feuille=F0):
+    return feuille if k == 0 else {"type": "si_sinon", "condition": {"indice": k % 8, "seuil": 0.0}, "si": arbre(k - 1, feuille),
+                                   "sinon": feuille}
+
+
+def dossier_prive():
+    d = tempfile.mkdtemp(prefix="pilote-v70-prive-")
+    os.chmod(d, 0o700)
+    return d
+
+
+def mondes_dev():
+    if "mondes" not in ETAT:
+        mondes = []
+        for r in P.MONDES_PILOTE:
+            spec = V4.generer_monde_v4(V4.P1.cle(ETIQUETTE_ESSAI, r))
+            mondes.append({"monde": r, "spec": spec, "spec_sha256": P.sha_spec(spec)})
+        d = dossier_prive()
+        chemin = os.path.join(d, "MONDES.json")
+        sha = P.ecrire_prive(chemin, mondes, [d])
+        ETAT.update(mondes=mondes, chemin=chemin, sha=sha, dossier=d, pm=P.preparer(mondes))
+    return ETAT
+
+
+def tearDownModule():
+    if "dossier" in ETAT:
+        shutil.rmtree(ETAT["dossier"], ignore_errors=True)
