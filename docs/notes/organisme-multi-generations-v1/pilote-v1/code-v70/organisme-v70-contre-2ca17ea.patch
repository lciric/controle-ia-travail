+        raise Refus("configuration : version « configuration-pilote-mr2-v11 » exigée")
+    props = conf.get("proposeurs")
+    if not isinstance(props, dict) or tuple(sorted(props)) != tuple(sorted(PROPOSEURS)):
+        raise Refus(f"configuration : proposeurs exactement {PROPOSEURS}")
+    omax = conf.get("octets_entree_max")
+    if not (isinstance(omax, int) and omax > 0):
+        raise Refus("configuration : octets_entree_max entier > 0")
+    if not isinstance(conf.get("numpy_exige"), str):
+        raise Refus("configuration : numpy_exige (version de numpy du mode réel)")
+    ports = set()
+    for nom, p in props.items():
+        if set(p) != CHAMPS_PROPOSEUR:
+            raise Refus(f"configuration, {nom} : champs exacts {sorted(CHAMPS_PROPOSEUR)}")
+        if p["dialecte"] not in URL_AMONT:
+            raise Refus(f"configuration, {nom} : dialecte inconnu")
+        for k in ("plafond_session_usd", "prix_entree_usd_par_million", "prix_sortie_usd_par_million", "part_usd", "delai_s"):
+            if not (isinstance(p[k], (int, float)) and not isinstance(p[k], bool) and math.isfinite(p[k]) and p[k] > 0):
+                raise Refus(f"configuration, {nom} : {k} > 0")
+        b = p["borne_sortie_jetons"]
+        if not (isinstance(b, int) and not isinstance(b, bool) and b > 0):
+            raise Refus(f"configuration, {nom} : borne de sortie entière > 0")
+        bmax = borne_de_sortie_max(p["plafond_session_usd"], p["prix_entree_usd_par_million"], p["prix_sortie_usd_par_million"], omax)
+        if b > bmax:
+            raise Refus(f"configuration, {nom} : borne de sortie {b} > {bmax}, que le plafond de session paie au pire cas")
+        if abs(p["part_usd"] - 4 * p["plafond_session_usd"]) > 1e-9:
+            raise Refus(f"configuration, {nom} : part ≠ 4 × plafond de session (un appel par monde)")
+        if not (isinstance(p["port"], int) and 1024 <= p["port"] <= 65535) or p["port"] in ports:
+            raise Refus(f"configuration, {nom} : port distinct dans [1024 ; 65535]")
+        ports.add(p["port"])
+        if p["url_amont"] != URL_AMONT[p["dialecte"]].format(modele=p["modele"]) and not amont_boucle_locale(p["url_amont"]):
+            raise Refus(f"configuration, {nom} : adresse d'amont ≠ adresse figée du dialecte")
+        if not (isinstance(p["variable_cle"], str) and p["variable_cle"]) or not (p["variable_espace"] is None
+                                                                                   or isinstance(p["variable_espace"], str)):
+            raise Refus(f"configuration, {nom} : variable_cle (nom), variable_espace (nom ou null)")
+        if not isinstance(p["reglages"], dict):
+            raise Refus(f"configuration, {nom} : reglages, objet")
+        if not isinstance(p["reflexion_comprise"], bool):  # D-2 : règle de comptage gelée, vérifiée par la sonde
+            raise Refus(f"configuration, {nom} : reflexion_comprise, booléen (règle de comptage de la réflexion)")
+        if p["dialecte"] == "claude" and p["reflexion_comprise"] is not True:
+            raise Refus(f"configuration, {nom} : claude n'a aucun compte séparé de la réflexion (reflexion_comprise vrai)")
+    go = conf.get("go")
+    if not isinstance(go, dict) or set(go) != {"pi1", "pi2"}:
+        raise Refus("configuration : go {pi1, pi2}")
+    vus = []
+    for ligne, g in go.items():
+        parts = g.get("parts_usd")
+        if not isinstance(parts, dict) or not parts:
+            raise Refus(f"configuration, go {ligne} : parts_usd")
+        if round(sum(parts.values()) * 100) != round(g.get("montant_usd", -1) * 100):
+            raise Refus(f"configuration, go {ligne} : somme des parts ≠ montant")
+        if not (isinstance(g.get("perimetre_contient"), list) and g["perimetre_contient"]):
+            raise Refus(f"configuration, go {ligne} : perimetre_contient, liste non vide")
+        for k, v in parts.items():
+            if k in props and abs(v - props[k]["part_usd"]) > 1e-9:
+                raise Refus(f"configuration, go {ligne} : part de {k} ≠ part du proposeur")
+            vus.append(k)
+    if sorted(k for k in vus if k in props) != sorted(PROPOSEURS):
+        raise Refus("configuration : chaque proposeur dans une seule ligne de GO")
+    verifier_section_sonde(conf, props)
+    for cle in ("commande", "relais"):
+        piece = conf.get(cle) or {}
+        f = os.path.normpath(os.path.join(dossier, piece.get("chemin", "")))
+        if not f.startswith(dossier + os.sep) or os.path.isabs(piece.get("chemin", "/")) or not os.path.isfile(f):
+            raise Refus(f"configuration : {cle} sous le dossier de la configuration")
+        if sha256_fichier(f) != piece.get("sha256"):
+            raise Refus(f"configuration : {cle} ≠ son empreinte")
+        piece["chemin_absolu"] = f
+    return conf, dossier
+
+
+def verifier_section_sonde(conf, props):
+    """D-4 : la section `sonde` : consignes de `octets_consigne_max` octets au plus (100), borne courte entière ≤ chaque borne
+    gelée, deux lignes de GO à part (s1 crédits de Claude, s2 hors crédits) dont la somme des parts égale le montant au centime,
+    chaque proposeur dans une seule ligne, chaque part au moins le pire cas des appels de la sonde (borne gelée, puis borne
+    courte, consigne au plus longue permise)."""
+    s = conf.get("sonde")
+    if not isinstance(s, dict) or set(s) != {"octets_consigne_max", "borne_courte_jetons", "consignes", "go"}:
+        raise Refus("configuration : sonde {octets_consigne_max, borne_courte_jetons, consignes, go}")
+    omax, bc = s["octets_consigne_max"], s["borne_courte_jetons"]
+    if not (isinstance(omax, int) and not isinstance(omax, bool) and 0 < omax <= 100):
+        raise Refus("configuration, sonde : octets_consigne_max entier dans [1 ; 100]")
+    if not (isinstance(bc, int) and not isinstance(bc, bool) and 0 < bc <= min(p["borne_sortie_jetons"] for p in props.values())):
+        raise Refus("configuration, sonde : borne courte entière > 0 et sous chaque borne gelée")
+    c = s["consignes"]
+    if not isinstance(c, dict) or set(c) != {"borne_gelee", "borne_courte"}:
+        raise Refus("configuration, sonde : consignes {borne_gelee, borne_courte}")
+    for k, v in c.items():
+        if not (isinstance(v, str) and v.strip() and len(v.encode("utf-8")) <= omax):
+            raise Refus(f"configuration, sonde : consigne {k} de {omax} octets au plus")
+    go = s["go"]
+    if not isinstance(go, dict) or set(go) != set(GO_SONDE):
+        raise Refus("configuration, sonde : go {s1, s2}")
+    vus = []
+    for ligne, g in go.items():
+        parts = g.get("parts_usd") if isinstance(g, dict) else None
+        if not isinstance(parts, dict) or not parts or not set(parts) <= set(props):
+            raise Refus(f"configuration, sonde, go {ligne} : parts_usd, proposeurs seulement")
+        if round(sum(parts.values()) * 100) != round(g.get("montant_usd", -1) * 100):
+            raise Refus(f"configuration, sonde, go {ligne} : somme des parts ≠ montant")
+        if not (isinstance(g.get("perimetre_contient"), list) and g["perimetre_contient"]):
+            raise Refus(f"configuration, sonde, go {ligne} : perimetre_contient, liste non vide")
+        for nom, v in parts.items():
+            pire = pire_cas_d_un_appel(props[nom], omax) + pire_cas_d_un_appel(props[nom], omax, bc)
+            if not (isinstance(v, (int, float)) and v + 1e-9 >= pire):
+                raise Refus(f"configuration, sonde, go {ligne} : part de {nom} {v} < pire cas des appels de la sonde {pire:.6f}")
+            vus.append(nom)
+    if sorted(vus) != sorted(PROPOSEURS):
+        raise Refus("configuration, sonde : chaque proposeur dans une seule ligne de GO de la sonde")
+
+
+def parts_de_la_sonde(conf):
+    """{proposeur : part de la sonde} (le plafond de son relais pendant la sonde)."""
+    return {nom: v for g in conf["sonde"]["go"].values() for nom, v in g["parts_usd"].items()}
+
+
+def lire_go_de_lignes(conf_go, registre, identifiants, aujourd_hui=None):
+    """Les lignes nommées (`{ligne : identifiant}`), lues par le lecteur v66 au montant **exact** de la configuration ;
+    identifiants distincts ; le périmètre de chaque ligne contient les mots écrits à la configuration."""
+    from .registre_go_v66 import GoRefuse, verifier_go_v66
+    if len(set(identifiants.values())) != len(identifiants):
+        raise Refus(f"GO : identifiants distincts exigés (lignes {sorted(identifiants)})")
+    out = {}
+    for ligne, ident in sorted(identifiants.items()):
+        try:
+            out[ligne] = verifier_go_v66(ident, registre, conf_go[ligne]["montant_usd"], aujourd_hui=aujourd_hui)
+        except GoRefuse as e:
+            raise Refus(f"GO {ligne} : {e}") from None
+        manquants = [m for m in conf_go[ligne]["perimetre_contient"] if m not in out[ligne]["perimetre"]]
+        if manquants:
+            raise Refus(f"GO {ligne} : périmètre sans {manquants}")
+    return out
+
+
+def lire_go_du_pilote(conf, registre, go_pi1, go_pi2, aujourd_hui=None):
+    """C-9 : les deux lignes π1 (crédits de Claude) et π2 (hors crédits), lues par le lecteur v66 au montant **exact** de la
+    configuration ; deux identifiants distincts ; m-4 : le périmètre de chaque ligne contient les mots écrits à la configuration."""
+    return lire_go_de_lignes(conf["go"], registre, {"pi1": go_pi1, "pi2": go_pi2}, aujourd_hui)
+
+
+def lire_go_de_la_sonde(conf, registre, go_s1, go_s2, aujourd_hui=None):
+    """D-4 : les deux lignes de la sonde, à part de π1 et π2 (s1 crédits de Claude, s2 hors crédits), même lecture."""
+    return lire_go_de_lignes(conf["sonde"]["go"], registre, {"s1": go_s1, "s2": go_s2}, aujourd_hui)
+
+
+def commande_d_un_proposeur(conf, nom, sortie_brute, python, borne=None):
+    p = conf["proposeurs"][nom]
+    b = p["borne_sortie_jetons"] if borne is None else borne
+    return [python, "-I", "-B", conf["commande"]["chemin_absolu"], "--url-relais", f"http://127.0.0.1:{p['port']}",
+            "--modele", p["modele"], "--dialecte", p["dialecte"], "--prix-entree", repr(p["prix_entree_usd_par_million"]),
+            "--prix-sortie", repr(p["prix_sortie_usd_par_million"]), "--borne-sortie", str(b),
+            "--delai-s", repr(float(p["delai_s"]) - conf.get("delai_marge_s", 30)), "--sortie-brute", sortie_brute,
+            "--reflexion-comprise", "oui" if p["reflexion_comprise"] else "non"]
+
+
+def _derniere_ligne(stdout):
+    for ligne in reversed((stdout or "").strip().splitlines()):
+        try:
+            o = json.loads(ligne)
+        except ValueError:
+            return None
+        return o if isinstance(o, dict) else None
+    return None
+
+
+def ecrire_scelle_json(chemin, objet):
+    octets = (json.dumps(objet, ensure_ascii=False, sort_keys=True, indent=1) + "\n").encode("utf-8")
+    with open(chemin, "xb") as f:
+        f.write(octets)
+    sha = hashlib.sha256(octets).hexdigest()
+    with open(chemin + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha}  {os.path.basename(chemin)}\n")
+    return sha
+
+
+def _compagnon_egal(chemin):
+    try:
+        with open(chemin + ".sha256", encoding="utf-8") as f:
+            return f.read().split()[0] == sha256_fichier(chemin)
+    except (OSError, IndexError):
+        return False
+
+
+def conditions_du_temoin(temoin, sha_texte, reglages, apres):
+    """W3 et « session neuve » (D-5) : les conditions du témoin d'isolement, chacune nommée ; toutes doivent être vraies."""
+    return {"relais": temoin["relais"] == temoin["relais_attendu"],
+            "texte_recu": temoin["texte_recu_sha256"] == sha_texte,
+            "consigne_commande": temoin["consigne_commande_sha256"] == sha_texte,
+            "aucun_outil": temoin["outils"] == [], "un_message": temoin["messages"] == 1,
+            "aucun_systeme": temoin["systeme"] is None, "session_neuve": temoin["session_neuve"] is True,
+            "session_vide": apres == [], "reglages": temoin["reglages"] == reglages}
+
+
+def appeler(conf, nom, texte, dossier_appel, jeton, python, executer=subprocess.run, borne=None):
+    """Un appel, une session neuve (C-10) : dossier de l'appel créé vide (il ne doit pas exister) ; commande lancée dans un
+    dossier courant vide, environnement minimal sans clé (le jeton du relais seulement) ; réponse brute (sortie entière, code,
+    corps du relais écrit par la commande) **scellée avant toute extraction** ; témoin d'isolement écrit et scellé. M-4 : pour un
+    appel rendu (complet, tronqué), le corps du relais doit être sur disque, égal à son compagnon et à l'empreinte que la
+    commande rend ; sinon ArretPilote. D-2 : cause `cout_excessif` → ArretPilote (pièces versées, l'appel porté par
+    l'exception). `borne` : borne de sortie plus courte que la borne gelée (sonde seulement)."""
+    p = conf["proposeurs"][nom]
+    if borne is not None and not (isinstance(borne, int) and 0 < borne <= p["borne_sortie_jetons"]):
+        raise Refus(f"{nom} : borne de sortie {borne!r} hors de ]0 ; borne gelée]")
+    if os.path.exists(dossier_appel):
+        raise ArretPilote(f"{nom} : dossier de session existant (session neuve exigée)")
+    os.makedirs(dossier_appel)
+    session = os.path.join(dossier_appel, "session")
+    os.makedirs(session)
+    avant = sorted(os.listdir(session))
+    brut = os.path.join(dossier_appel, "corps-relais.json")
+    cmd = commande_d_un_proposeur(conf, nom, brut, python, borne)
+    env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "PLAFOND_SESSION_USD": repr(float(p["plafond_session_usd"])),
+           "ROLE_POLE": ROLE, "MODELE_DEMANDE_POLE": p["modele"], "RELAIS_JETON_POLE": jeton}
+    sha_texte = hashlib.sha256(texte.encode("utf-8")).hexdigest()
+    debut = time.time()
+    delai_adaptateur = False
+    try:
+        r = executer(cmd, input=texte, capture_output=True, text=True, encoding="utf-8", cwd=session, env=env,
+                     timeout=float(p["delai_s"]))
+        code, sortie, erreur = r.returncode, r.stdout, r.stderr
+    except subprocess.TimeoutExpired:  # m-7 : panne (échec, abandon), plus un arrêt du pilote ; d-2 : compté au plafond de session
+        code, erreur, delai_adaptateur = 6, "délai de l'adaptateur", True
+        sortie = json.dumps({"etat": "echec", "erreur": "délai de l'adaptateur (commande tuée)",
+                             "cout_usd": float(p["plafond_session_usd"]), "cout_origine": "plafond_de_session"})
+    duree = round(time.time() - debut, 3)
+    derniere = _derniere_ligne(sortie)
+    brut_sha = sha256_fichier(brut) if os.path.isfile(brut) else None
+    reponse = {"proposeur": nom, "code": code, "sortie_standard": sortie, "sortie_erreur": (erreur or "")[-4000:],
+               "derniere_ligne": derniere, "corps_relais": "corps-relais.json" if brut_sha else None,
+               "corps_relais_sha256": brut_sha, "duree_s": duree, "delai_adaptateur": delai_adaptateur}
+    sha_rep = ecrire_scelle_json(os.path.join(dossier_appel, "reponse-brute.json"), reponse)
+    if derniere is None:
+        raise ArretPilote(f"{nom} : réponse brute sans dernière ligne JSON (code {code})")
+    etat = derniere.get("etat") if code == 0 else "echec"
+    if etat not in ("complet", "tronque", "echec"):
+        raise ArretPilote(f"{nom} : état rendu inconnu {etat!r}")
+    if brut_sha is not None and derniere.get("brut_sha256") not in (None, brut_sha):
+        raise ArretPilote(f"{nom} : corps du relais ≠ empreinte rendue par la commande")
+    if etat in ("complet", "tronque"):
+        if brut_sha is None or derniere.get("brut_sha256") != brut_sha or not _compagnon_egal(brut):
+            raise ArretPilote(f"{nom} : appel rendu sans corps du relais scellé sur disque (M-4)")
+    tr = derniere.get("temoin_relais")
+    apres = sorted(os.listdir(session))
+    temoin = {"proposeur": nom, "relais_attendu": f"relais-pilote-v70-{nom}", "relais": (tr or {}).get("relais"),
+              "session_neuve": avant == [], "fichiers_ecrits_dans_la_session": apres,
+              "texte_servi_sha256": sha_texte, "texte_recu_sha256": (tr or {}).get("consigne_recue_sha256"),
+              "consigne_commande_sha256": derniere.get("consigne_sha256"),
+              "outils": (tr or {}).get("outils"), "messages": (tr or {}).get("messages"), "systeme": (tr or {}).get("systeme"),
+              "appelant": (tr or {}).get("appelant"), "reglages": (tr or {}).get("reglages"),
+              "environnement_commande": sorted(env), "reponse_brute_sha256": sha_rep}
+    if tr is not None:
+        conditions = conditions_du_temoin(temoin, sha_texte, p["reglages"], apres)
+        temoin["conditions"] = conditions
+        temoin["conforme"] = all(conditions.values())
+    else:
+        temoin["conforme"] = None  # aucun corps rendu (échec avant le relais) : rien à attester sur l'amont
+    sha_tem = ecrire_scelle_json(os.path.join(dossier_appel, "temoin-isolement.json"), temoin)
+    if temoin["conforme"] is False:
+        manque = sorted(k for k, v in temoin["conditions"].items() if not v)
+        raise ArretPilote(f"{nom} : témoin d'isolement non conforme ({manque})")
+    if etat in ("complet", "tronque") and temoin["conforme"] is not True:
+        raise ArretPilote(f"{nom} : réponse rendue sans témoin d'isolement")
+    cause = derniere.get("cause")
+    abandon = code in CODES_PANNE or cause in CAUSES_ABANDON
+    r = {"proposeur": nom, "etat": etat, "code": code, "cause": cause, "cout_usd": float(derniere.get("cout_usd") or 0.0),
+         "jetons": derniere.get("jetons"), "raison_arret": derniere.get("raison_arret"),
+         "modele_servi": derniere.get("modele_servi"), "erreur": derniere.get("erreur"), "duree_s": duree,
+         "reponse_brute_sha256": sha_rep, "temoin_sha256": sha_tem, "corps_relais_sha256": brut_sha,
+         "texte_servi_sha256": sha_texte, "panne": code in CODES_PANNE, "abandon": abandon,
+         "texte": derniere.get("texte") if etat != "echec" else None}
+    if cause in CAUSES_ARRET:  # D-2 : coût au-dessus du pire cas → arrêt du pilote (le plafond n'est plus dur)
+        raise ArretPilote(f"{nom} : coût lu {r['cout_usd']} USD au-dessus du pire cas de l'appel (cause {cause}) : arrêt du pilote",
+                          appel=dict(r, texte=None))
+    return r
+
+
+# --- relais : lancés par le lanceur, sondés, arrêtés par leur PID ----------------------------------------------------------------
+
+def nouveau_jeton():
+    return secrets.token_hex(16)
+
+
+def env_du_relais(p, jeton, environ, factice):
+    """Environnement du seul relais, bâti par filtrage (noms de `ENV_FILTRE`) ; mode réel : la variable de clé (et d'espace)
+    recopiée **par son nom** depuis l'environnement du lanceur, jamais écrite ni imprimée ; à blanc : aucune clé."""
+    env = {k: environ[k] for k in ENV_FILTRE if k in environ}
+    env.setdefault("PATH", "/usr/bin:/bin")
+    env.setdefault("LANG", "C.UTF-8")
+    env["RELAIS_JETON"] = jeton
+    if not factice:
+        for nom_var in (p["variable_cle"], p["variable_espace"]):
+            if nom_var and nom_var in environ:
+                env[nom_var] = environ[nom_var]
+    return env
+
+
+def lancer_relais(conf, nom, journal, appelant, jeton, python, environ=None, plafond=None, max_appels=4):
+    """Lance le relais d'un proposeur ; rend (processus, ligne de démarrage). `plafond` (la part du proposeur par défaut) et
+    `max_appels` (4 par défaut) : ceux de la sonde quand c'est elle qui lance."""
+    p = conf["proposeurs"][nom]
+    factice = appelant.startswith("factice:")
+    plafond = p["part_usd"] if plafond is None else plafond
+    cmd = [python, "-I", "-B", conf["relais"]["chemin_absolu"], "--port", str(p["port"]), "--nom", nom, "--dialecte", p["dialecte"],
+           "--modele", p["modele"], "--plafond-usd", repr(float(plafond)), "--max-appels", str(max_appels),
+           "--prix-entree", repr(p["prix_entree_usd_par_million"]), "--prix-sortie", repr(p["prix_sortie_usd_par_million"]),
+           "--borne-sortie", str(p["borne_sortie_jetons"]), "--appelant", appelant, "--journal", journal,
+           "--url-amont", p["url_amont"], "--variable-cle", p["variable_cle"], "--reglages", json.dumps(p["reglages"]),
+           "--delai-amont-s", repr(float(p["delai_s"]) - 60), "--reflexion-comprise", "oui" if p["reflexion_comprise"] else "non"]
+    if p["variable_espace"]:
+        cmd += ["--variable-espace", p["variable_espace"]]
+    env = env_du_relais(p, jeton, os.environ if environ is None else environ, factice)
+    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8", env=env)
+    ligne = proc.stdout.readline()
+    try:
+        info = json.loads(ligne)
+    except ValueError:
+        err = proc.stderr.read()[:300] if proc.poll() is not None else ""
+        arreter_relais(proc)
+        raise Refus(f"relais {nom} : n'a pas démarré ({err})") from None
+    return proc, info
+
+
+def etat_relais(conf, nom):
+    import urllib.request
+    p = conf["proposeurs"][nom]
+    ouvreur = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    with ouvreur.open(f"http://127.0.0.1:{p['port']}/relais/etat", timeout=10) as r:
+        return json.loads(r.read())
+
+
+def noms_permis_au_relais(p):
+    """W1 : les seuls noms de variables qui peuvent arriver au relais d'un proposeur."""
+    return set(ENV_FILTRE) | set(NOMS_AJOUTES) | {n for n in (p["variable_cle"], p["variable_espace"]) if n}
+
+
+def controler_etat_relais(conf, nom, e, mode, plafond=None, max_appels=4):
+    """B-2 : l'état d'un relais avant tout appel, champ par champ ; rend la liste des écarts (vide si conforme). `plafond`
+    (la part du proposeur par défaut) et `max_appels` : ceux de la sonde quand c'est elle qui contrôle."""
+    p = conf["proposeurs"][nom]
+    plafond = p["part_usd"] if plafond is None else plafond
+    ecarts = []
+
+    def egal(cle, attendu):
+        if e.get(cle) != attendu:
+            ecarts.append(cle)
+    egal("relais", f"relais-pilote-v70-{nom}")
+    egal("fichier_sha256", conf["relais"]["sha256"])
+    egal("modele", p["modele"])
+    egal("dialecte", p["dialecte"])
+    egal("prix_entree", p["prix_entree_usd_par_million"])
+    egal("prix_sortie", p["prix_sortie_usd_par_million"])
+    egal("borne_sortie", p["borne_sortie_jetons"])
+    egal("max_appels", max_appels)
+    egal("url_amont", p["url_amont"])
+    egal("reglages", p["reglages"])
+    egal("appels", 0)
+    egal("regle_usd", 0.0)
+    egal("reflexion_comprise", p["reflexion_comprise"])
+    egal("verrouille", False)
+    noms = e.get("environnement_noms")
+    if not isinstance(noms, list) or set(noms) - noms_permis_au_relais(p):  # W1 : aucun autre nom n'est arrivé au relais
+        ecarts.append("environnement_noms")
+    if not isinstance(e.get("plafond_usd"), (int, float)) or abs(float(e["plafond_usd"]) - plafond) > 1e-9:
+        ecarts.append("plafond_usd")
+    if e.get("branche") is not True:
+        ecarts.append("branche")
+    if mode == "reel":
+        egal("appelant", p["dialecte"])
+        if e.get("cle_presente") is not True:
+            ecarts.append("cle_presente")
+    elif not str(e.get("appelant", "")).startswith("factice:"):
+        ecarts.append("appelant")
+    return ecarts
+
+
+def exiger_relais_prets(conf, mode, plafonds=None, max_appels=4):
+    """Avant tout appel : chaque relais répond et son état est conforme (`controler_etat_relais`) ; Refus sinon."""
+    out = {}
+    for nom in PROPOSEURS:
+        try:
+            e = etat_relais(conf, nom)
+        except OSError as x:
+            raise Refus(f"relais {nom} injoignable : {x}") from None
+        ecarts = controler_etat_relais(conf, nom, e, mode, (plafonds or {}).get(nom), max_appels)
+        if ecarts:
+            raise Refus(f"relais {nom} : état non conforme ({ecarts})")
+        out[nom] = {k: e[k] for k in ("relais", "appelant", "pid", "plafond_usd", "modele", "fichier_sha256", "url_amont",
+                                      "reglages", "cle_presente", "reflexion_comprise", "environnement_noms", "max_appels")}
+    return out
+
+
+def arreter_relais(proc):
+    """R10 : arrêt par le PID du processus lancé ici, jamais par motif."""
+    if proc.poll() is None:
+        os.kill(proc.pid, 15)
+        try:
+            proc.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            os.kill(proc.pid, 9)
+            proc.wait(timeout=10)
+    for f in (proc.stdout, proc.stderr):
+        if f:
+            f.close()
+    return proc.returncode
+
+
+def empreinte_configuration(conf):
+    c = json.loads(json.dumps(conf))
+    for cle in ("commande", "relais"):
+        c[cle].pop("chemin_absolu", None)
+    return hashlib.sha256(json_canonique(c)).hexdigest()
diff --git a/orchestrator/pole/sonde_pilote_v70.py b/orchestrator/pole/sonde_pilote_v70.py
new file mode 100644
index 0000000..2059fad
--- /dev/null
+++ b/orchestrator/pole/sonde_pilote_v70.py
@@ -0,0 +1,287 @@
+"""Sonde payante du pilote MR-2 — code v70 (fichier neuf ; D-4 de la contre-lecture du différentiel v68 → v69, `935e44bc…` ;
+décisions de la mère R-2548). Aucun réseau ici : la sous-commande `sonde` du lanceur lance les relais (clés par leur nom) et
+appelle par la chaîne du pilote (adaptateur → commande → relais → amont) ; ce module relit les pièces de chaque appel, en tire
+les faits et les conclusions, bâtit le relevé, et dit si un relevé permet le mode réel (`exiger_releve`).
+
+La sonde **n'est jamais jouée par le développeur** : elle dépense, sous deux lignes de GO à part de π1 et π2 (configuration,
+section `sonde` : s1 4,39 USD sur crédits de Claude, s2 3,68 USD hors crédits ; nœud de Lazar). Elle ne lit aucun monde ni aucun
+résultat (hors R1) ; elle se fait **avant** le scellement du texte, dont le bloc gelé cite l'empreinte de son relevé. Par relais :
+un appel à la borne gelée (consigne courte, réponse d'un mot) ; avec `--borne-courte`, un second appel à 256 jetons (texte long
+demandé).
+
+Faits relevés par appel : statut de l'amont, état et cause rendus par la commande, identifiant servi (règle M-1 de la commande),
+raison d'arrêt, champs d'usage bruts, sortie comptée par la règle de la configuration, coût calculé aux prix de la configuration
+(à rapprocher de la console par Lazar : hors du code), et pour Claude le flux brut relu ici indépendamment et comparé au message
+que le relais a reconstitué (`lire_flux_anthropic`).
+
+Conclusions par proposeur, toutes exigées vraies par le mode réel : `statut`, `modele_servi_conforme`, `borne_gelee_admise`,
+`raison_arret_normale`, `usage_entier`, `verdict_egal_a_la_regle` (le verdict de la sonde sur la réflexion égale la règle de
+comptage de la configuration), `borne_courte_tronquee` et `borne_tenue` (la sortie comptée reste sous la borne courte : le plafond
+est dur) ; Claude en plus : `flux_relu_egal`, `effort_admis`. Le mode réel recalcule les conclusions depuis les faits du relevé.
+"""
+
+import importlib.util
+import json
+import os
+
+from .outils import sha256_fichier
+from .pilote_mr2_v70 import PROPOSEURS, Refus
+
+VERSION = "sonde-pilote-v70"
+VERSION_RELEVE = "releve-sonde-pilote-v70"
+RELEVE = "releve-sonde-pilote-v70.json"
+APPELS = ("borne_gelee", "borne_courte")
+SEUIL_VISIBLE = 32  # jetons visibles d'une réponse d'un mot, au plus
+IDENTITE = ("modele", "dialecte", "url_amont", "reglages", "borne_sortie_jetons", "variable_cle", "variable_espace")
+CONCLUSIONS_EXIGEES = ("statut", "modele_servi_conforme", "borne_gelee_admise", "raison_arret_normale", "usage_entier",
+                       "verdict_egal_a_la_regle", "borne_courte_tronquee", "borne_tenue")
+CONCLUSIONS_CLAUDE = ("flux_relu_egal", "effort_admis")
+REGLE_DU_VERDICT = {"comprise": True, "sans_champ": True, "non_comprise": False}
+
+
+def _entier(x):
+    return isinstance(x, int) and not isinstance(x, bool) and x >= 0
+
+
+def _commande(conf):
+    """Le module de la commande gelée (sa règle M-1 sur l'identifiant servi), chargé depuis son chemin ; non inscrit dans
+    `sys.modules`."""
+    s = importlib.util.spec_from_file_location("commande_pilote_sonde", conf["commande"]["chemin_absolu"])
+    m = importlib.util.module_from_spec(s)
+    s.loader.exec_module(m)
+    return m
+
+
+def usage_brut(dialecte, corps):
+    """Les champs d'usage bruts du fournisseur (entiers ou None), sans aucune règle de comptage."""
+    corps = corps if isinstance(corps, dict) else {}
+    if dialecte == "claude":
+        u = corps.get("usage") or {}
+        return {k: u.get(k) for k in ("input_tokens", "output_tokens")}
+    if dialecte == "gemini":
+        u = corps.get("usageMetadata") or {}
+        return {k: u.get(k) for k in ("promptTokenCount", "candidatesTokenCount", "thoughtsTokenCount", "totalTokenCount")}
+    u = corps.get("usage") or {}
+    return {"prompt_tokens": u.get("prompt_tokens"), "completion_tokens": u.get("completion_tokens"),
+            "reasoning_tokens": (u.get("completion_tokens_details") or {}).get("reasoning_tokens"),
+            "total_tokens": u.get("total_tokens")}
+
+
+def verdict_reflexion(dialecte, u):
+    """D-2 : le champ de sortie du fournisseur compte-t-il déjà la réflexion ? « comprise », « non_comprise », « indetermine » ;
+    Claude : « sans_champ » (aucun compte séparé : `output_tokens` compte tout). Argon : `totalTokenCount` tranche s'il est
+    présent (prompt + candidats + pensées : non comprise ; prompt + candidats : comprise) ; sinon, comme Astra, sur une réponse
+    d'un mot : sortie ≥ réflexion et sortie − réflexion ≤ 32 → comprise ; sortie ≤ 32 et réflexion > sortie → non comprise."""
+    if dialecte == "claude":
+        return "sans_champ"
+    if dialecte == "gemini":
+        p, c, t, total = (u.get(k) for k in ("promptTokenCount", "candidatesTokenCount", "thoughtsTokenCount", "totalTokenCount"))
+    else:
+        p, c, t, total = u.get("prompt_tokens"), u.get("completion_tokens"), u.get("reasoning_tokens"), None
+    if not (_entier(c) and _entier(t)) or t == 0:
+        return "indetermine"
+    if dialecte == "gemini" and _entier(total) and _entier(p):
+        if total == p + c + t:
+            return "non_comprise"
+        if total == p + c:
+            return "comprise"
+        return "indetermine"
+    if c >= t and c - t <= SEUIL_VISIBLE:
+        return "comprise"
+    if c <= SEUIL_VISIBLE and t > c:
+        return "non_comprise"
+    return "indetermine"
+
+
+def usage_entier(dialecte, u):
+    """Les champs d'usage d'entrée et de sortie du dialecte, présents et entiers."""
+    cles = {"claude": ("input_tokens", "output_tokens"), "gemini": ("promptTokenCount", "candidatesTokenCount"),
+            "astra": ("prompt_tokens", "completion_tokens")}[dialecte]
+    return all(_entier(u.get(k)) for k in cles)
+
+
+def sortie_comptee(dialecte, u, comprise):
+    """La sortie comptée par la règle de la configuration (celle de la commande et du relais), ou None."""
+    if dialecte == "claude":
+        s = u.get("output_tokens")
+        return s if _entier(s) else None
+    c, t = (u.get("candidatesTokenCount"), u.get("thoughtsTokenCount") or 0) if dialecte == "gemini" else \
+        (u.get("completion_tokens"), u.get("reasoning_tokens") or 0)
+    if not (_entier(c) and _entier(t)):
+        return None
+    return c if comprise else c + t
+
+
+def relire_flux(flux):
+    """Le flux SSE brut de l'interface Messages, relu ici sans `lire_flux_anthropic` : identifiant, raison d'arrêt (dernière non
+    nulle), texte des blocs `text`, usage (celui de `message_start` mis à jour par chaque `message_delta`), événements vus."""
+    modele, raison, usage, textes, evenements, usage_delta = None, None, {}, {}, [], False
+    for ligne in (flux or "").splitlines():
+        if not ligne.startswith("data:"):
+            continue
+        d = json.loads(ligne[5:].strip())
+        t = d.get("type")
+        evenements.append(t)
+        if t == "message_start":
+            modele = (d.get("message") or {}).get("model")
+            usage.update((d.get("message") or {}).get("usage") or {})
+        elif t == "content_block_delta" and (d.get("delta") or {}).get("type") == "text_delta":
+            textes[d["index"]] = textes.get(d["index"], "") + d["delta"]["text"]
+        elif t == "message_delta":
+            if (d.get("delta") or {}).get("stop_reason") is not None:
+                raison = d["delta"]["stop_reason"]
+            if d.get("usage"):
+                usage.update(d["usage"])
+                usage_delta = True
+    return {"modele": modele, "raison_arret": raison, "texte": "".join(textes[i] for i in sorted(textes)),
+            "usage": {k: usage.get(k) for k in ("input_tokens", "output_tokens")}, "evenements": sorted(set(evenements)),
+            "usage_dans_message_delta": usage_delta}
+
+
+def comparer_flux(flux, corps):
+    """Le flux relu ici contre le message que le relais a reconstitué : identifiant, raison d'arrêt, texte, usage."""
+    try:
+        r = relire_flux(flux)
+    except (ValueError, KeyError, TypeError, AttributeError) as e:
+        return {"egal": False, "erreur": type(e).__name__}
+    corps = corps if isinstance(corps, dict) else {}
+    texte = "".join(b.get("text", "") for b in corps.get("content") or [] if isinstance(b, dict) and b.get("type") == "text")
+    u = corps.get("usage") or {}
+    ecarts = [k for k, a, b in (("modele", r["modele"], corps.get("model")), ("raison_arret", r["raison_arret"], corps.get("stop_reason")),
+                                ("texte", r["texte"], texte),
+                                ("usage", r["usage"], {k: u.get(k) for k in ("input_tokens", "output_tokens")})) if a != b]
+    return {"egal": not ecarts and r["usage_dans_message_delta"], "ecarts": ecarts, "evenements": r["evenements"],
+            "usage_dans_message_delta": r["usage_dans_message_delta"]}
+
+
+def faits_d_un_appel(conf, nom, quoi, borne, dossier, r):
+    """Les faits d'un appel de la sonde, depuis l'enregistrement rendu par `appeler` et le corps du relais scellé sur disque."""
+    p = conf["proposeurs"][nom]
+    rel = {}
+    f = os.path.join(dossier, "corps-relais.json")
+    if os.path.isfile(f):
+        try:
+            with open(f, encoding="utf-8") as h:
+                rel = json.load(h)
+        except ValueError:
+            rel = {}
+    corps = rel.get("corps") if isinstance(rel, dict) else None
+    u = usage_brut(p["dialecte"], corps)
+    sortie = sortie_comptee(p["dialecte"], u, p["reflexion_comprise"])
+    faits = {"proposeur": nom, "appel": quoi, "borne": borne, "etat": r.get("etat"), "code": r.get("code"), "cause": r.get("cause"),
+             "raison_arret": r.get("raison_arret"), "modele_servi": r.get("modele_servi"),
+             "modele_servi_conforme": bool(_commande(conf).modele_conforme(p["modele"], r.get("modele_servi"))),
+             "statut_amont": rel.get("statut_amont") if isinstance(rel, dict) else None,
+             "type_erreur": rel.get("type_erreur") if isinstance(rel, dict) else None,
+             "usage_brut": u, "usage_entier": usage_entier(p["dialecte"], u),
+             "verdict_reflexion": verdict_reflexion(p["dialecte"], u), "sortie_comptee": sortie, "cout_usd": r.get("cout_usd"),
+             "au_dessus_du_pire_cas": rel.get("au_dessus_du_pire_cas") if isinstance(rel, dict) else None,
+             "pieces": {k: r.get(k) for k in ("reponse_brute_sha256", "temoin_sha256", "corps_relais_sha256")}}
+    if p["dialecte"] == "claude":
+        faits["flux"] = comparer_flux(rel.get("flux") if isinstance(rel, dict) else None, corps)
+    return faits
+
+
+def verdict_d_ensemble(verdicts):
+    """Un verdict par appel → un verdict : le seul verdict tranché s'il n'y en a qu'un, « contradictoire » s'ils divergent."""
+    tranches = {v for v in verdicts if v in REGLE_DU_VERDICT}
+    if len(tranches) == 1:
+        return tranches.pop()
+    return "contradictoire" if tranches else "indetermine"
+
+
+def conclusions(conf, nom, faits):
+    """Les conclusions d'un proposeur, depuis ses faits (un ou deux appels) ; verdict, usage et sortie comptée **recalculés**
+    depuis les champs d'usage bruts (jamais repris des valeurs dérivées écrites au relevé)."""
+    p = conf["proposeurs"][nom]
+    d = p["dialecte"]
+    f1 = next((f for f in faits if f["appel"] == "borne_gelee"), None)
+    f2 = next((f for f in faits if f["appel"] == "borne_courte"), None)
+    tous = [f for f in (f1, f2) if f is not None]
+    verdict = verdict_d_ensemble([verdict_reflexion(d, f["usage_brut"]) for f in tous])
+    sortie2 = sortie_comptee(d, f2["usage_brut"], p["reflexion_comprise"]) if f2 is not None else None
+    c = {"statut": bool(tous) and all(f["statut_amont"] == 200 and f["etat"] in ("complet", "tronque") for f in tous),
+         "modele_servi_conforme": bool(tous) and all(f["modele_servi_conforme"] for f in tous),
+         "borne_gelee_admise": f1 is not None and f1["statut_amont"] == 200 and f1["borne"] == p["borne_sortie_jetons"],
+         "raison_arret_normale": f1 is not None and f1["etat"] == "complet",
+         "usage_entier": bool(tous) and all(usage_entier(d, f["usage_brut"]) for f in tous),
+         "verdict_reflexion": verdict, "regle_configuree": p["reflexion_comprise"],
+         "verdict_egal_a_la_regle": REGLE_DU_VERDICT.get(verdict) is p["reflexion_comprise"],
+         "borne_courte_tronquee": f2 is not None and f2["etat"] == "tronque",
+         "borne_tenue": f2 is not None and _entier(sortie2) and sortie2 <= f2["borne"],
+         "en_tete_d_espace": p["variable_espace"] is not None,
+         "au_dessus_du_pire_cas": any(f.get("au_dessus_du_pire_cas") for f in tous)}
+    if d == "claude":
+        c["flux_relu_egal"] = bool(tous) and all((f.get("flux") or {}).get("egal") is True for f in tous)
+        c["effort_admis"] = f1 is not None and f1["statut_amont"] == 200 and "output_config" in p["reglages"]
+    return c
+
+
+def conclusions_exigees(dialecte):
+    return CONCLUSIONS_EXIGEES + (CONCLUSIONS_CLAUDE if dialecte == "claude" else ())
+
+
+def releve(conf, faits, borne_courte, debut, fin, partiel, arret, extra):
+    """Le relevé de la sonde (scellé par le lanceur) : identité de chaque proposeur, faits par appel, conclusions."""
+    out = {"version": VERSION_RELEVE, "module": VERSION, "debut_utc": debut, "fin_utc": fin, "partiel": partiel, "arret": arret,
+           "borne_courte": borne_courte,
+           "identite": {n: {k: conf["proposeurs"][n][k] for k in IDENTITE} for n in PROPOSEURS},
+           "pieces_sha256": {"commande": conf["commande"]["sha256"], "relais": conf["relais"]["sha256"]},
+           "appels": faits,
+           "conclusions": {n: conclusions(conf, n, [f for f in faits if f["proposeur"] == n]) for n in PROPOSEURS}}
+    out.update(extra)
+    return out
+
+
+def _compagnon_egal(chemin):
+    try:
+        with open(chemin + ".sha256", encoding="utf-8") as f:
+            return f.read().split()[0] == sha256_fichier(chemin)
+    except (OSError, IndexError):
+        return False
+
+
+def exiger_releve(conf, chemin):
+    """D-4 : le mode réel (et le bloc gelé qui le cite) exige un relevé de la sonde : présent, égal à son compagnon, complet, fait
+    avec l'appel à borne courte, par la commande et le relais de cette configuration, pour l'identité de chaque proposeur de la
+    configuration ; conclusions recalculées depuis ses faits égales aux siennes et toutes vraies, verdict sur la réflexion égal à
+    la règle de comptage gelée. Rend l'empreinte du relevé ; Refus sinon."""
+    if not chemin or not os.path.isfile(chemin):
+        raise Refus("relevé de la sonde absent : le mode réel l'exige (D-4)")
+    if not _compagnon_egal(chemin):
+        raise Refus("relevé de la sonde ≠ son compagnon")
+    try:
+        with open(chemin, encoding="utf-8") as f:
+            r = json.load(f)
+    except ValueError:
+        raise Refus("relevé de la sonde illisible") from None
+    if not isinstance(r, dict) or r.get("version") != VERSION_RELEVE:
+        raise Refus(f"relevé de la sonde : version « {VERSION_RELEVE} » exigée")
+    if r.get("partiel") is not False or r.get("borne_courte") is not True:
+        raise Refus("relevé de la sonde partiel ou sans l'appel à borne courte (le plafond n'y est pas éprouvé)")
+    if r.get("pieces_sha256") != {"commande": conf["commande"]["sha256"], "relais": conf["relais"]["sha256"]}:
+        raise Refus("relevé de la sonde fait par une autre commande ou un autre relais")
+    faits = r.get("appels")
+    if not isinstance(faits, list):
+        raise Refus("relevé de la sonde : appels absents")
+    for nom in PROPOSEURS:
+        p = conf["proposeurs"][nom]
+        if (r.get("identite") or {}).get(nom) != {k: p[k] for k in IDENTITE}:
+            raise Refus(f"relevé de la sonde : identité de {nom} ≠ configuration")
+        a_lui = [f for f in faits if isinstance(f, dict) and f.get("proposeur") == nom]
+        if sorted(f.get("appel") for f in a_lui) != sorted(APPELS):
+            raise Refus(f"relevé de la sonde : {nom} sans ses deux appels")
+        try:
+            recalculees = conclusions(conf, nom, a_lui)
+        except (KeyError, TypeError, AttributeError):
+            raise Refus(f"relevé de la sonde : faits de {nom} illisibles") from None
+        if (r.get("conclusions") or {}).get(nom) != recalculees:
+            raise Refus(f"relevé de la sonde : conclusions de {nom} ≠ celles de ses faits")
+        manque = [k for k in conclusions_exigees(p["dialecte"]) if recalculees.get(k) is not True]
+        if manque:
+            raise Refus(f"relevé de la sonde : {nom} ne confirme pas {manque} (verdict sur la réflexion : "
+                        f"{recalculees['verdict_reflexion']}, règle gelée : {p['reflexion_comprise']})")
+    return sha256_fichier(chemin)
+
+
+__all__ = [n for n in dir() if not n.startswith("_")]
