+    # --- banc v68 porté (43 ; M26 remplacée : « à confirmer » n'existe plus, numpy exigé à sa place) ---
+    M("M01-quatre-conditions-admises", PC, "if c > CONDITIONS_MAX:", "if c > CONDITIONS_MAX + 1:", "C5Gardien",
+      "test_artefact_quatre_conditions_refusee"),
