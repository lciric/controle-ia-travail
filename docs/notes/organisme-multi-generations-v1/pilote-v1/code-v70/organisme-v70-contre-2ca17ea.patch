+                   f"est fini (ni NaN ni Infinity). Au plus {CONDITIONS_MAX} conditions emboîtées : le long de tout chemin de "
+                   f"la racine à une feuille, au plus {CONDITIONS_MAX} nœuds si_sinon (sur un trait ou sur une "
+                   "sous-population) ; un niveau par_sous_population, melange ou transformee ne compte pas. Le gardien évalue "
+                   "chaque loi sur un jeu d'instances fixe : une loi qu'il ne sait pas évaluer, ou dont une probabilité n'est "
+                   "pas finie, est refusée."),
+        "types": {
+            "fixe": {"champs": {"type": "\"fixe\"", "probas": "3 nombres ≥ 0 de somme > 0 (normalisés)"},
+                     "exemple": {"type": "fixe", "probas": [0.5, 0.25, 0.25]}},
+            "softmax": {"champs": {"type": "\"softmax\"",
+                                   "poids": f"3 lignes (une par issue) de {D_PILOTE} nombres (coefficients de z0 à z{D_PILOTE - 1})",
+                                   "biais": "3 nombres (un par issue)"},
+                        "formule": "p(k) ∝ exp(biais[k] + Σ_j poids[k][j]·z_j)", "exemple": soft},
+            "par_sous_population": {"champs": {"type": "\"par_sous_population\"",
+                                               "lois": "objet {\"0\": loi, \"1\": loi, \"2\": loi} (clé : la sous-population g, "
+                                                       "en texte)",
+                                               "defaut": "facultatif : loi des sous-populations absentes de « lois » (exigé si "
+                                                         "une clé manque)"},
+                                    "exemple": {"type": "par_sous_population",
+                                                "lois": {"0": {"type": "fixe", "probas": [0.5, 0.25, 0.25]}, "1": soft},
+                                                "defaut": {"type": "fixe", "probas": [1.0, 1.0, 1.0]}}},
+            "melange": {"champs": {"type": "\"melange\"", "composantes": "liste non vide de lois",
+                                   "poids": "un poids ≥ 0 par composante, de somme 1"},
+                        "exemple": {"type": "melange", "composantes": [{"type": "fixe", "probas": [1.0, 1.0, 1.0]}, soft],
+                                    "poids": [0.25, 0.75]}},
+            "si_sinon": {"champs": {"type": "\"si_sinon\"",
+                                    "condition": "{\"sous_population\": entier 0, 1 ou 2} (vraie si g vaut cette valeur), ou "
+                                                 f"{{\"indice\": entier de 0 à {D_PILOTE - 1}, \"seuil\": nombre fini facultatif, "
+                                                 "0 par défaut} (vraie si z[indice] > seuil)",
+                                    "si": "loi si la condition est vraie", "sinon": "loi sinon"},
+                         "exemple": {"type": "si_sinon", "condition": {"indice": 1, "seuil": 0.5},
+                                     "si": {"type": "fixe", "probas": [0.25, 0.5, 0.25]},
+                                     "sinon": {"type": "fixe", "probas": [0.25, 0.25, 0.5]}}},
+            "transformee": {"champs": {"type": "\"transformee\"", "base": "loi",
+                                       "melange_aveugle": "facultatif : {\"lambda\": nombre dans [0 ; 1], \"probas\": 3 nombres "
+                                                          "≥ 0} (p ← (1 − lambda)·p + lambda·probas normalisées)",
+                                       "puissance": "facultatif : nombre > 0 (p ← p^puissance, renormalisé)",
+                                       "inclinaison": "facultatif : 3 nombres (p(k) ← p(k)·exp(inclinaison[k]), renormalisé)",
+                                       "oscillation": f"facultatif : {{\"amplitude\", \"frequence\", \"trait\": entier de 0 à "
+                                                      f"{D_PILOTE - 1}, \"issue\": entier 0, 1 ou 2, \"phase\" facultative}} "
+                                                      "(p(issue) ← p(issue)·exp(amplitude·cos(frequence·z[trait] + phase)))"},
+                            "ordre": "mélange aveugle, puis puissance, puis inclinaison, puis oscillation",
+                            "exemple": {"type": "transformee", "base": soft, "puissance": 0.5, "inclinaison": [0.0, 0.25, -0.25]}},
+        }}
+
+
+CONSIGNE_PROPOSEUR = ("Propose au plus {n} lois qui prédisent l'issue mieux que la marginale et mieux que les lois déjà "
+                      "retenues. Réponds par un seul bloc ```json … ``` (le premier bloc ```json de ta réponse est le seul lu) : une liste d'objets {{\"enonce\": texte (≤ 400 caractères), "
+                      "\"loi_predictive\": loi}}, et rien d'autre. Une loi suit exactement la grammaire servie dans le contexte "
+                      "(« gabarit » → « grammaire » : types, champs exacts, un exemple valide par type, bornes, au plus {c} "
+                      "conditions emboîtées) ; toute autre clé, tout autre type ou toute borne dépassée est refusé au gardien. "
+                      "Au-delà de la {n}e, une loi est refusée. Rien d'autre n'est à proposer.").format(n=CARTES_MAX, c=CONDITIONS_MAX)
+
+
+def gabarit():
+    """Le gabarit servi, indépendant du monde : consigne et partie « gabarit » du contexte (C-6)."""
+    return {"consigne": CONSIGNE_PROPOSEUR,
+            "gabarit": {"types": list(TYPES_PERMIS), "borne_des_poids": BORNE_GABARIT, "cartes_max": CARTES_MAX,
+                        "conditions_emboitees_max": CONDITIONS_MAX, "grammaire": grammaire_servie()}}
+
+
+def gabarit_sha256():
+    """[GABARIT-SHA256] : empreinte du JSON canonique du gabarit servi (marqueur du texte, recopiée au bloc gelé)."""
+    return hashlib.sha256(json_canonique(gabarit())).hexdigest()
+
+
+def contexte_servi(archive, episodes):
+    g = gabarit()
+    return {"monde": {"traits": D_PILOTE, "sous_populations": NSP_PILOTE, "issues": K_PILOTE,
+                      "enonce_public": "monde synthétique à loi inconnue"},
+            "gabarit": g["gabarit"], "lois_retenues": archive, "episodes_developpement": episodes}
+
+
+def texte_servi(archive, episodes):
+    """Le texte entier servi à un proposeur : consigne, puis le contexte en bloc JSON (même forme que la v64)."""
+    return CONSIGNE_PROPOSEUR + "\n\n```json\n" + json.dumps(contexte_servi(archive, episodes), ensure_ascii=False) + "\n```\n"
+
+
+def pieces_du_texte(texte, archive, episodes):
+    """Vrai si `texte` est exactement le texte bâti sur les seules pièces gelées (gabarit, archive {K1}, épisodes)."""
+    return texte == texte_servi(archive, episodes)
+
+
+# --- C-5 : gardien à la dimension du monde ----------------------------------------------------------------------------------
+
+def _entier(x, permis):
+    return type(x) is int and x in permis
+
+
+def _nombres(x, n=None):
+    return isinstance(x, list) and (n is None or len(x) == n) and all(nombre_fini(v) for v in x)
+
+
+def conditions_emboitees_gardien(loi):
+    """S-a, étendu à `defaut` : nombre maximal de nœuds `si_sinon` sur un chemin de la racine à une feuille."""
+    if not isinstance(loi, dict):
+        return 0
+    t = loi.get("type")
+    if t == "si_sinon":
+        return 1 + max(conditions_emboitees_gardien(loi.get("si")), conditions_emboitees_gardien(loi.get("sinon")))
+    sous = []
+    if t == "par_sous_population":
+        sous = list((loi.get("lois") or {}).values()) + ([loi["defaut"]] if "defaut" in loi else [])
+    elif t in ("melange",):
+        sous = list(loi.get("composantes") or [])
+    elif t == "enveloppe":
+        sous = list(loi.get("lois") or [])
+    elif t == "transformee":
+        sous = [loi.get("base")]
+    elif t == "echelle":
+        sous = [loi.get("loi")]
+    return max([conditions_emboitees_gardien(s) for s in sous] + [0])
+
+
+def _verifier_noeud(loi, profondeur, D, nsp):
+    if profondeur > PROFONDEUR_MAX:
+        return f"loi trop imbriquée (plus de {PROFONDEUR_MAX} niveaux)"
+    if not isinstance(loi, dict) or loi.get("type") not in TYPES_PERMIS:
+        return f"type de loi hors de la grammaire servie : {loi.get('type') if isinstance(loi, dict) else type(loi).__name__}"
+    t = loi["type"]
+    requis, facultatifs = CHAMPS_PAR_TYPE[t]
+    if not requis <= set(loi) or set(loi) - requis - facultatifs:
+        return f"{t} : champs exacts {sorted(requis)} (+ facultatifs {sorted(facultatifs)}), reçus {sorted(loi)}"
+    sous = []
+    if t == "fixe":
+        if not _nombres(loi["probas"], K_PILOTE):
+            return "fixe : 3 probabilités"
+    elif t == "softmax":
+        P, b = loi["poids"], loi["biais"]
+        if not (isinstance(P, list) and len(P) == K_PILOTE and all(_nombres(l, D) for l in P) and _nombres(b, K_PILOTE)):
+            return f"softmax : {K_PILOTE} lignes de {D} poids et {K_PILOTE} biais finis"
+        if any(abs(v) > BORNE_GABARIT for v in [w for l in P for w in l] + list(b)):
+            return f"softmax : poids et biais dans [−{BORNE_GABARIT:g} ; {BORNE_GABARIT:g}] (gabarit des proposeurs)"
+    elif t == "par_sous_population":
+        if not isinstance(loi["lois"], dict):
+            return "par_sous_population : « lois » est un objet"
+        cles, permises = set(loi["lois"]), {str(g) for g in range(nsp)}
+        if not cles <= permises:
+            return f"par_sous_population : clés de « lois » parmi {sorted(permises)}"
+        if cles != permises and "defaut" not in loi:
+            return "par_sous_population : toutes les sous-populations, ou une loi « defaut »"
+        sous = list(loi["lois"].values()) + ([loi["defaut"]] if "defaut" in loi else [])
+    elif t == "melange":
+        if not isinstance(loi["composantes"], list) or not loi["composantes"]:
+            return "melange : composantes, liste non vide"
+        sous = list(loi["composantes"])
+    elif t == "si_sinon":
+        c = loi["condition"]
+        if not isinstance(c, dict):
+            return "si_sinon : condition = objet {sous_population} ou {indice, seuil facultatif}"
+        if set(c) == {"sous_population"}:
+            if not _entier(c["sous_population"], tuple(range(nsp))):
+                return f"si_sinon : condition.sous_population entier de 0 à {nsp - 1} exigé"
+        elif set(c) in ({"indice"}, {"indice", "seuil"}):
+            if not _entier(c["indice"], tuple(range(D))):
+                return f"si_sinon : condition.indice entier de 0 à {D - 1} exigé"
+            if not nombre_fini(c.get("seuil", 0.0)):
+                return "si_sinon : condition.seuil fini exigé"
+        else:
+            return "si_sinon : condition {sous_population} ou {indice, seuil facultatif}"
+        sous = [loi["si"], loi["sinon"]]
+    elif t == "transformee":
+        g = loi.get("puissance")
+        if g is not None and not (nombre_fini(g) and 0 < g <= BORNE_SURETE):
+            return f"transformee : puissance dans ]0 ; {BORNE_SURETE:g}]"
+        b = loi.get("inclinaison")
+        if b is not None and (not _nombres(b, K_PILOTE) or any(abs(x) > BORNE_SURETE for x in b)):
+            return f"transformee : inclinaison, 3 nombres de valeur absolue ≤ {BORNE_SURETE:g}"
+        m = loi.get("melange_aveugle")
+        if m is not None and (not isinstance(m, dict) or set(m) != {"lambda", "probas"}):
+            return "transformee : melange_aveugle = {lambda, probas} exactement"
+        o = loi.get("oscillation")
+        if o is not None:
+            if not isinstance(o, dict) or not {"amplitude", "frequence", "trait", "issue"} <= set(o) \
+                    or set(o) - {"amplitude", "frequence", "trait", "issue", "phase"} \
+                    or not all(nombre_fini(o[k]) for k in ("amplitude", "frequence")) or abs(o["amplitude"]) > BORNE_SURETE \
+                    or not nombre_fini(o.get("phase", 0.0)):
+                return f"transformee : oscillation = {{amplitude (|·| ≤ {BORNE_SURETE:g}), frequence, trait, issue, phase facultative}}"
+            if not _entier(o["trait"], tuple(range(D))) or not _entier(o["issue"], tuple(range(K_PILOTE))):
+                return f"transformee : oscillation.trait entier de 0 à {D - 1}, oscillation.issue entier 0, 1 ou 2"
+        sous = [loi["base"]]
+    for s in sous:
+        motif = _verifier_noeud(s, profondeur + 1, D, nsp)
+        if motif:
+            return motif
+    return None
+
+
+def _jeu_factice(D, nsp):
+    """Jeu factice fixe du gardien à la dimension du monde : pour chaque sous-population, 7 vecteurs constants, les 2·D vecteurs
+    d'axe (+8 et −6) et 7 vecteurs mêlés écrits par formule (traits jusqu'à ±8)."""
+    lignes = [[v] * D for v in (-8.0, -2.5, -1.0, -0.25, 0.0, 0.5, 3.0)]
+    for i in range(D):
+        for v in (8.0, -6.0):
+            z = [0.0] * D
+            z[i] = v
+            lignes.append(z)
+    for k in range(7):
+        lignes.append([round(((j * 37 + k * 11) % 17 - 8) / 2.0, 2) for j in range(D)])
+    return tuple({"z": list(z), "g": g} for g in range(nsp) for z in lignes)
+
+
+JEU_FACTICE = _jeu_factice(D_PILOTE, NSP_PILOTE)
+
+
+def _noeuds(loi):
+    out, pile = [], [loi]
+    while pile:
+        x = pile.pop()
+        out.append(x)
+        t = x.get("type")
+        if t == "par_sous_population":
+            pile += list(x["lois"].values()) + ([x["defaut"]] if "defaut" in x else [])
+        elif t == "melange":
+            pile += list(x["composantes"])
+        elif t == "si_sinon":
+            pile += [x["si"], x["sinon"]]
+        elif t == "transformee":
+            pile.append(x["base"])
+    return out
+
+
+def evaluer_sur_jeu_factice(loi, jeu=JEU_FACTICE):
+    """Chaque nœud par `selection_pari.proba` (l'évaluateur de la chaîne) : 3 probabilités finies, ≥ 0, de somme 1 à 10⁻⁹ ;
+    la loi entière par `M.probas` (l'évaluateur de la mesure), égale à 10⁻⁹ près ; le motif ou None ; jamais une exception."""
+    _, M, _ = charger_mr2()
+    try:
+        for i, noeud in enumerate(_noeuds(loi)):
+            for x in jeu:
+                p = sp.proba(noeud, x, [], 0)
+                if len(p) != K_PILOTE or not all(nombre_fini(v) and v >= 0.0 for v in p) or abs(sum(p) - 1.0) > 1e-9:
+                    return f"jeu factice du gardien : probabilités hors du simplexe (nœud {i})"
+        Z = np.array([x["z"] for x in jeu], float)
+        G = np.array([x["g"] for x in jeu])
+        Q = M.probas(loi, Z, G)
+        P = np.array([sp.proba(loi, x, [], 0) for x in jeu])
+        if Q.shape != P.shape or not np.all(np.isfinite(Q)) or float(np.max(np.abs(Q - P))) > TOLERANCE_EVALUATEUR:
+            return "jeu factice du gardien : l'évaluateur de la mesure s'écarte de celui de la chaîne"
+    except Exception as e:  # noqa: BLE001 — une loi non évaluable est refusée au gardien, motif dit ; jamais un arrêt
+        return f"jeu factice du gardien : loi non évaluable : {type(e).__name__} : {str(e)[:160]}"
+    return None
+
+
+def garder_loi(loi, D=D_PILOTE, nsp=NSP_PILOTE):
+    """Gardien mécanique du pilote (C-5) : `valider_loi` à la dimension du monde, grammaire servie (types, champs, indices
+    entiers, bornes ±4 et de sûreté), **au plus 3 conditions emboîtées** (R-2504), évaluation sur le jeu factice ; rend None
+    (admise) ou le motif ; jamais une exception."""
+    try:
+        sp.valider_loi(loi, K_PILOTE, D)
+    except Exception as e:  # noqa: BLE001
+        return f"loi invalide : {type(e).__name__} : {str(e)[:160]}"
+    try:
+        motif = _verifier_noeud(loi, 0, D, nsp)
+        if motif:
+            return f"grammaire servie : {motif}"
+        _, _, MP = charger_mr2()
+        c = max(conditions_emboitees_gardien(loi), MP.conditions_emboitees(loi))
+        if c > CONDITIONS_MAX:
+            return f"plus de {CONDITIONS_MAX} conditions emboîtées ({c})"
+        json_canonique(loi)
+    except Exception as e:  # noqa: BLE001
+        return f"loi non vérifiable : {type(e).__name__} : {str(e)[:160]}"
+    return evaluer_sur_jeu_factice(loi)
+
+
+def garder_proposition(proposition):
+    """Gabarit de la proposition (clés exactes, énoncé), puis le gardien sur sa loi ; rend (loi ou None, motif ou None)."""
+    if not isinstance(proposition, dict):
+        return None, "proposition non dictionnaire"
+    en_trop = sorted(set(proposition) - set(CLES_PROPOSITION))
+    manquantes = [k for k in CLES_PROPOSITION if k not in proposition]
+    if en_trop or manquantes:
+        return None, f"gabarit du proposeur : clés en trop {en_trop}, manquantes {manquantes}"
+    e = proposition["enonce"]
+    if not isinstance(e, str) or not e.strip() or len(e) > LONGUEUR_ENONCE:
+        return None, f"énoncé : texte non vide de {LONGUEUR_ENONCE} caractères au plus"
+    motif = garder_loi(proposition["loi_predictive"])
+    return (proposition["loi_predictive"], None) if motif is None else (None, motif)
+
+
+def extraire_propositions(texte):
+    """Liste de propositions du premier bloc ```json … ``` (ou du texte entier) ; (liste, motif) ; liste vide si illisible."""
+    m = re.search(r"```json\s*(.*?)\s*```", texte or "", re.S)
+    brut = m.group(1) if m else (texte or "")
+    try:
+        obj = json.loads(brut)
+    except (ValueError, RecursionError):
+        return [], "réponse illisible (JSON)"
+    if isinstance(obj, dict) and isinstance(obj.get("propositions"), list):
+        obj = obj["propositions"]
+    if not isinstance(obj, list):
+        return [], "réponse sans liste de propositions"
+    return obj, None
+
+
+def cartes_d_un_appel(monde, proposeur, texte):
+    """Cartes au format du programme de la mesure : chaque proposition numérotée à partir de 1 ; au-delà de la sixième,
+    refusée (comptée) ; sinon gardien ; une loi refusée garde sa loi brute si c'est un objet JSON, sinon null."""
+    props, motif = extraire_propositions(texte)
+    cartes, motifs = [], []
+    for i, p in enumerate(props, start=1):
+        loi_brute = p.get("loi_predictive") if isinstance(p, dict) else None
+        if i > CARTES_MAX:
+            cartes.append({"monde": monde, "proposeur": proposeur, "emplacement": i, "etat": "refusee",
+                           "loi": loi_brute if isinstance(loi_brute, (dict, list)) else None})
+            motifs.append({"emplacement": i, "motif": f"au-delà de la {CARTES_MAX}e"})
+            continue
+        loi, m = garder_proposition(p)
+        if loi is None:
+            cartes.append({"monde": monde, "proposeur": proposeur, "emplacement": i, "etat": "refusee",
+                           "loi": loi_brute if isinstance(loi_brute, (dict, list)) else None})
+            motifs.append({"emplacement": i, "motif": m})
+        else:
+            cartes.append({"monde": monde, "proposeur": proposeur, "emplacement": i, "etat": "admise", "loi": loi})
+    return cartes, {"lecture": motif, "refus": motifs, "propositions": len(props)}
+
+
+# --- C-16 et C-17 ---------------------------------------------------------------------------------------------------------
+
+PUISSANCE_MAX = 50.0
+MARGE_RECRITURE = 1.0 + 1e-9
+
+
+def _max_abs_softmax(loi):
+    return max(abs(v) for v in [w for l in loi["poids"] for w in l] + list(loi["biais"]))
+
+
+def recrire_dans_les_bornes(loi):
+    """Q-2 (d) : chaque feuille softmax dont un coefficient dépasse ±4 devient `transformee{base: softmax/g, puissance: g}`,
+    g = max|coefficient| / 4 × (1 + 10⁻⁹) (la même loi : softmax(s/g)^g renormalisée = softmax(s)) ; rend (loi, récrite) ou
+    lève Refus si g > 50 (borne de sûreté de la grammaire servie)."""
+    if not isinstance(loi, dict):
+        return loi, False
+    t = loi.get("type")
+    if t == "softmax":
+        m = _max_abs_softmax(loi)
+        if m <= BORNE_GABARIT:
+            return loi, False
+        g = m / BORNE_GABARIT * MARGE_RECRITURE
+        if g > PUISSANCE_MAX:
+            raise Refus(f"C-16 : coefficient {m:g} : puissance {g:g} > {PUISSANCE_MAX:g}, aucune écriture dans la grammaire servie")
+        base = {"type": "softmax", "poids": [[w / g for w in l] for l in loi["poids"]], "biais": [b / g for b in loi["biais"]]}
+        return {"type": "transformee", "base": base, "puissance": g}, True
+    out, recrite = dict(loi), False
+    for k in ("si", "sinon", "base", "loi", "defaut"):
+        if isinstance(loi.get(k), dict):
+            out[k], r = recrire_dans_les_bornes(loi[k])
+            recrite |= r
+    if isinstance(loi.get("lois"), dict):
+        out["lois"] = {}
+        for k, v in loi["lois"].items():
+            out["lois"][k], r = recrire_dans_les_bornes(v)
+            recrite |= r
+    if isinstance(loi.get("composantes"), list):
+        out["composantes"] = []
+        for v in loi["composantes"]:
+            c, r = recrire_dans_les_bornes(v)
+            out["composantes"].append(c)
+            recrite |= r
+    return out, recrite
+
+
+def jouer_c16(pm_, tolerance=TOLERANCE_EVALUATEUR):
+    """C-16 : pour chaque monde, les lois de référence (`lois_de_reference` du programme v4 : K1 restreinte à son effet, « K1 +
+    première conditionnelle » non calibrée, monde sans sa composante latente) passent le gardien du pilote, telles quelles ou
+    **récrites** en `transformee` équivalente (Q-2 (d) : probabilités égales à 10⁻⁹ sur le jeu factice et 2 000 instances de
+    l'oracle) ; et la K1 **servie** passe le gardien telle quelle (m-10). Refus sinon. Rend (public, privé) : le public ne dit
+    que l'admission et l'empreinte de la loi jugée (M-3, d-1) ; le privé ajoute la réécriture, les conditions emboîtées et le
+    motif."""
+    _, M, MP = charger_mr2()
+    public, prive = {}, {}
+    for w in sorted(pm_):
+        o = pm_[w]["o"]
+        Z = np.vstack([np.array([x["z"] for x in JEU_FACTICE], float), o.Z[:2000]])
+        G = np.concatenate([np.array([x["g"] for x in JEU_FACTICE]), o.G[:2000]])
+        lois = dict(MP.lois_de_reference(pm_[w]))
+        lois["k1_servie"] = pm_[w]["k1"]
+        for nom, loi in lois.items():
+            motif, recrite, ecrite = garder_loi(loi), False, loi
+            if motif is not None and nom != "k1_servie":
+                ecrite, recrite = recrire_dans_les_bornes(loi)
+                if recrite:
+                    ecart = float(np.max(np.abs(M.probas(loi, Z, G) - M.probas(ecrite, Z, G))))
+                    motif = garder_loi(ecrite)
+                    if motif is None and not ecart <= tolerance:
+                        motif = f"réécriture non équivalente (écart {ecart:.3g})"
+            cle = f"{w}:{nom}"
+            public[cle] = {"admise": motif is None, "loi_sha256": hashlib.sha256(json_canonique(ecrite)).hexdigest()}
+            prive[cle] = dict(public[cle], recrite=recrite, motif=motif, conditions=conditions_emboitees_gardien(ecrite),
+                              loi_d_origine_sha256=hashlib.sha256(json_canonique(loi)).hexdigest())
+    refusees = sorted(k for k, v in prive.items() if not v["admise"])
+    if refusees:
+        raise Refus(f"C-16 : lois refusées au gardien, aucune écriture dans la grammaire servie : {refusees} "
+                    f"({prive[refusees[0]]['motif']})")
+    return public, prive
+
+
+def verifier_texte_servi(texte, archive, episodes):
+    """M-6 : relecture indépendante du texte servi : la consigne d'abord, puis un seul bloc ```json dont le contexte a
+    exactement les clés {monde, gabarit, lois_retenues, episodes_developpement}, le monde public, le gabarit servi, l'archive
+    {K1} et les épisodes donnés ; rend la liste des écarts (vide si conforme)."""
+    ecarts = []
+    tete = CONSIGNE_PROPOSEUR + "\n\n```json\n"
+    if not texte.startswith(tete) or not texte.endswith("\n```\n") or texte.count("```") != CONSIGNE_PROPOSEUR.count("```") + 2:
+        return ["forme : consigne, puis un seul bloc ```json"]
+    try:
+        ctx = json.loads(texte[len(tete):-len("\n```\n")])
+    except ValueError:
+        return ["contexte : JSON illisible"]
+    if set(ctx) != {"monde", "gabarit", "lois_retenues", "episodes_developpement"}:
+        ecarts.append("contexte : clés")
+    if ctx.get("monde") != {"traits": D_PILOTE, "sous_populations": NSP_PILOTE, "issues": K_PILOTE,
+                            "enonce_public": "monde synthétique à loi inconnue"}:
+        ecarts.append("monde public")
+    if ctx.get("gabarit") != json.loads(json.dumps(gabarit()["gabarit"])):
+        ecarts.append("gabarit")
+    if ctx.get("lois_retenues") != json.loads(json.dumps(archive)):
+        ecarts.append("archive")
+    if ctx.get("episodes_developpement") != json.loads(json.dumps(episodes)):
+        ecarts.append("épisodes")
+    return ecarts
+
+
+def controle_episodes(episodes):
+    """M-6 : contrôle mécanique des épisodes servis, sans rien dire du monde : 400 épisodes, 8 traits finis et non constants,
+    les trois issues et les trois sous-populations vues ; rend {contrôle : booléen}."""
+    Z = np.array([e["z"] for e in episodes], float) if episodes else np.zeros((0, D_PILOTE))
+    return {"nombre_400": len(episodes) == EPISODES_DEVELOPPEMENT,
+            "huit_traits": Z.ndim == 2 and Z.shape[1:] == (D_PILOTE,),
+            "traits_finis": bool(Z.size) and bool(np.all(np.isfinite(Z))),
+            "traits_non_constants": Z.ndim == 2 and Z.shape[0] > 1 and bool(np.all(Z.std(axis=0) > 0)),
+            "issues_vues": {e["y"] for e in episodes} == set(range(K_PILOTE)),
+            "sous_populations_vues": {e["g"] for e in episodes} == set(range(NSP_PILOTE))}
+
+
+def cartes_c17(pm_):
+    """Jeu fixe de cartes de la grammaire servie pour C-17 : les lois de référence de chaque monde, et des cartes écrites ici
+    (chaque type, `defaut`, trois conditions emboîtées sur trait et sur sous-population, transformée complète)."""
+    _, _, MP = charger_mr2()
+    z = [0.0] * D_PILOTE
+    s1 = {"type": "softmax", "poids": [[0.5, -1.0, 0, 0, 0.25, 0, 0, 0], z[:], [-0.5, 1.0, 0, 0, 0, 0, -0.75, 0]],
+          "biais": [0.1, 0.0, -0.1]}
+    s2 = {"type": "softmax", "poids": [[0, 0, 1.5, 0, 0, -2.0, 0, 0], [0, 0, 0, 0.5, 0, 0, 0, 1.0], z[:]], "biais": [0.0, 0.3, 0.0]}
+    trois = {"type": "si_sinon", "condition": {"indice": 3, "seuil": 0.2},
+             "si": {"type": "si_sinon", "condition": {"sous_population": 2},
+                    "si": {"type": "si_sinon", "condition": {"indice": 7}, "si": s1, "sinon": s2}, "sinon": s2},
+             "sinon": s1}
+    fixes = {
+        "fixe": {"type": "fixe", "probas": [0.2, 0.0, 0.8]},
+        "par_sp_defaut": {"type": "par_sous_population", "lois": {"1": s1}, "defaut": s2},
+        "trois_conditions": trois,
+        "par_sp_trois": {"type": "par_sous_population", "lois": {"0": trois, "1": s1, "2": s2}},
+        "melange": {"type": "melange", "composantes": [s1, trois, {"type": "fixe", "probas": [1, 1, 1]}], "poids": [0.5, 0.3, 0.2]},
+        "transformee": {"type": "transformee", "base": trois, "melange_aveugle": {"lambda": 0.1, "probas": [1, 2, 3]},
+                        "puissance": 0.7, "inclinaison": [0.0, 0.2, -0.3],
+                        "oscillation": {"amplitude": 0.4, "frequence": 1.3, "trait": 5, "issue": 1, "phase": 0.2}},
+    }
+    out = dict(fixes)
+    for w in sorted(pm_):
+        for nom, loi in MP.lois_de_reference(pm_[w]).items():
+            out[f"{w}:{nom}"] = loi
+    return out
+
+
+def jouer_c17(pm_, episodes_par_monde, tolerance=TOLERANCE_EVALUATEUR):
+    """C-17 : égalité des probabilités entre `selection_pari.proba` (évaluateur de la chaîne) et `M.probas` (évaluateur de la
+    mesure) sur le jeu fixe de cartes, sur le jeu factice et sur les épisodes de développement de chaque monde ; écart ≤ 10⁻⁹,
+    sinon Refus. Rend {carte : écart maximal}."""
+    _, M, _ = charger_mr2()
+    instances = list(JEU_FACTICE)
+    for w in sorted(episodes_par_monde):
+        instances += [{"z": e["z"], "g": e["g"]} for e in episodes_par_monde[w][:256]]
+    Z = np.array([x["z"] for x in instances], float)
+    G = np.array([x["g"] for x in instances])
+    ecarts = {}
+    for nom, loi in sorted(cartes_c17(pm_).items()):
+        Q = M.probas(loi, Z, G)
+        P = np.array([sp.proba(loi, x, [], 0) for x in instances])
+        e = float(np.max(np.abs(Q - P))) if Q.shape == P.shape and np.all(np.isfinite(Q)) else math.inf
+        ecarts[nom] = e
+    mauvais = sorted(k for k, v in ecarts.items() if not v <= tolerance)
+    if mauvais:
+        raise Refus(f"C-17 : écart d'évaluation > {tolerance:g} : {mauvais}")
+    return {"instances": len(instances), "cartes": len(ecarts), "ecart_max": max(ecarts.values()), "par_carte": ecarts}
+
+
+# --- C-15 : générateur MR-2 à graine du secret du pilote ; écriture privée ----------------------------------------------------
+
+def lire_secret(chemin):
+    exiger_hors_depot(chemin, "secret du pilote")
+    with open(chemin, "rb") as f:
+        s = f.read()
+    if len(s) != 32:
+        raise Refus("secret : 32 octets")
+    return s
+
+
+def tirer_secret(chemin, tirer=None):
+    """Secret machine de 32 octets (`secrets.token_bytes`), écrit hors de tout dépôt, mode 0600, jamais écrasé ; rend son
+    empreinte (à inscrire et pousser avant la phrase de Lazar). `tirer` : doublure des essais seulement."""
+    import secrets
+    exiger_hors_depot(chemin, "secret du pilote")
+    s = (tirer or secrets.token_bytes)(32)
+    if not isinstance(s, bytes) or len(s) != 32:
+        raise Refus("secret : 32 octets")
+    fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "wb") as f:
+        f.write(s)
+    return hashlib.sha256(s).hexdigest()
+
+
+def ecrire_prive(chemin, objet, liste_blanche):
+    """Écrit `objet` (JSON) à `chemin`, dans un dossier de la liste blanche, hors de tout dépôt, mode 0600, sans écraser ;
+    rend l'empreinte du fichier. Le contenu n'est jamais imprimé."""
+    exiger_hors_depot(chemin, "écriture privée")
+    d = os.path.realpath(os.path.dirname(chemin))
+    if not any(d == os.path.realpath(b) for b in liste_blanche):
+        raise Refus("écriture privée : dossier hors de la liste blanche")
+    octets = json.dumps(objet, ensure_ascii=False, sort_keys=True).encode("utf-8")
+    fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "wb") as f:
+        f.write(octets)
+    if stat.S_IMODE(os.stat(chemin).st_mode) != 0o600:
+        raise Refus("écriture privée : mode ≠ 0600")
+    return hashlib.sha256(octets).hexdigest()
+
+
+def generer_mondes(secret, phrase, empreinte_texte_hex, generer=None):
+    """C-15 : les 4 mondes du pilote ; graine `graine_monde_pilote` (programme v4) ; les 8 tirages de `generer_v4` (porté) ;
+    un monde sans tirage conforme en 8 → Refus (arrêt avant tout appel). Rend (mondes, contrôles sans contenu)."""
+    V4, _, MP = charger_mr2()
+    generer = generer or (lambda g: sans_chemin_v52b(V4.generer_v4, g))
+    mondes, controles = [], []
+    for r in MONDES_PILOTE:
+        try:
+            graine = MP.graine_monde_pilote(secret, phrase, empreinte_texte_hex, r)
+        except (MP.Refus, ValueError) as e:
+            raise Refus(f"graine du monde {r} : {e}") from None
+        spec, rap, refus = generer(graine)
+        if spec is None:
+            raise Refus(f"monde {r} : aucun tirage conforme en 8 (refus {refus}) : arrêt avant tout appel")
+        exiger_dimensions(spec)
+        sha = sha_spec(spec)
+        mondes.append({"monde": r, "spec": spec, "spec_sha256": sha})
+        controles.append({"monde": r, "spec_sha256": sha, "tirages_refuses": list(refus), "conforme": bool(rap and rap["conforme"])})
+    return mondes, controles
+
+
+def ecrire_engagement(chemin_mondes, sha_fichier, mondes, texte_sha256, liste_blanche):
+    """m-3 : à côté du fichier des mondes (privé), l'engagement qui lie ce fichier et ses mondes à l'empreinte du texte scellé
+    dont la graine dérive ; relu par le lanceur en mode réel."""
+    return ecrire_prive(chemin_mondes + ".engagement.json",
+                        {"version": VERSION, "texte_sha256": texte_sha256, "fichier_mondes_sha256": sha_fichier,
+                         "mondes_sha256": [w["spec_sha256"] for w in sorted(mondes, key=lambda w: w["monde"])]}, liste_blanche)
+
+
+def lire_engagement(chemin_mondes, sha_fichier, texte_sha256):
+    """m-3 : l'engagement relu ; Refus s'il manque ou s'il porte un autre texte ou un autre fichier des mondes."""
+    c = chemin_mondes + ".engagement.json"
+    exiger_hors_depot(c, "engagement des mondes")
+    try:
+        with open(c, encoding="utf-8") as f:
+            e = json.load(f)
+    except (OSError, ValueError):
+        raise Refus("engagement des mondes absent ou illisible") from None
+    if e.get("texte_sha256") != texte_sha256 or e.get("fichier_mondes_sha256") != sha_fichier:
+        raise Refus("engagement des mondes : texte ou fichier des mondes différent")
+    return e
+
