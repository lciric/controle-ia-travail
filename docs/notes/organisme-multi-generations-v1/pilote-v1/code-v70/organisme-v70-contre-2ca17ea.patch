+#!/usr/bin/env python3
+"""Relais local d'un proposeur du pilote MR-2 (code v70, C-7, C-9, C-10) — fichier neuf (R12 ; remplace `relais_pilote_v69.py`,
+gardé). Bibliothèque standard seule.
+
+Changements depuis la v69 (contre-lecture du différentiel v68 → v69, `935e44bc…` ; décisions de la mère R-2548) :
+- **D-2** : la règle de comptage de la réflexion est celle de la configuration gelée (`--reflexion-comprise oui|non`, la même
+  que la commande ; vérifiée par la sonde) ; un appel dont le coût lu dépasse le pire cas que le relais a réservé **verrouille**
+  le relais : le relais le dit dans sa réponse et son journal (`au_dessus_du_pire_cas`), puis refuse tout appel suivant (409,
+  rien n'est envoyé à l'amont) ; le lanceur arrête le pilote.
+- **D-5 (W1)** : `/relais/etat` rend les **noms** des variables de son environnement (`environnement_noms`, jamais une valeur) :
+  le lanceur contrôle qu'aucun autre nom que ceux du filtre, du jeton et de la clé du proposeur n'est arrivé au relais.
+- **D-4** : `/relais/etat` rend aussi la règle de comptage et le verrou ; le relais sert la sonde comme le pilote (plafond et
+  nombre d'appels donnés par le lanceur).
+- **d-3** : flux de l'interface Messages : un `message_delta` sans raison d'arrêt n'efface plus la raison déjà lue ; le flux
+  entier tient un délai total (`--delai-amont-s`), plus seulement chaque lecture.
+
+Changements de la v69 (gardés) : voie de Claude branchée (B-1, Q-5 : `POST https://api.anthropic.com/v1/messages`, `x-api-key`
+de la variable dont le **nom** est passé par `--variable-cle`, `anthropic-version: 2023-06-01`, `anthropic-workspace-id`
+seulement si `--variable-espace` est donnée et présente, corps `{model, max_tokens, stream: true, messages: [un message
+utilisateur], output_config: {effort}}`, **aucun outil, aucun message système, aucun `thinking`, aucun `fallbacks`**, adresse fixe,
+jamais `ANTHROPIC_BASE_URL`) ; adresse d'amont figée par dialecte (Q-6, B-2 (c)) ; `--reglages` fusionnés au corps (Q-4) ;
+`/relais/etat` complet (B-2 (b)) ; erreurs de l'amont réduites au statut et au type (M-2) ; pire cas propre au relais (M-8) ;
+jeton du lancement (m-11).
+
+`POST /appel` {modele, consigne, max_tokens} → 200 {relais, appelant, reglages, corps, flux, entetes, statut_amont,
+consigne_recue_sha256, corps_amont_sha256, outils, messages, systeme, au_dessus_du_pire_cas} ; 400 requête ou borne ; 401 jeton ;
+402 plafond ; 403 modèle ; 409 relais verrouillé ; 429 nombre d'appels ; 501 voie non branchée (clé absente) ; 502 erreur de
+l'amont (statut et type seulement).
+
+Appelants : le dialecte lui-même (`claude`, `gemini`, `astra` : appel réel), ou `factice:SCENARIO[;N=SCENARIO…]` (amont en mémoire,
+essai à blanc seulement ; il lit **le seul texte servi**). Scénarios : `k1_plus`, `k1_seul`, `tronque`, `refus`, `modele_faux`,
+`illisible`, `panne`, `sans_usage`, `usage_faux`, `cout_excessif`, `erreur_amont`, `reflexion_longue`.
+
+Usage : python3 -I -B relais_pilote_v70.py --port P --nom NOM --dialecte D --modele M --plafond-usd X --max-appels N
+            --prix-entree PE --prix-sortie PS --borne-sortie N --appelant A --journal J.jsonl --url-amont URL
+            --reflexion-comprise oui|non [--variable-cle NOM] [--variable-espace NOM] [--reglages JSON] [--delai-amont-s 3600]
+"""
+
+import argparse
+import hashlib
+import hmac
+import json
+import math
+import os
+import signal
+import ssl
+import sys
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+VERSION = "relais-pilote-v70"
+URL_AMONT = {"claude": "https://api.anthropic.com/v1/messages",
+             "gemini": "https://generativelanguage.googleapis.com/v1beta/models/{modele}:generateContent",
+             "astra": "https://api.openai.com/v1/chat/completions"}
+VERSION_API_ANTHROPIC = "2023-06-01"
+
+
+class NonBranche(Exception):
+    pass
+
+
+class ErreurAmont(Exception):
+    def __init__(self, statut, type_erreur):
+        super().__init__(f"amont HTTP {statut}")
+        self.statut, self.type_erreur = statut, type_erreur
+
+
+def url_permise(dialecte, modele, url):
+    """L'adresse figée du dialecte, ou la boucle locale d'essai (http://127.0.0.1:PORT/…) ; rien d'autre."""
+    if url == URL_AMONT[dialecte].format(modele=modele):
+        return True
+    u = urllib.parse.urlsplit(url or "")
+    return u.scheme == "http" and u.hostname == "127.0.0.1" and bool(u.port)
+
+
+def corps_amont(dialecte, modele, consigne, max_tokens, reglages):
+    """Le corps envoyé au fournisseur : un seul message utilisateur, aucun outil, aucun message système ; réglages fusionnés."""
+    if dialecte == "claude":
+        c = {"model": modele, "max_tokens": max_tokens, "stream": True, "messages": [{"role": "user", "content": consigne}]}
+    elif dialecte == "gemini":
+        c = {"contents": [{"role": "user", "parts": [{"text": consigne}]}], "generationConfig": {"maxOutputTokens": max_tokens}}
+    else:
+        c = {"model": modele, "messages": [{"role": "user", "content": consigne}], "max_completion_tokens": max_tokens}
+    for k, v in (reglages or {}).items():
+        if k in c:
+            raise ValueError(f"réglage {k!r} écraserait un champ du corps")
+        c[k] = v
+    return c
+
+
+def temoin_du_corps(dialecte, corps):
+    if dialecte == "gemini":
+        return corps.get("tools", []), len(corps.get("contents", [])), corps.get("systemInstruction")
+    return corps.get("tools", []), len(corps.get("messages", [])), corps.get("system")
+
+
+def usage_du_corps(dialecte, corps, comprise=True):
+    """(entrée, sortie) en jetons, ou None ; même lecture que la commande (D-2) : `comprise` vrai, le champ de sortie du
+    fournisseur compte déjà la réflexion ; faux, la réflexion lui est ajoutée."""
+    try:
+        if dialecte == "claude":
+            e, s = corps["usage"]["input_tokens"], corps["usage"]["output_tokens"]
+        elif dialecte == "gemini":
+            u = corps["usageMetadata"]
+            e, s = u["promptTokenCount"], u.get("candidatesTokenCount", 0) + (0 if comprise else u.get("thoughtsTokenCount", 0))
+        else:
+            u = corps["usage"]
+            e = u["prompt_tokens"]
+            s = u["completion_tokens"] + (0 if comprise else
+                                          ((u.get("completion_tokens_details") or {}).get("reasoning_tokens") or 0))
+    except (KeyError, IndexError, TypeError):
+        return None
+    ok = all(isinstance(x, int) and not isinstance(x, bool) and x >= 0 for x in (e, s))
+    return (e, s) if ok else None
+
+
+def lire_flux_anthropic(lignes):
+    """Message final reconstitué d'un flux SSE de l'API Messages (`message_start`, `content_block_*`, `message_delta`,
+    `message_stop`) ; lève ValueError si le flux est incomplet ou porte un événement `error`."""
+    msg, blocs, fini = None, {}, False
+    evenement = None
+    for brute in lignes:
+        ligne = brute.rstrip("\r\n")
+        if ligne.startswith("event:"):
+            evenement = ligne[6:].strip()
+            continue
+        if not ligne.startswith("data:"):
+            continue
+        d = json.loads(ligne[5:].strip())
+        t = d.get("type", evenement)
+        if t == "error":
+            raise ValueError(f"flux : erreur {(d.get('error') or {}).get('type')}")
+        if t == "message_start":
+            msg = dict(d["message"])
+            msg["content"] = []
+        elif t == "content_block_start":
+            blocs[d["index"]] = dict(d["content_block"])
+        elif t == "content_block_delta":
+            b, delta = blocs[d["index"]], d["delta"]
+            if delta.get("type") == "text_delta":
+                b["text"] = b.get("text", "") + delta["text"]
+            elif delta.get("type") == "thinking_delta":
+                b["thinking"] = b.get("thinking", "") + delta["thinking"]
+            elif delta.get("type") == "signature_delta":
+                b["signature"] = delta["signature"]
+        elif t == "message_delta":  # d-3 : une raison d'arrêt déjà lue n'est jamais effacée par un delta qui n'en porte pas
+            for cle in ("stop_reason", "stop_details"):
+                if d["delta"].get(cle) is not None:
+                    msg[cle] = d["delta"][cle]
+                else:
+                    msg.setdefault(cle, None)
+            msg.setdefault("usage", {}).update(d.get("usage") or {})
+        elif t == "message_stop":
+            fini = True
+    if msg is None or not fini:
+        raise ValueError("flux incomplet (message_start ou message_stop absent)")
+    msg["content"] = [blocs[i] for i in sorted(blocs)]
+    return msg
+
+
+def lignes_dans_le_delai(lignes, fin, horloge=time.monotonic):
+    """d-3 : les lignes du flux, tant que l'horloge n'a pas passé `fin` ; TimeoutError sinon (délai total du flux)."""
+    for ligne in lignes:
+        if horloge() > fin:
+            raise TimeoutError("flux : délai total de l'amont dépassé")
+        yield ligne
+
+
+def type_d_erreur(octets):
+    try:
+        o = json.loads(octets)
+    except (ValueError, RecursionError):
+        return None
+    e = o.get("error") if isinstance(o, dict) else None
+    if isinstance(e, dict):
+        t = e.get("type") or e.get("status") or e.get("code")
+        return str(t)[:60] if t is not None else None
+    return None
+
+
+def appel_reel(dialecte, url, corps, cle, espace, delai):
+    """L'appel de l'amont, sans reprise ; rend (corps du fournisseur, en-têtes retenus, flux brut ou None)."""
+    if not cle:
+        raise NonBranche("clé absente")
+    entetes = {"Content-Type": "application/json"}
+    if dialecte == "claude":
+        entetes.update({"x-api-key": cle, "anthropic-version": VERSION_API_ANTHROPIC, "accept": "text/event-stream"})
+        if espace:
+            entetes["anthropic-workspace-id"] = espace
+    elif dialecte == "gemini":
+        entetes["x-goog-api-key"] = cle
+    else:
+        entetes["Authorization"] = "Bearer " + cle
+    locale = url.startswith("http://127.0.0.1:")
+    ca = os.environ.get("SSL_CERT_FILE")
+    contexte = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
+    gestionnaires = [urllib.request.HTTPSHandler(context=contexte)] + ([urllib.request.ProxyHandler({})] if locale else [])
+    ouvreur = urllib.request.build_opener(*gestionnaires)
+    req = urllib.request.Request(url, data=json.dumps(corps, ensure_ascii=False).encode("utf-8"), method="POST", headers=entetes)
+    fin = time.monotonic() + delai
+    try:
+        with ouvreur.open(req, timeout=delai) as r:
+            garder = {k.lower(): v for k, v in r.headers.items() if k.lower() in ("content-type", "request-id", "x-request-id")}
+            if dialecte == "claude":
+                flux = [l.decode("utf-8") for l in lignes_dans_le_delai(r, fin)]
+                return lire_flux_anthropic(flux), garder, "".join(flux)
+            return json.loads(r.read()), garder, None
+    except urllib.error.HTTPError as e:
+        raise ErreurAmont(e.code, type_d_erreur(e.read())) from None
+
+
+# --- amont factice (essai à blanc) --------------------------------------------------------------------------------------------
+
+def _contexte(consigne):
+    i = consigne.find("```json\n")
+    j = consigne.rfind("\n```")
+    return json.loads(consigne[i + 8:j])
+
+
+def cartes_factices(consigne, scenario):
+    """Propositions écrites depuis le seul texte servi (K1 de l'archive, dimension du gabarit)."""
+    ctx = _contexte(consigne)
+    k1 = ctx["lois_retenues"][0]["loi"]
+    D = ctx["monde"]["traits"]
+    if scenario == "k1_seul":
+        return [{"enonce": f"copie {i} de la loi retenue", "loi_predictive": k1} for i in range(1, 7)]
+    j = next((i for i in range(D) if any(l[i] for l in k1["poids"])), 0)
+    autre = (j + 1) % D
+    k1b = json.loads(json.dumps(k1))
+    k1b["poids"][1][autre] = 0.5
+    k1b["poids"][2][autre] = -0.5
+
+    def arbre(n):
+        return k1b if n == 0 else {"type": "si_sinon", "condition": {"indice": (j + n) % D, "seuil": 0.0}, "si": arbre(n - 1),
+                                   "sinon": k1}
+    return [{"enonce": "la loi retenue", "loi_predictive": k1},
+            {"enonce": "la loi retenue et un second trait", "loi_predictive": k1b},
+            {"enonce": "trois conditions", "loi_predictive": arbre(3)},
+            {"enonce": "quatre conditions (refusée au gardien)", "loi_predictive": arbre(4)},
+            {"enonce": "sous-populations", "loi_predictive": {"type": "par_sous_population", "lois": {"2": k1b}, "defaut": k1}},
+            {"enonce": "clé en trop", "loi_predictive": k1, "test_de_mort": "x"},
+            {"enonce": "septième (refusée, comptée)", "loi_predictive": k1}]
+
+
+def corps_factice(dialecte, modele, consigne, max_tokens, scenario, comprise=True):
+    """Un corps au dialecte du proposeur (Claude : message final, comme le relais le reconstitue du flux), dont l'usage suit la
+    règle de comptage `comprise` (D-2) : la sortie comptée par cette règle vaut la sortie voulue par le scénario."""
+    if scenario == "panne":
+        raise ConnectionResetError("panne factice")
+    if scenario == "erreur_amont":
+        raise ErreurAmont(400, type_d_erreur(b'{"error": {"type": "invalid_request_error", "message": '
+                                             b'"organization org-ABCDEF123456 key sk-****abcd"}}'))
+    if scenario == "illisible":
+        texte, raison = "Je ne propose rien.", "fin"
+    else:
+        texte = "```json\n" + json.dumps(cartes_factices(consigne, "k1_seul" if scenario == "k1_seul" else "k1_plus")) + "\n```"
+        raison = "fin"
+    if scenario == "tronque":
+        texte, raison = texte[: len(texte) // 2], "borne"
+    if scenario == "refus":
+        texte, raison = "", "refus"
+    entree, sortie = len(consigne.encode("utf-8")) // 4 + 7, min(max_tokens, len(texte) // 4 + 100)
+    pensee = 50
+    if scenario == "cout_excessif":
+        sortie = max_tokens * 10
+    if scenario == "reflexion_longue":  # D-2 : longue réflexion, sortie comptée sous la borne (épreuve X2 de la contre-lecture)
+        sortie, pensee = int(max_tokens * 0.8), int(max_tokens * 0.7)
+    servi = modele + "-autre" if scenario == "modele_faux" else modele
+    if dialecte == "claude":
+        sr = {"fin": "end_turn", "borne": "max_tokens", "refus": "refusal"}[raison]
+        corps = {"id": "msg_factice", "type": "message", "role": "assistant", "model": servi, "stop_reason": sr,
+                 "stop_details": None, "content": [{"type": "thinking", "thinking": ""}, {"type": "text", "text": texte}],
+                 "usage": {"input_tokens": entree, "output_tokens": sortie}}
+    elif dialecte == "gemini":
+        fr = {"fin": "STOP", "borne": "MAX_TOKENS", "refus": "SAFETY"}[raison]
+        corps = {"modelVersion": servi, "candidates": [{"finishReason": fr, "content": {"role": "model", "parts": [
+            {"text": "réflexion", "thought": True}, {"text": texte}]}}],
+                 "usageMetadata": {"promptTokenCount": entree, "candidatesTokenCount": sortie if comprise else max(sortie - pensee, 0),
+                                   "thoughtsTokenCount": pensee}}
+    else:
+        fr = {"fin": "stop", "borne": "length", "refus": "content_filter"}[raison]
+        corps = {"model": servi, "choices": [{"index": 0, "finish_reason": fr, "message": {"role": "assistant", "content": texte}}],
+                 "usage": {"prompt_tokens": entree, "completion_tokens": sortie if comprise else max(sortie - pensee, 0),
+                           "completion_tokens_details": {"reasoning_tokens": pensee}}}
+    if scenario == "usage_faux":
+        for cle in ("usage", "usageMetadata"):
+            if cle in corps:
+                k = next(iter(corps[cle]))
+                corps[cle][k] = None
+    if scenario == "sans_usage":
+        corps.pop("usage", None)
+        corps.pop("usageMetadata", None)
+    return corps
+
+
+def empreinte_de_soi():
+    with open(os.path.abspath(__file__), "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+class Etat:
+    def __init__(self, args, cle, espace, jeton, noms_environnement=()):
+        self.args, self.cle, self.espace, self.jeton = args, cle, espace, jeton
+        self.verrou = threading.Lock()
+        self.appels, self.reserve, self.regle = 0, 0.0, 0.0
+        self.verrouille = False  # D-2 : vrai après un coût lu au-dessus du pire cas réservé ; tout appel suivant est refusé
+        self.comprise = args.reflexion_comprise == "oui"
+        self.noms_environnement = sorted(noms_environnement)  # W1 : les noms seulement, jamais une valeur
+        self.factice = args.appelant.startswith("factice:")
+        self.scenarios, self.defaut = {}, None
+        if self.factice:
+            parts = args.appelant[len("factice:"):].split(";")
+            self.defaut = parts[0]
+            for p in parts[1:]:
+                n, s = p.split("=")
+                self.scenarios[int(n)] = s
+        self.branche = self.factice or bool(cle)
+        self.fichier_sha256 = empreinte_de_soi()
+
+    def journal(self, entree):
+        with open(self.args.journal, "a", encoding="utf-8") as f:
+            f.write(json.dumps(entree, ensure_ascii=False, sort_keys=True) + "\n")
+
+
+def fabriquer(etat):
+    a = etat.args
+
+    class Gestion(BaseHTTPRequestHandler):
+        def log_message(self, *x):
+            pass
+
+        def _json(self, code, objet):
+            o = json.dumps(objet, ensure_ascii=False).encode("utf-8")
+            self.send_response(code)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(o)))
+            self.end_headers()
+            self.wfile.write(o)
+
+        def do_GET(self):
+            if self.path != "/relais/etat":
+                return self._json(404, {"relais": VERSION})
+            with etat.verrou:
+                self._json(200, {"relais": f"{VERSION}-{a.nom}", "version": VERSION, "fichier_sha256": etat.fichier_sha256,
+                                 "appelant": a.appelant, "branche": etat.branche, "cle_presente": bool(etat.cle),
+                                 "variable_cle": a.variable_cle, "plafond_usd": a.plafond_usd, "reserve_usd": etat.reserve,
+                                 "regle_usd": etat.regle, "appels": etat.appels, "max_appels": a.max_appels, "pid": os.getpid(),
+                                 "modele": a.modele, "dialecte": a.dialecte, "prix_entree": a.prix_entree,
+                                 "prix_sortie": a.prix_sortie, "borne_sortie": a.borne_sortie, "url_amont": a.url_amont,
+                                 "reglages": a.reglages_objet, "reflexion_comprise": etat.comprise,
+                                 "verrouille": etat.verrouille, "environnement_noms": etat.noms_environnement})
+
+        def do_POST(self):
+            if self.path != "/appel":
+                return self._json(404, {"relais": VERSION})
+            if not hmac.compare_digest(self.headers.get("X-Jeton-Relais", ""), etat.jeton):
+                return self._json(401, {"relais": VERSION, "erreur": "jeton du relais absent ou faux"})
+            try:
+                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))))
+                modele, consigne, mt = d["modele"], d["consigne"], d["max_tokens"]
+                if not (isinstance(consigne, str) and consigne and isinstance(mt, int) and not isinstance(mt, bool) and mt > 0):
+                    raise ValueError
+            except (ValueError, KeyError, TypeError):
+                return self._json(400, {"relais": VERSION, "erreur": "requête illisible"})
+            if modele != a.modele:
+                return self._json(403, {"relais": VERSION, "erreur": "modèle non permis"})
+            if mt > a.borne_sortie:
+                return self._json(400, {"relais": VERSION, "erreur": "max_tokens au-dessus de la borne du relais"})
+            if not etat.branche:
+                return self._json(501, {"relais": VERSION, "erreur": "voie non branchée (clé absente)"})
+            pire = (len(consigne.encode("utf-8")) + 1024) * a.prix_entree / 1e6 + mt * a.prix_sortie / 1e6  # M-8 : son propre pire cas
+            with etat.verrou:
+                if etat.verrouille:  # D-2 : un coût au-dessus du pire cas a été lu ; plus rien ne part vers l'amont
+                    return self._json(409, {"relais": VERSION, "erreur": "relais verrouillé : coût lu au-dessus du pire cas"})
+                if etat.appels >= a.max_appels:
+                    return self._json(429, {"relais": VERSION, "erreur": "nombre d'appels atteint"})
+                if etat.regle + etat.reserve + pire > a.plafond_usd + 1e-12:
+                    return self._json(402, {"relais": VERSION, "erreur": "plafond du relais"})
+                etat.appels += 1
+                n = etat.appels
+                etat.reserve += pire
+            corps = corps_amont(a.dialecte, modele, consigne, mt, a.reglages_objet)
+            outils, messages, systeme = temoin_du_corps(a.dialecte, corps)
+            base = {"relais": f"{VERSION}-{a.nom}", "appelant": a.appelant, "reglages": a.reglages_objet,
+                    "consigne_recue_sha256": hashlib.sha256(consigne.encode("utf-8")).hexdigest(),
+                    "corps_amont_sha256": hashlib.sha256(json.dumps(corps, ensure_ascii=False, sort_keys=True).encode()).hexdigest(),
+                    "outils": outils, "messages": messages, "systeme": systeme}
+            cout, statut = pire, 200
+            try:
+                if etat.factice:
+                    rep, entetes, flux = corps_factice(a.dialecte, modele, consigne, mt, etat.scenarios.get(n, etat.defaut),
+                                                       etat.comprise), {"content-type": "application/json"}, None
+                else:
+                    rep, entetes, flux = appel_reel(a.dialecte, a.url_amont, corps, etat.cle, etat.espace, a.delai_amont_s)
+                u = usage_du_corps(a.dialecte, rep, etat.comprise)
+                if u is not None:
+                    cout = (u[0] * a.prix_entree + u[1] * a.prix_sortie) / 1e6
+                reponse = dict(base, corps=rep, flux=flux, entetes=entetes, statut_amont=200)
+            except NonBranche as e:
+                cout, statut, reponse = 0.0, 501, dict(base, erreur=str(e))
+            except ErreurAmont as e:
+                statut, reponse = 502, dict(base, erreur="erreur de l'amont", statut_amont=e.statut, type_erreur=e.type_erreur)
+            except Exception as e:  # noqa: BLE001 — transport ou flux illisible : compté au pire cas, classe seule
+                statut, reponse = 502, dict(base, erreur=f"{type(e).__name__}")
+            excessif = cout > pire + 1e-9
+            with etat.verrou:
+                etat.reserve -= pire
+                etat.regle += cout
+                if excessif:
+                    etat.verrouille = True
+            reponse["au_dessus_du_pire_cas"] = excessif
+            etat.journal({"appel": n, "statut": statut, "cout_usd": round(cout, 8), "pire_cas_usd": round(pire, 8),
+                          "au_dessus_du_pire_cas": excessif, "consigne_recue_sha256": base["consigne_recue_sha256"],
+                          "relais": base["relais"]})
+            return self._json(statut, reponse)
+    return Gestion
+
+
+def principal(argv, environ):
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--port", type=int, required=True)
+    p.add_argument("--nom", required=True)
+    p.add_argument("--dialecte", required=True, choices=("claude", "gemini", "astra"))
+    p.add_argument("--modele", required=True)
+    p.add_argument("--plafond-usd", type=float, required=True)
+    p.add_argument("--max-appels", type=int, required=True)
+    p.add_argument("--prix-entree", type=float, required=True)
+    p.add_argument("--prix-sortie", type=float, required=True)
+    p.add_argument("--borne-sortie", type=int, required=True)
+    p.add_argument("--appelant", required=True)
+    p.add_argument("--journal", required=True)
+    p.add_argument("--url-amont", required=True)
+    p.add_argument("--variable-cle", default=None)
+    p.add_argument("--variable-espace", default=None)
+    p.add_argument("--reglages", default="{}")
+    p.add_argument("--delai-amont-s", type=float, default=3600.0)
+    p.add_argument("--reflexion-comprise", required=True, choices=("oui", "non"))
+    a = p.parse_args(argv)
+    if not (a.plafond_usd > 0 and a.max_appels > 0 and a.borne_sortie > 0 and math.isfinite(a.plafond_usd)):
+        print(f"{VERSION} : plafond, appels et borne > 0", file=sys.stderr)
+        sys.exit(2)
+    if not (a.appelant.startswith("factice:") or a.appelant == a.dialecte):
+        print(f"{VERSION} : appelant {a.appelant!r} ≠ dialecte {a.dialecte!r}", file=sys.stderr)
+        sys.exit(2)
+    if a.dialecte == "claude" and a.reflexion_comprise != "oui":
+        print(f"{VERSION} : claude : --reflexion-comprise oui seulement", file=sys.stderr)
+        sys.exit(2)
+    if not url_permise(a.dialecte, a.modele, a.url_amont):
+        print(f"{VERSION} : adresse d'amont refusée (adresse figée du dialecte ou boucle locale d'essai seulement)", file=sys.stderr)
+        sys.exit(2)
+    try:
+        a.reglages_objet = json.loads(a.reglages)
+        corps_amont(a.dialecte, a.modele, "x", 1, a.reglages_objet)
+    except ValueError as e:
+        print(f"{VERSION} : réglages refusés : {e}", file=sys.stderr)
+        sys.exit(2)
+    jeton = environ.get("RELAIS_JETON")
+    if not jeton:
+        print(f"{VERSION} : RELAIS_JETON absent", file=sys.stderr)
+        sys.exit(2)
+    cle = None if a.appelant.startswith("factice:") or not a.variable_cle else environ.get(a.variable_cle)
+    espace = environ.get(a.variable_espace) if a.variable_espace else None
+    etat = Etat(a, cle, espace, jeton, noms_environnement=list(environ))
+    serveur = ThreadingHTTPServer(("127.0.0.1", a.port), fabriquer(etat))
+    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=serveur.shutdown).start())
+    print(json.dumps({"relais": f"{VERSION}-{a.nom}", "port": serveur.server_address[1], "pid": os.getpid()}), flush=True)
+    serveur.serve_forever()
+
+
+if __name__ == "__main__":
+    principal(sys.argv[1:], dict(os.environ))
