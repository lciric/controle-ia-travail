+
+def lire_configuration(chemin):
+    """Configuration v10 : rend (conf, dossier) après contrôles (C-7, C-9) : quatre proposeurs nommés, champs exacts, bornes
+    payées par le plafond de session au pire cas, part = 4 plafonds de session, parts par ligne de GO égales aux montants, chaque
+    proposeur dans une seule ligne, adresse d'amont = adresse figée du dialecte (ou boucle locale d'essai), réglages objets,
+    commande et relais égaux à leurs empreintes."""
+    dossier = os.path.dirname(os.path.abspath(chemin))
