+             "parts_usd": parts, "depense_usd": round(sum(f["cout_usd"] or 0.0 for f in faits), 8),
+             "a_lire_hors_du_code": "prix : coût de chaque appel à rapprocher de la console par Lazar"}
+    rel = S.releve(conf, faits, bool(args.borne_courte), debut, maintenant(), arret is not None, arret, extra)
+    sha = ecrire(os.path.join(args.sortie, S.RELEVE), rel)
+    imprimer({"lanceur": VERSION, "releve_sonde_sha256": sha, "partiel": arret is not None, "arret": arret,
+              "conclusions": rel["conclusions"]})
+    if arret is not None:
+        print(f"arrêt : {arret}", file=sys.stderr)
+        return 3
+    return 0
