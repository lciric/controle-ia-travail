+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+T = "essais/test_pilote_mr2_v70.py"
+PC, PR, AU, LA = "pole/pilote_mr2_v70.py", "pole/proposeurs_pilote_v70.py", "pole/audit_pilote_v70.py", "demonstrations/pilote_mr2_v70.py"
+SO = "pole/sonde_pilote_v70.py"
