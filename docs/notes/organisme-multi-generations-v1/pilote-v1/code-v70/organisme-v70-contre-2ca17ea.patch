+
+def borne_de_sortie_max(plafond, prix_entree, prix_sortie, octets_entree_max):
+    """La plus grande borne de sortie que le plafond de session paie au pire cas de la commande (entrée comptée en octets + 1024)
+    pour un texte servi d'au plus `octets_entree_max` octets."""
+    reste = plafond - (octets_entree_max + 1024) * prix_entree / 1e6
+    return int(math.floor(reste * 1e6 / prix_sortie)) if reste > 0 else 0
+
+
+def pire_cas_d_un_appel(p, octets, borne=None):
+    """Le pire cas d'un appel, règle de la commande et du relais : (octets + 1024) × prix d'entrée + borne × prix de sortie."""
+    b = p["borne_sortie_jetons"] if borne is None else borne
+    return (octets + 1024) * p["prix_entree_usd_par_million"] / 1e6 + b * p["prix_sortie_usd_par_million"] / 1e6
+
+
+def amont_boucle_locale(url):
