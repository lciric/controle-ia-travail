+def preparer_copie(d, m=None):
+    orch = os.path.join(d, "orchestrator")
+    shutil.copytree(RACINE, orch, ignore=shutil.ignore_patterns("__pycache__", ".pytest_cache"))
+    if m is None:
+        return orch
+    f = os.path.join(orch, m["fichier"])
+    with open(f, encoding="utf-8") as h:
+        t = h.read()
+    if t.count(m["avant"]) != 1:
+        raise RuntimeError(f"{m['id']} : texte avant présent {t.count(m['avant'])} fois")
+    with open(f, "w", encoding="utf-8") as h:
+        h.write(t.replace(m["avant"], m["apres"]))
+    if m["fichier"] in (CO, RE):
+        c = os.path.join(orch, CONF)
+        conf = json.load(open(c, encoding="utf-8"))
+        cle = "commande" if m["fichier"] == CO else "relais"
+        conf[cle]["sha256"] = hashlib.sha256(open(f, "rb").read()).hexdigest()
+        with open(c, "w", encoding="utf-8") as h:
+            json.dump(conf, h, ensure_ascii=False, indent=1)
+    return orch
+
+
+def jouer(orch, selection):
+    r = subprocess.run([sys.executable, "-I", "-B", "-m", "pytest", "-q", "-p", "no:cacheprovider", "-x" if False else "-q",
+                        T, "-k", selection, "-rfE"], cwd=orch, capture_output=True, text=True,
+                       env=dict({"PATH": "/usr/bin:/bin", "OMP_NUM_THREADS": "2", "HOME": os.environ.get("HOME", "/tmp")},
+                                **({"TMPDIR": os.environ["TMPDIR"]} if os.environ.get("TMPDIR") else {})), timeout=1800)
+    echecs = sorted(set(re.findall(r"(?:SUBFAILED\[[^\]]*\]|FAILED|ERROR) \S+::(\w+)(?:::(\w+))?", r.stdout)))
+    return r.returncode, [b or a for a, b in echecs], r.stdout[-1500:]
+
+
+def principal(argv=None):
+    a = argparse.ArgumentParser()
+    a.add_argument("--sortie", default=None)
+    a.add_argument("--seulement", default=None)
+    args = a.parse_args(argv)
+    choisies = [m for m in MUTATIONS if not args.seulement or m["id"].split("-")[0] in args.seulement.split(",")]
+    res = {"debut": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "mutations": []}
+    with tempfile.TemporaryDirectory() as d:
+        orch = preparer_copie(d)
+        selections = sorted({m["selection"] for m in choisies})
+        code, echecs, queue = jouer(orch, " or ".join(f"({s})" for s in selections))
+        res["sain"] = {"code": code, "echecs": echecs}
+        if code != 0:
+            print(queue, file=sys.stderr)
+            res["defaut"] = "essais sains en échec sur la copie non mutée"
+            return 2, res
+    for m in choisies:
+        with tempfile.TemporaryDirectory() as d:
+            try:
+                orch = preparer_copie(d, m)
+            except RuntimeError as e:
+                res["mutations"].append(dict(m, issue="défaut du banc", detail=str(e)))
+                continue
+            code, echecs, queue = jouer(orch, m["selection"])
+            issue = "tuée (raison attendue)" if code != 0 and m["attendu"] in echecs else ("survit" if code == 0 else "tuée (autre raison)")
+            res["mutations"].append({"id": m["id"], "fichier": m["fichier"], "issue": issue, "echecs": echecs,
+                                     "attendu": m["attendu"]})
+            print(f"{m['id']} : {issue} {echecs}", flush=True)
+    res["fin"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    res["bilan"] = {i: sum(1 for x in res["mutations"] if x["issue"] == i) for i in sorted({x["issue"] for x in res["mutations"]})}
+    code = 0 if res["bilan"] == {"tuée (raison attendue)": len(choisies)} else 1
+    return code, res
+
+
+if __name__ == "__main__":
+    code, res = principal()
+    a = sys.argv
+    if "--sortie" in a:
+        with open(a[a.index("--sortie") + 1], "x", encoding="utf-8") as f:
+            json.dump(res, f, ensure_ascii=False, indent=1, sort_keys=True)
+    print(json.dumps(res.get("bilan"), ensure_ascii=False))
+    sys.exit(code)
