+    def executer_doublure(self, temoin=None, brut=True, brut_sha=True, compagnon_faux=False, etat="complet", fichier_session=False,
+                          consigne=None):
+        """Une doublure de la commande (essais seulement) : écrit un corps du relais et rend une dernière ligne choisie."""
+        sha_texte = hashlib.sha256(self.texte.encode()).hexdigest()
+        consigne = sha_texte if consigne is None else consigne
+        tr = {"relais": "relais-pilote-v70-astra", "consigne_recue_sha256": sha_texte, "outils": [], "messages": 1, "systeme": None,
+              "appelant": "astra", "reglages": {}, "corps_amont_sha256": "x"}
+        tr.update(temoin or {})
+
+        def executer(cmd, **k):
+            chemin = cmd[cmd.index("--sortie-brute") + 1]
+            sha = None
+            if brut:
