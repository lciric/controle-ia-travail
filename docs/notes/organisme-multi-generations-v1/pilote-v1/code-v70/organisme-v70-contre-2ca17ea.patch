+def conf_ports_libres():
+    """La configuration v11 lue, ports remplacés par des ports libres (d'autres processus tournent sur la machine)."""
+    import socket
+    conf, _ = PR.lire_configuration(CONF)
+    for p in conf["proposeurs"].values():
+        s = socket.socket()
+        s.bind(("127.0.0.1", 0))
+        p["port"] = s.getsockname()[1]
+        s.close()
+    return conf
