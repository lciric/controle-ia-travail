+    """D-1 : une seule chaîne, du code au manifeste et au texte."""
+
+    def test_sain(self):
+        self.assertIn("« pilote-mr2-v69|episodes-developpement| »", P.REGLE_EPISODES)
+        self.assertEqual(P.ETIQUETTE_EPISODES, "pilote-mr2-v69|episodes-developpement")  # épisodes de la v69, inchangés
+        self.assertTrue(L.REGLE_DES_GRAINES.startswith(P.REGLE_EPISODES))
+        e = mondes_dev()
+        spec = e["mondes"][1]["spec"]
+        cle = int.from_bytes(hashlib.sha256(("pilote-mr2-v69|episodes-developpement|" + P.sha_spec(spec)).encode()).digest()[:16], "big")
+        import numpy as np
+        rng = np.random.default_rng(np.random.SeedSequence(cle))
+        Z, G = M.tirer_instances(rng, 400, 8, 3)
+        Y = M.tirer_issues(rng, M.probas(P.compiler_monde(spec), Z, G))
+        self.assertEqual(P.episodes_de_developpement(spec), [{"z": [float(x) for x in z], "g": int(g), "y": int(y)}
+                                                            for z, g, y in zip(Z, G, Y)])
+
+
+class SondeFonctions(unittest.TestCase):
+    """D-4 : les fonctions pures de la sonde, cas sain et artefact chacune."""
+
+    def test_verdicts(self):
+        V = S.verdict_reflexion
+        self.assertEqual(V("claude", {}), "sans_champ")
+        self.assertEqual(V("astra", {"completion_tokens": 42, "reasoning_tokens": 40}), "comprise")
+        self.assertEqual(V("astra", {"completion_tokens": 2, "reasoning_tokens": 40}), "non_comprise")
+        self.assertEqual(V("astra", {"completion_tokens": 300, "reasoning_tokens": 40}), "indetermine")
+        self.assertEqual(V("astra", {"completion_tokens": 2, "reasoning_tokens": 0}), "indetermine")
+        self.assertEqual(V("astra", {"completion_tokens": None, "reasoning_tokens": 40}), "indetermine")
+        g = {"promptTokenCount": 10, "candidatesTokenCount": 2, "thoughtsTokenCount": 40}
+        self.assertEqual(V("gemini", dict(g, totalTokenCount=52)), "non_comprise")
+        self.assertEqual(V("gemini", dict(g, totalTokenCount=12)), "comprise")
+        self.assertEqual(V("gemini", dict(g, totalTokenCount=99)), "indetermine")
+        self.assertEqual(V("gemini", dict(g, totalTokenCount=None)), "non_comprise")
+        self.assertEqual(S.verdict_d_ensemble(["comprise", "indetermine"]), "comprise")
+        self.assertEqual(S.verdict_d_ensemble(["comprise", "non_comprise"]), "contradictoire")
+        self.assertEqual(S.verdict_d_ensemble(["indetermine"]), "indetermine")
+
+    def test_sortie_comptee(self):
+        self.assertEqual(S.sortie_comptee("astra", {"completion_tokens": 256, "reasoning_tokens": 200}, True), 256)
+        self.assertEqual(S.sortie_comptee("astra", {"completion_tokens": 56, "reasoning_tokens": 200}, False), 256)
+        self.assertEqual(S.sortie_comptee("gemini", {"candidatesTokenCount": 56, "thoughtsTokenCount": 200}, False), 256)
+        self.assertEqual(S.sortie_comptee("gemini", {"candidatesTokenCount": 56, "thoughtsTokenCount": 200}, True), 56)
+        self.assertEqual(S.sortie_comptee("claude", {"output_tokens": 30}, True), 30)
+        self.assertIsNone(S.sortie_comptee("astra", {"completion_tokens": None}, True))
+
+    def test_flux_relu_et_compare(self):
+        R = charger_relais_module()
+        evs = [{"type": "message_start", "message": {"id": "m", "model": "claude-fable-5-2", "stop_reason": None,
+                                                     "usage": {"input_tokens": 12, "output_tokens": 1}}},
+               {"type": "ping"},
+               {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
+               {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "O"}},
+               {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "K"}},
+               {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 30}},
+               {"type": "message_stop"}]
+        flux = "".join(f"event: {e['type']}\ndata: {json.dumps(e)}\n\n" for e in evs)
+        corps = R.lire_flux_anthropic(flux.splitlines(keepends=True))
+        c = S.comparer_flux(flux, corps)
+        self.assertTrue(c["egal"], c)
+        self.assertIn("ping", c["evenements"])
+        faux = dict(corps, content=[{"type": "text", "text": "KO"}])
+        self.assertEqual(S.comparer_flux(flux, faux)["ecarts"], ["texte"])
+        self.assertFalse(S.comparer_flux(flux, dict(corps, stop_reason="max_tokens"))["egal"])
+        sans_usage = flux.replace(', "usage": {"output_tokens": 30}', "")
+        self.assertFalse(S.comparer_flux(sans_usage, R.lire_flux_anthropic(sans_usage.splitlines(keepends=True)))["egal"])
+        self.assertFalse(S.comparer_flux("data: [DONE]\n", corps)["egal"])
+
+
