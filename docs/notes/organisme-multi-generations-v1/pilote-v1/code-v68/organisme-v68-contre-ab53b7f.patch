+class Relais:
+    """Un relais à amont factice lancé pour un essai, arrêté par son PID."""
+
+    def __init__(self, conf, nom, scenario, d):
+        self.journal = os.path.join(d, f"journal-relais-{nom}.jsonl")
+        self.proc, self.info = PR.lancer_relais(conf, nom, self.journal, "factice:" + scenario, python=sys.executable)
+
+    def fermer(self):
+        PR.arreter_relais(self.proc)
+
