+    M("M12-manifeste-avec-loi", PC, "if k in CLES_INTERDITES_MANIFESTE:", "if k in ():", "C2Manifeste", "test_artefacts"),
+    M("M13-sous-populations-non-lues", PC, "if (d, g, k) != (D_PILOTE, NSP_PILOTE, K_PILOTE)", "if d != D_PILOTE", "C1MondePrive",
