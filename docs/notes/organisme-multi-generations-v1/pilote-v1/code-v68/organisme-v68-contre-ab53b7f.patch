+# --- C-3, C-4 : dimensions, compilation, épisodes de développement ----------------------------------------------------------
+
+def exiger_dimensions(spec):
+    """C-3 : dimension 8, 3 sous-populations, 3 issues, lues dans le monde et égales à celles du gabarit servi."""
+    if not isinstance(spec, dict):
+        raise Refus("devis du monde : objet")
+    d, g, k = spec.get("dimension"), spec.get("sous_populations"), spec.get("nombre_issues")
+    if (d, g, k) != (D_PILOTE, NSP_PILOTE, K_PILOTE) or any(isinstance(x, bool) for x in (d, g, k)):
+        raise Refus(f"monde de dimension {d}, {g} sous-populations, {k} issues : le gabarit servi est à "
+                    f"{D_PILOTE}, {NSP_PILOTE}, {K_PILOTE}")
+    return d, g, k
+
+
+def compiler_monde(spec):
+    """C-4 : `compiler_v4` (porté), loi validée par `selection_pari.valider_loi` à la dimension du monde."""
+    V4, _, _ = charger_mr2()
+    d, _, k = exiger_dimensions(spec)
+    loi = V4.compiler_v4(spec)
+    try:
+        sp.valider_loi(loi, k, d)
+    except sp.LoiInvalide as e:
+        raise Refus(f"loi compilée refusée par selection_pari.valider_loi : {e}") from None
+    return loi
+
+
+def verifier_monde(spec):
+    """C-4 : `verifier_v4` (porté ; C0 à C8 v4, toute conditionnelle certifiée) ; rend (conforme, refus, rapport)."""
+    V4, _, _ = charger_mr2()
+    r = sans_chemin_v52b(V4.verifier_v4, spec)
+    return bool(r["conforme"]), r.get("refus"), r
+
+
+def episodes_de_developpement(spec, n=EPISODES_DEVELOPPEMENT):
+    """C-3 : la tranche de 400 épisodes de développement du monde : instances publiques (traits N(0, 1) à six décimales,
+    sous-population uniforme) et issues tirées de la loi compilée ; graine `SeedSequence` dérivée de l'empreinte du devis (R9)."""
+    _, M, _ = charger_mr2()
+    loi = compiler_monde(spec)
+    cle = int.from_bytes(hashlib.sha256((ETIQUETTE_EPISODES + "|" + sha_spec(spec)).encode()).digest()[:16], "big")
+    rng = np.random.default_rng(np.random.SeedSequence(cle))
+    Z, G = M.tirer_instances(rng, n, spec["dimension"], spec["sous_populations"])
+    Y = M.tirer_issues(rng, M.probas(loi, Z, G))
+    return [{"z": [float(x) for x in z], "g": int(g), "y": int(y)} for z, g, y in zip(Z, G, Y)]
+
+
+# --- C-12 : héritage {K1} -------------------------------------------------------------------------------------------------
+
+def preparer(mondes):
+    """Les mondes préparés par le programme de la mesure lui-même (`preparer_mondes` : oracle de 12 000 instances, K1, première
+    conditionnelle, refus si la condition est l'effet de K1) : la K1 servie est celle que la mesure retire du témoin (R-4)."""
+    _, _, MP = charger_mr2()
+    try:
+        return MP.preparer_mondes(mondes)
+    except MP.Refus as e:
+        raise Refus(f"mondes refusés par le programme de la mesure : {e}") from None
+
+
+def identifiant_opaque(sha_monde, quoi):
+    return "F-" + hashlib.sha256(f"{ETIQUETTE_ARCHIVE}|{sha_monde}|{quoi}".encode()).hexdigest()[:12]
+
+
+def heritage_k1(pm_monde):
+    """C-12 : l'archive servie {K1} d'un monde, écrite par programme depuis le monde privé (K1 arrondie à six décimales par
+    `k1_du_monde`), identifiant opaque ; rend (archive, empreinte)."""
+    k1 = copy.deepcopy(pm_monde["k1"])
+    for v in [x for l in k1["poids"] for x in l] + list(k1["biais"]):
+        if round(v, 6) != v:
+            raise Refus("K1 non arrondie à six décimales")
+    archive = [{"identifiant": identifiant_opaque(pm_monde["sha"], "K1"), "loi": k1}]
+    return archive, hashlib.sha256(json_canonique(archive)).hexdigest()
+
