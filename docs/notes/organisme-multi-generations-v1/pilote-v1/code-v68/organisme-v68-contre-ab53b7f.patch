+"""Lanceur du pilote d'une génération sur la famille MR-2 — code v68 (fichier neuf, R12 ; C-11, C-13, C-14, C-18).
+
+Texte : `preenregistrement-pilote-conditionnelles-v1-brouillon4.md` (`04ada9fa…`), Q-P2 (a) : **une génération, proposeurs puis
+gardien, sans juge, sans étage, sans test de mort, sans expérimentateur ni vérificateur** ; 4 mondes, bras A seul (archive
+{K1}), 4 proposeurs, un appel chacun par monde, sessions séparées ; aucun bac exigé.
+
+Sous-commandes (sorties imprimées : empreintes et contrôles seulement, jamais un devis ni une loi du monde) :
+  secret  DOSSIER_PRIVE/secret.bin                          tire le secret machine (32 octets), imprime son empreinte
+  generer --secret S --phrase-fichier F --texte-sha256 H --sortie DOSSIER_PRIVE/MONDES.json
+                                                            C-15 : 4 mondes du secret du pilote, vérifiés ; empreintes
+  preparer --mondes M --mondes-sha256 H                     C-16, C-17, héritages {K1}, gabarit : empreintes
+  jouer   --mode a_blanc|reel --mondes M --mondes-sha256 H --configuration C --sortie DOSSIER
+          [--scenarios NOM=SCENARIO,…]                      (à blanc : relais à amont factice lancés ici)
+          [--go-pi1 GO --go-pi2 GO --registre-go R --texte T --texte-sha256 H]   (réel : exigés)
+  lire    --sortie-mesure S --releve R [--journaux DOSSIER]  C-14 : champ `regle` de la mesure, coûts rapprochés
+  relire  --cartes CARTES.json                              C-18 : cartes tirées pour l'audit R4
+  rapatrier --source DOSSIER --destination DOSSIER [--mondes-sha256 H]   C-18 : aucune pièce qui porte un monde
+  bloc                                                      bloc gelé : empreintes du code v68, du gabarit, bornes
+Codes : 0 conforme ; 2 refus nommé (rien appelé) ; 3 arrêt (pièces versées).
+
+La mesure elle-même n'est pas lancée ici : `python3 -I -B orchestrator/mr2_v68/pilote-v1/outils/mesure_pilote_v4.py mesurer
+MONDES.json CARTES.json SORTIE.json`, une seule fois (plan d'analyse, étape 2).
+"""
+
+import argparse
+import datetime
+import hashlib
+import json
+import os
+import sys
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+if RACINE not in sys.path:
+    sys.path.insert(0, RACINE)
+
+from pole import audit_pilote_v68 as AU  # noqa: E402
+from pole import pilote_mr2_v68 as P  # noqa: E402
+from pole import proposeurs_pilote_v68 as PR  # noqa: E402
+from pole.outils import json_canonique, sha256_fichier  # noqa: E402
+
+VERSION = "lanceur-pilote-mr2-v68"
+LANCEUR = "demonstrations/pilote_mr2_v68.py"
+DEBUT_BLOC, FIN_BLOC = "<!-- empreintes-du-code-pilote-v68 : début -->", "<!-- empreintes-du-code-pilote-v68 : fin -->"
+FICHIERS_GELES = (
+    "demonstrations/pilote_mr2_v68.py", "pole/pilote_mr2_v68.py", "pole/proposeurs_pilote_v68.py", "pole/audit_pilote_v68.py",
+    "exemples/pilote-mr2-v68/commandes/commande_pilote_v68.py", "exemples/pilote-mr2-v68/commandes/relais_pilote_v68.py",
+    "exemples/pilote-mr2-v68/configuration-pilote-mr2-v9.json",
+    "pole/selection_pari.py", "pole/outils.py", "pole/registre_go_v66.py", "pole/configuration_v53.py",
+    "pole/configuration_v55.py", "pole/configuration_v54.py", "pole/__init__.py",
+) + tuple("mr2_v68/" + r for r in sorted(P.FICHIERS_MR2))
+CONFIGURATION = os.path.join(RACINE, "exemples", "pilote-mr2-v68", "configuration-pilote-mr2-v9.json")
+SCENARIO_A_BLANC = "k1_plus"
+
+
+def maintenant():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
+
+
+def empreintes_du_code(racine=RACINE):
+    out = {}
+    for rel in FICHIERS_GELES:
+        f = os.path.join(racine, rel)
+        if not os.path.isfile(f):
+            raise P.Refus(f"fichier gelé absent : {rel}")
+        out[rel] = sha256_fichier(f)
+    return out
+
+
+def bloc_gele(racine=RACINE):
+    """Le bloc que le texte scellé recopie : empreintes du code v68 et des modules portés, empreinte du gabarit servi, bornes
+    de sortie et plafonds de la configuration v9."""
+    conf, _ = PR.lire_configuration(os.path.join(racine, "exemples", "pilote-mr2-v68", "configuration-pilote-mr2-v9.json"))
+    lignes = [DEBUT_BLOC, "```", f"gabarit-servi-sha256 {P.gabarit_sha256()}"]
+    for nom in P.PROPOSEURS:
+        p = conf["proposeurs"][nom]
+        lignes.append(f"borne-de-sortie {nom} {p['modele']} {p['borne_sortie_jetons']} jetons ; plafond de session "
+                      f"{p['plafond_session_usd']:g} USD ; part {p['part_usd']:g} USD")
+    lignes.append(f"octets-entree-max {conf['octets_entree_max']}")
+    for rel, sha in sorted(empreintes_du_code(racine).items()):
+        lignes.append(f"{sha}  orchestrator/{rel}")
+    lignes += ["```", FIN_BLOC]
+    return "\n".join(lignes) + "\n"
+
+
+def verifier_bloc_du_texte(texte, racine=RACINE):
+    """Mode réel : le bloc gelé du texte scellé est exactement celui que rend le code présent (refus sinon)."""
+    i, j = texte.find(DEBUT_BLOC), texte.find(FIN_BLOC)
+    if i < 0 or j < i:
+        raise P.Refus("texte scellé : bloc « empreintes-du-code-pilote-v68 » absent")
+    if texte[i:j + len(FIN_BLOC)] + "\n" != bloc_gele(racine):
+        raise P.Refus("texte scellé : bloc gelé ≠ code, gabarit ou bornes présents")
+
+
+def ecrire(chemin, objet):
+    return PR.ecrire_scelle_json(chemin, objet)
+
+
+def imprimer(objet):
+    print(json.dumps(objet, ensure_ascii=False, sort_keys=True))
+
+
+# --- étapes -------------------------------------------------------------------------------------------------------------------
+
+def preparer_les_mondes(chemin_mondes, sha_mondes, octets_max=None):
+    """C-1 → C-17 sans appel : mondes lus, préparés par le programme de la mesure, C-16 et C-17 joués, héritages et textes
+    servis bâtis ; rend (mondes, pm_, servis, contrôles sans contenu)."""
+    mondes = P.charger_mondes_prives(chemin_mondes, sha_mondes)
+    for w in mondes:
+        P.compiler_monde(w["spec"])
+    pm_ = P.preparer(mondes)
+    c16 = P.jouer_c16(pm_)
+    episodes = {w: P.episodes_de_developpement(pm_[w]["spec"]) for w in sorted(pm_)}
+    c17 = P.jouer_c17(pm_, episodes)
+    servis = {}
+    for w in sorted(pm_):
+        archive, sha_arch = P.heritage_k1(pm_[w])
+        texte = P.texte_servi(archive, episodes[w])
+        n = len(texte.encode("utf-8"))
+        if octets_max is not None and n > octets_max:
+            raise P.Refus(f"monde {w} : texte servi de {n} octets > {octets_max} (bornes de sortie calculées pour ce maximum)")
+        servis[w] = {"texte": texte, "archive": archive, "episodes": episodes[w], "archive_sha256": sha_arch,
+                     "texte_sha256": hashlib.sha256(texte.encode("utf-8")).hexdigest(), "octets": n,
+                     "episodes_sha256": hashlib.sha256(json_canonique(episodes[w])).hexdigest()}
+        if not P.pieces_du_texte(texte, archive, episodes[w]):
+            raise P.Refus(f"monde {w} : texte servi ≠ texte bâti sur les seules pièces gelées")
+    controles = {"mondes": P.monde_au_manifeste(mondes, sha_mondes),
+                 "c16": {k: {x: v[x] for x in ("admise", "conditions", "loi_sha256")} for k, v in c16.items()},
+                 "c17": {"instances": c17["instances"], "cartes": c17["cartes"], "ecart_max": c17["ecart_max"]},
+                 "heritages_sha256": {str(w): s["archive_sha256"] for w, s in servis.items()},
+                 "textes_servis": {str(w): {"sha256": s["texte_sha256"], "octets": s["octets"], "episodes_sha256": s["episodes_sha256"]}
+                                   for w, s in servis.items()},
+                 "gabarit_sha256": P.gabarit_sha256()}
+    P.exiger_manifeste_sans_loi(controles)
+    return mondes, pm_, servis, controles
+
+
+def jouer(args):
+    debut = maintenant()
+    conf, _ = PR.lire_configuration(args.configuration)
+    go = None
+    if args.mode == "reel":
+        PR.exiger_confirme(conf)
+        if not (args.go_pi1 and args.go_pi2 and args.registre_go and args.texte and args.texte_sha256):
+            raise P.Refus("mode réel : --go-pi1, --go-pi2, --registre-go, --texte et --texte-sha256 exigés")
+        if sha256_fichier(args.texte) != args.texte_sha256:
+            raise P.Refus("texte scellé : empreinte différente")
+        with open(args.texte, encoding="utf-8") as f:
+            verifier_bloc_du_texte(f.read())
+        go = PR.lire_go_du_pilote(conf, args.registre_go, args.go_pi1, args.go_pi2)
+    elif args.mode != "a_blanc":
+        raise P.Refus("mode : a_blanc ou reel")
+    if os.path.exists(args.sortie):
+        raise P.Refus("dossier de sortie existant")
+    mondes, pm_, servis, controles = preparer_les_mondes(args.mondes, args.mondes_sha256, conf["octets_entree_max"])
+    os.makedirs(args.sortie)
+    procs, journaux = {}, {}
+    scen = dict(x.split("=", 1) for x in (args.scenarios or "").split(",") if x)
+    try:
+        if args.mode == "a_blanc":
+            for nom in P.PROPOSEURS:
+                journaux[nom] = os.path.join(args.sortie, f"journal-relais-{nom}.jsonl")
+                procs[nom], _ = PR.lancer_relais(conf, nom, journaux[nom], "factice:" + scen.get(nom, SCENARIO_A_BLANC),
+                                                 python=sys.executable)
+        relais = PR.exiger_relais_prets(conf)
+        appels, cartes, gardien = [], [], []
+        depense = {nom: 0.0 for nom in P.PROPOSEURS}
+        abandonnes = {}
+        for w in P.MONDES_PILOTE:
+            s = servis[w]
+            for nom in P.PROPOSEURS:
+                ligne = {"monde": w, "proposeur": nom, "texte_servi_sha256": s["texte_sha256"], "archive_sha256": s["archive_sha256"],
+                         "episodes_sha256": s["episodes_sha256"], "gabarit_sha256": controles["gabarit_sha256"]}
+                if nom in abandonnes:
+                    appels.append(dict(ligne, etat="echec", appele=False, cause=f"proposeur abandonné ({abandonnes[nom]})"))
+                    continue
+                p = conf["proposeurs"][nom]
+                if depense[nom] + p["plafond_session_usd"] > p["part_usd"] + 1e-9:
+                    raise PR.ArretPilote(f"{nom} : la part {p['part_usd']} USD serait atteinte au pire cas de l'appel suivant")
+                r = PR.appeler(conf, nom, s["texte"], os.path.join(args.sortie, f"monde-{w}", nom), python=sys.executable)
+                depense[nom] += r["cout_usd"]
+                if r["panne"]:
+                    abandonnes[nom] = f"panne au monde {w} : code {r['code']}"
+                cs, info = ([], None) if r["etat"] == "echec" else P.cartes_d_un_appel(w, nom, r["texte"])
+                cartes += cs
+                gardien.append({"monde": w, "proposeur": nom, "lecture": info})
+                appels.append(dict(ligne, appele=True, **{k: v for k, v in r.items() if k not in ("texte", "proposeur")}))
+        export = {"cartes": cartes, "appels": [{"monde": a["monde"], "proposeur": a["proposeur"], "etat": a["etat"]} for a in appels]}
+        sha_cartes = ecrire(os.path.join(args.sortie, "CARTES.json"), export)
+        releve = {"version": VERSION, "mode": args.mode, "appels": appels, "gardien": gardien, "depense_usd": depense,
+                  "abandonnes": abandonnes, "cartes_sha256": sha_cartes,
+                  "comptes": {e: sum(1 for a in appels if a["etat"] == e) for e in ("complet", "tronque", "echec")}}
+        sha_releve = ecrire(os.path.join(args.sortie, "releve-pilote-v68.json"), releve)
+        manifeste = {"version": VERSION, "lanceur": LANCEUR, "mode": args.mode, "debut_utc": debut, "fin_utc": maintenant(),
+                     "controles": controles, "configuration_sha256": PR.empreinte_configuration(conf),
+                     "code_sha256": empreintes_du_code(), "relais": relais, "go": go, "releve_sha256": sha_releve,
+                     "cartes_sha256": sha_cartes, "scenarios_a_blanc": scen if args.mode == "a_blanc" else None,
+                     "juge": None, "etage": None, "tests_de_mort": None}
+        P.exiger_manifeste_sans_loi({k: v for k, v in manifeste.items() if k not in ("go",)})
+        sha_man = ecrire(os.path.join(args.sortie, "manifeste-pilote-v68.json"), manifeste)
+    finally:
+        for nom, proc in procs.items():
+            PR.arreter_relais(proc)
+    imprimer({"lanceur": VERSION, "mode": args.mode, "cartes_sha256": sha_cartes, "releve_sha256": sha_releve,
+              "manifeste_sha256": sha_man, "comptes": releve["comptes"], "abandonnes": abandonnes})
+    return 0
+
+
+def lire(args):
+    """C-14 : la lecture du pilote = le champ `regle` de la sortie de la mesure (corps vérifié contre son empreinte, programme
+    contre la sienne, modules importés contre le bloc), et le rapprochement des coûts. Aucune autre lecture."""
+    with open(args.sortie_mesure, encoding="utf-8") as f:
+        s = json.load(f)
+    corps = s["corps"]
+    if hashlib.sha256(json.dumps(corps, ensure_ascii=False, sort_keys=True, default=str).encode()).hexdigest() != s["corps_sha256"]:
+        raise P.Refus("sortie de la mesure : corps ≠ son empreinte")
+    if s["hors_corps"]["script_sha256"] != P.FICHIERS_MR2["pilote-v1/outils/mesure_pilote_v4.py"]:
+        raise P.Refus("sortie de la mesure : programme ≠ mesure_pilote_v4.py (676d5f37…)")
+    attendus = {r: sha for r, sha in P.verifier_fichiers_mr2().items()}
+    for rel, sha in s["hors_corps"]["modules_importes"]:
+        if attendus.get(rel) != sha:
+            raise P.Refus(f"sortie de la mesure : module importé {rel} ≠ bloc gelé")
+    with open(args.releve, encoding="utf-8") as f:
+        releve = json.load(f)
+    journaux = {}
+    if args.journaux:
+        journaux = {n: os.path.join(args.journaux, f"journal-relais-{n}.jsonl") for n in P.PROPOSEURS}
+    lecture = {"version": VERSION, "regle": corps["regle"], "issue": corps["regle"]["issue"],
+               "sortie_mesure_sha256": sha256_fichier(args.sortie_mesure), "releve_sha256": sha256_fichier(args.releve),
+               "couts": AU.rapprocher_couts(releve, journaux),
+               "a_dire_au_rapport": ["P_VUE = 0,25 supposée, non mesurée", "p_c ne vaut que pour ce gabarit",
+                                     f"gabarit servi {P.gabarit_sha256()}"]}
+    if args.ecrire:
+        lecture["lecture_sha256"] = ecrire(args.ecrire, lecture)
+    imprimer({"issue": lecture["issue"], "texte": corps["regle"].get("texte"), "noeuds": corps["regle"].get("noeuds_avant_banc"),
+              "ecarts_de_cout": {n: v["ecart_usd"] for n, v in lecture["couts"].items()}})
+    return 0
+
+
+def principal(argv=None):
+    a = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    s = a.add_subparsers(dest="commande", required=True)
+    x = s.add_parser("secret")
+    x.add_argument("chemin")
+    x = s.add_parser("generer")
+    x.add_argument("--secret", required=True)
+    x.add_argument("--phrase-fichier", required=True)
+    x.add_argument("--texte-sha256", required=True)
+    x.add_argument("--sortie", required=True)
+    x = s.add_parser("preparer")
+    x.add_argument("--mondes", required=True)
+    x.add_argument("--mondes-sha256", required=True)
+    x = s.add_parser("jouer")
+    x.add_argument("--mode", required=True)
+    x.add_argument("--mondes", required=True)
+    x.add_argument("--mondes-sha256", required=True)
+    x.add_argument("--configuration", default=CONFIGURATION)
+    x.add_argument("--sortie", required=True)
+    x.add_argument("--scenarios", default="")
+    for o in ("--go-pi1", "--go-pi2", "--registre-go", "--texte", "--texte-sha256"):
+        x.add_argument(o, default=None)
+    x = s.add_parser("lire")
+    x.add_argument("--sortie-mesure", required=True)
+    x.add_argument("--releve", required=True)
+    x.add_argument("--journaux", default=None)
+    x.add_argument("--ecrire", default=None)
+    x = s.add_parser("relire")
+    x.add_argument("--cartes", required=True)
+    x = s.add_parser("rapatrier")
+    x.add_argument("--source", required=True)
+    x.add_argument("--destination", required=True)
+    x.add_argument("--mondes-sha256", default=None)
+    s.add_parser("bloc")
+    args = a.parse_args(argv)
+    try:
+        if args.commande == "secret":
+            imprimer({"secret_sha256": P.tirer_secret(args.chemin)})
+        elif args.commande == "generer":
+            secret = P.lire_secret(args.secret)
+            with open(args.phrase_fichier, encoding="utf-8") as f:
+                phrase = f.read().rstrip("\n")
+            mondes, ctl = P.generer_mondes(secret, phrase, args.texte_sha256)
+            sha = P.ecrire_prive(args.sortie, mondes, [os.path.dirname(os.path.abspath(args.secret))])  # liste blanche : le dossier du secret
+            imprimer({"fichier_mondes_sha256": sha, "controles": ctl})
+        elif args.commande == "preparer":
+            _, _, _, ctl = preparer_les_mondes(args.mondes, args.mondes_sha256)
+            imprimer(ctl)
+        elif args.commande == "jouer":
+            return jouer(args)
+        elif args.commande == "lire":
+            return lire(args)
+        elif args.commande == "relire":
+            imprimer(AU.cartes_a_relire(args.cartes))
+        elif args.commande == "rapatrier":
+            imprimer(AU.rapatrier(args.source, args.destination, args.mondes_sha256))
+        elif args.commande == "bloc":
+            sys.stdout.write(bloc_gele())
+    except P.Refus as e:
+        print(f"refus : {e}", file=sys.stderr)
+        return 2
+    except PR.ArretPilote as e:
+        print(f"arrêt : {e}", file=sys.stderr)
+        return 3
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(principal())
