+def conf_ports_libres(d):
+    """La configuration v9 copiée avec des ports libres (essais parallèles à d'autres processus de la machine)."""
+    import socket
+    conf, dossier = PR.lire_configuration(CONF)
+    for p in conf["proposeurs"].values():
+        s = socket.socket()
+        s.bind(("127.0.0.1", 0))
+        p["port"] = s.getsockname()[1]
+        s.close()
+    return conf
+
