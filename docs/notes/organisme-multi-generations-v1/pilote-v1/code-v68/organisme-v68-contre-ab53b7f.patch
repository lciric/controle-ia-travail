+
+
+def verifier_fichiers_mr2(racine=RACINE_MR2, attendues=None):
+    """Chaque fichier porté égal à son compagnon, et à l'empreinte écrite ici quand elle l'est ; rend {chemin relatif : sha}."""
+    attendues = FICHIERS_MR2 if attendues is None else attendues
+    out = {}
+    for rel, ecrite in sorted(attendues.items()):
+        f = os.path.join(racine, rel)
+        if not os.path.isfile(f):
+            raise Refus(f"outil MR-2 absent : {rel}")
+        sha = sha256_fichier(f)
+        if _compagnon(f) != sha:
+            raise Refus(f"outil MR-2 différent de son compagnon : {rel}")
+        if ecrite is not None and ecrite != sha:
+            raise Refus(f"outil MR-2 {rel} : empreinte ≠ celle écrite dans le code v68")
+        out[rel] = sha
+    return out
+
+
+def charger_mr2():
+    """(V4, M, MP) : `monde_riche_v4`, `monde_riche_outils_v1` (modifié par V4 à l'import, comme dans le dépôt de travail) et
+    `mesure_pilote_v4`, depuis `orchestrator/mr2_v68/` seulement ; refus si un module de même nom vient d'ailleurs."""
+    if _MR2:
+        return _MR2["V4"], _MR2["M"], _MR2["MP"]
+    verifier_fichiers_mr2()
+    for d in ("outils-v4", os.path.join("pilote-v1", "outils")):
+        p = os.path.join(RACINE_MR2, d)
+        if p not in sys.path:
+            sys.path.insert(0, p)
+    for nom in MODULES_MR2 + ("monde_riche_outils_v1",):
+        m = sys.modules.get(nom)
+        if m is not None and not os.path.abspath(getattr(m, "__file__", "")).startswith(RACINE_MR2 + os.sep):
+            raise Refus(f"module {nom} déjà chargé hors de mr2_v68 : {getattr(m, '__file__', None)}")
+    import monde_riche_v4 as V4  # noqa: E402
+    import mesure_pilote_v4 as MP  # noqa: E402
+    for mod in (V4, MP, V4.M):
+        if not os.path.abspath(mod.__file__).startswith(RACINE_MR2 + os.sep):
+            raise Refus(f"module {mod.__name__} chargé hors de mr2_v68")
+    _MR2.update(V4=V4, M=V4.M, MP=MP)
+    return V4, V4.M, MP
+
+
+def sans_chemin_v52b(fonction, *args, **kwargs):
+    """`verifier_monde_kimi_v1.controler_grammaire` (porté tel quel) insère un chemin du dépôt de travail en tête de `sys.path` ;
+    on rend `sys.path` tel qu'il était après l'appel (l'import de `pole` y reste celui de l'arbre déjà chargé)."""
+    avant = list(sys.path)
+    try:
+        return fonction(*args, **kwargs)
+    finally:
+        sys.path[:] = avant
+
+
+def sha_spec(spec):
+    _, M, _ = charger_mr2()
+    return hashlib.sha256(M.json_canonique(spec)).hexdigest()
+
+
+# --- C-1, C-2 : monde privé hors de l'arbre, manifeste sans loi -----------------------------------------------------------------
+
+def dans_un_depot(chemin):
+    """Vrai si `chemin` est sous un dossier qui porte un `.git` (fichier ou dossier) : « dans un dépôt »."""
+    d = os.path.dirname(os.path.realpath(chemin))
+    while True:
+        if os.path.exists(os.path.join(d, ".git")):
+            return True
+        parent = os.path.dirname(d)
+        if parent == d:
+            return False
+        d = parent
+
+
+def exiger_hors_depot(chemin, quoi):
+    if not os.path.isabs(chemin):
+        raise Refus(f"{quoi} : chemin absolu exigé")
+    reel = os.path.realpath(chemin)
+    racine_arbre = os.path.realpath(os.path.dirname(RACINE_ORCHESTRATEUR))
+    if reel == racine_arbre or reel.startswith(racine_arbre + os.sep):
+        raise Refus(f"{quoi} : dans l'arbre de l'organisme")
+    if dans_un_depot(reel):
+        raise Refus(f"{quoi} : dans un dépôt git (un dossier parent porte .git)")
+
+
+def charger_mondes_prives(chemin, sha_attendue, shas_mondes=None):
+    """C-1 : MONDES.json lu hors de tout dépôt, chemin donné au lancement ; empreinte du fichier = celle du registre ; 4 mondes
+    {monde, spec, spec_sha256}, numéros 1 à 4, empreinte de chaque devis recalculée (et égale à la liste du registre si donnée).
+    Rend la liste telle que lue (format du programme de la mesure)."""
+    exiger_hors_depot(chemin, "fichier des mondes")
+    if not isinstance(sha_attendue, str) or not re.fullmatch(r"[0-9a-f]{64}", sha_attendue):
+        raise Refus("empreinte attendue du fichier des mondes : 64 chiffres hexadécimaux")
+    if not os.path.isfile(chemin):
+        raise Refus("fichier des mondes absent")
+    if sha256_fichier(chemin) != sha_attendue:
+        raise Refus("fichier des mondes : empreinte ≠ celle du registre")
+    with open(chemin, encoding="utf-8") as f:
+        mondes = json.load(f)
+    if not isinstance(mondes, list) or len(mondes) != len(MONDES_PILOTE):
+        raise Refus(f"fichier des mondes : exactement {len(MONDES_PILOTE)} mondes")
+    vus = set()
+    for w in mondes:
+        if not isinstance(w, dict) or set(w) != {"monde", "spec", "spec_sha256"} or w["monde"] not in MONDES_PILOTE \
+                or isinstance(w["monde"], bool) or w["monde"] in vus:
+            raise Refus("monde : clés {monde, spec, spec_sha256}, numéros 1 à 4 une fois chacun")
+        vus.add(w["monde"])
+        if sha_spec(w["spec"]) != w["spec_sha256"]:
+            raise Refus(f"monde {w['monde']} : empreinte du devis différente")
+        exiger_dimensions(w["spec"])
+    if shas_mondes is not None and sorted(shas_mondes) != sorted(w["spec_sha256"] for w in mondes):
+        raise Refus("empreintes des mondes ≠ celles du registre")
+    return sorted(mondes, key=lambda w: w["monde"])
+
+
+CLES_INTERDITES_MANIFESTE = {"loi_vraie", "loi", "spec", "effets", "composante_condition", "pente", "poids", "biais", "decalage"}
+
+
+def exiger_manifeste_sans_loi(objet, chemin="$"):
+    """C-2 : le manifeste ne porte que des empreintes du monde ; toute clé qui dirait une loi ou un devis est refusée."""
+    if isinstance(objet, dict):
+        for k, v in objet.items():
+            if k in CLES_INTERDITES_MANIFESTE:
+                raise Refus(f"manifeste : clé interdite {chemin}.{k} (aucune loi, aucun devis du monde au manifeste)")
+            exiger_manifeste_sans_loi(v, f"{chemin}.{k}")
+    elif isinstance(objet, list):
+        for i, v in enumerate(objet):
+            exiger_manifeste_sans_loi(v, f"{chemin}[{i}]")
+
+
+def monde_au_manifeste(mondes, sha_fichier):
+    m = {"fichier_mondes_sha256": sha_fichier, "mondes_sha256": {str(w["monde"]): w["spec_sha256"] for w in mondes}}
+    exiger_manifeste_sans_loi(m)
+    return m
