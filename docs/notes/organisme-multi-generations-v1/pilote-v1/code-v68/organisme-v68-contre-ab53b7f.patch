+"""Commande externe d'un proposeur du pilote MR-2 (code v68, C-7, C-8, C-10) — fichier neuf. Bibliothèque standard seule.
+
+Un appel, une session neuve : la consigne arrive sur l'entrée standard ; la commande la pose au **relais local** de son
+proposeur (`relais_pilote_v68.py`, 127.0.0.1 seulement, jamais de mandataire ; le relais tient la clé, le plafond du relais,
+les modèles permis), écrit **la réponse entière du relais** (corps du fournisseur tel quel, en-têtes, empreintes de ce que le
+relais a reçu et envoyé) dans `--sortie-brute` avec son compagnon `.sha256`, **avant toute lecture**, puis lit la réponse selon
+le dialecte du fournisseur et rend une dernière ligne JSON.
+
+Garde avant envoi : pire cas = (octets de la consigne + 1024) × prix d'entrée + borne de sortie × prix de sortie ≤
+`PLAFOND_SESSION_USD` ; sinon refus sans envoi (code 4). La borne de sortie est **fixe** (configuration gelée, C-7) : elle n'est
+jamais réduite pour tenir le plafond (une réponse coupée à une autre borne ne serait pas celle du texte). La réflexion compte
+dans la sortie (Claude : `output_tokens` ; Argon : `candidatesTokenCount` + `thoughtsTokenCount` ; Astra : à confirmer).
+
+États rendus (champ `etat` de la dernière ligne, code 0) : `complet` (raison d'arrêt normale), `tronque` (raison d'arrêt =
+borne de sortie). Tout le reste est un échec, avec son code : 2 réglage ou entrée refusés (rien envoyé) ; 3 relais (connexion,
+HTTP, relais non branché) ; 4 pire cas au-dessus du plafond de session (rien envoyé) ; 5 réponse non conforme (refus du modèle,
+modèle servi différent, usage absent, corps illisible, raison d'arrêt inconnue, coût au-dessus du pire cas) ; 6 délai.
+
+Dialectes (C-8) :
+- `claude` (API Messages) : `model` ; `stop_reason` (`end_turn`, `stop_sequence` → complet ; `max_tokens` → tronqué ;
+  `refusal` → refus, code 5 ; autre → code 5) ; `usage.input_tokens`, `usage.output_tokens` (réflexion comprise) ; texte =
+  blocs `text` de `content`.
+- `gemini` (Argon, generateContent) : `modelVersion` ; `candidates[0].finishReason` (`STOP` → complet ; `MAX_TOKENS` →
+  tronqué ; `SAFETY`, `RECITATION`, `PROHIBITED_CONTENT`, `BLOCKLIST`, `SPII` → refus ; autre → code 5) ;
+  `usageMetadata.promptTokenCount`, `candidatesTokenCount`, `thoughtsTokenCount` ; texte = parties `text` non marquées
+  `thought`.
+- `astra` : **[CHAMPS-ASTRA] à confirmer** — lu ici comme une réponse de « chat completions » (`model` ;
+  `choices[0].finish_reason` `stop` → complet, `length` → tronqué, `content_filter` → refus ; `usage.prompt_tokens`,
+  `usage.completion_tokens` (réflexion comprise), `usage.completion_tokens_details.reasoning_tokens`) : hypothèse du
+  développeur, que le lanceur refuse en mode réel tant que la configuration dit « à confirmer ».
+
+Usage : python3 -I -B commande_pilote_v68.py --url-relais http://127.0.0.1:PORT --modele M --dialecte claude|gemini|astra
+            --prix-entree PE --prix-sortie PS --borne-sortie N --delai-s S --sortie-brute FICHIER
+Environnement lu : PLAFOND_SESSION_USD, ROLE_POLE (= proposeur_ideation), MODELE_DEMANDE_POLE (= --modele).
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import signal
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+VERSION = "commande-pilote-v68"
+ROLE = "proposeur_ideation"
+PLANCHER = 1e-6
+DIALECTES = ("claude", "gemini", "astra")
+COMPLET = {"claude": ("end_turn", "stop_sequence"), "gemini": ("STOP",), "astra": ("stop",)}
+TRONQUE = {"claude": ("max_tokens",), "gemini": ("MAX_TOKENS",), "astra": ("length",)}
+REFUS = {"claude": ("refusal",), "gemini": ("SAFETY", "RECITATION", "PROHIBITED_CONTENT", "BLOCKLIST", "SPII"),
+         "astra": ("content_filter",)}
+
+
+def rendre(code, **champs):
+    champs.setdefault("cout_usd", PLANCHER)
+    c = champs["cout_usd"]
+    champs["cout_usd"] = round(float(c), 8) if isinstance(c, (int, float)) and math.isfinite(c) and c > 0 else PLANCHER
+    print(json.dumps(dict(champs, version=VERSION, code=code), ensure_ascii=False, sort_keys=True))
+    sys.stdout.flush()
+    sys.exit(code)
+
+
+def lire_arguments(argv):
+    a = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    a.add_argument("--url-relais", required=True)
+    a.add_argument("--modele", required=True)
+    a.add_argument("--dialecte", required=True, choices=DIALECTES)
+    a.add_argument("--prix-entree", type=float, required=True)
+    a.add_argument("--prix-sortie", type=float, required=True)
+    a.add_argument("--borne-sortie", type=int, required=True)
+    a.add_argument("--delai-s", type=float, required=True)
+    a.add_argument("--sortie-brute", required=True)
+    return a.parse_args(argv)
+
+
+def verifier_url(url):
+    u = urllib.parse.urlsplit(url)
+    if u.scheme != "http" or u.hostname not in ("127.0.0.1", "localhost") or u.path not in ("", "/") or not u.port:
+        raise ValueError("--url-relais : http://127.0.0.1:PORT seulement (le relais local tient la clé)")
+    return url.rstrip("/") + "/appel"
+
+
+def modele_conforme(demande, servi):
+    """Identifiant exact, ou suivi d'un suffixe de date (8 chiffres, « -20261101 ») ou de révision (3 chiffres, « -001 ») ;
+    jamais un autre identifiant qui commence comme lui (« claude-opus-5 » ≠ « claude-opus-5-5 »)."""
+    if not isinstance(servi, str) or not servi:
+        return False
+    if servi == demande:
+        return True
+    reste = servi[len(demande):] if servi.startswith(demande + "-") else None
+    return bool(reste) and reste[1:].isdigit() and len(reste) in (4, 9)
+
+
+def _entier(x):
+    return isinstance(x, int) and not isinstance(x, bool) and x >= 0
+
+
+def lire_dialecte(dialecte, corps):
+    """(texte, raison d'arrêt, modèle servi, jetons {entree, sortie, reflexion}) ; lève ValueError si illisible."""
+    if dialecte == "claude":
+        u = corps["usage"]
+        texte = "".join(b.get("text", "") for b in corps["content"] if isinstance(b, dict) and b.get("type") == "text")
+        jetons = {"entree": u["input_tokens"], "sortie": u["output_tokens"], "reflexion": None}
+        return texte, corps["stop_reason"], corps.get("model"), jetons
+    if dialecte == "gemini":
+        c = corps["candidates"][0]
+        u = corps["usageMetadata"]
+        parts = (c.get("content") or {}).get("parts") or []
+        texte = "".join(p.get("text", "") for p in parts if isinstance(p, dict) and not p.get("thought"))
+        cand, pensee = u.get("candidatesTokenCount", 0), u.get("thoughtsTokenCount", 0)
+        if not (_entier(cand) and _entier(pensee)):
+            raise ValueError("usage Argon illisible")
+        jetons = {"entree": u["promptTokenCount"], "sortie": cand + pensee, "reflexion": pensee}
+        return texte, c.get("finishReason"), corps.get("modelVersion"), jetons
+    # astra : [CHAMPS-ASTRA], hypothèse « chat completions » (à confirmer)
+    ch = corps["choices"][0]
+    u = corps["usage"]
+    det = u.get("completion_tokens_details") or {}
+    jetons = {"entree": u["prompt_tokens"], "sortie": u["completion_tokens"], "reflexion": det.get("reasoning_tokens")}
+    return (ch.get("message") or {}).get("content") or "", ch.get("finish_reason"), corps.get("model"), jetons
+
+
+def ecrire_brut(chemin, octets):
+    """La réponse entière du relais, écrite et scellée avant toute lecture (C-10) ; jamais d'écrasement."""
+    fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "wb") as f:
+        f.write(octets)
+    sha = hashlib.sha256(octets).hexdigest()
+    with open(chemin + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha}  {os.path.basename(chemin)}\n")
+    return sha
+
+
+def principal(argv, environ, entree):
+    try:
+        args = lire_arguments(argv)
+        cible = verifier_url(args.url_relais)
+        plafond = float(environ.get("PLAFOND_SESSION_USD", "nan"))
+        if not (math.isfinite(plafond) and plafond > 0):
+            raise ValueError("PLAFOND_SESSION_USD absent ou invalide")
+        if environ.get("ROLE_POLE") != ROLE:
+            raise ValueError(f"ROLE_POLE {environ.get('ROLE_POLE')!r} : {ROLE} seulement")
+        if environ.get("MODELE_DEMANDE_POLE") != args.modele:
+            raise ValueError("MODELE_DEMANDE_POLE ≠ --modele")
+        if not (args.borne_sortie > 0 and args.prix_entree > 0 and args.prix_sortie > 0 and args.delai_s > 0):
+            raise ValueError("borne de sortie, prix et délai > 0")
+        if os.path.exists(args.sortie_brute):
+            raise ValueError("--sortie-brute existe déjà (session neuve exigée)")
+        consigne = entree.read()
+        if not consigne.strip():
+            raise ValueError("consigne vide")
+    except (ValueError, SystemExit) as e:
+        rendre(2, etat="echec", erreur=str(e)[:300], envoye=False)
+    octets = len(consigne.encode("utf-8"))
+    pire = (octets + 1024) * args.prix_entree / 1e6 + args.borne_sortie * args.prix_sortie / 1e6
+    diag = {"modele_demande": args.modele, "dialecte": args.dialecte, "borne_sortie": args.borne_sortie,
+            "pire_cas_usd": round(pire, 8), "consigne_sha256": hashlib.sha256(consigne.encode("utf-8")).hexdigest()}
+    if pire > plafond + 1e-12:
+        rendre(4, etat="echec", erreur=f"pire cas {pire:.4f} USD au-dessus du plafond de session {plafond} USD", envoye=False,
+               **diag)
+
+    def interrompu(signum, _cadre):
+        rendre(6, etat="echec", cout_usd=pire, cout_origine="pire_cas", erreur=f"signal {signum}", envoye=True, **diag)
+    signal.signal(signal.SIGTERM, interrompu)
+
+    corps = json.dumps({"modele": args.modele, "consigne": consigne, "max_tokens": args.borne_sortie,
+                        "pire_cas_usd": pire}, ensure_ascii=False).encode("utf-8")
+    ouvreur = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    requete = urllib.request.Request(cible, data=corps, method="POST", headers={"Content-Type": "application/json"})
+    try:
+        with ouvreur.open(requete, timeout=args.delai_s) as r:
+            brut = r.read()
+    except urllib.error.HTTPError as e:
+        octets_err = e.read()
+        sha = ecrire_brut(args.sortie_brute, octets_err)
+        avant = e.code in (402, 429, 501)  # refus du relais lui-même (plafond, nombre d'appels, voie non branchée)
+        rendre(3, etat="echec", cout_usd=PLANCHER if avant else pire, cout_origine="plancher" if avant else "pire_cas",
+               erreur=f"relais HTTP {e.code}", envoye=not avant, brut_sha256=sha, **diag)
+    except urllib.error.URLError as e:
+        if isinstance(e.reason, ConnectionRefusedError):
+            rendre(3, etat="echec", erreur="relais injoignable (connexion refusée)", envoye=False, **diag)
+        rendre(3, etat="echec", cout_usd=pire, cout_origine="pire_cas", erreur=f"URLError : {str(e.reason)[:200]}", envoye=True,
+               **diag)
+    except (TimeoutError, OSError) as e:
+        rendre(6 if isinstance(e, TimeoutError) else 3, etat="echec", cout_usd=pire, cout_origine="pire_cas",
+               erreur=f"{type(e).__name__} : {str(e)[:200]}", envoye=True, **diag)
+    sha = ecrire_brut(args.sortie_brute, brut)
+    diag["brut_sha256"] = sha
+    try:
+        rep = json.loads(brut)
+        temoin = {k: rep[k] for k in ("relais", "consigne_recue_sha256", "corps_amont_sha256", "outils", "messages", "systeme",
+                                      "appelant")}
+        texte, raison, servi, jetons = lire_dialecte(args.dialecte, rep["corps"])
+        if not (_entier(jetons["entree"]) and _entier(jetons["sortie"])):
+            raise ValueError("usage absent")
+    except (ValueError, KeyError, IndexError, TypeError, AttributeError) as e:
+        rendre(5, etat="echec", cout_usd=pire, cout_origine="pire_cas", erreur=f"réponse illisible : {str(e)[:200]}",
+               envoye=True, **diag)
+    cout = (jetons["entree"] * args.prix_entree + jetons["sortie"] * args.prix_sortie) / 1e6
+    diag.update(temoin_relais=temoin, raison_arret=raison, modele_servi=servi, jetons=jetons, cout_origine="usage",
+                envoye=True)
+    if cout > pire + 1e-9:
+        rendre(5, etat="echec", cout_usd=cout, erreur="coût lu au-dessus du pire cas", **diag)
+    if not modele_conforme(args.modele, servi):
+        rendre(5, etat="echec", cout_usd=cout, erreur=f"modèle servi {servi!r} ≠ {args.modele!r}", **diag)
+    if raison in REFUS[args.dialecte]:
+        rendre(5, etat="echec", cout_usd=cout, refus=True, erreur=f"refus du modèle ({raison})", **diag)
+    if raison in TRONQUE[args.dialecte]:
+        rendre(0, etat="tronque", texte=texte, cout_usd=cout, **diag)
+    if raison in COMPLET[args.dialecte]:
+        rendre(0, etat="complet", texte=texte, cout_usd=cout, **diag)
+    rendre(5, etat="echec", cout_usd=cout, erreur=f"raison d'arrêt inconnue {raison!r}", **diag)
+
+
+if __name__ == "__main__":
+    principal(sys.argv[1:], dict(os.environ), sys.stdin)
