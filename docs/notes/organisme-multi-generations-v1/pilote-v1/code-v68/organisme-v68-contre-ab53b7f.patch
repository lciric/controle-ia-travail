+    M("M21-gabarit-dit-les-conditions", PC, "Au-delà de la {n}e, une loi est refusée.",
+      "Au-delà de la {n}e, une loi est refusée. Le monde peut avoir des composantes conditionnelles.", "C6Gabarit",
+      "test_sain_rien_sur_les_conditions_du_monde"),
+    M("M22-evaluateur-de-la-mesure-non-compare", PC, "float(np.max(np.abs(Q - P))) > TOLERANCE_EVALUATEUR",
+      "float(np.max(np.abs(Q - P))) > 1.0", "C5Gardien", "test_artefact_jeu_factice"),
+    M("M23-borne-non-payee", PR, "        if b > bmax:\n", "        if False:\n", "Configuration", "test_artefacts"),
+    M("M24-part-libre", PR, 'abs(p["part_usd"] - 4 * p["plafond_session_usd"]) > 1e-9', 'abs(p["part_usd"] - 4 * p["plafond_session_usd"]) > 10',
+      "Configuration", "test_artefacts"),
+    M("M25-go-identiques", PR, "if go_pi1 == go_pi2:", "if False:", "Configuration", "test_go_pi1_pi2"),
+    M("M26-a-confirmer-ignore", PR, "    if restes:\n", "    if False:\n", "Configuration or mode_reel", "test_sain"),
+    M("M27-temoin-faux-admis", PR, '    if temoin["conforme"] is False:\n', "    if False:\n", "C7C8C10Appel",
+      "test_artefact_temoin_faux_et_sans_derniere_ligne"),
+    M("M28-sans-derniere-ligne", PR, "    if derniere is None:\n        raise", "    if False:\n        raise", "C7C8C10Appel",
+      "test_artefact_temoin_faux_et_sans_derniere_ligne"),
+    M("M29-session-reutilisee", PR, "    if os.path.exists(dossier_appel):\n", "    if False:\n", "C7C8C10Appel",
+      "test_artefact_session_existante"),
+    M("M30-panne-non-abandonnee", LA, '                if r["panne"]:\n', "                if False:\n", "EssaiABlanc", "test_lanceur"),
+    M("M31-part-non-tenue", LA, 'if depense[nom] + p["plafond_session_usd"] > p["part_usd"] + 1e-9:', "if False:", "EssaiABlanc",
+      "test_part_atteinte_arret"),
+    M("M32-lecture-corps-non-verifie", LA, '.hexdigest() != s["corps_sha256"]:', '.hexdigest() == "x":', "EssaiABlanc",
