+"""Proposeurs du pilote MR-2 — code v68 (fichier neuf, R12) : configuration v9, bornes de sortie, parts et lignes de GO (C-7,
+C-9), appel d'un proposeur par sa commande, réponse brute et témoin d'isolement scellés avant l'extraction (C-8, C-10), relais
+lancés et arrêtés par leur PID (R10). Aucun réseau ici (la commande parle au relais local) ; aucune clé lue.
+
+États d'un appel (texte, section « Métrique ») : `complet`, `tronque`, `echec`. Règles de la liste d'arrêt :
+- panne d'un relais (codes 2, 3, 4, 6 de la commande : réglage, relais injoignable ou en erreur, plafond, délai) → l'appel est
+  `echec`, **le proposeur est abandonné** (ses appels restants sont `echec`, aucune reprise, aucune bascule) ;
+- réponse non conforme (code 5 : refus du modèle, modèle servi différent, usage absent, corps illisible) → l'appel est `echec`,
+  le proposeur continue (lecture du développeur : « panne d'un relais » ne vise que le relais ; question ouverte au rapport) ;
+- réponse brute ou témoin d'isolement absent ou faux → `ArretPilote` (code 3), pièces versées ;
+- dépense d'un proposeur qui atteindrait sa part au pire cas de l'appel suivant → `ArretPilote` (code 3).
+"""
+
+import hashlib
+import json
+import math
+import os
+import subprocess
+import time
+
+from .outils import json_canonique, sha256_fichier
+from .pilote_mr2_v68 import PROPOSEURS, Refus
+
+VERSION = "proposeurs-pilote-v68"
+ROLE = "proposeur_ideation"
+CODES_PANNE = (2, 3, 4, 6)
+CHAMPS_PROPOSEUR = {"modele", "dialecte", "credits", "plafond_session_usd", "borne_sortie_jetons", "prix_entree_usd_par_million",
+                    "prix_sortie_usd_par_million", "part_usd", "delai_s", "port", "a_confirmer"}
+DIALECTES = {"claude": "claude", "gemini": "gemini", "astra": "astra"}
+
+
+class ArretPilote(RuntimeError):
+    """Arrêt (code 3) : pièces versées, rien n'est lu."""
+
+
+def borne_de_sortie_max(plafond, prix_entree, prix_sortie, octets_entree_max):
+    """La plus grande borne de sortie que le plafond de session paie au pire cas de la commande (entrée comptée en octets + 1024,
+    un jeton d'entrée au moins un octet) pour un texte servi d'au plus `octets_entree_max` octets."""
+    reste = plafond - (octets_entree_max + 1024) * prix_entree / 1e6
+    return int(math.floor(reste * 1e6 / prix_sortie)) if reste > 0 else 0
+
+
+def lire_configuration(chemin):
+    """Configuration v9 : rend (conf, dossier) après contrôles (C-7, C-9) : quatre proposeurs nommés, champs exacts, bornes
+    payées par le plafond de session au pire cas, part = 4 plafonds de session, parts par ligne de GO égales aux montants,
+    commande et relais égaux à leurs empreintes."""
+    dossier = os.path.dirname(os.path.abspath(chemin))
+    with open(chemin, encoding="utf-8") as f:
+        conf = json.load(f)
+    if conf.get("version") != "configuration-pilote-mr2-v9":
+        raise Refus("configuration : version « configuration-pilote-mr2-v9 » exigée")
+    props = conf.get("proposeurs")
+    if not isinstance(props, dict) or tuple(sorted(props)) != tuple(sorted(PROPOSEURS)):
+        raise Refus(f"configuration : proposeurs exactement {PROPOSEURS}")
+    omax = conf.get("octets_entree_max")
+    if not (isinstance(omax, int) and omax > 0):
+        raise Refus("configuration : octets_entree_max entier > 0")
+    ports = set()
+    for nom, p in props.items():
+        if set(p) != CHAMPS_PROPOSEUR:
+            raise Refus(f"configuration, {nom} : champs exacts {sorted(CHAMPS_PROPOSEUR)}")
+        if p["dialecte"] not in DIALECTES:
+            raise Refus(f"configuration, {nom} : dialecte inconnu")
+        for k in ("plafond_session_usd", "prix_entree_usd_par_million", "prix_sortie_usd_par_million", "part_usd", "delai_s"):
+            if not (isinstance(p[k], (int, float)) and not isinstance(p[k], bool) and math.isfinite(p[k]) and p[k] > 0):
+                raise Refus(f"configuration, {nom} : {k} > 0")
+        b = p["borne_sortie_jetons"]
+        if not (isinstance(b, int) and not isinstance(b, bool) and b > 0):
+            raise Refus(f"configuration, {nom} : borne de sortie entière > 0")
+        bmax = borne_de_sortie_max(p["plafond_session_usd"], p["prix_entree_usd_par_million"], p["prix_sortie_usd_par_million"], omax)
+        if b > bmax:
+            raise Refus(f"configuration, {nom} : borne de sortie {b} > {bmax}, que le plafond de session paie au pire cas")
+        if abs(p["part_usd"] - 4 * p["plafond_session_usd"]) > 1e-9:
+            raise Refus(f"configuration, {nom} : part ≠ 4 × plafond de session (un appel par monde)")
+        if not (isinstance(p["port"], int) and 1024 <= p["port"] <= 65535) or p["port"] in ports:
+            raise Refus(f"configuration, {nom} : port distinct dans [1024 ; 65535]")
+        ports.add(p["port"])
+        if not isinstance(p["a_confirmer"], list):
+            raise Refus(f"configuration, {nom} : a_confirmer, liste")
+    go = conf.get("go")
+    if not isinstance(go, dict) or set(go) != {"pi1", "pi2"}:
+        raise Refus("configuration : go {pi1, pi2}")
+    vus = []
+    for ligne, g in go.items():
+        parts = g.get("parts_usd")
+        if not isinstance(parts, dict) or not parts:
+            raise Refus(f"configuration, go {ligne} : parts_usd")
+        if round(sum(parts.values()) * 100) != round(g.get("montant_usd", -1) * 100):
+            raise Refus(f"configuration, go {ligne} : somme des parts ≠ montant")
+        for k, v in parts.items():
+            if k in props and abs(v - props[k]["part_usd"]) > 1e-9:
+                raise Refus(f"configuration, go {ligne} : part de {k} ≠ part du proposeur")
+            vus.append(k)
+    if sorted(k for k in vus if k in props) != sorted(PROPOSEURS):
+        raise Refus("configuration : chaque proposeur dans une seule ligne de GO")
+    for cle in ("commande", "relais"):
+        piece = conf.get(cle) or {}
+        f = os.path.normpath(os.path.join(dossier, piece.get("chemin", "")))
+        if not f.startswith(dossier + os.sep) or os.path.isabs(piece.get("chemin", "/")) or not os.path.isfile(f):
+            raise Refus(f"configuration : {cle} sous le dossier de la configuration")
+        if sha256_fichier(f) != piece.get("sha256"):
+            raise Refus(f"configuration : {cle} ≠ son empreinte")
+        piece["chemin_absolu"] = f
+    return conf, dossier
+
+
+def exiger_confirme(conf):
+    """Mode réel : aucun « à confirmer » (identifiant, prix, champs d'Astra ; voie d'accès aux crédits de Claude)."""
+    restes = {n: p["a_confirmer"] for n, p in conf["proposeurs"].items() if p["a_confirmer"]}
+    if restes:
+        raise Refus(f"configuration : points à confirmer avant le mode réel : {restes}")
+
+
+def lire_go_du_pilote(conf, registre, go_pi1, go_pi2, aujourd_hui=None):
+    """C-9 : les deux lignes π1 (crédits de Claude) et π2 (hors crédits), lues par le lecteur v66 au montant **exact** de la
+    configuration ; deux identifiants distincts."""
+    from .registre_go_v66 import GoRefuse, verifier_go_v66
+    if go_pi1 == go_pi2:
+        raise Refus("GO : π1 et π2 distincts")
+    out = {}
+    for ligne, ident in (("pi1", go_pi1), ("pi2", go_pi2)):
+        try:
+            out[ligne] = verifier_go_v66(ident, registre, conf["go"][ligne]["montant_usd"], aujourd_hui=aujourd_hui)
+        except GoRefuse as e:
+            raise Refus(f"GO {ligne} : {e}") from None
+    return out
+
+
+def commande_d_un_proposeur(conf, nom, sortie_brute, python="/usr/bin/python3"):
+    p = conf["proposeurs"][nom]
+    return [python, "-I", "-B", conf["commande"]["chemin_absolu"], "--url-relais", f"http://127.0.0.1:{p['port']}",
+            "--modele", p["modele"], "--dialecte", p["dialecte"], "--prix-entree", repr(p["prix_entree_usd_par_million"]),
+            "--prix-sortie", repr(p["prix_sortie_usd_par_million"]), "--borne-sortie", str(p["borne_sortie_jetons"]),
+            "--delai-s", repr(float(p["delai_s"]) - conf.get("delai_marge_s", 30)), "--sortie-brute", sortie_brute]
+
+
+def _derniere_ligne(stdout):
+    for ligne in reversed((stdout or "").strip().splitlines()):
+        try:
+            o = json.loads(ligne)
+        except ValueError:
+            return None
+        return o if isinstance(o, dict) else None
+    return None
+
+
+def ecrire_scelle_json(chemin, objet):
+    octets = (json.dumps(objet, ensure_ascii=False, sort_keys=True, indent=1) + "\n").encode("utf-8")
+    with open(chemin, "xb") as f:
+        f.write(octets)
+    sha = hashlib.sha256(octets).hexdigest()
+    with open(chemin + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha}  {os.path.basename(chemin)}\n")
+    return sha
+
+
+def appeler(conf, nom, texte, dossier_appel, python="/usr/bin/python3", executer=subprocess.run):
+    """Un appel, une session neuve (C-10) : le dossier de l'appel est créé vide (il ne doit pas exister) ; la commande y tourne
+    (dossier courant vide, environnement minimal sans clé) ; la réponse brute (sortie entière de la commande, code, et le corps
+    du relais écrit par la commande) est **scellée avant toute extraction** ; le témoin d'isolement est écrit et scellé.
+    Rend le relevé de l'appel (état, coût, jetons, raison d'arrêt, empreintes, texte). Absence de réponse brute → ArretPilote."""
+    p = conf["proposeurs"][nom]
+    if os.path.exists(dossier_appel):
+        raise ArretPilote(f"{nom} : dossier de session existant (session neuve exigée)")
+    os.makedirs(dossier_appel)
+    session = os.path.join(dossier_appel, "session")
+    os.makedirs(session)
+    avant = sorted(os.listdir(session))
+    brut = os.path.join(dossier_appel, "corps-relais.json")
+    cmd = commande_d_un_proposeur(conf, nom, brut, python)
+    env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "PLAFOND_SESSION_USD": repr(float(p["plafond_session_usd"])),
+           "ROLE_POLE": ROLE, "MODELE_DEMANDE_POLE": p["modele"]}
+    sha_texte = hashlib.sha256(texte.encode("utf-8")).hexdigest()
+    debut = time.time()
+    try:
+        r = executer(cmd, input=texte, capture_output=True, text=True, cwd=session, env=env, timeout=float(p["delai_s"]))
+        code, sortie, erreur = r.returncode, r.stdout, r.stderr
+    except subprocess.TimeoutExpired as e:
+        code, sortie, erreur = 6, (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or ""), "délai de l'adaptateur"
+    duree = round(time.time() - debut, 3)
+    derniere = _derniere_ligne(sortie)
+    brut_sha = sha256_fichier(brut) if os.path.isfile(brut) else None
+    reponse = {"proposeur": nom, "code": code, "sortie_standard": sortie, "sortie_erreur": (erreur or "")[-4000:],
+               "derniere_ligne": derniere, "corps_relais": "corps-relais.json" if brut_sha else None,
+               "corps_relais_sha256": brut_sha, "duree_s": duree}
+    sha_rep = ecrire_scelle_json(os.path.join(dossier_appel, "reponse-brute.json"), reponse)
+    if derniere is None:
+        raise ArretPilote(f"{nom} : réponse brute sans dernière ligne JSON (code {code})")
+    if brut_sha is not None and derniere.get("brut_sha256") not in (None, brut_sha):
+        raise ArretPilote(f"{nom} : corps du relais ≠ empreinte rendue par la commande")
+    etat = derniere.get("etat") if code == 0 else "echec"
+    if etat not in ("complet", "tronque", "echec"):
+        raise ArretPilote(f"{nom} : état rendu inconnu {etat!r}")
+    tr = derniere.get("temoin_relais")
+    apres = sorted(os.listdir(session))
+    temoin = {"proposeur": nom, "relais_attendu": f"relais-pilote-v68-{nom}", "relais": (tr or {}).get("relais"),
+              "session_neuve": avant == [], "fichiers_ecrits_dans_la_session": apres,
+              "texte_servi_sha256": sha_texte, "texte_recu_sha256": (tr or {}).get("consigne_recue_sha256"),
+              "consigne_commande_sha256": derniere.get("consigne_sha256"),
+              "outils": (tr or {}).get("outils"), "messages": (tr or {}).get("messages"), "systeme": (tr or {}).get("systeme"),
+              "environnement_commande": sorted(env), "reponse_brute_sha256": sha_rep}
+    if tr is not None:
+        ok = (temoin["relais"] == temoin["relais_attendu"] and temoin["texte_recu_sha256"] == sha_texte
+              and temoin["consigne_commande_sha256"] == sha_texte and temoin["outils"] == [] and temoin["messages"] == 1
+              and temoin["systeme"] is None and temoin["session_neuve"] and apres == [])
+        temoin["conforme"] = ok
+    else:
+        temoin["conforme"] = None  # aucun corps rendu (échec avant le relais) : rien à attester sur l'amont
+    sha_tem = ecrire_scelle_json(os.path.join(dossier_appel, "temoin-isolement.json"), temoin)
+    if temoin["conforme"] is False:
+        raise ArretPilote(f"{nom} : témoin d'isolement non conforme")
+    if etat in ("complet", "tronque") and temoin["conforme"] is not True:
+        raise ArretPilote(f"{nom} : réponse rendue sans témoin d'isolement")
+    return {"proposeur": nom, "etat": etat, "code": code, "cout_usd": float(derniere.get("cout_usd") or 0.0),
+            "jetons": derniere.get("jetons"), "raison_arret": derniere.get("raison_arret"),
+            "modele_servi": derniere.get("modele_servi"), "erreur": derniere.get("erreur"), "duree_s": duree,
+            "reponse_brute_sha256": sha_rep, "temoin_sha256": sha_tem, "corps_relais_sha256": brut_sha,
+            "texte_servi_sha256": sha_texte, "panne": code in CODES_PANNE, "texte": derniere.get("texte") if etat != "echec" else None}
+
+
+# --- relais (essai à blanc et mode réel) : lancés, sondés, arrêtés par leur PID ---------------------------------------------------
+
+def lancer_relais(conf, nom, journal, appelant, python="/usr/bin/python3", env_relais=None):
+    """Lance le relais d'un proposeur ; rend (processus, état lu). `env_relais` : environnement du seul relais (mode réel : la
+    variable de clé y est passée par le poste, jamais lue ici) ; essai à blanc : vide."""
+    p = conf["proposeurs"][nom]
+    cmd = [python, "-I", "-B", conf["relais"]["chemin_absolu"], "--port", str(p["port"]), "--nom", nom, "--dialecte", p["dialecte"],
+           "--modele", p["modele"], "--plafond-usd", repr(float(p["part_usd"])), "--max-appels", "4",
+           "--prix-entree", repr(p["prix_entree_usd_par_million"]), "--prix-sortie", repr(p["prix_sortie_usd_par_million"]),
+           "--appelant", appelant, "--journal", journal, "--delai-amont-s", repr(float(p["delai_s"]) - 60)]
+    env = dict(env_relais or {}, PATH="/usr/bin:/bin", LANG="C.UTF-8")
+    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
+    ligne = proc.stdout.readline()
+    try:
+        info = json.loads(ligne)
+    except ValueError:
+        arreter_relais(proc)
+        raise Refus(f"relais {nom} : n'a pas démarré ({proc.stderr.read()[:300] if proc.poll() is not None else ''})") from None
+    return proc, info
+
+
+def etat_relais(conf, nom):
+    import urllib.request
+    p = conf["proposeurs"][nom]
+    ouvreur = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    with ouvreur.open(f"http://127.0.0.1:{p['port']}/relais/etat", timeout=10) as r:
+        return json.loads(r.read())
+
+
+def exiger_relais_prets(conf):
+    """Avant tout appel : chaque relais répond, est branché, sur le bon modèle, avec un plafond égal à la part, rien de réglé."""
+    out = {}
+    for nom in PROPOSEURS:
+        try:
+            e = etat_relais(conf, nom)
+        except OSError as x:
+            raise Refus(f"relais {nom} injoignable : {x}") from None
+        p = conf["proposeurs"][nom]
+        if not e.get("branche"):
+            raise Refus(f"relais {nom} : voie non branchée ({e.get('appelant')})")
+        if e.get("modele") != p["modele"] or abs(float(e.get("plafond_usd", -1)) - p["part_usd"]) > 1e-9 \
+                or e.get("appels") != 0 or e.get("regle_usd") != 0.0 or e.get("relais") != f"relais-pilote-v68-{nom}":
+            raise Refus(f"relais {nom} : modèle, plafond ≠ part, ou appels déjà faits")
+        out[nom] = {k: e[k] for k in ("relais", "appelant", "pid", "plafond_usd", "modele")}
+    return out
+
+
+def arreter_relais(proc):
+    """R10 : arrêt par le PID du processus lancé ici, jamais par motif."""
+    if proc.poll() is None:
+        os.kill(proc.pid, 15)
+        try:
+            proc.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            os.kill(proc.pid, 9)
+            proc.wait(timeout=10)
+    for f in (proc.stdout, proc.stderr):
+        if f:
+            f.close()
+    return proc.returncode
+
+
+def empreinte_configuration(conf):
+    c = json.loads(json.dumps(conf))
+    for cle in ("commande", "relais"):
+        c[cle].pop("chemin_absolu", None)
+    return hashlib.sha256(json_canonique(c)).hexdigest()
