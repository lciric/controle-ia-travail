+#!/usr/bin/env python3
+"""Relais local d'un proposeur du pilote MR-2 (code v68, C-7, C-9, C-10) — fichier neuf. Bibliothèque standard seule.
+
+Un relais par proposeur (Fable 5.2, Opus 5.5, Argon, Astra), chacun sur son port de la boucle locale (127.0.0.1), lancé sous
+`env -i` avec, **dans son seul environnement**, la variable de clé de son fournisseur (jamais en argument, jamais en fichier,
+jamais écrite au journal) ; arrêt par son PID (R10). Il tient : le plafond du relais (`--plafond-usd`, **égal à la part du
+proposeur**, réservé au pire cas sous verrou avant l'appel, réglé au coût lu après), le nombre d'appels (`--max-appels`, 4 : un
+par monde), le modèle permis (exact). Il rend à la commande **le corps entier du fournisseur**, quelques en-têtes, et le témoin
+de ce qu'il a reçu et envoyé : empreinte de la consigne reçue, empreinte du corps envoyé en amont, outils envoyés (aucun),
+nombre de messages (un, de rôle utilisateur), message système (aucun). Une session = une requête sans historique : le relais ne
+garde aucune conversation.
+
+`POST /appel` {modele, consigne, max_tokens, pire_cas_usd} → 200 {relais, appelant, corps, entetes, statut_amont,
+consigne_recue_sha256, corps_amont_sha256, outils, messages, systeme} ; 402 plafond du relais ; 429 nombre d'appels ; 403 modèle
+non permis ; 501 voie non branchée ; 502 erreur de l'amont (corps de l'amont joint, borné). `GET /relais/etat` → compteurs,
+plafond, réservé, réglé, appelant, branché (booléen), présence de la clé (booléen), PID.
+
+Appelants (`--appelant`) :
+- `claude` — **voie d'accès aux crédits de Claude : décrite, non branchée** (consigne de la mère, R-2513 « voie d'accès à
+  confirmer »). L'appel serait `POST https://api.anthropic.com/v1/messages`, en-têtes `x-api-key` (clé de l'organisation qui
+  porte les crédits, variable `ANTHROPIC_API_KEY` du seul environnement du relais) et `anthropic-version: 2023-06-01`, corps
+  `{model, max_tokens, messages: [{role: "user", content: consigne}]}` : **aucun outil, aucun message système, aucune
+  réflexion configurée** (Fable 5.2 et Opus 5.5 réfléchissent toujours ; `thinking` omis ; niveau d'effort : défaut du modèle,
+  question ouverte), en flux (SSE) pour des bornes de 70 000 à 95 000 jetons, le message final reconstitué tel que l'API le
+  rend (champs `model`, `stop_reason`, `usage.input_tokens`, `usage.output_tokens`, `content`). Ce qui reste à confirmer
+  par Lazar avant de brancher : quel compte porte les « crédits de Claude » (clé d'API d'une organisation, ou autre voie), si
+  la consommation y est relevée par appel, et si le refus serveur `fallbacks` doit rester **absent** (il changerait le modèle
+  servi : le pilote exige le modèle demandé). Ici : 501 « non branchée », jamais un appel.
+- `gemini` — Argon : `POST https://generativelanguage.googleapis.com/v1beta/models/{modele}:generateContent`, en-tête
+  `x-goog-api-key` (variable `GEMINI_API_KEY`), corps `{contents: [{role: "user", parts: [{text: consigne}]}],
+  generationConfig: {maxOutputTokens: max_tokens}}`, aucun outil. **Écrit, jamais appelé** (aucun appel permis au développeur).
+- `astra` — **[CHAMPS-ASTRA] à confirmer** : `POST --url-amont`, `Authorization: Bearer` (variable `ASTRA_API_KEY`), corps
+  « chat completions » `{model, messages: [{role: "user", content: consigne}], max_completion_tokens}`. Hypothèse, jamais
+  appelée.
+- `factice:SCENARIO[;N=SCENARIO…]` — amont factice en mémoire pour l'essai à blanc (C-18) : il lit **le seul texte servi**
+  (jamais un monde) et rend un corps au dialecte du proposeur. Scénarios : `k1_plus`, `k1_seul`, `tronque`, `refus`,
+  `modele_faux`, `illisible`, `panne`, `sans_usage` ; `N=…` change le scénario du N-ième appel.
+
+Usage : python3 -I -B relais_pilote_v68.py --port P --nom NOM --dialecte claude|gemini|astra --modele M --plafond-usd X
+            --max-appels 4 --prix-entree PE --prix-sortie PS --appelant claude|gemini|astra|factice:… --journal J.jsonl
+            [--url-amont URL] [--delai-amont-s 3600]
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import signal
+import sys
+import threading
+import urllib.error
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+VERSION = "relais-pilote-v68"
+VARIABLE_CLE = {"claude": "ANTHROPIC_API_KEY", "gemini": "GEMINI_API_KEY", "astra": "ASTRA_API_KEY"}
+
+
+class NonBranche(Exception):
+    pass
+
+
+class ErreurAmont(Exception):
+    def __init__(self, statut, corps):
+        super().__init__(f"amont HTTP {statut}")
+        self.statut, self.corps = statut, corps
+
+
+def corps_amont(dialecte, modele, consigne, max_tokens):
+    """Le corps envoyé au fournisseur : un seul message utilisateur, aucun outil, aucun message système."""
+    if dialecte == "claude":
+        return {"model": modele, "max_tokens": max_tokens, "messages": [{"role": "user", "content": consigne}]}
+    if dialecte == "gemini":
+        return {"contents": [{"role": "user", "parts": [{"text": consigne}]}], "generationConfig": {"maxOutputTokens": max_tokens}}
+    return {"model": modele, "messages": [{"role": "user", "content": consigne}], "max_completion_tokens": max_tokens}
+
+
+def temoin_du_corps(dialecte, corps):
+    """(outils, messages, système) lus sur le corps envoyé : ce que le témoin d'isolement atteste."""
+    if dialecte == "gemini":
+        return corps.get("tools", []), len(corps.get("contents", [])), corps.get("systemInstruction")
+    return corps.get("tools", []), len(corps.get("messages", [])), corps.get("system")
+
+
+def usage_du_corps(dialecte, corps):
+    """(entrée, sortie) en jetons, ou None (même lecture que la commande)."""
+    try:
+        if dialecte == "claude":
+            e, s = corps["usage"]["input_tokens"], corps["usage"]["output_tokens"]
+        elif dialecte == "gemini":
+            u = corps["usageMetadata"]
+            e, s = u["promptTokenCount"], u.get("candidatesTokenCount", 0) + u.get("thoughtsTokenCount", 0)
+        else:
+            e, s = corps["usage"]["prompt_tokens"], corps["usage"]["completion_tokens"]
+    except (KeyError, IndexError, TypeError):
+        return None
+    ok = all(isinstance(x, int) and not isinstance(x, bool) and x >= 0 for x in (e, s))
+    return (e, s) if ok else None
+
+
+# --- amont factice (essai à blanc) --------------------------------------------------------------------------------------------
+
+def _contexte(consigne):
+    i = consigne.find("```json\n")
+    j = consigne.rfind("\n```")
+    return json.loads(consigne[i + 8:j])
+
+
+def cartes_factices(consigne, scenario):
+    """Propositions écrites depuis le seul texte servi (K1 de l'archive, dimension du gabarit)."""
+    ctx = _contexte(consigne)
+    k1 = ctx["lois_retenues"][0]["loi"]
+    D = ctx["monde"]["traits"]
+    if scenario == "k1_seul":
+        return [{"enonce": f"copie {i} de la loi retenue", "loi_predictive": k1} for i in range(1, 7)]
+    j = next((i for i in range(D) if any(l[i] for l in k1["poids"])), 0)
+    autre = (j + 1) % D
+    k1b = json.loads(json.dumps(k1))
+    k1b["poids"][1][autre] = 0.5
+    k1b["poids"][2][autre] = -0.5
+
+    def arbre(n):
+        return k1b if n == 0 else {"type": "si_sinon", "condition": {"indice": (j + n) % D, "seuil": 0.0}, "si": arbre(n - 1),
+                                   "sinon": k1}
+    return [{"enonce": "la loi retenue", "loi_predictive": k1},
+            {"enonce": "la loi retenue et un second trait", "loi_predictive": k1b},
+            {"enonce": "trois conditions", "loi_predictive": arbre(3)},
+            {"enonce": "quatre conditions (refusée au gardien)", "loi_predictive": arbre(4)},
+            {"enonce": "sous-populations", "loi_predictive": {"type": "par_sous_population", "lois": {"2": k1b}, "defaut": k1}},
+            {"enonce": "clé en trop", "loi_predictive": k1, "test_de_mort": "x"},
+            {"enonce": "septième (refusée, comptée)", "loi_predictive": k1}]
+
+
+def appel_factice(dialecte, modele, consigne, max_tokens, scenario):
+    if scenario == "panne":
+        raise ErreurAmont(500, b'{"erreur": "panne factice"}')
+    if scenario == "illisible":
+        texte, raison = "Je ne propose rien.", "fin"
+    else:
+        texte = "```json\n" + json.dumps(cartes_factices(consigne, "k1_seul" if scenario == "k1_seul" else "k1_plus")) + "\n```"
+        raison = "fin"
+    if scenario == "tronque":
+        texte, raison = texte[: len(texte) // 2], "borne"
+    if scenario == "refus":
+        texte, raison = "", "refus"
+    entree, sortie = len(consigne.encode("utf-8")) // 4 + 7, min(max_tokens, len(texte) // 4 + 100)
+    servi = modele + "-autre" if scenario == "modele_faux" else modele
+    if dialecte == "claude":
+        sr = {"fin": "end_turn", "borne": "max_tokens", "refus": "refusal"}[raison]
+        corps = {"id": "msg_factice", "type": "message", "role": "assistant", "model": servi, "stop_reason": sr,
+                 "content": [{"type": "thinking", "thinking": ""}, {"type": "text", "text": texte}],
+                 "usage": {"input_tokens": entree, "output_tokens": sortie}}
+    elif dialecte == "gemini":
+        fr = {"fin": "STOP", "borne": "MAX_TOKENS", "refus": "SAFETY"}[raison]
+        corps = {"modelVersion": servi, "candidates": [{"finishReason": fr, "content": {"role": "model", "parts": [
+            {"text": "réflexion", "thought": True}, {"text": texte}]}}],
+                 "usageMetadata": {"promptTokenCount": entree, "candidatesTokenCount": sortie - 50, "thoughtsTokenCount": 50}}
+    else:
+        fr = {"fin": "stop", "borne": "length", "refus": "content_filter"}[raison]
+        corps = {"model": servi, "choices": [{"index": 0, "finish_reason": fr, "message": {"role": "assistant", "content": texte}}],
+                 "usage": {"prompt_tokens": entree, "completion_tokens": sortie,
+                           "completion_tokens_details": {"reasoning_tokens": 50}}}
+    if scenario == "sans_usage":
+        corps.pop("usage", None)
+        corps.pop("usageMetadata", None)
+    return corps, {"content-type": "application/json"}
+
+
+# --- amonts réels (écrits ; claude non branché) ---------------------------------------------------------------------------------
+
+def appel_reel(dialecte, modele, corps, cle, url_amont, delai):
+    if dialecte == "claude":
+        raise NonBranche("voie d'accès aux crédits de Claude décrite, non branchée (code v68)")
+    if dialecte == "gemini":
+        url = f"https://generativelanguage.googleapis.com/v1beta/models/{modele}:generateContent"
+        entetes = {"x-goog-api-key": cle, "Content-Type": "application/json"}
+    else:
+        if not url_amont:
+            raise NonBranche("Astra : --url-amont absent ([CHAMPS-ASTRA], identifiant et prix à confirmer)")
+        url, entetes = url_amont, {"Authorization": "Bearer " + cle, "Content-Type": "application/json"}
+    req = urllib.request.Request(url, data=json.dumps(corps).encode("utf-8"), method="POST", headers=entetes)
+    try:
+        with urllib.request.urlopen(req, timeout=delai) as r:
+            return json.loads(r.read()), {k.lower(): v for k, v in r.headers.items() if k.lower() in ("content-type", "x-request-id", "request-id")}
+    except urllib.error.HTTPError as e:
+        raise ErreurAmont(e.code, e.read()[:2000]) from None
+
+
+class Etat:
+    def __init__(self, args, cle):
+        self.args, self.cle = args, cle
+        self.verrou = threading.Lock()
+        self.appels, self.reserve, self.regle = 0, 0.0, 0.0
+        self.appelant = args.appelant
+        self.factice = args.appelant.startswith("factice:")
+        self.scenarios = {}
+        if self.factice:
+            parts = args.appelant[len("factice:"):].split(";")
+            self.defaut = parts[0]
+            for p in parts[1:]:
+                n, s = p.split("=")
+                self.scenarios[int(n)] = s
+        self.branche = self.factice or args.appelant in ("gemini", "astra") and bool(cle) \
+            and (args.appelant != "astra" or bool(args.url_amont))
+
+    def journal(self, entree):
+        with open(self.args.journal, "a", encoding="utf-8") as f:
+            f.write(json.dumps(entree, ensure_ascii=False, sort_keys=True) + "\n")
+
+
+def fabriquer(etat):
+    a = etat.args
+
+    class Gestion(BaseHTTPRequestHandler):
+        def log_message(self, *x):
+            pass
+
+        def _json(self, code, objet):
+            o = json.dumps(objet, ensure_ascii=False).encode("utf-8")
+            self.send_response(code)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(o)))
+            self.end_headers()
+            self.wfile.write(o)
+
+        def do_GET(self):
+            if self.path != "/relais/etat":
+                return self._json(404, {"relais": VERSION})
+            with etat.verrou:
+                self._json(200, {"relais": f"{VERSION}-{a.nom}", "appelant": etat.appelant, "branche": etat.branche,
+                                 "cle_presente": bool(etat.cle), "plafond_usd": a.plafond_usd, "reserve_usd": etat.reserve,
+                                 "regle_usd": etat.regle, "appels": etat.appels, "max_appels": a.max_appels, "pid": os.getpid(),
+                                 "modele": a.modele, "dialecte": a.dialecte})
+
+        def do_POST(self):
+            if self.path != "/appel":
+                return self._json(404, {"relais": VERSION})
+            try:
+                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))))
+                modele, consigne, mt, pire = d["modele"], d["consigne"], int(d["max_tokens"]), float(d["pire_cas_usd"])
+                if not (isinstance(consigne, str) and consigne and mt > 0 and math.isfinite(pire) and pire > 0):
+                    raise ValueError
+            except (ValueError, KeyError, TypeError):
+                return self._json(400, {"relais": VERSION, "erreur": "requête illisible"})
+            if modele != a.modele:
+                return self._json(403, {"relais": VERSION, "erreur": "modèle non permis"})
+            if not etat.branche:
+                return self._json(501, {"relais": VERSION, "erreur": "voie non branchée"})
+            with etat.verrou:
+                if etat.appels >= a.max_appels:
+                    return self._json(429, {"relais": VERSION, "erreur": "nombre d'appels atteint"})
+                if etat.regle + etat.reserve + pire > a.plafond_usd + 1e-12:
+                    return self._json(402, {"relais": VERSION, "erreur": "plafond du relais"})
+                etat.appels += 1
+                n = etat.appels
+                etat.reserve += pire
+            corps = corps_amont(a.dialecte, modele, consigne, mt)
+            outils, messages, systeme = temoin_du_corps(a.dialecte, corps)
+            base = {"relais": f"{VERSION}-{a.nom}", "appelant": etat.appelant,
+                    "consigne_recue_sha256": hashlib.sha256(consigne.encode("utf-8")).hexdigest(),
+                    "corps_amont_sha256": hashlib.sha256(json.dumps(corps, ensure_ascii=False, sort_keys=True).encode()).hexdigest(),
+                    "outils": outils, "messages": messages, "systeme": systeme}
+            cout, statut = pire, 200
+            try:
+                if etat.factice:
+                    rep, entetes = appel_factice(a.dialecte, modele, consigne, mt, etat.scenarios.get(n, etat.defaut))
+                else:
+                    rep, entetes = appel_reel(a.dialecte, modele, corps, etat.cle, a.url_amont, a.delai_amont_s)
+                u = usage_du_corps(a.dialecte, rep)
+                if u is not None:
+                    cout = (u[0] * a.prix_entree + u[1] * a.prix_sortie) / 1e6
+                reponse = dict(base, corps=rep, entetes=entetes, statut_amont=200)
+            except NonBranche as e:
+                cout, statut, reponse = 0.0, 501, dict(base, erreur=str(e))
+            except ErreurAmont as e:
+                statut, reponse = 502, dict(base, erreur=str(e), corps_amont=e.corps.decode("utf-8", "replace")[:2000])
+            except Exception as e:  # noqa: BLE001 — transport : compté au pire cas
+                statut, reponse = 502, dict(base, erreur=f"{type(e).__name__} : {str(e)[:200]}")
+            with etat.verrou:
+                etat.reserve -= pire
+                etat.regle += cout
+            etat.journal({"appel": n, "statut": statut, "cout_usd": round(cout, 8), "pire_cas_usd": round(pire, 8),
+                          "consigne_recue_sha256": base["consigne_recue_sha256"], "relais": base["relais"]})
+            return self._json(statut, reponse)
+    return Gestion
+
+
+def principal(argv, environ):
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--port", type=int, required=True)
+    p.add_argument("--nom", required=True)
+    p.add_argument("--dialecte", required=True, choices=("claude", "gemini", "astra"))
+    p.add_argument("--modele", required=True)
+    p.add_argument("--plafond-usd", type=float, required=True)
+    p.add_argument("--max-appels", type=int, required=True)
+    p.add_argument("--prix-entree", type=float, required=True)
+    p.add_argument("--prix-sortie", type=float, required=True)
+    p.add_argument("--appelant", required=True)
+    p.add_argument("--journal", required=True)
+    p.add_argument("--url-amont", default=None)
+    p.add_argument("--delai-amont-s", type=float, default=3600.0)
+    a = p.parse_args(argv)
+    if not (a.plafond_usd > 0 and a.max_appels > 0):
+        sys.exit(2)
+    if not (a.appelant.startswith("factice:") or a.appelant == a.dialecte):
+        print(f"{VERSION} : appelant {a.appelant!r} ≠ dialecte {a.dialecte!r}", file=sys.stderr)
+        sys.exit(2)
+    cle = None if a.appelant.startswith("factice:") else environ.get(VARIABLE_CLE[a.dialecte])
+    etat = Etat(a, cle)
+    serveur = ThreadingHTTPServer(("127.0.0.1", a.port), fabriquer(etat))
+    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=serveur.shutdown).start())
+    print(json.dumps({"relais": f"{VERSION}-{a.nom}", "port": serveur.server_address[1], "pid": os.getpid()}), flush=True)
+    serveur.serve_forever()
+
+
+if __name__ == "__main__":
+    principal(sys.argv[1:], dict(os.environ))
