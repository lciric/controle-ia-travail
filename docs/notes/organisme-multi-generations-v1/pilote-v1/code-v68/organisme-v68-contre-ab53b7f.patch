+        "par_proposeur": {k: {"appels": v["appels"], "trouvent": v["trouvent"]} for k, v in qj.items()},
+        "survie_par_produit": {"survie_une_generation": round(survie_prod, 4), "p_prod": round(p_prod, 4),
