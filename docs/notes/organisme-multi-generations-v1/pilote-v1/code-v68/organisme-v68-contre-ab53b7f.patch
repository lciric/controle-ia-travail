+"""Essais R5 du code v68 du pilote MR-2 (C-1 à C-18) : chaque garde sur un cas sain et sur un artefact. Aucun réseau hors de la
+boucle locale (relais à amont factice), aucune clé, aucun appel de modèle. Mondes : ceux de l'essai public de la mesure
+(`generer_monde_v4(P1.cle("pilote-v2-essai-developpement", r))`), écrits dans un dossier provisoire hors de tout dépôt ; jamais un
+monde du secret du pilote, de calibration ou de test.
+
+  OMP_NUM_THREADS=2 python3 -I -B -m pytest -q -p no:cacheprovider essais/test_pilote_mr2_v68.py
+"""
+
+import copy
+import hashlib
+import io
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from unittest import mock
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+if RACINE not in sys.path:
+    sys.path.insert(0, RACINE)
+
+from pole import audit_pilote_v68 as AU  # noqa: E402
+from pole import pilote_mr2_v68 as P  # noqa: E402
+from pole import proposeurs_pilote_v68 as PR  # noqa: E402
+from pole import selection_pari as sp  # noqa: E402
+from pole.outils import json_canonique, sha256_fichier  # noqa: E402
+
+_spec = __import__("importlib.util").util.spec_from_file_location("lanceur_pilote_v68", os.path.join(RACINE, "demonstrations",
+                                                                                                    "pilote_mr2_v68.py"))
+L = __import__("importlib.util").util.module_from_spec(_spec)
+_spec.loader.exec_module(L)
+
+V4, M, MP = P.charger_mr2()
+CONF = L.CONFIGURATION
+COMMANDE = os.path.join(RACINE, "exemples", "pilote-mr2-v68", "commandes", "commande_pilote_v68.py")
+RELAIS = os.path.join(RACINE, "exemples", "pilote-mr2-v68", "commandes", "relais_pilote_v68.py")
+F0 = {"type": "softmax", "poids": [[0.0] * 8] * 3, "biais": [0.0, 0.0, 0.0]}
+ETAT = {}
+# Mondes publics de l'essai v68 : leurs lois de référence passent le gardien (C-16). Le monde 3 de l'étiquette de l'essai de la
+# mesure (« pilote-v2-essai-developpement ») est l'artefact naturel de C-16 : sa loi « monde sans latente » porte un coefficient
+# de valeur absolue 5,25 > 4 (constat du développeur, rapporté).
+ETIQUETTE_ESSAI = "pilote-v68-essai-developpement"
+
+
+def arbre(k, feuille=F0):
+    return feuille if k == 0 else {"type": "si_sinon", "condition": {"indice": k % 8, "seuil": 0.0}, "si": arbre(k - 1, feuille),
+                                   "sinon": feuille}
+
+
+def dossier_prive():
+    d = tempfile.mkdtemp(prefix="pilote-v68-prive-")
+    os.chmod(d, 0o700)
+    return d
+
+
+def mondes_dev():
+    if "mondes" not in ETAT:
+        mondes = []
+        for r in P.MONDES_PILOTE:
+            spec = V4.generer_monde_v4(V4.P1.cle(ETIQUETTE_ESSAI, r))
+            mondes.append({"monde": r, "spec": spec, "spec_sha256": P.sha_spec(spec)})
+        d = dossier_prive()
+        chemin = os.path.join(d, "MONDES.json")
+        sha = P.ecrire_prive(chemin, mondes, [d])
+        ETAT.update(mondes=mondes, chemin=chemin, sha=sha, dossier=d, pm=P.preparer(mondes))
+    return ETAT
+
+
