+      "test_artefact_loi_compilee_invalide"),
+    M("M15-k1-non-arrondie", PC, "if round(v, 6) != v:", "if False:", "C12Heritage", "test_artefact_k1_non_arrondie"),
+    M("M16-c16-sans-arret", PC, "    if refusees:\n        raise Refus(f\"C-16", "    if False:\n        raise Refus(f\"C-16", "C16C17",
