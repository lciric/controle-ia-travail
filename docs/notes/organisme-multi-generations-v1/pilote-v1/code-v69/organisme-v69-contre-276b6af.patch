+"""Lanceur du pilote d'une génération sur la famille MR-2 — code v69 (fichier neuf, R12 ; remplace `pilote_mr2_v68.py`, gardé ;
+C-11, C-13, C-14, C-18).
+
+Texte : `preenregistrement-pilote-conditionnelles-v1-brouillon4.md` (`04ada9fa…`), Q-P2 (a) : une génération, proposeurs puis
+gardien, sans juge, sans étage, sans test de mort ; 4 mondes, bras A seul (archive {K1}), 4 proposeurs, un appel chacun par monde.
+
+Changements depuis la v68 (contre-lecture `7af19261…`, décisions de la mère R-2534) : B-2 (le lanceur lance lui-même les relais
+en mode réel, clés par leur nom, environnement filtré ; état de chaque relais contrôlé champ par champ ; `appelant == dialecte`),
+M-3 (manifeste sans conditions par monde ; contrôles privés laissés sur la machine), M-5 (sous-commande `mesurer` : la mesure une
+seule fois, sortie scellée, liée à `CARTES.json` ; `lire` exige cette pièce), M-6 (textes servis gardés dans `prive/`, jamais
+rapatriés ; contrôle des épisodes et relecture du texte servi au manifeste), M-7 (versions, plate-forme, commit, règle des graines
+au manifeste ; numpy exigé en mode réel), M-9 (illisibles comptés), m-2 (empreintes des mondes du registre exigées en mode réel),
+m-3 (engagement des mondes au texte), m-5 (relevé et manifeste partiels sur arrêt ; toute exception imprévue = arrêt), m-6 (un
+seul lancement réel par texte, `--registre-lancements`), m-13 (liste des modules de la mesure complète), Q-8 (abandon).
+
+Sous-commandes (sorties imprimées : empreintes et contrôles seulement) :
+  secret  DOSSIER_PRIVE/secret.bin
+  generer --secret S --phrase-fichier F --texte T --texte-sha256 H --sortie DOSSIER_PRIVE/MONDES.json
+  preparer --mondes M --mondes-sha256 H
+  jouer   --mode a_blanc|reel --mondes M --mondes-sha256 H --sortie DOSSIER [--scenarios NOM=SCENARIO,…]
+          mode réel, exigés : --go-pi1 GO --go-pi2 GO --registre-go R --texte T --texte-sha256 H --mondes-shas S1,S2,S3,S4
+                              --registre-lancements FICHIER (hors dépôt)
+  mesurer --sortie DOSSIER --mondes M --mondes-sha256 H     la mesure v4, une seule fois, sortie scellée et liée
+  lire    --sortie DOSSIER [--ecrire F]                     C-14 : champ `regle`, coûts rapprochés
+  relire  --cartes CARTES.json                              C-18 : cartes tirées et cartes refusées (audit R4)
+  rapatrier --source DOSSIER --destination DOSSIER [--mondes-sha256 H]
+  bloc
+Codes : 0 conforme ; 2 refus nommé (rien appelé) ; 3 arrêt (pièces versées).
+"""
+
+import argparse
+import datetime
+import hashlib
+import json
+import os
+import platform
+import subprocess
+import sys
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+if RACINE not in sys.path:
+    sys.path.insert(0, RACINE)
+
+import numpy as np  # noqa: E402
+
+from pole import audit_pilote_v69 as AU  # noqa: E402
+from pole import pilote_mr2_v69 as P  # noqa: E402
+from pole import proposeurs_pilote_v69 as PR  # noqa: E402
+from pole.outils import json_canonique, sha256_fichier  # noqa: E402
+
+VERSION = "lanceur-pilote-mr2-v69"
+LANCEUR = "demonstrations/pilote_mr2_v69.py"
+DEBUT_BLOC, FIN_BLOC = "<!-- empreintes-du-code-pilote-v69 : début -->", "<!-- empreintes-du-code-pilote-v69 : fin -->"
+FICHIERS_GELES = (
+    "demonstrations/pilote_mr2_v69.py", "pole/pilote_mr2_v69.py", "pole/proposeurs_pilote_v69.py", "pole/audit_pilote_v69.py",
+    "exemples/pilote-mr2-v69/commandes/commande_pilote_v69.py", "exemples/pilote-mr2-v69/commandes/relais_pilote_v69.py",
+    "exemples/pilote-mr2-v69/configuration-pilote-mr2-v10.json",
+    "pole/selection_pari.py", "pole/outils.py", "pole/registre_go_v66.py", "pole/configuration_v53.py",
+    "pole/configuration_v55.py", "pole/configuration_v54.py", "pole/__init__.py",
+) + tuple("mr2_v68/" + r for r in sorted(P.FICHIERS_MR2))
+CONFIGURATION = os.path.join(RACINE, "exemples", "pilote-mr2-v69", "configuration-pilote-mr2-v10.json")
+PROGRAMME_MESURE = os.path.join(P.RACINE_MR2, "pilote-v1", "outils", "mesure_pilote_v4.py")
+SCENARIO_A_BLANC = "k1_plus"
+REGLE_DES_GRAINES = ("épisodes de développement : SeedSequence(entier des 16 premiers octets de sha256(« pilote-mr2-v68|episodes-"
+                     "developpement|» ∥ empreinte du devis)), instances par monde_riche_outils_v1.tirer_instances, issues par "
+                     "tirer_issues ; mondes : graine_monde_pilote du programme v4 ; cartes relues : SeedSequence(16 premiers "
+                     "chiffres de l'empreinte de CARTES.json) ; jeton des relais : secrets.token_hex(16)")
+
+
+def maintenant():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
+
+
+def empreintes_du_code(racine=RACINE):
+    out = {}
+    for rel in FICHIERS_GELES:
+        f = os.path.join(racine, rel)
+        if not os.path.isfile(f):
+            raise P.Refus(f"fichier gelé absent : {rel}")
+        out[rel] = sha256_fichier(f)
+    return out
+
+
+def bloc_gele(racine=RACINE):
+    """Le bloc que le texte scellé recopie : empreintes du code et des modules portés, gabarit, bornes, plafonds, parts, lignes
+    de GO, réglages envoyés, numpy exigé."""
+    conf, _ = PR.lire_configuration(os.path.join(racine, "exemples", "pilote-mr2-v69", "configuration-pilote-mr2-v10.json"))
+    lignes = [DEBUT_BLOC, "```", f"gabarit-servi-sha256 {P.gabarit_sha256()}"]
+    for nom in P.PROPOSEURS:
+        p = conf["proposeurs"][nom]
+        lignes.append(f"borne-de-sortie {nom} {p['modele']} {p['borne_sortie_jetons']} jetons ; plafond de session "
+                      f"{p['plafond_session_usd']:g} USD ; part {p['part_usd']:g} USD ; réglages envoyés "
+                      f"{json.dumps(p['reglages'], sort_keys=True)}")
+    for ligne in ("pi1", "pi2"):
+        g = conf["go"][ligne]
+        lignes.append(f"ligne-de-go {ligne} {g['montant_usd']:.2f} USD ; parts {json.dumps(g['parts_usd'], sort_keys=True)}")
+    lignes.append(f"octets-entree-max {conf['octets_entree_max']}")
+    lignes.append(f"numpy-exige {conf['numpy_exige']}")
+    for rel, sha in sorted(empreintes_du_code(racine).items()):
+        lignes.append(f"{sha}  orchestrator/{rel}")
+    lignes += ["```", FIN_BLOC]
+    return "\n".join(lignes) + "\n"
+
+
+def verifier_bloc_du_texte(texte, racine=RACINE):
+    """Mode réel : le bloc gelé du texte scellé est exactement celui que rend le code présent (refus sinon)."""
+    i, j = texte.find(DEBUT_BLOC), texte.find(FIN_BLOC)
+    if i < 0 or j < i:
+        raise P.Refus("texte scellé : bloc « empreintes-du-code-pilote-v69 » absent")
+    if texte[i:j + len(FIN_BLOC)] + "\n" != bloc_gele(racine):
+        raise P.Refus("texte scellé : bloc gelé ≠ code, gabarit, bornes ou réglages présents")
+
+
+def ecrire(chemin, objet):
+    return PR.ecrire_scelle_json(chemin, objet)
+
+
+def imprimer(objet):
+    print(json.dumps(objet, ensure_ascii=False, sort_keys=True))
+
+
+def commit_de_l_arbre():
+    """M-7 : le commit de l'arbre s'il est un dépôt git, sinon None (sur la machine : l'empreinte du paquet est au registre)."""
+    try:
+        r = subprocess.run(["git", "-C", RACINE, "rev-parse", "HEAD"], capture_output=True, text=True, encoding="utf-8", timeout=10)
+        return r.stdout.strip() or None if r.returncode == 0 else None
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+
+
+def environnement_de_calcul():
+    return {"python": platform.python_version(), "numpy": np.__version__, "plate_forme": platform.platform(),
+            "commit": commit_de_l_arbre(), "regle_des_graines": REGLE_DES_GRAINES}
+
+
+# --- étapes -------------------------------------------------------------------------------------------------------------------
+
+def preparer_les_mondes(chemin_mondes, sha_mondes, octets_max=None, shas_mondes=None):
+    """C-1 → C-17 sans appel ; rend (mondes, pm_, servis, contrôles publics, contrôles privés)."""
+    mondes = P.charger_mondes_prives(chemin_mondes, sha_mondes, shas_mondes)
+    for w in mondes:
+        P.compiler_monde(w["spec"])
+    pm_ = P.preparer(mondes)
+    c16_public, c16_prive = P.jouer_c16(pm_)
+    episodes = {w: P.episodes_de_developpement(pm_[w]["spec"]) for w in sorted(pm_)}
+    c17 = P.jouer_c17(pm_, episodes)
+    servis, ctl_ep = {}, {}
+    for w in sorted(pm_):
+        archive, sha_arch = P.heritage_k1(pm_[w])
+        texte = P.texte_servi(archive, episodes[w])
+        n = len(texte.encode("utf-8"))
+        if octets_max is not None and n > octets_max:
+            raise P.Refus(f"monde {w} : texte servi de {n} octets > {octets_max} (bornes de sortie calculées pour ce maximum)")
+        ecarts = P.verifier_texte_servi(texte, archive, episodes[w])
+        if ecarts:
+            raise P.Refus(f"monde {w} : texte servi non conforme : {ecarts}")
+        ctl_ep[str(w)] = P.controle_episodes(episodes[w])
+        if not all(ctl_ep[str(w)].values()):
+            raise P.Refus(f"monde {w} : épisodes servis non conformes : {ctl_ep[str(w)]}")
+        servis[w] = {"texte": texte, "archive": archive, "episodes": episodes[w], "archive_sha256": sha_arch,
+                     "texte_sha256": hashlib.sha256(texte.encode("utf-8")).hexdigest(), "octets": n,
+                     "episodes_sha256": hashlib.sha256(json_canonique(episodes[w])).hexdigest()}
+    controles = {"mondes": P.monde_au_manifeste(mondes, sha_mondes), "c16": c16_public,
+                 "c17": {"instances": c17["instances"], "cartes": c17["cartes"], "ecart_max": c17["ecart_max"]},
+                 "heritages_sha256": {str(w): s["archive_sha256"] for w, s in servis.items()},
+                 "textes_servis": {str(w): {"sha256": s["texte_sha256"], "octets": s["octets"], "episodes_sha256": s["episodes_sha256"],
+                                            "relu_conforme": True} for w, s in servis.items()},
+                 "episodes_servis": ctl_ep, "gabarit_sha256": P.gabarit_sha256()}
+    P.exiger_manifeste_sans_loi(controles)
+    return mondes, pm_, servis, controles, {"c16": c16_prive}
+
+
+def exiger_mode_reel(args, conf):
+    """Gardes du mode réel, avant toute préparation et tout relais (B-2, M-7, m-2, m-3, m-6)."""
+    manquants = [o for o in ("go_pi1", "go_pi2", "registre_go", "texte", "texte_sha256", "mondes_shas", "registre_lancements")
+                 if not getattr(args, o)]
+    if manquants:
+        raise P.Refus(f"mode réel : options exigées absentes : {manquants}")
+    if os.path.realpath(args.configuration) != os.path.realpath(CONFIGURATION):
+        raise P.Refus("mode réel : la configuration gelée de l'arbre seulement")
+    if np.__version__ != conf["numpy_exige"]:
+        raise P.Refus(f"mode réel : numpy {np.__version__} ≠ {conf['numpy_exige']} (bloc gelé)")
+    if sha256_fichier(args.texte) != args.texte_sha256:
+        raise P.Refus("texte scellé : empreinte différente")
+    with open(args.texte, encoding="utf-8") as f:
+        verifier_bloc_du_texte(f.read())
+    go = PR.lire_go_du_pilote(conf, args.registre_go, args.go_pi1, args.go_pi2)
+    P.lire_engagement(args.mondes, args.mondes_sha256, args.texte_sha256)
+    P.exiger_hors_depot(args.registre_lancements, "registre des lancements")
+    if os.path.exists(args.registre_lancements):
+        with open(args.registre_lancements, encoding="utf-8") as f:
+            if any(json.loads(l).get("texte_sha256") == args.texte_sha256 for l in f if l.strip()):
+                raise P.Refus("mode réel : un lancement réel a déjà eu lieu pour ce texte (tout second lancement est un nœud)")
+    return go
+
+
+def jouer(args):
+    debut = maintenant()
+    conf, _ = PR.lire_configuration(args.configuration)
+    go = None
+    if args.mode == "reel":
+        go = exiger_mode_reel(args, conf)
+    elif args.mode != "a_blanc":
+        raise P.Refus("mode : a_blanc ou reel")
+    if os.path.exists(args.sortie):
+        raise P.Refus("dossier de sortie existant")
+    shas = args.mondes_shas.split(",") if args.mondes_shas else None
+    mondes, pm_, servis, controles, prives = preparer_les_mondes(args.mondes, args.mondes_sha256, conf["octets_entree_max"], shas)
+    os.makedirs(args.sortie)
+    prive = os.path.join(args.sortie, "prive")
+    os.makedirs(prive, mode=0o700)
+    for w, s in servis.items():  # M-6 : textes servis gardés sur la machine pour l'audit R4, jamais rapatriés
+        with open(os.path.join(prive, f"texte-servi-monde-{w}.txt"), "x", encoding="utf-8") as f:
+            f.write(s["texte"])
+    ecrire(os.path.join(prive, "controles-prives.json"), prives)
+    procs, appels, cartes, gardien = {}, [], [], []
+    scen = dict(x.split("=", 1) for x in (args.scenarios or "").split(",") if x)
+    if args.mode == "reel" and scen:
+        raise P.Refus("mode réel : aucun scénario factice")
+    depense = {nom: 0.0 for nom in P.PROPOSEURS}
+    abandonnes, relais, arret = {}, None, None
+    jeton = PR.nouveau_jeton()
+    try:
+        for nom in P.PROPOSEURS:
+            journal = os.path.join(args.sortie, f"journal-relais-{nom}.jsonl")
+            appelant = conf["proposeurs"][nom]["dialecte"] if args.mode == "reel" else "factice:" + scen.get(nom, SCENARIO_A_BLANC)
+            procs[nom], _ = PR.lancer_relais(conf, nom, journal, appelant, jeton, python=sys.executable)
+        relais = PR.exiger_relais_prets(conf, args.mode)
+        if args.mode == "reel":  # m-6 : le lancement réel est consigné quand les relais sont prêts, avant le premier appel
+            with open(args.registre_lancements, "a", encoding="utf-8") as f:
+                f.write(json.dumps({"texte_sha256": args.texte_sha256, "debut_utc": debut, "sortie": os.path.abspath(args.sortie)})
+                        + "\n")
+        for w in P.MONDES_PILOTE:
+            s = servis[w]
+            for nom in P.PROPOSEURS:
+                ligne = {"monde": w, "proposeur": nom, "texte_servi_sha256": s["texte_sha256"], "archive_sha256": s["archive_sha256"],
+                         "episodes_sha256": s["episodes_sha256"], "gabarit_sha256": controles["gabarit_sha256"]}
+                if nom in abandonnes:
+                    appels.append(dict(ligne, etat="echec", appele=False, cause=f"proposeur abandonné ({abandonnes[nom]})"))
+                    continue
+                p = conf["proposeurs"][nom]
+                if depense[nom] + p["plafond_session_usd"] > p["part_usd"] + 1e-9:
+                    raise PR.ArretPilote(f"{nom} : la part {p['part_usd']} USD serait atteinte au pire cas de l'appel suivant")
+                r = PR.appeler(conf, nom, s["texte"], os.path.join(args.sortie, f"monde-{w}", nom), jeton, python=sys.executable)
+                depense[nom] += r["cout_usd"]
+                if r["abandon"]:
+                    abandonnes[nom] = f"monde {w} : code {r['code']}, cause {r['cause']}"
+                cs, info = ([], None) if r["etat"] == "echec" else P.cartes_d_un_appel(w, nom, r["texte"])
+                cartes += cs
+                gardien.append({"monde": w, "proposeur": nom, "lecture": info})
+                appels.append(dict(ligne, appele=True, **{k: v for k, v in r.items() if k not in ("texte", "proposeur")}))
+    except (PR.ArretPilote, Exception) as e:  # noqa: BLE001 — m-5 : tout arrêt (nommé ou imprévu) laisse relevé et manifeste partiels
+        arret = f"{type(e).__name__} : {e}"
+        if isinstance(e, P.Refus) and not appels:
+            for proc in procs.values():
+                PR.arreter_relais(proc)
+            raise
+    finally:
+        for proc in procs.values():
+            PR.arreter_relais(proc)
+    export = {"cartes": cartes, "appels": [{"monde": a["monde"], "proposeur": a["proposeur"], "etat": a["etat"]} for a in appels]}
+    nom_cartes = "CARTES.json" if arret is None else "CARTES-partiel.json"
+    sha_cartes = ecrire(os.path.join(args.sortie, nom_cartes), export)
+    illisibles = sum(1 for g in gardien if g["lecture"] and g["lecture"]["lecture"])
+    releve = {"version": VERSION, "mode": args.mode, "partiel": arret is not None, "arret": arret, "appels": appels,
+              "gardien": gardien, "depense_usd": depense, "abandonnes": abandonnes, "cartes_sha256": sha_cartes,
+              "appels_complets_illisibles": illisibles,
+              "comptes": {e: sum(1 for a in appels if a["etat"] == e) for e in ("complet", "tronque", "echec")}}
+    sha_releve = ecrire(os.path.join(args.sortie, "releve-pilote-v69.json"), releve)
+    manifeste = {"version": VERSION, "lanceur": LANCEUR, "mode": args.mode, "debut_utc": debut, "fin_utc": maintenant(),
+                 "partiel": arret is not None, "arret": arret, "controles": controles,
+                 "configuration_sha256": PR.empreinte_configuration(conf), "code_sha256": empreintes_du_code(),
+                 "environnement_de_calcul": environnement_de_calcul(), "relais": relais, "go": go,
+                 "reglages_envoyes": {n: conf["proposeurs"][n]["reglages"] for n in P.PROPOSEURS},
+                 "amont": {n: conf["proposeurs"][n]["url_amont"] for n in P.PROPOSEURS},
+                 "amont_boucle_locale": any(PR.amont_boucle_locale(conf["proposeurs"][n]["url_amont"]) for n in P.PROPOSEURS),
+                 "releve_sha256": sha_releve, "cartes_sha256": sha_cartes, "cartes_fichier": nom_cartes,
+                 "scenarios_a_blanc": scen if args.mode == "a_blanc" else None, "juge": None, "etage": None, "tests_de_mort": None}
+    P.exiger_manifeste_sans_loi({k: v for k, v in manifeste.items() if k not in ("go",)})
+    sha_man = ecrire(os.path.join(args.sortie, "manifeste-pilote-v69.json"), manifeste)
+    imprimer({"lanceur": VERSION, "mode": args.mode, "cartes_sha256": sha_cartes, "releve_sha256": sha_releve,
+              "manifeste_sha256": sha_man, "comptes": releve["comptes"], "abandonnes": abandonnes, "arret": arret})
+    if arret is not None:
+        print(f"arrêt : {arret}", file=sys.stderr)
+        return 3
+    return 0
+
+
+def mesurer(args):
+    """M-5 : la mesure **une seule fois** : `CARTES.json` égal à son compagnon et au manifeste ; aucune sortie de mesure déjà
+    présente ; programme `676d5f37…` lancé sans copie ; sortie scellée ; pièce de liaison scellée (empreintes des cartes, du
+    programme, de la sortie)."""
+    cartes = os.path.join(args.sortie, "CARTES.json")
+    man = os.path.join(args.sortie, "manifeste-pilote-v69.json")
+    with open(man, encoding="utf-8") as f:
+        manifeste = json.load(f)
+    if manifeste.get("partiel") or not os.path.isfile(cartes) or not PR._compagnon_egal(cartes) \
+            or sha256_fichier(cartes) != manifeste.get("cartes_sha256") or not PR._compagnon_egal(man):
+        raise P.Refus("mesure : CARTES.json ≠ son compagnon ou le manifeste (ou relevé partiel)")
+    deja = [n for n in os.listdir(args.sortie) if n.startswith("sortie-mesure") or n.startswith("mesure-pilote-v69")]
+    if deja:
+        raise P.Refus(f"mesure : déjà lancée dans ce dossier ({deja}) : une seule fois")
+    if sha256_fichier(PROGRAMME_MESURE) != P.FICHIERS_MR2["pilote-v1/outils/mesure_pilote_v4.py"]:
+        raise P.Refus("mesure : programme ≠ 676d5f37…")
+    P.charger_mondes_prives(args.mondes, args.mondes_sha256)
+    sortie = os.path.join(args.sortie, "sortie-mesure-pilote-v69.json")
+    debut = maintenant()
+    r = subprocess.run([sys.executable, "-I", "-B", PROGRAMME_MESURE, "mesurer", args.mondes, cartes, sortie],
+                       capture_output=True, text=True, encoding="utf-8", env={"PATH": "/usr/bin:/bin", "OMP_NUM_THREADS": "2"})
+    if r.returncode != 0 or not os.path.isfile(sortie):
+        raise PR.ArretPilote(f"mesure : programme en erreur (code {r.returncode}) : {r.stderr[-300:]}")
+    with open(sortie + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha256_fichier(sortie)}  {os.path.basename(sortie)}\n")
+    piece = {"version": VERSION, "debut_utc": debut, "fin_utc": maintenant(), "cartes_sha256": sha256_fichier(cartes),
+             "programme_sha256": sha256_fichier(PROGRAMME_MESURE), "sortie": os.path.basename(sortie),
+             "sortie_sha256": sha256_fichier(sortie), "manifeste_sha256": sha256_fichier(man)}
+    imprimer(dict(piece, piece_sha256=ecrire(os.path.join(args.sortie, "mesure-pilote-v69.json"), piece)))
+    return 0
+
+
+def lire(args):
+    """C-14 : la lecture = le champ `regle` de la sortie de la mesure ; exige la pièce de `mesurer` (M-5), la sortie égale à son
+    compagnon et à la pièce, le programme, la liste **complète** des modules importés (m-13), et les cartes du manifeste."""
+    piece_f = os.path.join(args.sortie, "mesure-pilote-v69.json")
+    if not os.path.isfile(piece_f) or not PR._compagnon_egal(piece_f):
+        raise P.Refus("lecture : pièce de la mesure absente ou différente de son compagnon (sous-commande mesurer)")
+    with open(piece_f, encoding="utf-8") as f:
+        piece = json.load(f)
+    sortie_f = os.path.join(args.sortie, piece["sortie"])
+    if not PR._compagnon_egal(sortie_f) or sha256_fichier(sortie_f) != piece["sortie_sha256"]:
+        raise P.Refus("lecture : sortie de la mesure ≠ son compagnon ou la pièce")
+    if sha256_fichier(os.path.join(args.sortie, "CARTES.json")) != piece["cartes_sha256"]:
+        raise P.Refus("lecture : CARTES.json ≠ celui qui a été mesuré")
+    with open(sortie_f, encoding="utf-8") as f:
+        s = json.load(f)
+    corps = s["corps"]
+    if hashlib.sha256(json.dumps(corps, ensure_ascii=False, sort_keys=True, default=str).encode()).hexdigest() != s["corps_sha256"]:
+        raise P.Refus("sortie de la mesure : corps ≠ son empreinte")
+    if s["hors_corps"]["script_sha256"] != P.FICHIERS_MR2["pilote-v1/outils/mesure_pilote_v4.py"]:
+        raise P.Refus("sortie de la mesure : programme ≠ mesure_pilote_v4.py (676d5f37…)")
+    attendus = P.verifier_fichiers_mr2()
+    lus = {rel: sha for rel, sha in s["hors_corps"]["modules_importes"]}
+    if lus != attendus:
+        raise P.Refus("sortie de la mesure : liste des modules importés ≠ les 13 fichiers portés")
+    with open(os.path.join(args.sortie, "releve-pilote-v69.json"), encoding="utf-8") as f:
+        releve = json.load(f)
+    journaux = {n: os.path.join(args.sortie, f"journal-relais-{n}.jsonl") for n in P.PROPOSEURS}
+    lecture = {"version": VERSION, "regle": corps["regle"], "issue": corps["regle"]["issue"],
+               "sortie_mesure_sha256": piece["sortie_sha256"], "releve_sha256": sha256_fichier(os.path.join(args.sortie,
+                                                                                                          "releve-pilote-v69.json")),
+               "couts": AU.rapprocher_couts(releve, journaux),
+               "a_dire_au_rapport": ["P_VUE = 0,25 supposée, non mesurée", "p_c ne vaut que pour ce gabarit",
+                                     f"gabarit servi {P.gabarit_sha256()}"]}
+    if args.ecrire:
+        lecture["lecture_sha256"] = ecrire(args.ecrire, lecture)
+    imprimer({"issue": lecture["issue"], "texte": corps["regle"].get("texte"), "noeuds": corps["regle"].get("noeuds_avant_banc"),
+              "ecarts_de_cout": {n: v["ecart_usd"] for n, v in lecture["couts"].items()}})
+    return 0
+
+
