+    def requete_directe(self, port, corps, jeton="jeton-essai"):
+        import urllib.error
+        import urllib.request
+        o = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+        r = urllib.request.Request(f"http://127.0.0.1:{port}/appel", data=json.dumps(corps).encode(), method="POST",
+                                   headers={"Content-Type": "application/json", "X-Jeton-Relais": jeton})
