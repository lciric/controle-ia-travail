+        elif args.commande == "preparer":
+            _, _, _, ctl, _ = preparer_les_mondes(args.mondes, args.mondes_sha256)
+            imprimer(ctl)
+        elif args.commande == "jouer":
+            return jouer(args)
+        elif args.commande == "mesurer":
