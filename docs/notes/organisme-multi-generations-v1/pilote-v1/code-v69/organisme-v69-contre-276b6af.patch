+# --- C-3, C-4 : dimensions, compilation, épisodes de développement ----------------------------------------------------------
+
+def exiger_dimensions(spec):
+    """C-3 : dimension 8, 3 sous-populations, 3 issues, lues dans le monde et égales à celles du gabarit servi."""
+    if not isinstance(spec, dict):
+        raise Refus("devis du monde : objet")
+    d, g, k = spec.get("dimension"), spec.get("sous_populations"), spec.get("nombre_issues")
+    if (d, g, k) != (D_PILOTE, NSP_PILOTE, K_PILOTE) or any(isinstance(x, bool) for x in (d, g, k)):
+        raise Refus(f"monde de dimension {d}, {g} sous-populations, {k} issues : le gabarit servi est à "
+                    f"{D_PILOTE}, {NSP_PILOTE}, {K_PILOTE}")
+    return d, g, k
+
+
+def compiler_monde(spec):
+    """C-4 : `compiler_v4` (porté), loi validée par `selection_pari.valider_loi` à la dimension du monde."""
+    V4, _, _ = charger_mr2()
+    d, _, k = exiger_dimensions(spec)
+    loi = V4.compiler_v4(spec)
+    try:
+        sp.valider_loi(loi, k, d)
+    except sp.LoiInvalide as e:
+        raise Refus(f"loi compilée refusée par selection_pari.valider_loi : {e}") from None
+    return loi
+
+
+def verifier_monde(spec):
+    """C-4 : `verifier_v4` (porté ; C0 à C8 v4, toute conditionnelle certifiée) ; rend (conforme, refus, rapport)."""
+    V4, _, _ = charger_mr2()
+    r = sans_chemin_v52b(V4.verifier_v4, spec)
+    return bool(r["conforme"]), r.get("refus"), r
+
+
+def episodes_de_developpement(spec, n=EPISODES_DEVELOPPEMENT):
+    """C-3 : la tranche de 400 épisodes de développement du monde : instances publiques (traits N(0, 1) à six décimales,
+    sous-population uniforme) et issues tirées de la loi compilée ; graine `SeedSequence` dérivée de l'empreinte du devis (R9)."""
+    _, M, _ = charger_mr2()
+    loi = compiler_monde(spec)
+    cle = int.from_bytes(hashlib.sha256((ETIQUETTE_EPISODES + "|" + sha_spec(spec)).encode()).digest()[:16], "big")
+    rng = np.random.default_rng(np.random.SeedSequence(cle))
+    Z, G = M.tirer_instances(rng, n, spec["dimension"], spec["sous_populations"])
+    Y = M.tirer_issues(rng, M.probas(loi, Z, G))
+    return [{"z": [float(x) for x in z], "g": int(g), "y": int(y)} for z, g, y in zip(Z, G, Y)]
+
+
+# --- C-12 : héritage {K1} -------------------------------------------------------------------------------------------------
+
+def preparer(mondes):
+    """Les mondes préparés par le programme de la mesure lui-même (`preparer_mondes` : oracle de 12 000 instances, K1, première
+    conditionnelle, refus si la condition est l'effet de K1) : la K1 servie est celle que la mesure retire du témoin (R-4)."""
+    _, _, MP = charger_mr2()
+    try:
+        return MP.preparer_mondes(mondes)
+    except MP.Refus as e:
+        raise Refus(f"mondes refusés par le programme de la mesure : {e}") from None
+
+
+def identifiant_opaque(sha_monde, quoi):
+    return "F-" + hashlib.sha256(f"{ETIQUETTE_ARCHIVE}|{sha_monde}|{quoi}".encode()).hexdigest()[:12]
+
+
+def heritage_k1(pm_monde):
+    """C-12 : l'archive servie {K1} d'un monde, écrite par programme depuis le monde privé (K1 arrondie à six décimales par
+    `k1_du_monde`), identifiant opaque ; rend (archive, empreinte)."""
+    k1 = copy.deepcopy(pm_monde["k1"])
+    for v in [x for l in k1["poids"] for x in l] + list(k1["biais"]):
+        if round(v, 6) != v:
+            raise Refus("K1 non arrondie à six décimales")
+    archive = [{"identifiant": identifiant_opaque(pm_monde["sha"], "K1"), "loi": k1}]
+    return archive, hashlib.sha256(json_canonique(archive)).hexdigest()
+
+
+# --- C-6 : gabarit servi ------------------------------------------------------------------------------------------------------
+
+def grammaire_servie():
+    """La grammaire de la course (types, champs exacts, un exemple valide par type, bornes) à la dimension du monde MR-2 ; la
+    règle des conditions emboîtées en une phrase ; rien sur les conditions du monde, les sortes d'effets ni la famille (R-2504)."""
+    z = [0.0] * D_PILOTE
+    soft = {"type": "softmax", "poids": [[1.0, -0.5] + z[2:], z[:], [-1.0, 0.5] + z[2:]], "biais": [0.0, 0.25, -0.25]}
+    return {
+        "regles": (f"Trois issues (0, 1, 2), {D_PILOTE} traits réels z0 à z{D_PILOTE - 1}, sous-population g dans "
+                   f"{{0, 1, 2}}. Une loi est un objet JSON de l'un des six types ci-dessous, avec exactement ses champs (aucun "
+                   "autre). Probabilité d'une issue : celle que donne la loi, chaque probabilité relevée au plancher 1e-12 puis "
+                   f"renormalisée. Softmax d'une proposition : chaque poids et chaque biais dans [−{BORNE_GABARIT:g} ; "
+                   f"{BORNE_GABARIT:g}]. Inclinaison et amplitude : valeur absolue ≤ {BORNE_SURETE:g} ; puissance dans ]0 ; "
+                   f"{BORNE_SURETE:g}]. Indices (sous_population, indice, trait, issue) : entiers JSON (0, pas 0.0). Tout nombre "
+                   f"est fini (ni NaN ni Infinity). Au plus {CONDITIONS_MAX} conditions emboîtées : le long de tout chemin de "
+                   f"la racine à une feuille, au plus {CONDITIONS_MAX} nœuds si_sinon (sur un trait ou sur une "
+                   "sous-population) ; un niveau par_sous_population, melange ou transformee ne compte pas. Le gardien évalue "
+                   "chaque loi sur un jeu d'instances fixe : une loi qu'il ne sait pas évaluer, ou dont une probabilité n'est "
+                   "pas finie, est refusée."),
+        "types": {
+            "fixe": {"champs": {"type": "\"fixe\"", "probas": "3 nombres ≥ 0 de somme > 0 (normalisés)"},
+                     "exemple": {"type": "fixe", "probas": [0.5, 0.25, 0.25]}},
+            "softmax": {"champs": {"type": "\"softmax\"",
+                                   "poids": f"3 lignes (une par issue) de {D_PILOTE} nombres (coefficients de z0 à z{D_PILOTE - 1})",
+                                   "biais": "3 nombres (un par issue)"},
+                        "formule": "p(k) ∝ exp(biais[k] + Σ_j poids[k][j]·z_j)", "exemple": soft},
+            "par_sous_population": {"champs": {"type": "\"par_sous_population\"",
+                                               "lois": "objet {\"0\": loi, \"1\": loi, \"2\": loi} (clé : la sous-population g, "
+                                                       "en texte)",
+                                               "defaut": "facultatif : loi des sous-populations absentes de « lois » (exigé si "
+                                                         "une clé manque)"},
+                                    "exemple": {"type": "par_sous_population",
+                                                "lois": {"0": {"type": "fixe", "probas": [0.5, 0.25, 0.25]}, "1": soft},
+                                                "defaut": {"type": "fixe", "probas": [1.0, 1.0, 1.0]}}},
+            "melange": {"champs": {"type": "\"melange\"", "composantes": "liste non vide de lois",
+                                   "poids": "un poids ≥ 0 par composante, de somme 1"},
+                        "exemple": {"type": "melange", "composantes": [{"type": "fixe", "probas": [1.0, 1.0, 1.0]}, soft],
+                                    "poids": [0.25, 0.75]}},
+            "si_sinon": {"champs": {"type": "\"si_sinon\"",
+                                    "condition": "{\"sous_population\": entier 0, 1 ou 2} (vraie si g vaut cette valeur), ou "
+                                                 f"{{\"indice\": entier de 0 à {D_PILOTE - 1}, \"seuil\": nombre fini facultatif, "
+                                                 "0 par défaut} (vraie si z[indice] > seuil)",
+                                    "si": "loi si la condition est vraie", "sinon": "loi sinon"},
+                         "exemple": {"type": "si_sinon", "condition": {"indice": 1, "seuil": 0.5},
+                                     "si": {"type": "fixe", "probas": [0.25, 0.5, 0.25]},
+                                     "sinon": {"type": "fixe", "probas": [0.25, 0.25, 0.5]}}},
+            "transformee": {"champs": {"type": "\"transformee\"", "base": "loi",
+                                       "melange_aveugle": "facultatif : {\"lambda\": nombre dans [0 ; 1], \"probas\": 3 nombres "
+                                                          "≥ 0} (p ← (1 − lambda)·p + lambda·probas normalisées)",
+                                       "puissance": "facultatif : nombre > 0 (p ← p^puissance, renormalisé)",
+                                       "inclinaison": "facultatif : 3 nombres (p(k) ← p(k)·exp(inclinaison[k]), renormalisé)",
