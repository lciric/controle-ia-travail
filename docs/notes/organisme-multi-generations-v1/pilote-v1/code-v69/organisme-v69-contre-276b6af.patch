+    res = {"debut": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "mutations": []}
+    with tempfile.TemporaryDirectory() as d:
+        orch = preparer_copie(d)
+        selections = sorted({m["selection"] for m in choisies})
+        code, echecs, queue = jouer(orch, " or ".join(f"({s})" for s in selections))
+        res["sain"] = {"code": code, "echecs": echecs}
+        if code != 0:
+            print(queue, file=sys.stderr)
+            res["defaut"] = "essais sains en échec sur la copie non mutée"
+            return 2, res
+    for m in choisies:
+        with tempfile.TemporaryDirectory() as d:
+            try:
+                orch = preparer_copie(d, m)
+            except RuntimeError as e:
+                res["mutations"].append(dict(m, issue="défaut du banc", detail=str(e)))
+                continue
+            code, echecs, queue = jouer(orch, m["selection"])
+            issue = "tuée (raison attendue)" if code != 0 and m["attendu"] in echecs else ("survit" if code == 0 else "tuée (autre raison)")
+            res["mutations"].append({"id": m["id"], "fichier": m["fichier"], "issue": issue, "echecs": echecs,
+                                     "attendu": m["attendu"]})
+            print(f"{m['id']} : {issue} {echecs}", flush=True)
+    res["fin"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    res["bilan"] = {i: sum(1 for x in res["mutations"] if x["issue"] == i) for i in sorted({x["issue"] for x in res["mutations"]})}
+    code = 0 if res["bilan"] == {"tuée (raison attendue)": len(choisies)} else 1
+    return code, res
+
+
+if __name__ == "__main__":
+    code, res = principal()
+    a = sys.argv
+    if "--sortie" in a:
+        with open(a[a.index("--sortie") + 1], "x", encoding="utf-8") as f:
+            json.dump(res, f, ensure_ascii=False, indent=1, sort_keys=True)
+    print(json.dumps(res.get("bilan"), ensure_ascii=False))
+    sys.exit(code)
