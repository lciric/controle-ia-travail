+def ecrire_conf(d, conf):
+    """Une copie de la configuration v10 (commandes comprises) avec les ports de `conf`."""
+    shutil.copytree(os.path.dirname(CONF), os.path.join(d, "conf"))
+    c = os.path.join(d, "conf", "configuration-pilote-mr2-v10.json")
+    with open(c, encoding="utf-8") as f:
+        brut = json.load(f)
+    for n in P.PROPOSEURS:
+        brut["proposeurs"][n]["port"] = conf["proposeurs"][n]["port"]
+    with open(c, "w", encoding="utf-8") as f:
+        json.dump(brut, f)
+    return c
