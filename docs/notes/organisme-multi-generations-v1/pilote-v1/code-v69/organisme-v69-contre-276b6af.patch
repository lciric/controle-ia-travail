@@ -0,0 +1,389 @@
+"""Proposeurs du pilote MR-2 — code v69 (fichier neuf, R12 ; remplace `proposeurs_pilote_v68.py`, gardé) : configuration v10,
+bornes de sortie, parts et lignes de GO (C-7, C-9), appel d'un proposeur par sa commande, réponse brute et témoin d'isolement
+scellés avant l'extraction (C-8, C-10), relais lancés **par le lanceur lui-même** (essai à blanc et mode réel), clés par leur
+**nom**, environnement bâti par filtrage, arrêtés par leur PID (R10). Aucun réseau ici ; aucune valeur de clé lue ni écrite
+ailleurs que dans l'environnement du seul relais.
+
+Changements depuis la v68 (contre-lecture `7af19261…`, décisions de la mère R-2534) : B-1 (plus aucun « à confirmer » ; voie de
+Claude branchée au relais), B-2 (état du relais contrôlé champ par champ, `appelant == dialecte` en mode réel, adresse d'amont
+figée, empreinte du fichier du relais), M-4 (corps du relais exigé sur disque pour un appel rendu), Q-8 (modèle servi différent,
+usage absent, coût au-dessus du pire cas → abandon), m-4 (périmètre des lignes de GO), m-7 (délai de l'adaptateur = panne,
+plus un arrêt), m-9 (encodage UTF-8 explicite), m-11 (jeton du relais).
+
+États d'un appel : `complet`, `tronque`, `echec`. Abandon du proposeur (ses appels restants « échec » sans appel) : panne du relais
+(codes 2, 3, 4, 6 de la commande, délai de l'adaptateur compris) et causes `modele_servi`, `usage_absent`, `cout_excessif`. Échec
+sans abandon : `refus`, `illisible`, `aucun_candidat`, `raison_inconnue`. Arrêt du pilote (`ArretPilote`, code 3) : réponse
+brute, corps du relais ou témoin d'isolement absent ou faux ; part qui serait atteinte.
+"""
+
+import hashlib
+import json
+import math
+import os
+import secrets
+import subprocess
+import time
+import urllib.parse
+
+from .outils import json_canonique, sha256_fichier
+from .pilote_mr2_v69 import PROPOSEURS, Refus
+
+VERSION = "proposeurs-pilote-v69"
+ROLE = "proposeur_ideation"
+CODES_PANNE = (2, 3, 4, 6)
+CAUSES_ABANDON = ("modele_servi", "usage_absent", "cout_excessif")
+CHAMPS_PROPOSEUR = {"modele", "dialecte", "credits", "plafond_session_usd", "borne_sortie_jetons", "prix_entree_usd_par_million",
+                    "prix_sortie_usd_par_million", "part_usd", "delai_s", "port", "variable_cle", "variable_espace", "url_amont",
+                    "reglages", "sources"}
+URL_AMONT = {"claude": "https://api.anthropic.com/v1/messages",
+             "gemini": "https://generativelanguage.googleapis.com/v1beta/models/{modele}:generateContent",
+             "astra": "https://api.openai.com/v1/chat/completions"}
+ENV_FILTRE = ("PATH", "LANG", "LC_ALL", "SSL_CERT_FILE", "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "https_proxy", "http_proxy",
+              "no_proxy")  # noms seulement ; aucun autre nom ne passe au relais
+
+
+class ArretPilote(RuntimeError):
+    """Arrêt (code 3) : pièces versées, rien n'est lu."""
+
+
+def borne_de_sortie_max(plafond, prix_entree, prix_sortie, octets_entree_max):
+    """La plus grande borne de sortie que le plafond de session paie au pire cas de la commande (entrée comptée en octets + 1024)
+    pour un texte servi d'au plus `octets_entree_max` octets."""
+    reste = plafond - (octets_entree_max + 1024) * prix_entree / 1e6
+    return int(math.floor(reste * 1e6 / prix_sortie)) if reste > 0 else 0
+
+
+def amont_boucle_locale(url):
+    u = urllib.parse.urlsplit(url or "")
+    return u.scheme == "http" and u.hostname == "127.0.0.1" and bool(u.port)
+
+
+def lire_configuration(chemin):
+    """Configuration v10 : rend (conf, dossier) après contrôles (C-7, C-9) : quatre proposeurs nommés, champs exacts, bornes
+    payées par le plafond de session au pire cas, part = 4 plafonds de session, parts par ligne de GO égales aux montants, chaque
+    proposeur dans une seule ligne, adresse d'amont = adresse figée du dialecte (ou boucle locale d'essai), réglages objets,
+    commande et relais égaux à leurs empreintes."""
+    dossier = os.path.dirname(os.path.abspath(chemin))
+    with open(chemin, encoding="utf-8") as f:
+        conf = json.load(f)
+    if conf.get("version") != "configuration-pilote-mr2-v10":
+        raise Refus("configuration : version « configuration-pilote-mr2-v10 » exigée")
+    props = conf.get("proposeurs")
+    if not isinstance(props, dict) or tuple(sorted(props)) != tuple(sorted(PROPOSEURS)):
+        raise Refus(f"configuration : proposeurs exactement {PROPOSEURS}")
+    omax = conf.get("octets_entree_max")
+    if not (isinstance(omax, int) and omax > 0):
+        raise Refus("configuration : octets_entree_max entier > 0")
+    if not isinstance(conf.get("numpy_exige"), str):
+        raise Refus("configuration : numpy_exige (version de numpy du mode réel)")
+    ports = set()
+    for nom, p in props.items():
+        if set(p) != CHAMPS_PROPOSEUR:
+            raise Refus(f"configuration, {nom} : champs exacts {sorted(CHAMPS_PROPOSEUR)}")
+        if p["dialecte"] not in URL_AMONT:
+            raise Refus(f"configuration, {nom} : dialecte inconnu")
+        for k in ("plafond_session_usd", "prix_entree_usd_par_million", "prix_sortie_usd_par_million", "part_usd", "delai_s"):
+            if not (isinstance(p[k], (int, float)) and not isinstance(p[k], bool) and math.isfinite(p[k]) and p[k] > 0):
+                raise Refus(f"configuration, {nom} : {k} > 0")
+        b = p["borne_sortie_jetons"]
+        if not (isinstance(b, int) and not isinstance(b, bool) and b > 0):
+            raise Refus(f"configuration, {nom} : borne de sortie entière > 0")
+        bmax = borne_de_sortie_max(p["plafond_session_usd"], p["prix_entree_usd_par_million"], p["prix_sortie_usd_par_million"], omax)
+        if b > bmax:
+            raise Refus(f"configuration, {nom} : borne de sortie {b} > {bmax}, que le plafond de session paie au pire cas")
+        if abs(p["part_usd"] - 4 * p["plafond_session_usd"]) > 1e-9:
+            raise Refus(f"configuration, {nom} : part ≠ 4 × plafond de session (un appel par monde)")
+        if not (isinstance(p["port"], int) and 1024 <= p["port"] <= 65535) or p["port"] in ports:
+            raise Refus(f"configuration, {nom} : port distinct dans [1024 ; 65535]")
+        ports.add(p["port"])
+        if p["url_amont"] != URL_AMONT[p["dialecte"]].format(modele=p["modele"]) and not amont_boucle_locale(p["url_amont"]):
+            raise Refus(f"configuration, {nom} : adresse d'amont ≠ adresse figée du dialecte")
+        if not (isinstance(p["variable_cle"], str) and p["variable_cle"]) or not (p["variable_espace"] is None
+                                                                                   or isinstance(p["variable_espace"], str)):
+            raise Refus(f"configuration, {nom} : variable_cle (nom), variable_espace (nom ou null)")
+        if not isinstance(p["reglages"], dict):
+            raise Refus(f"configuration, {nom} : reglages, objet")
+    go = conf.get("go")
+    if not isinstance(go, dict) or set(go) != {"pi1", "pi2"}:
+        raise Refus("configuration : go {pi1, pi2}")
+    vus = []
+    for ligne, g in go.items():
+        parts = g.get("parts_usd")
+        if not isinstance(parts, dict) or not parts:
+            raise Refus(f"configuration, go {ligne} : parts_usd")
+        if round(sum(parts.values()) * 100) != round(g.get("montant_usd", -1) * 100):
+            raise Refus(f"configuration, go {ligne} : somme des parts ≠ montant")
+        if not (isinstance(g.get("perimetre_contient"), list) and g["perimetre_contient"]):
+            raise Refus(f"configuration, go {ligne} : perimetre_contient, liste non vide")
+        for k, v in parts.items():
+            if k in props and abs(v - props[k]["part_usd"]) > 1e-9:
+                raise Refus(f"configuration, go {ligne} : part de {k} ≠ part du proposeur")
+            vus.append(k)
+    if sorted(k for k in vus if k in props) != sorted(PROPOSEURS):
+        raise Refus("configuration : chaque proposeur dans une seule ligne de GO")
+    for cle in ("commande", "relais"):
+        piece = conf.get(cle) or {}
+        f = os.path.normpath(os.path.join(dossier, piece.get("chemin", "")))
+        if not f.startswith(dossier + os.sep) or os.path.isabs(piece.get("chemin", "/")) or not os.path.isfile(f):
+            raise Refus(f"configuration : {cle} sous le dossier de la configuration")
+        if sha256_fichier(f) != piece.get("sha256"):
+            raise Refus(f"configuration : {cle} ≠ son empreinte")
+        piece["chemin_absolu"] = f
+    return conf, dossier
+
+
+def lire_go_du_pilote(conf, registre, go_pi1, go_pi2, aujourd_hui=None):
+    """C-9 : les deux lignes π1 (crédits de Claude) et π2 (hors crédits), lues par le lecteur v66 au montant **exact** de la
+    configuration ; deux identifiants distincts ; m-4 : le périmètre de chaque ligne contient les mots écrits à la configuration."""
+    from .registre_go_v66 import GoRefuse, verifier_go_v66
+    if go_pi1 == go_pi2:
+        raise Refus("GO : π1 et π2 distincts")
+    out = {}
+    for ligne, ident in (("pi1", go_pi1), ("pi2", go_pi2)):
+        try:
+            out[ligne] = verifier_go_v66(ident, registre, conf["go"][ligne]["montant_usd"], aujourd_hui=aujourd_hui)
+        except GoRefuse as e:
+            raise Refus(f"GO {ligne} : {e}") from None
+        manquants = [m for m in conf["go"][ligne]["perimetre_contient"] if m not in out[ligne]["perimetre"]]
+        if manquants:
+            raise Refus(f"GO {ligne} : périmètre sans {manquants}")
+    return out
+
+
+def commande_d_un_proposeur(conf, nom, sortie_brute, python):
+    p = conf["proposeurs"][nom]
+    return [python, "-I", "-B", conf["commande"]["chemin_absolu"], "--url-relais", f"http://127.0.0.1:{p['port']}",
+            "--modele", p["modele"], "--dialecte", p["dialecte"], "--prix-entree", repr(p["prix_entree_usd_par_million"]),
+            "--prix-sortie", repr(p["prix_sortie_usd_par_million"]), "--borne-sortie", str(p["borne_sortie_jetons"]),
+            "--delai-s", repr(float(p["delai_s"]) - conf.get("delai_marge_s", 30)), "--sortie-brute", sortie_brute]
+
+
+def _derniere_ligne(stdout):
+    for ligne in reversed((stdout or "").strip().splitlines()):
+        try:
+            o = json.loads(ligne)
+        except ValueError:
+            return None
+        return o if isinstance(o, dict) else None
+    return None
+
+
+def ecrire_scelle_json(chemin, objet):
+    octets = (json.dumps(objet, ensure_ascii=False, sort_keys=True, indent=1) + "\n").encode("utf-8")
+    with open(chemin, "xb") as f:
+        f.write(octets)
+    sha = hashlib.sha256(octets).hexdigest()
+    with open(chemin + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha}  {os.path.basename(chemin)}\n")
+    return sha
+
+
+def _compagnon_egal(chemin):
+    try:
+        with open(chemin + ".sha256", encoding="utf-8") as f:
+            return f.read().split()[0] == sha256_fichier(chemin)
+    except (OSError, IndexError):
+        return False
+
+
+def appeler(conf, nom, texte, dossier_appel, jeton, python, executer=subprocess.run):
+    """Un appel, une session neuve (C-10) : dossier de l'appel créé vide (il ne doit pas exister) ; commande lancée dans un
+    dossier courant vide, environnement minimal sans clé (le jeton du relais seulement) ; réponse brute (sortie entière, code,
+    corps du relais écrit par la commande) **scellée avant toute extraction** ; témoin d'isolement écrit et scellé. M-4 : pour un
+    appel rendu (complet, tronqué), le corps du relais doit être sur disque, égal à son compagnon et à l'empreinte que la
+    commande rend ; sinon ArretPilote."""
+    p = conf["proposeurs"][nom]
+    if os.path.exists(dossier_appel):
+        raise ArretPilote(f"{nom} : dossier de session existant (session neuve exigée)")
+    os.makedirs(dossier_appel)
+    session = os.path.join(dossier_appel, "session")
+    os.makedirs(session)
+    avant = sorted(os.listdir(session))
+    brut = os.path.join(dossier_appel, "corps-relais.json")
+    cmd = commande_d_un_proposeur(conf, nom, brut, python)
+    env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "PLAFOND_SESSION_USD": repr(float(p["plafond_session_usd"])),
+           "ROLE_POLE": ROLE, "MODELE_DEMANDE_POLE": p["modele"], "RELAIS_JETON_POLE": jeton}
+    sha_texte = hashlib.sha256(texte.encode("utf-8")).hexdigest()
+    debut = time.time()
+    delai_adaptateur = False
+    try:
+        r = executer(cmd, input=texte, capture_output=True, text=True, encoding="utf-8", cwd=session, env=env,
+                     timeout=float(p["delai_s"]))
+        code, sortie, erreur = r.returncode, r.stdout, r.stderr
+    except subprocess.TimeoutExpired as e:  # m-7 : panne (échec, abandon), plus un arrêt du pilote
+        code, sortie, erreur, delai_adaptateur = 6, "", "délai de l'adaptateur", True
+        sortie = json.dumps({"etat": "echec", "erreur": "délai de l'adaptateur (commande tuée)", "cout_usd": None})
+    duree = round(time.time() - debut, 3)
+    derniere = _derniere_ligne(sortie)
+    brut_sha = sha256_fichier(brut) if os.path.isfile(brut) else None
+    reponse = {"proposeur": nom, "code": code, "sortie_standard": sortie, "sortie_erreur": (erreur or "")[-4000:],
+               "derniere_ligne": derniere, "corps_relais": "corps-relais.json" if brut_sha else None,
+               "corps_relais_sha256": brut_sha, "duree_s": duree, "delai_adaptateur": delai_adaptateur}
+    sha_rep = ecrire_scelle_json(os.path.join(dossier_appel, "reponse-brute.json"), reponse)
+    if derniere is None:
+        raise ArretPilote(f"{nom} : réponse brute sans dernière ligne JSON (code {code})")
+    etat = derniere.get("etat") if code == 0 else "echec"
+    if etat not in ("complet", "tronque", "echec"):
+        raise ArretPilote(f"{nom} : état rendu inconnu {etat!r}")
+    if brut_sha is not None and derniere.get("brut_sha256") not in (None, brut_sha):
+        raise ArretPilote(f"{nom} : corps du relais ≠ empreinte rendue par la commande")
+    if etat in ("complet", "tronque"):
+        if brut_sha is None or derniere.get("brut_sha256") != brut_sha or not _compagnon_egal(brut):
+            raise ArretPilote(f"{nom} : appel rendu sans corps du relais scellé sur disque (M-4)")
+    tr = derniere.get("temoin_relais")
+    apres = sorted(os.listdir(session))
+    temoin = {"proposeur": nom, "relais_attendu": f"relais-pilote-v69-{nom}", "relais": (tr or {}).get("relais"),
+              "session_neuve": avant == [], "fichiers_ecrits_dans_la_session": apres,
+              "texte_servi_sha256": sha_texte, "texte_recu_sha256": (tr or {}).get("consigne_recue_sha256"),
+              "consigne_commande_sha256": derniere.get("consigne_sha256"),
+              "outils": (tr or {}).get("outils"), "messages": (tr or {}).get("messages"), "systeme": (tr or {}).get("systeme"),
+              "appelant": (tr or {}).get("appelant"), "reglages": (tr or {}).get("reglages"),
+              "environnement_commande": sorted(env), "reponse_brute_sha256": sha_rep}
+    if tr is not None:
+        conditions = {"relais": temoin["relais"] == temoin["relais_attendu"],
+                      "texte_recu": temoin["texte_recu_sha256"] == sha_texte,
+                      "consigne_commande": temoin["consigne_commande_sha256"] == sha_texte,
+                      "aucun_outil": temoin["outils"] == [], "un_message": temoin["messages"] == 1,
+                      "aucun_systeme": temoin["systeme"] is None, "session_neuve": temoin["session_neuve"],
+                      "session_vide": apres == [], "reglages": temoin["reglages"] == p["reglages"]}
+        temoin["conditions"] = conditions
+        temoin["conforme"] = all(conditions.values())
+    else:
+        temoin["conforme"] = None  # aucun corps rendu (échec avant le relais) : rien à attester sur l'amont
+    sha_tem = ecrire_scelle_json(os.path.join(dossier_appel, "temoin-isolement.json"), temoin)
+    if temoin["conforme"] is False:
+        manque = sorted(k for k, v in temoin["conditions"].items() if not v)
+        raise ArretPilote(f"{nom} : témoin d'isolement non conforme ({manque})")
+    if etat in ("complet", "tronque") and temoin["conforme"] is not True:
+        raise ArretPilote(f"{nom} : réponse rendue sans témoin d'isolement")
+    cause = derniere.get("cause")
+    abandon = code in CODES_PANNE or cause in CAUSES_ABANDON
+    return {"proposeur": nom, "etat": etat, "code": code, "cause": cause, "cout_usd": float(derniere.get("cout_usd") or 0.0),
+            "jetons": derniere.get("jetons"), "raison_arret": derniere.get("raison_arret"),
+            "modele_servi": derniere.get("modele_servi"), "erreur": derniere.get("erreur"), "duree_s": duree,
+            "reponse_brute_sha256": sha_rep, "temoin_sha256": sha_tem, "corps_relais_sha256": brut_sha,
+            "texte_servi_sha256": sha_texte, "panne": code in CODES_PANNE, "abandon": abandon,
+            "texte": derniere.get("texte") if etat != "echec" else None}
+
+
+# --- relais : lancés par le lanceur, sondés, arrêtés par leur PID ----------------------------------------------------------------
+
+def nouveau_jeton():
+    return secrets.token_hex(16)
+
+
+def env_du_relais(p, jeton, environ, factice):
+    """Environnement du seul relais, bâti par filtrage (noms de `ENV_FILTRE`) ; mode réel : la variable de clé (et d'espace)
+    recopiée **par son nom** depuis l'environnement du lanceur, jamais écrite ni imprimée ; à blanc : aucune clé."""
+    env = {k: environ[k] for k in ENV_FILTRE if k in environ}
+    env.setdefault("PATH", "/usr/bin:/bin")
+    env.setdefault("LANG", "C.UTF-8")
+    env["RELAIS_JETON"] = jeton
+    if not factice:
+        for nom_var in (p["variable_cle"], p["variable_espace"]):
+            if nom_var and nom_var in environ:
+                env[nom_var] = environ[nom_var]
+    return env
+
+
+def lancer_relais(conf, nom, journal, appelant, jeton, python, environ=None):
+    """Lance le relais d'un proposeur ; rend (processus, ligne de démarrage)."""
+    p = conf["proposeurs"][nom]
+    factice = appelant.startswith("factice:")
+    cmd = [python, "-I", "-B", conf["relais"]["chemin_absolu"], "--port", str(p["port"]), "--nom", nom, "--dialecte", p["dialecte"],
+           "--modele", p["modele"], "--plafond-usd", repr(float(p["part_usd"])), "--max-appels", "4",
+           "--prix-entree", repr(p["prix_entree_usd_par_million"]), "--prix-sortie", repr(p["prix_sortie_usd_par_million"]),
+           "--borne-sortie", str(p["borne_sortie_jetons"]), "--appelant", appelant, "--journal", journal,
+           "--url-amont", p["url_amont"], "--variable-cle", p["variable_cle"], "--reglages", json.dumps(p["reglages"]),
+           "--delai-amont-s", repr(float(p["delai_s"]) - 60)]
+    if p["variable_espace"]:
+        cmd += ["--variable-espace", p["variable_espace"]]
+    env = env_du_relais(p, jeton, os.environ if environ is None else environ, factice)
+    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8", env=env)
+    ligne = proc.stdout.readline()
+    try:
+        info = json.loads(ligne)
+    except ValueError:
+        err = proc.stderr.read()[:300] if proc.poll() is not None else ""
+        arreter_relais(proc)
+        raise Refus(f"relais {nom} : n'a pas démarré ({err})") from None
+    return proc, info
+
+
+def etat_relais(conf, nom):
+    import urllib.request
+    p = conf["proposeurs"][nom]
+    ouvreur = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    with ouvreur.open(f"http://127.0.0.1:{p['port']}/relais/etat", timeout=10) as r:
+        return json.loads(r.read())
+
+
+def controler_etat_relais(conf, nom, e, mode):
+    """B-2 : l'état d'un relais avant tout appel, champ par champ ; rend la liste des écarts (vide si conforme)."""
+    p = conf["proposeurs"][nom]
+    ecarts = []
+
+    def egal(cle, attendu):
+        if e.get(cle) != attendu:
+            ecarts.append(cle)
+    egal("relais", f"relais-pilote-v69-{nom}")
+    egal("fichier_sha256", conf["relais"]["sha256"])
+    egal("modele", p["modele"])
+    egal("dialecte", p["dialecte"])
+    egal("prix_entree", p["prix_entree_usd_par_million"])
+    egal("prix_sortie", p["prix_sortie_usd_par_million"])
+    egal("borne_sortie", p["borne_sortie_jetons"])
+    egal("max_appels", 4)
+    egal("url_amont", p["url_amont"])
+    egal("reglages", p["reglages"])
+    egal("appels", 0)
+    egal("regle_usd", 0.0)
+    if not isinstance(e.get("plafond_usd"), (int, float)) or abs(float(e["plafond_usd"]) - p["part_usd"]) > 1e-9:
+        ecarts.append("plafond_usd")
+    if e.get("branche") is not True:
+        ecarts.append("branche")
+    if mode == "reel":
+        egal("appelant", p["dialecte"])
+        if e.get("cle_presente") is not True:
+            ecarts.append("cle_presente")
+    elif not str(e.get("appelant", "")).startswith("factice:"):
+        ecarts.append("appelant")
+    return ecarts
+
+
+def exiger_relais_prets(conf, mode):
+    """Avant tout appel : chaque relais répond et son état est conforme (`controler_etat_relais`) ; Refus sinon."""
+    out = {}
+    for nom in PROPOSEURS:
+        try:
+            e = etat_relais(conf, nom)
+        except OSError as x:
+            raise Refus(f"relais {nom} injoignable : {x}") from None
+        ecarts = controler_etat_relais(conf, nom, e, mode)
+        if ecarts:
+            raise Refus(f"relais {nom} : état non conforme ({ecarts})")
+        out[nom] = {k: e[k] for k in ("relais", "appelant", "pid", "plafond_usd", "modele", "fichier_sha256", "url_amont",
+                                      "reglages", "cle_presente")}
+    return out
+
+
+def arreter_relais(proc):
+    """R10 : arrêt par le PID du processus lancé ici, jamais par motif."""
+    if proc.poll() is None:
+        os.kill(proc.pid, 15)
+        try:
+            proc.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            os.kill(proc.pid, 9)
+            proc.wait(timeout=10)
+    for f in (proc.stdout, proc.stderr):
+        if f:
+            f.close()
+    return proc.returncode
+
+
+def empreinte_configuration(conf):
+    c = json.loads(json.dumps(conf))
+    for cle in ("commande", "relais"):
+        c[cle].pop("chemin_absolu", None)
+    return hashlib.sha256(json_canonique(c)).hexdigest()
