+        L.verifier_bloc_du_texte("texte\n" + b + "suite")
+
+    def test_artefacts(self):
+        b = L.bloc_gele()
+        sha = L.empreintes_du_code()["pole/pilote_mr2_v69.py"]
+        with self.assertRaisesRegex(P.Refus, "≠ code"):
+            L.verifier_bloc_du_texte(b.replace(sha, "0" * 64))
+        with self.assertRaisesRegex(P.Refus, "absent"):
+            L.verifier_bloc_du_texte("rien")
+
+    def test_fermeture_des_imports(self):
+        """Les modules de l'arbre chargés par le lanceur sont tous au bloc gelé (fermeture statique)."""
+        r = subprocess.run([sys.executable, "-I", "-B", "-c", (
+            "import sys, os; sys.path.insert(0, %r); import runpy; runpy.run_path(%r, run_name='x');"
+            "from pole import pilote_mr2_v69 as P; P.charger_mr2();"
+            "print('\\n'.join(sorted(os.path.relpath(m.__file__, %r) for m in list(sys.modules.values())"
+            " if getattr(m, '__file__', None) and os.path.abspath(m.__file__).startswith(%r))))") % (
+            RACINE, os.path.join(RACINE, "demonstrations", "pilote_mr2_v69.py"), RACINE, RACINE + os.sep)],
+            capture_output=True, text=True)
+        charges = set(r.stdout.split())
+        self.assertTrue(charges, r.stderr)
+        self.assertEqual(charges - set(L.FICHIERS_GELES), set())
+
+
+if __name__ == "__main__":
+    unittest.main()
