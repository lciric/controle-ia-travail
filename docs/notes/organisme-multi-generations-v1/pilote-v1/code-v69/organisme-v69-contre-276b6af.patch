+"""Outils de l'audit et du rapport du pilote MR-2 — code v69 (fichier neuf, R12 ; remplace `audit_pilote_v68.py`, gardé ; C-18).
+Aucun réseau, aucun appel.
+
+Changements depuis la v68 (contre-lecture `7af19261…`) : M-2 (tout fichier qui porte un motif d'identifiant de fournisseur est
+refusé au rapatriement), M-6 (`cartes_refusees` : la liste des cartes refusées, pour l'audit R4), m-13 (compagnon vérifié pour
+chaque fichier qui en a un ; marques de contenu étendues : épisodes et contexte servis), noms des pièces v69.
+
+- `rapprocher_couts` : coût par proposeur et par appel, relevé de la commande rapproché du journal de son relais.
+- `cartes_a_relire` : 3 cartes par appel, graine dérivée de l'empreinte de `CARTES.json` (audit R4, x = 0).
+- `cartes_refusees` : toutes les cartes refusées au gardien ou au-delà de la sixième (audit R4, x = 0 et x ≥ 3).
+- `rapatrier` : copie des seules pièces permises ; refuse tout fichier qui porterait un monde, un contexte servi ou un
+  identifiant de fournisseur, et tout fichier différent de son compagnon ; rien copié alors ; rend la liste copiée.
+"""
+
+import hashlib
+import json
+import os
+import re
+import shutil
+
+import numpy as np
+
+from .outils import sha256_fichier
+from .pilote_mr2_v69 import PROPOSEURS, Refus
+
+VERSION = "audit-pilote-v69"
+PERMIS = re.compile(r"^(reponse-brute\.json|corps-relais\.json|temoin-isolement\.json|CARTES\.json|releve-pilote-v69\.json|"
+                    r"manifeste-pilote-v69\.json|sortie-mesure[\w.-]*\.json|mesure-pilote-v69\.json|lecture-pilote-v69\.json|"
+                    r"journal-relais-[a-z0-9]+\.jsonl)(\.sha256)?$")
+MARQUES_DE_MONDE = ('"effets"', '"composante_condition"', '"interaction_xor"', '"distracteurs"', '"episodes_developpement"',
+                    '"lois_retenues"')
+MOTIFS_IDENTIFIANT = (re.compile(r"\borg-[A-Za-z0-9]{6,}"), re.compile(r"\bsk-[A-Za-z0-9_*.\-]{4,}"),
+                      re.compile(r"\bproj_[A-Za-z0-9]{6,}"), re.compile(r"\bAIza[0-9A-Za-z_\-]{10,}"),
+                      re.compile(r"\bwrkspc_[A-Za-z0-9]{6,}"), re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{4,}"))
+
+
+def rapprocher_couts(releve, journaux):
+    """{proposeur : {commande_usd, relais_usd, ecart_usd, appels : [...]}} ; `journaux` : {proposeur : chemin du journal}."""
+    out = {}
+    for nom in PROPOSEURS:
+        appels = [a for a in releve["appels"] if a["proposeur"] == nom]
+        lignes = []
+        if journaux.get(nom) and os.path.isfile(journaux[nom]):
+            with open(journaux[nom], encoding="utf-8") as f:
+                lignes = [json.loads(l) for l in f if l.strip()]
+        cmd = sum(a.get("cout_usd") or 0.0 for a in appels if a.get("appele"))
+        rel = sum(l["cout_usd"] for l in lignes)
+        par_appel = []
+        for a in appels:
+            j = [l for l in lignes if l.get("consigne_recue_sha256") == a.get("texte_servi_sha256")]
+            par_appel.append({"monde": a["monde"], "etat": a["etat"], "commande_usd": a.get("cout_usd"),
+                              "relais_usd": round(sum(l["cout_usd"] for l in j), 8) if j else None})
+        out[nom] = {"commande_usd": round(cmd, 8), "relais_usd": round(rel, 8), "ecart_usd": round(cmd - rel, 8),
+                    "appels_au_relais": len(lignes), "par_appel": par_appel}
+    return out
+
+
+def cartes_a_relire(chemin_cartes, par_appel=3):
+    """3 cartes par appel (ou toutes s'il en a moins), graine = 16 premiers chiffres de l'empreinte du fichier (R9)."""
+    sha = sha256_fichier(chemin_cartes)
+    rng = np.random.default_rng(np.random.SeedSequence(int(sha[:16], 16)))
+    with open(chemin_cartes, encoding="utf-8") as f:
+        cartes = json.load(f)["cartes"]
+    out = []
+    for cle in sorted({(c["monde"], c["proposeur"]) for c in cartes}):
+        ems = sorted(c["emplacement"] for c in cartes if (c["monde"], c["proposeur"]) == cle)
+        choisis = sorted(int(x) for x in rng.choice(ems, size=min(par_appel, len(ems)), replace=False))
+        out.append({"monde": cle[0], "proposeur": cle[1], "emplacements": choisis})
+    return {"cartes_sha256": sha, "graine": int(sha[:16], 16), "tirage": out,
+            "refusees": cartes_refusees(cartes)}
+
+
+def cartes_refusees(cartes):
+    """M-6 : (monde, proposeur, emplacement) de toutes les cartes refusées (au gardien ou au-delà de la sixième)."""
+    return [{"monde": c["monde"], "proposeur": c["proposeur"], "emplacement": c["emplacement"]}
+            for c in sorted(cartes, key=lambda c: (c["monde"], c["proposeur"], c["emplacement"])) if c["etat"] == "refusee"]
+
+
+def motif_interdit(chemin, sha_fichier_mondes=None):
+    """Le motif qui interdit de rapatrier ce fichier, ou None."""
+    if sha_fichier_mondes and sha256_fichier(chemin) == sha_fichier_mondes:
+        return "fichier des mondes"
+    with open(chemin, "rb") as f:
+        texte = f.read().decode("utf-8", "replace")
+    for m in MARQUES_DE_MONDE:
+        if m in texte:
+            return f"contenu d'un monde ou d'un texte servi ({m})"
+    for r in MOTIFS_IDENTIFIANT:
+        if r.search(texte):
+            return "identifiant de fournisseur"
+    if os.path.isfile(chemin + ".sha256"):
+        with open(chemin + ".sha256", encoding="utf-8") as f:
+            attendu = (f.read().split() or [""])[0]
+        if attendu != sha256_fichier(chemin):
+            return "différent de son compagnon"
+    return None
+
+
+def porte_un_monde(chemin, sha_fichier_mondes=None):
+    return motif_interdit(chemin, sha_fichier_mondes) is not None
+
+
+def rapatrier(source, destination, sha_fichier_mondes=None):
+    """Copie les pièces permises de `source` vers `destination` (créée) ; refuse tout fichier interdit (`motif_interdit`) ;
+    rien n'est copié alors. Les autres fichiers sont laissés et listés. Rend {copies: [[chemin, sha]], laisses, refuses}."""
+    if os.path.exists(destination):
+        raise Refus("rapatriement : destination existante")
+    a_copier, laisses, refuses = [], [], []
+    for racine, _dossiers, fichiers in sorted(os.walk(source)):
+        for nom in sorted(fichiers):
+            f = os.path.join(racine, nom)
+            rel = os.path.relpath(f, source)
+            if not PERMIS.match(nom):
+                laisses.append(rel)
+                continue
+            m = None if nom.endswith(".sha256") else motif_interdit(f, sha_fichier_mondes)
+            if m:
+                refuses.append([rel, m])
+            else:
+                a_copier.append(rel)
+    if refuses:
+        raise Refus(f"rapatriement : fichiers interdits, rien n'est rendu : {refuses}")
+    copies = []
+    for rel in a_copier:
+        cible = os.path.join(destination, rel)
+        os.makedirs(os.path.dirname(cible), exist_ok=True)
+        shutil.copyfile(os.path.join(source, rel), cible)
+        copies.append([rel, sha256_fichier(cible)])
+    liste = {"version": VERSION, "copies": copies, "laisses": laisses, "refuses": refuses,
+             "aucun_monde": all(not porte_un_monde(os.path.join(destination, r), sha_fichier_mondes)
+                                for r, _ in copies if not r.endswith(".sha256"))}
+    octets = (json.dumps(liste, ensure_ascii=False, sort_keys=True, indent=1) + "\n").encode("utf-8")
+    with open(os.path.join(destination, "liste-rapatriement-pilote-v69.json"), "xb") as f:
+        f.write(octets)
+    liste["liste_sha256"] = hashlib.sha256(octets).hexdigest()
+    return liste
