@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+"""Commande externe d'un proposeur du pilote MR-2 (code v69, C-7, C-8, C-10) — fichier neuf (R12 ; remplace
+`commande_pilote_v68.py`, gardé). Bibliothèque standard seule.
+
+Changements depuis la v68 (contre-lecture `contre-lecture-code-pilote-v68-v1.md`, `7af19261…` ; décisions de la mère R-2534) :
+- **M-1** : modèle servi = identifiant demandé exact, ou identifiant demandé suivi d'un **suffixe de date** seulement
+  (`-AAAAMMJJ` ou `-AAAA-MM-JJ`) ; rien de plus large (le suffixe de révision à 3 chiffres de la v68 est retiré). Fait relevé :
+  journal masqué du collisionneur du 12 novembre (`docs/notes/collisionneur-diversite-idees-v1/run-e3-v1/journal-masque-v1.jsonl`,
+  `12cb6401…`) : `gpt-6-astra`, `gemini-4-argon`, `claude-fable-5-1`, `claude-opus-4-6` servis chacun **exactement** sous
+  l'identifiant demandé.
+- **Q-8** : la dernière ligne porte `cause` (`refus`, `modele_servi`, `usage_absent`, `illisible`, `cout_excessif`,
+  `raison_inconnue`, `aucun_candidat`) ; l'adaptateur abandonne le proposeur sur `modele_servi`, `usage_absent` et
+  `cout_excessif`, pas sur `refus`.
+- **m-11** : jeton du relais (variable `RELAIS_JETON_POLE`) envoyé dans l'en-tête `X-Jeton-Relais`.
+- **m-12** : Astra — un refus servi par le champ `refusal` du message est un refus, quel que soit `finish_reason` ; la sortie
+  comptée = `completion_tokens` + `reasoning_tokens` (règle prudente du collisionneur, `lire_reponse_openai`). Argon — un
+  `promptFeedback.blockReason` est un refus ; aucun candidat : `aucun_candidat`.
+- Le relais ne rend plus le corps d'une erreur de l'amont (M-2) : statut et type seulement.
+
+Un appel, une session neuve : la consigne arrive sur l'entrée standard ; la commande la pose au **relais local** de son
+proposeur (127.0.0.1 seulement, jamais de mandataire), écrit **la réponse entière du relais** dans `--sortie-brute` avec son
+compagnon `.sha256`, **avant toute lecture**, puis lit la réponse selon le dialecte du fournisseur et rend une dernière ligne JSON.
+
+Garde avant envoi : pire cas = (octets de la consigne + 1024) × prix d'entrée + borne de sortie × prix de sortie ≤
+`PLAFOND_SESSION_USD` ; sinon refus sans envoi (code 4). La borne de sortie est fixe (configuration gelée).
+
+États (code 0) : `complet` (raison d'arrêt normale), `tronque` (raison d'arrêt = borne). Échecs : 2 réglage ou entrée refusés
+(rien envoyé) ; 3 relais (connexion, HTTP, voie non branchée, jeton) ; 4 pire cas au-dessus du plafond de session ; 5 réponse non
+conforme (`cause`) ; 6 délai.
+
+Dialectes (C-8) :
+- `claude` (API Messages, message final reconstitué du flux par le relais) : `model` ; `stop_reason` (`end_turn`,
+  `stop_sequence` → complet ; `max_tokens` → tronqué ; `refusal` → refus) ; `usage.input_tokens`, `usage.output_tokens` (réflexion
+  comprise) ; texte = blocs `text`.
+- `gemini` (Argon, generateContent) : `modelVersion` ; `promptFeedback.blockReason` → refus ; `candidates[0].finishReason`
+  (`STOP` → complet ; `MAX_TOKENS` → tronqué ; `SAFETY`, `RECITATION`, `PROHIBITED_CONTENT`, `BLOCKLIST`, `SPII`, `IMAGE_SAFETY` →
+  refus) ; `usageMetadata.promptTokenCount`, `candidatesTokenCount` + `thoughtsTokenCount` ; texte = parties non `thought`.
+- `astra` (« chat completions » d'OpenAI, champs du collisionneur v8) : `model` ; `choices[0].finish_reason` (`stop` →
+  complet, `length` → tronqué, `content_filter` → refus) ; champ `message.refusal` → refus ; `usage.prompt_tokens`,
+  `completion_tokens` + `completion_tokens_details.reasoning_tokens`.
+
+Usage : python3 -I -B commande_pilote_v69.py --url-relais http://127.0.0.1:PORT --modele M --dialecte claude|gemini|astra
+            --prix-entree PE --prix-sortie PS --borne-sortie N --delai-s S --sortie-brute FICHIER
+Environnement lu : PLAFOND_SESSION_USD, ROLE_POLE (= proposeur_ideation), MODELE_DEMANDE_POLE (= --modele), RELAIS_JETON_POLE.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import signal
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+VERSION = "commande-pilote-v69"
+ROLE = "proposeur_ideation"
+PLANCHER = 1e-6
+DIALECTES = ("claude", "gemini", "astra")
+COMPLET = {"claude": ("end_turn", "stop_sequence"), "gemini": ("STOP",), "astra": ("stop",)}
+TRONQUE = {"claude": ("max_tokens",), "gemini": ("MAX_TOKENS",), "astra": ("length",)}
+REFUS = {"claude": ("refusal",), "gemini": ("SAFETY", "RECITATION", "PROHIBITED_CONTENT", "BLOCKLIST", "SPII", "IMAGE_SAFETY"),
+         "astra": ("content_filter",)}
+SUFFIXE_DATE = re.compile(r"-(\d{8}|\d{4}-\d{2}-\d{2})")
+
+
+def rendre(code, **champs):
+    champs.setdefault("cout_usd", PLANCHER)
+    c = champs["cout_usd"]
+    champs["cout_usd"] = round(float(c), 8) if isinstance(c, (int, float)) and math.isfinite(c) and c > 0 else PLANCHER
+    print(json.dumps(dict(champs, version=VERSION, code=code), ensure_ascii=False, sort_keys=True))
+    sys.stdout.flush()
+    sys.exit(code)
+
+
+def lire_arguments(argv):
+    a = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    a.add_argument("--url-relais", required=True)
+    a.add_argument("--modele", required=True)
+    a.add_argument("--dialecte", required=True, choices=DIALECTES)
+    a.add_argument("--prix-entree", type=float, required=True)
+    a.add_argument("--prix-sortie", type=float, required=True)
+    a.add_argument("--borne-sortie", type=int, required=True)
+    a.add_argument("--delai-s", type=float, required=True)
+    a.add_argument("--sortie-brute", required=True)
+    return a.parse_args(argv)
+
+
+def verifier_url(url):
+    u = urllib.parse.urlsplit(url)
+    if u.scheme != "http" or u.hostname not in ("127.0.0.1", "localhost") or u.path not in ("", "/") or not u.port:
+        raise ValueError("--url-relais : http://127.0.0.1:PORT seulement (le relais local tient la clé)")
+    return url.rstrip("/") + "/appel"
+
+
+def modele_conforme(demande, servi):
+    """M-1 : identifiant exact, ou identifiant demandé suivi d'un suffixe de date (`-AAAAMMJJ` ou `-AAAA-MM-JJ`), rien d'autre."""
+    if not isinstance(servi, str) or not isinstance(demande, str) or not demande:
+        return False
+    if servi == demande:
+        return True
+    return servi.startswith(demande) and SUFFIXE_DATE.fullmatch(servi[len(demande):]) is not None
+
+
+def _entier(x):
+    return isinstance(x, int) and not isinstance(x, bool) and x >= 0
+
+
+def lire_dialecte(dialecte, corps):
+    """(texte, raison d'arrêt, modèle servi, jetons {entree, sortie, reflexion}, refus) ; lève KeyError ou TypeError si le corps
+    est illisible ; un usage absent ou non entier rend des jetons `None` (cause `usage_absent`, lue par l'appelant).
+    `refus` : vrai si le corps dit un refus hors de la raison d'arrêt (Argon : blocage de la consigne ; Astra : champ refusal)."""
+    if dialecte == "claude":
+        u = corps.get("usage") or {}
+        texte = "".join(b.get("text", "") for b in corps["content"] if isinstance(b, dict) and b.get("type") == "text")
+        jetons = {"entree": u.get("input_tokens"), "sortie": u.get("output_tokens"), "reflexion": None}
+        return texte, corps["stop_reason"], corps.get("model"), jetons, False
+    if dialecte == "gemini":
+        u = corps.get("usageMetadata") or {}
+        cand, pensee = u.get("candidatesTokenCount", 0), u.get("thoughtsTokenCount", 0)
+        jetons = {"entree": u.get("promptTokenCount"), "sortie": cand + pensee if _entier(cand) and _entier(pensee) else None,
+                  "reflexion": pensee}
+        if (corps.get("promptFeedback") or {}).get("blockReason"):
+            return "", "BLOCAGE_PROMPT", corps.get("modelVersion"), jetons, True
+        candidats = corps.get("candidates") or []
+        if not candidats:
+            return "", "AUCUN_CANDIDAT", corps.get("modelVersion"), jetons, False
+        c = candidats[0]
+        parts = (c.get("content") or {}).get("parts") or []
+        texte = "".join(p.get("text", "") for p in parts if isinstance(p, dict) and not p.get("thought"))
+        return texte, c.get("finishReason"), corps.get("modelVersion"), jetons, False
+    ch = corps["choices"][0]
+    u = corps.get("usage") or {}
+    det = u.get("completion_tokens_details") or {}
+    raisonnement = det.get("reasoning_tokens") or 0
+    visibles = u.get("completion_tokens")
+    jetons = {"entree": u.get("prompt_tokens"), "sortie": visibles + raisonnement if _entier(visibles) and _entier(raisonnement)
+              else None, "reflexion": raisonnement}
+    message = ch.get("message") or {}
+    refus = isinstance(message.get("refusal"), str) and bool(message.get("refusal"))
+    return message.get("content") or "", ch.get("finish_reason"), corps.get("model"), jetons, refus
+
+
+def ecrire_brut(chemin, octets):
+    """La réponse entière du relais, écrite et scellée avant toute lecture (C-10) ; jamais d'écrasement."""
+    fd = os.open(chemin, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "wb") as f:
+        f.write(octets)
+    sha = hashlib.sha256(octets).hexdigest()
+    with open(chemin + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha}  {os.path.basename(chemin)}\n")
+    return sha
+
+
+def principal(argv, environ, entree):
+    try:
+        args = lire_arguments(argv)
+        cible = verifier_url(args.url_relais)
+        plafond = float(environ.get("PLAFOND_SESSION_USD", "nan"))
+        if not (math.isfinite(plafond) and plafond > 0):
+            raise ValueError("PLAFOND_SESSION_USD absent ou invalide")
+        if environ.get("ROLE_POLE") != ROLE:
+            raise ValueError(f"ROLE_POLE {environ.get('ROLE_POLE')!r} : {ROLE} seulement")
+        if environ.get("MODELE_DEMANDE_POLE") != args.modele:
+            raise ValueError("MODELE_DEMANDE_POLE ≠ --modele")
+        jeton = environ.get("RELAIS_JETON_POLE")
+        if not jeton:
+            raise ValueError("RELAIS_JETON_POLE absent")
+        if not (args.borne_sortie > 0 and args.prix_entree > 0 and args.prix_sortie > 0 and args.delai_s > 0):
+            raise ValueError("borne de sortie, prix et délai > 0")
+        if os.path.exists(args.sortie_brute):
+            raise ValueError("--sortie-brute existe déjà (session neuve exigée)")
+        consigne = entree.read()
+        if not consigne.strip():
+            raise ValueError("consigne vide")
+    except (ValueError, SystemExit) as e:
+        rendre(2, etat="echec", erreur=str(e)[:300], envoye=False)
+    octets = len(consigne.encode("utf-8"))
+    pire = (octets + 1024) * args.prix_entree / 1e6 + args.borne_sortie * args.prix_sortie / 1e6
+    diag = {"modele_demande": args.modele, "dialecte": args.dialecte, "borne_sortie": args.borne_sortie,
+            "pire_cas_usd": round(pire, 8), "consigne_sha256": hashlib.sha256(consigne.encode("utf-8")).hexdigest()}
+    if pire > plafond + 1e-12:
+        rendre(4, etat="echec", erreur=f"pire cas {pire:.4f} USD au-dessus du plafond de session {plafond} USD", envoye=False,
+               **diag)
+
+    def interrompu(signum, _cadre):
+        rendre(6, etat="echec", cout_usd=pire, cout_origine="pire_cas", erreur=f"signal {signum}", envoye=True, **diag)
+    signal.signal(signal.SIGTERM, interrompu)
+
+    corps = json.dumps({"modele": args.modele, "consigne": consigne, "max_tokens": args.borne_sortie},
+                       ensure_ascii=False).encode("utf-8")
+    ouvreur = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    requete = urllib.request.Request(cible, data=corps, method="POST",
+                                     headers={"Content-Type": "application/json", "X-Jeton-Relais": jeton})
+    try:
+        with ouvreur.open(requete, timeout=args.delai_s) as r:
+            brut = r.read()
+    except urllib.error.HTTPError as e:
+        octets_err = e.read()
+        sha = ecrire_brut(args.sortie_brute, octets_err)
+        avant = e.code in (400, 401, 402, 403, 429, 501)  # refus du relais lui-même : rien parti vers l'amont
+        rendre(3, etat="echec", cout_usd=PLANCHER if avant else pire, cout_origine="plancher" if avant else "pire_cas",
+               erreur=f"relais HTTP {e.code}", envoye=not avant, brut_sha256=sha, **diag)
+    except urllib.error.URLError as e:
+        if isinstance(e.reason, ConnectionRefusedError):
+            rendre(3, etat="echec", erreur="relais injoignable (connexion refusée)", envoye=False, **diag)
+        rendre(3, etat="echec", cout_usd=pire, cout_origine="pire_cas", erreur=f"URLError : {type(e.reason).__name__}", envoye=True,
+               **diag)
+    except (TimeoutError, OSError) as e:
+        rendre(6 if isinstance(e, TimeoutError) else 3, etat="echec", cout_usd=pire, cout_origine="pire_cas",
+               erreur=f"{type(e).__name__}", envoye=True, **diag)
+    sha = ecrire_brut(args.sortie_brute, brut)
+    diag["brut_sha256"] = sha
+    try:
+        rep = json.loads(brut)
+        temoin = {k: rep[k] for k in ("relais", "consigne_recue_sha256", "corps_amont_sha256", "outils", "messages", "systeme",
+                                      "appelant", "reglages")}
+        texte, raison, servi, jetons, refus = lire_dialecte(args.dialecte, rep["corps"])
+    except (ValueError, KeyError, IndexError, TypeError, AttributeError) as e:
+        rendre(5, etat="echec", cause="illisible", cout_usd=pire, cout_origine="pire_cas",
+               erreur=f"réponse illisible : {type(e).__name__}", envoye=True, **diag)
+    diag.update(temoin_relais=temoin, raison_arret=raison, modele_servi=servi, jetons=jetons, envoye=True)
+    if not (_entier(jetons["entree"]) and _entier(jetons["sortie"])):
+        rendre(5, etat="echec", cause="usage_absent", cout_usd=pire, cout_origine="pire_cas", erreur="usage absent", **diag)
+    cout = (jetons["entree"] * args.prix_entree + jetons["sortie"] * args.prix_sortie) / 1e6
+    diag["cout_origine"] = "usage"
+    if cout > pire + 1e-9:
+        rendre(5, etat="echec", cause="cout_excessif", cout_usd=cout, erreur="coût lu au-dessus du pire cas", **diag)
+    if not modele_conforme(args.modele, servi):
+        rendre(5, etat="echec", cause="modele_servi", cout_usd=cout, erreur=f"modèle servi {servi!r} ≠ {args.modele!r}", **diag)
+    if refus or raison in REFUS[args.dialecte]:
+        rendre(5, etat="echec", cause="refus", cout_usd=cout, refus=True, erreur=f"refus du modèle ({raison})", **diag)
+    if raison == "AUCUN_CANDIDAT":
+        rendre(5, etat="echec", cause="aucun_candidat", cout_usd=cout, erreur="aucun candidat", **diag)
+    if raison in TRONQUE[args.dialecte]:
+        rendre(0, etat="tronque", texte=texte, cout_usd=cout, **diag)
+    if raison in COMPLET[args.dialecte]:
+        rendre(0, etat="complet", texte=texte, cout_usd=cout, **diag)
+    rendre(5, etat="echec", cause="raison_inconnue", cout_usd=cout, erreur=f"raison d'arrêt inconnue {raison!r}", **diag)
+
+
+if __name__ == "__main__":
+    principal(sys.argv[1:], dict(os.environ), sys.stdin)
