+def lire_flux_anthropic(lignes):
+    """Message final reconstitué d'un flux SSE de l'API Messages (`message_start`, `content_block_*`, `message_delta`,
+    `message_stop`) ; lève ValueError si le flux est incomplet ou porte un événement `error`."""
+    msg, blocs, fini = None, {}, False
+    evenement = None
+    for brute in lignes:
+        ligne = brute.rstrip("\r\n")
+        if ligne.startswith("event:"):
+            evenement = ligne[6:].strip()
+            continue
+        if not ligne.startswith("data:"):
+            continue
+        d = json.loads(ligne[5:].strip())
+        t = d.get("type", evenement)
+        if t == "error":
+            raise ValueError(f"flux : erreur {(d.get('error') or {}).get('type')}")
+        if t == "message_start":
+            msg = dict(d["message"])
+            msg["content"] = []
+        elif t == "content_block_start":
+            blocs[d["index"]] = dict(d["content_block"])
+        elif t == "content_block_delta":
+            b, delta = blocs[d["index"]], d["delta"]
+            if delta.get("type") == "text_delta":
+                b["text"] = b.get("text", "") + delta["text"]
+            elif delta.get("type") == "thinking_delta":
+                b["thinking"] = b.get("thinking", "") + delta["thinking"]
+            elif delta.get("type") == "signature_delta":
+                b["signature"] = delta["signature"]
+        elif t == "message_delta":
+            msg["stop_reason"] = d["delta"].get("stop_reason")
+            msg["stop_details"] = d["delta"].get("stop_details")
+            msg.setdefault("usage", {}).update(d.get("usage") or {})
+        elif t == "message_stop":
+            fini = True
+    if msg is None or not fini:
+        raise ValueError("flux incomplet (message_start ou message_stop absent)")
+    msg["content"] = [blocs[i] for i in sorted(blocs)]
+    return msg
+
