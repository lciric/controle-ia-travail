+    @classmethod
+    def jouer(cls, nom, lancements, remplacer=None, env=None):
+        args = {"--mode": "reel", "--mondes": cls.mondes, "--mondes-sha256": mondes_dev()["sha"],
+                "--sortie": os.path.join(cls.d, nom), "--go-pi1": "GO-2026-11-13-71", "--go-pi2": "GO-2026-11-13-72",
