+"""Sonde payante du pilote MR-2 — code v71 (fichier neuf, R12 ; remplace `sonde_pilote_v70.py`, gardé). Aucun réseau ici : la
+sous-commande `sonde` du lanceur v71 lance les relais (clés par leur nom) et appelle par la chaîne du pilote (adaptateur →
+commande → relais → amont) ; ce module relit les pièces de chaque appel, en tire les faits et les conclusions, bâtit le relevé,
+tient le registre des lancements de la sonde, et dit si un relevé permet le mode réel (`exiger_releve`).
+
+Changements depuis la v70 (contre-lecture du différentiel v69 → v70, `f6bc1b00…` ; mot de Lazar R-2604) :
+- **A-1** : le verdict sur la réflexion d'Astra (et d'Argon quand `totalTokenCount` ne tranche pas) ne confirme plus « comprise »
+  sur une zone où la réflexion pourrait être ajoutée. Par appel, avec c la sortie du fournisseur, t la réflexion et O les octets
+  du texte visible (relu du corps par la commande gelée) : t > c → « non_comprise » (si la réflexion était comprise, c ≥ t) ;
+  t > 0 et c − t ≤ O + 16 < c → « comprise » (si la réflexion était ajoutée, c ne compterait que le texte visible, au plus
+  O + 16 jetons : un jeton de texte porte au moins un octet, 16 jetons de forme au plus) ; sinon « indetermine ». Une réponse
+  d'un mot n'est plus supposée : sa longueur est lue. Un verdict « contradictoire » d'un appel rend l'ensemble contradictoire.
+- **A-2** : l'usage est lu par la fonction même de la commande gelée (`lire_dialecte`) : un champ absent vaut ce qu'il vaut pour
+  elle (Argon : `candidatesTokenCount` absent = 0). Les champs bruts sont gardés **tels quels** (absent ≠ nul), avec la liste des
+  champs absents.
+- **a-1** : registre des lancements de la sonde (hors dépôt) : un second lancement sous une ligne de GO déjà employée est refusé
+  avant tout dossier, sauf reprise écrite au registre des décisions (`R-NNNN` qui cite les deux identifiants et les mots
+  « reprise de la sonde »), employée une seule fois.
+- **a-2** : le relevé doit porter l'empreinte de la configuration et celles du code de l'arbre qui le lit ; ses faits sont
+  **relus des pièces** de chaque appel (réponse brute, corps du relais, témoin), chacune égale à son compagnon : un relevé sans
+  ses pièces, ou dont un fait diffère de ses pièces, est refusé (au bloc et au mode réel : le dossier de la sonde accompagne son
+  relevé). La borne de chaque appel est lue de la ligne de la commande et doit être la borne configurée.
+- **a-3** : les faits d'un appel sont tirés de ses pièces : un appel parti puis arrêté sans être porté par l'arrêt est porté au
+  relevé (partiel) avec sa dépense, dès que sa réponse brute existe.
+
+La sonde **n'est jamais jouée par le développeur** : elle dépense, sous deux lignes de GO à part de π1 et π2 (configuration,
+section `sonde` : s1 4,39 USD sur crédits de Claude, s2 3,68 USD hors crédits). Elle ne lit aucun monde ni aucun résultat ;
+elle se fait **avant** le scellement du texte, dont le bloc gelé cite l'empreinte de son relevé. Par relais : un appel à la borne
+gelée (consigne courte, réponse d'un mot demandée) ; avec `--borne-courte`, un second appel à 256 jetons (texte long demandé).
+
+Conclusions par proposeur, toutes exigées vraies par le mode réel : `statut`, `modele_servi_conforme`, `borne_gelee_admise`,
+`raison_arret_normale`, `usage_entier`, `verdict_egal_a_la_regle`, `borne_courte_tronquee` et `borne_tenue` ; Claude en plus :
+`flux_relu_egal`, `effort_admis`. Le mode réel recalcule les conclusions depuis les faits, et les faits depuis les pièces.
+"""
+
+import copy
+import importlib.util
+import json
+import os
+import re
+
+from .outils import sha256_fichier
+from .pilote_mr2_v70 import PROPOSEURS, Refus, exiger_hors_depot
+
+VERSION = "sonde-pilote-v71"
+VERSION_RELEVE = "releve-sonde-pilote-v71"
+RELEVE = "releve-sonde-pilote-v71.json"
+APPELS = ("borne_gelee", "borne_courte")
+MARGE_FORMAT = 16  # jetons comptés hors du texte visible (forme du message), au plus — A-1
+IDENTITE = ("modele", "dialecte", "url_amont", "reglages", "borne_sortie_jetons", "variable_cle", "variable_espace")
+CONCLUSIONS_EXIGEES = ("statut", "modele_servi_conforme", "borne_gelee_admise", "raison_arret_normale", "usage_entier",
+                       "verdict_egal_a_la_regle", "borne_courte_tronquee", "borne_tenue")
+CONCLUSIONS_CLAUDE = ("flux_relu_egal", "effort_admis")
+REGLE_DU_VERDICT = {"comprise": True, "sans_champ": True, "non_comprise": False}
+CHAMPS_ATTENDUS = {"claude": ("input_tokens", "output_tokens"),
+                   "gemini": ("promptTokenCount", "candidatesTokenCount", "thoughtsTokenCount", "totalTokenCount"),
+                   "astra": ("prompt_tokens", "completion_tokens", "completion_tokens_details.reasoning_tokens", "total_tokens")}
+REPRISE = "reprise de la sonde"
+_COMMANDES = {}
+
+
+def _entier(x):
+    return isinstance(x, int) and not isinstance(x, bool) and x >= 0
+
+
+def _commande(conf):
+    """Le module de la commande gelée (ses règles M-1 et d-6 sur l'identifiant servi, sa lecture de l'usage), chargé une fois
+    depuis son chemin ; non inscrit dans `sys.modules`."""
+    chemin = conf["commande"]["chemin_absolu"]
+    if chemin not in _COMMANDES:
+        s = importlib.util.spec_from_file_location("commande_pilote_sonde_v71", chemin)
+        m = importlib.util.module_from_spec(s)
+        s.loader.exec_module(m)
+        _COMMANDES[chemin] = m
+    return _COMMANDES[chemin]
+
+
+# --- usage : champs bruts tels quels, lecture par la commande gelée (A-2) ----------------------------------------------------
+
+def usage_brut(dialecte, corps):
+    """A-2 : l'objet d'usage du fournisseur **tel quel** (copie ; None s'il est absent) : un champ absent reste absent."""
+    corps = corps if isinstance(corps, dict) else {}
+    return copy.deepcopy(corps.get("usageMetadata" if dialecte == "gemini" else "usage"))
+
+
+def champs_absents(dialecte, u):
+    """Les champs d'usage attendus du dialecte qui manquent à l'objet brut (`a.b` : champ b de l'objet a)."""
+    u = u if isinstance(u, dict) else {}
+    out = []
+    for k in CHAMPS_ATTENDUS[dialecte]:
+        a, _, b = k.partition(".")
+        if a not in u or (b and not (isinstance(u[a], dict) and b in u[a])):
+            out.append(k)
+    return out
+
+
+def corps_reduit(dialecte, u):
+    """Un corps du fournisseur réduit à son usage brut, lisible par `lire_dialecte` (rien d'autre n'y est lu pour les jetons)."""
+    if dialecte == "claude":
+        return {"content": [], "stop_reason": None, "usage": u}
+    if dialecte == "gemini":
+        return {"candidates": [{}], "usageMetadata": u}
+    return {"choices": [{}], "usage": u}
+
+
+def lecture_de_la_commande(conf, dialecte, corps, comprise):
+    """(texte visible, jetons {entree, sortie, reflexion, regle}) par `lire_dialecte` de la commande gelée ; (None, None) si le
+    corps est illisible pour elle."""
+    try:
+        texte, _, _, jetons, _ = _commande(conf).lire_dialecte(dialecte, corps, comprise)
+    except (ValueError, KeyError, IndexError, TypeError, AttributeError):
+        return None, None
+    return texte, jetons
+
+
+def jetons_de_l_usage(conf, dialecte, u, comprise):
+    """A-2 : les jetons que la commande gelée lit de cet usage brut (même fonction que le pilote), ou None."""
+    return lecture_de_la_commande(conf, dialecte, corps_reduit(dialecte, u), comprise)[1]
+
+
+def usage_entier(conf, dialecte, u, comprise):
+    """A-2 : l'usage est entier au sens de la commande (entrée et sortie comptées entières ; sinon elle rend `usage_absent`)."""
+    j = jetons_de_l_usage(conf, dialecte, u, comprise)
+    return j is not None and _entier(j["entree"]) and _entier(j["sortie"])
+
+
+def sortie_comptee(conf, dialecte, u, comprise):
+    """A-2 : la sortie comptée par la commande gelée selon la règle de la configuration, ou None."""
+    j = jetons_de_l_usage(conf, dialecte, u, comprise)
+    return j["sortie"] if j is not None and _entier(j["sortie"]) else None
+
+
+# --- verdict sur la réflexion (A-1) ---------------------------------------------------------------------------------------------
+
+def champs(dialecte, u):
+    """(entrée, sortie du fournisseur c, réflexion t, total) avec les valeurs par défaut de la commande gelée (Argon : candidats
+    et pensées absents = 0 ; Astra : réflexion absente ou nulle = 0)."""
+    u = u if isinstance(u, dict) else {}
+    if dialecte == "gemini":
+        return (u.get("promptTokenCount"), u.get("candidatesTokenCount", 0), u.get("thoughtsTokenCount", 0),
+                u.get("totalTokenCount"))
+    det = u.get("completion_tokens_details")
+    det = det if isinstance(det, dict) else {}
+    return u.get("prompt_tokens"), u.get("completion_tokens"), det.get("reasoning_tokens") or 0, None
+
+
+def verdict_reflexion(dialecte, u, octets_visibles):
+    """A-1 : le champ de sortie du fournisseur compte-t-il déjà la réflexion ? Par appel : « comprise », « non_comprise »,
+    « contradictoire » ou « indetermine » ; Claude : « sans_champ » (aucun compte séparé). Votes, chacun sûr sous sa seule
+    hypothèse :
+    - Argon, `totalTokenCount` entier et réflexion t > 0 : total = entrée + c + t → non comprise ; total = entrée + c et t ≤ c →
+      comprise ;
+    - t > c → non comprise (comprise, c compterait t) ;
+    - t > 0 et c − t ≤ O + 16 < c (O : octets du texte visible) → comprise (ajoutée, c ne compterait que le texte visible : au plus
+      un jeton par octet, plus 16 jetons de forme).
+    Un seul vote : ce verdict ; deux votes différents : « contradictoire » ; aucun : « indetermine »."""
+    if dialecte == "claude":
+        return "sans_champ"
+    p, c, t, total = champs(dialecte, u)
+    if not (_entier(c) and _entier(t)) or t == 0:
+        return "indetermine"
+    votes = set()
+    if dialecte == "gemini" and _entier(total) and _entier(p):
+        if total == p + c + t:
+            votes.add("non_comprise")
+        elif total == p + c and t <= c:
+            votes.add("comprise")
+    if t > c:
+        votes.add("non_comprise")
+    elif _entier(octets_visibles) and c - t <= octets_visibles + MARGE_FORMAT < c:
+        votes.add("comprise")
+    if len(votes) == 1:
+        return votes.pop()
+    return "contradictoire" if votes else "indetermine"
+
+
+def verdict_d_ensemble(verdicts):
+    """Un verdict par appel → un verdict : « contradictoire » si un appel l'est ou si les verdicts tranchés divergent ; le seul
+    verdict tranché sinon ; « indetermine » si aucun ne tranche."""
+    if "contradictoire" in verdicts:
+        return "contradictoire"
+    tranches = {v for v in verdicts if v in REGLE_DU_VERDICT}
+    if len(tranches) == 1:
+        return tranches.pop()
+    return "contradictoire" if tranches else "indetermine"
+
+
+# --- flux de Claude, relu indépendamment ---------------------------------------------------------------------------------------
+
+def relire_flux(flux):
+    """Le flux SSE brut de l'interface Messages, relu ici sans `lire_flux_anthropic` : identifiant, raison d'arrêt (dernière non
+    nulle), texte des blocs `text`, usage (celui de `message_start` mis à jour par chaque `message_delta`), événements vus."""
+    modele, raison, usage, textes, evenements, usage_delta = None, None, {}, {}, [], False
+    for ligne in (flux or "").splitlines():
+        if not ligne.startswith("data:"):
+            continue
+        d = json.loads(ligne[5:].strip())
+        t = d.get("type")
+        evenements.append(t)
+        if t == "message_start":
+            modele = (d.get("message") or {}).get("model")
+            usage.update((d.get("message") or {}).get("usage") or {})
+        elif t == "content_block_delta" and (d.get("delta") or {}).get("type") == "text_delta":
+            textes[d["index"]] = textes.get(d["index"], "") + d["delta"]["text"]
+        elif t == "message_delta":
+            if (d.get("delta") or {}).get("stop_reason") is not None:
+                raison = d["delta"]["stop_reason"]
+            if d.get("usage"):
+                usage.update(d["usage"])
+                usage_delta = True
+    return {"modele": modele, "raison_arret": raison, "texte": "".join(textes[i] for i in sorted(textes)),
+            "usage": {k: usage.get(k) for k in ("input_tokens", "output_tokens")}, "evenements": sorted(set(evenements)),
+            "usage_dans_message_delta": usage_delta}
+
+
+def comparer_flux(flux, corps):
+    """Le flux relu ici contre le message que le relais a reconstitué : identifiant, raison d'arrêt, texte, usage."""
+    try:
+        r = relire_flux(flux)
+    except (ValueError, KeyError, TypeError, AttributeError) as e:
+        return {"egal": False, "erreur": type(e).__name__}
+    corps = corps if isinstance(corps, dict) else {}
+    texte = "".join(b.get("text", "") for b in corps.get("content") or [] if isinstance(b, dict) and b.get("type") == "text")
+    u = corps.get("usage") or {}
+    ecarts = [k for k, a, b in (("modele", r["modele"], corps.get("model")), ("raison_arret", r["raison_arret"], corps.get("stop_reason")),
+                                ("texte", r["texte"], texte),
+                                ("usage", r["usage"], {k: u.get(k) for k in ("input_tokens", "output_tokens")})) if a != b]
+    return {"egal": not ecarts and r["usage_dans_message_delta"], "ecarts": ecarts, "evenements": r["evenements"],
+            "usage_dans_message_delta": r["usage_dans_message_delta"]}
+
+
+# --- faits d'un appel, tirés de ses pièces (a-2, a-3) ---------------------------------------------------------------------------
+
+def _compagnon_egal(chemin):
+    try:
+        with open(chemin + ".sha256", encoding="utf-8") as f:
+            return f.read().split()[0] == sha256_fichier(chemin)
+    except (OSError, IndexError):
+        return False
+
+
+def _lire_piece(chemin):
+    """Une pièce scellée d'un appel : présente, égale à son compagnon, JSON ; rend (objet, empreinte)."""
+    nom = os.path.join(*chemin.split(os.sep)[-3:])
+    if not os.path.isfile(chemin):
+        raise Refus(f"pièce de la sonde absente : {nom}")
+    if not _compagnon_egal(chemin):
+        raise Refus(f"pièce de la sonde ≠ son compagnon : {nom}")
+    try:
+        with open(chemin, encoding="utf-8") as f:
+            return json.load(f), sha256_fichier(chemin)
+    except ValueError:
+        raise Refus(f"pièce de la sonde illisible : {nom}") from None
+
+
+def dossier_d_un_appel(racine, nom, quoi):
+    """Le dossier d'un appel : `racine/proposeur/appel` (disposition fixe : rien n'est lu ailleurs)."""
+    if nom not in PROPOSEURS or quoi not in APPELS:
+        raise Refus(f"appel de la sonde inconnu : {nom!r}, {quoi!r}")
+    return os.path.join(racine, nom, quoi)
+
+
+def faits_depuis_les_pieces(conf, nom, quoi, racine):
+    """Les faits d'un appel, tirés de ses seules pièces (réponse brute écrite par l'adaptateur, corps du relais écrit par la
+    commande, témoin d'isolement), chacune égale à son compagnon : code, état, cause, raison d'arrêt, identifiant servi, coût et
+    borne de la dernière ligne de la commande (comme l'adaptateur les lit) ; statut de l'amont, usage brut, drapeau du pire cas et
+    flux de Claude du corps du relais ; octets du texte visible et jetons par la commande gelée."""
+    p = conf["proposeurs"][nom]
+    d = p["dialecte"]
+    dossier = dossier_d_un_appel(racine, nom, quoi)
+    rep, sha_rep = _lire_piece(os.path.join(dossier, "reponse-brute.json"))
+    rep = rep if isinstance(rep, dict) else {}
+    der = rep.get("derniere_ligne") if isinstance(rep.get("derniere_ligne"), dict) else {}
+    code = rep.get("code")
+    rel, sha_corps = {}, None
+    if rep.get("corps_relais_sha256") is not None:
+        rel, sha_corps = _lire_piece(os.path.join(dossier, "corps-relais.json"))
+        if sha_corps != rep["corps_relais_sha256"]:
+            raise Refus(f"pièce de la sonde : corps du relais de {nom}, {quoi} ≠ empreinte de sa réponse brute")
+        rel = rel if isinstance(rel, dict) else {}
+    tem = os.path.join(dossier, "temoin-isolement.json")
+    sha_tem = _lire_piece(tem)[1] if os.path.exists(tem) else None
+    corps = rel.get("corps")
+    u = usage_brut(d, corps)
+    texte, _ = lecture_de_la_commande(conf, d, corps, p["reflexion_comprise"]) if isinstance(corps, dict) else (None, None)
+    octets = len(texte.encode("utf-8")) if isinstance(texte, str) else None
+    faits = {"proposeur": nom, "appel": quoi, "borne": der.get("borne_sortie"), "consigne_sha256": der.get("consigne_sha256"),
+             "code": code, "etat": der.get("etat") if code == 0 else "echec", "cause": der.get("cause"),
+             "raison_arret": der.get("raison_arret"), "modele_servi": der.get("modele_servi"),
+             "modele_servi_conforme": bool(_commande(conf).modele_conforme(p["modele"], der.get("modele_servi"))),
+             "cout_usd": float(der.get("cout_usd") or 0.0),
+             "statut_amont": rel.get("statut_amont"), "type_erreur": rel.get("type_erreur"),
+             "au_dessus_du_pire_cas": rel.get("au_dessus_du_pire_cas"),
+             "usage_brut": u, "champs_absents": champs_absents(d, u), "octets_visibles": octets,
+             # lus pour Lazar, jamais repris par les conclusions (recalculées des champs bruts) :
+             "usage_entier": usage_entier(conf, d, u, p["reflexion_comprise"]),
+             "sortie_comptee": sortie_comptee(conf, d, u, p["reflexion_comprise"]),
+             "verdict_reflexion": verdict_reflexion(d, u, octets),
+             "pieces": {"reponse_brute_sha256": sha_rep, "corps_relais_sha256": sha_corps, "temoin_sha256": sha_tem}}
+    if d == "claude":
+        faits["flux"] = comparer_flux(rel.get("flux"), corps)
+    return faits
+
+
+def conclusions(conf, nom, faits):
+    """Les conclusions d'un proposeur, depuis ses faits (un ou deux appels) ; verdict, usage et sortie comptée **recalculés**
+    depuis les champs d'usage bruts et les octets visibles (jamais repris des valeurs dérivées écrites au relevé) ; bornes
+    comparées à la configuration."""
+    p = conf["proposeurs"][nom]
+    d = p["dialecte"]
+    bc = conf["sonde"]["borne_courte_jetons"]
+    f1 = next((f for f in faits if f.get("appel") == "borne_gelee"), None)
+    f2 = next((f for f in faits if f.get("appel") == "borne_courte"), None)
+    tous = [f for f in (f1, f2) if f is not None]
+    verdict = verdict_d_ensemble([verdict_reflexion(d, f.get("usage_brut"), f.get("octets_visibles")) for f in tous])
+    sortie2 = sortie_comptee(conf, d, f2.get("usage_brut"), p["reflexion_comprise"]) if f2 is not None else None
+    c = {"statut": bool(tous) and all(f.get("statut_amont") == 200 and f.get("etat") in ("complet", "tronque") for f in tous),
+         "modele_servi_conforme": bool(tous) and all(f.get("modele_servi_conforme") is True for f in tous),
+         "borne_gelee_admise": f1 is not None and f1.get("statut_amont") == 200 and f1.get("borne") == p["borne_sortie_jetons"],
+         "raison_arret_normale": f1 is not None and f1.get("etat") == "complet",
+         "usage_entier": bool(tous) and all(usage_entier(conf, d, f.get("usage_brut"), p["reflexion_comprise"]) for f in tous),
+         "verdict_reflexion": verdict, "regle_configuree": p["reflexion_comprise"],
+         "verdict_egal_a_la_regle": REGLE_DU_VERDICT.get(verdict) is p["reflexion_comprise"],
+         "borne_courte_tronquee": f2 is not None and f2.get("etat") == "tronque",
+         "borne_tenue": f2 is not None and f2.get("borne") == bc and _entier(sortie2) and sortie2 <= bc,
+         "en_tete_d_espace": p["variable_espace"] is not None,
+         "au_dessus_du_pire_cas": any(f.get("au_dessus_du_pire_cas") for f in tous)}
+    if d == "claude":
+        c["flux_relu_egal"] = bool(tous) and all((f.get("flux") or {}).get("egal") is True for f in tous)
+        c["effort_admis"] = f1 is not None and f1.get("statut_amont") == 200 and "output_config" in p["reglages"]
+    return c
+
+
+def conclusions_exigees(dialecte):
+    return CONCLUSIONS_EXIGEES + (CONCLUSIONS_CLAUDE if dialecte == "claude" else ())
+
+
+def releve(conf, faits, borne_courte, debut, fin, partiel, arret, extra):
+    """Le relevé de la sonde (scellé par le lanceur) : identité de chaque proposeur, faits par appel, conclusions."""
+    out = {"version": VERSION_RELEVE, "module": VERSION, "debut_utc": debut, "fin_utc": fin, "partiel": partiel, "arret": arret,
+           "borne_courte": borne_courte,
+           "identite": {n: {k: conf["proposeurs"][n][k] for k in IDENTITE} for n in PROPOSEURS},
+           "pieces_sha256": {"commande": conf["commande"]["sha256"], "relais": conf["relais"]["sha256"]},
+           "appels": faits,
+           "conclusions": {n: conclusions(conf, n, [f for f in faits if f.get("proposeur") == n]) for n in PROPOSEURS}}
+    out.update(extra)
+    return out
+
+
+def exiger_releve(conf, chemin, attendu):
+    """D-4 : le mode réel (et le bloc gelé qui le cite) exige un relevé de la sonde : présent, égal à son compagnon, complet,
+    fait avec l'appel à borne courte, par la commande et le relais de cette configuration, **sous cette configuration et ce code**
+    (`attendu` : {configuration_sha256, code_sha256} de l'arbre qui lit ; a-2), pour l'identité de chaque proposeur ; deux appels
+    par proposeur ; conclusions recalculées depuis ses faits égales aux siennes et toutes vraies ; **chaque fait égal aux faits
+    relus de ses pièces** (dossier de la sonde à côté du relevé ; a-2). Rend l'empreinte du relevé ; Refus sinon."""
+    if not chemin or not os.path.isfile(chemin):
+        raise Refus("relevé de la sonde absent : le mode réel l'exige (D-4)")
+    if not _compagnon_egal(chemin):
+        raise Refus("relevé de la sonde ≠ son compagnon")
+    try:
+        with open(chemin, encoding="utf-8") as f:
+            r = json.load(f)
+    except ValueError:
+        raise Refus("relevé de la sonde illisible") from None
+    if not isinstance(r, dict) or r.get("version") != VERSION_RELEVE:
+        raise Refus(f"relevé de la sonde : version « {VERSION_RELEVE} » exigée")
+    if r.get("partiel") is not False or r.get("borne_courte") is not True:
+        raise Refus("relevé de la sonde partiel ou sans l'appel à borne courte (le plafond n'y est pas éprouvé)")
+    if r.get("pieces_sha256") != {"commande": conf["commande"]["sha256"], "relais": conf["relais"]["sha256"]}:
+        raise Refus("relevé de la sonde fait par une autre commande ou un autre relais")
+    if r.get("configuration_sha256") != attendu["configuration_sha256"]:  # a-2
+        raise Refus("relevé de la sonde fait sous une autre configuration")
+    if r.get("code_sha256") != attendu["code_sha256"]:  # a-2
+        raise Refus("relevé de la sonde fait par un autre code")
+    faits = r.get("appels")
+    if not isinstance(faits, list) or not all(isinstance(f, dict) for f in faits) \
+            or len(faits) != len(PROPOSEURS) * len(APPELS):
+        raise Refus("relevé de la sonde : appels absents ou en nombre faux")
+    for nom in PROPOSEURS:
+        p = conf["proposeurs"][nom]
+        if (r.get("identite") or {}).get(nom) != {k: p[k] for k in IDENTITE}:
+            raise Refus(f"relevé de la sonde : identité de {nom} ≠ configuration")
+        a_lui = [f for f in faits if f.get("proposeur") == nom]
+        if sorted(str(f.get("appel")) for f in a_lui) != sorted(APPELS):
+            raise Refus(f"relevé de la sonde : {nom} sans ses deux appels")
+        try:
+            recalculees = conclusions(conf, nom, a_lui)
+        except (KeyError, TypeError, AttributeError):
+            raise Refus(f"relevé de la sonde : faits de {nom} illisibles") from None
+        if (r.get("conclusions") or {}).get(nom) != recalculees:
+            raise Refus(f"relevé de la sonde : conclusions de {nom} ≠ celles de ses faits")
+        manque = [k for k in conclusions_exigees(p["dialecte"]) if recalculees.get(k) is not True]
+        if manque:
+            raise Refus(f"relevé de la sonde : {nom} ne confirme pas {manque} (verdict sur la réflexion : "
+                        f"{recalculees['verdict_reflexion']}, règle gelée : {p['reflexion_comprise']})")
+    racine = os.path.dirname(os.path.abspath(chemin))
+    for f in faits:  # a-2 : les faits sont ceux des pièces
+        if f != faits_depuis_les_pieces(conf, f["proposeur"], f["appel"], racine):
+            raise Refus(f"relevé de la sonde : faits de {f['proposeur']}, {f['appel']} ≠ ceux de ses pièces")
+    return sha256_fichier(chemin)
+
+
+# --- registre des lancements de la sonde (a-1) ----------------------------------------------------------------------------------
+
+def lancements_de_la_sonde(registre):
+    """Les lancements consignés (une ligne JSON par lancement) ; [] si le registre n'existe pas encore."""
+    if not os.path.exists(registre):
+        return []
+    try:
+        with open(registre, encoding="utf-8") as f:
+            out = [json.loads(ligne) for ligne in f if ligne.strip()]
+    except (OSError, ValueError):
+        raise Refus("registre des lancements de la sonde illisible") from None
+    if not all(isinstance(x, dict) and isinstance(x.get("go"), list) for x in out):
+        raise Refus("registre des lancements de la sonde : ligne sans « go »")
+    return out
+
+
+def exiger_premier_lancement(registre, identifiants, reprise=None, registre_decisions=None):
+    """a-1 : avant tout dossier et tout relais. Registre hors dépôt (chemin absolu, hors de tout dépôt git). Si l'un des
+    identifiants de GO a déjà servi à un lancement consigné : refus, sauf reprise écrite — `reprise` (R-NNNN) est une seule
+    ligne du registre des décisions, qui cite les deux identifiants et les mots « reprise de la sonde », et n'a jamais servi.
+    Une reprise sans lancement antérieur sous ces lignes est refusée. Rend la reprise admise, ou None."""
+    exiger_hors_depot(registre, "registre des lancements de la sonde")
+    deja = lancements_de_la_sonde(registre)
+    vus = {i for x in deja for i in x["go"]}
+    if not set(identifiants) & vus:
+        if reprise is not None:
+            raise Refus("sonde : --reprise sans lancement antérieur sous ces lignes de GO")
+        return None
+    if reprise is None:
+        raise Refus(f"sonde : déjà lancée sous {sorted(set(identifiants) & vus)} (une seule exécution par ligne ; une reprise "
+                    f"exige --reprise R-NNNN écrite au registre des décisions)")
+    if not (isinstance(reprise, str) and re.fullmatch(r"R-\d+", reprise)):
+        raise Refus("sonde : --reprise R-NNNN exigé")
+    if any(x.get("reprise") == reprise for x in deja):
+        raise Refus(f"sonde : la reprise {reprise} a déjà servi")
+    if not registre_decisions or not os.path.isfile(registre_decisions):
+        raise Refus("sonde : --reprise exige --registre-decisions (le registre des décisions)")
+    with open(registre_decisions, encoding="utf-8") as f:
+        lignes = [ligne for ligne in f if ligne.startswith(f"| {reprise} |")]
+    if len(lignes) != 1 or REPRISE not in lignes[0] or not all(i in lignes[0] for i in identifiants):
+        raise Refus(f"sonde : {reprise} n'est pas une seule ligne du registre des décisions citant les deux lignes de GO et "
+                    f"« {REPRISE} »")
+    return reprise
+
+
+def consigner_lancement(registre, identifiants, sortie, debut, reprise):
+    """a-1 : le lancement consigné quand les relais sont prêts, avant le premier appel (comme le pilote, m-6)."""
+    with open(registre, "a", encoding="utf-8") as f:
+        f.write(json.dumps({"go": list(identifiants), "debut_utc": debut, "sortie": os.path.abspath(sortie), "reprise": reprise,
+                            "module": VERSION}, ensure_ascii=False) + "\n")
+
+
+__all__ = [n for n in dir() if not n.startswith("_")]
