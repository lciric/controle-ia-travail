+def sonde(args):
+    """D-4 : la sonde payante (jamais jouée par le développeur). Configuration gelée de l'arbre seulement ; deux lignes de GO à part
+    lues au montant exact ; registre des lancements (a-1) : un second lancement sous une ligne déjà employée est refusé, sauf
+    reprise écrite ; relais lancés ici (clés par leur nom, plafond = part de la sonde, un ou deux appels) et contrôlés champ par
+    champ en mode réel ; le lancement consigné quand les relais sont prêts ; par relais, la consigne courte à la borne gelée puis,
+    avec `--borne-courte`, la consigne longue à 256 jetons, par la chaîne du pilote ; faits tirés des pièces de chaque appel
+    (a-2, a-3) ; relevé scellé. Tout arrêt après le premier appel laisse un relevé partiel, que le mode réel refuse."""
+    debut = maintenant()
+    conf, _ = PR.lire_configuration(CONFIGURATION)
+    if os.path.exists(args.sortie):
+        raise P.Refus("sonde : dossier de sortie existant")
+    go = PR.lire_go_de_la_sonde(conf, args.registre_go, args.go_sonde_credits, args.go_sonde_hors)
+    identifiants = [args.go_sonde_credits, args.go_sonde_hors]
+    reprise = S.exiger_premier_lancement(args.registre_lancements, identifiants, args.reprise, args.registre_decisions)  # a-1
+    s = conf["sonde"]
+    n_appels = 2 if args.borne_courte else 1
+    parts = PR.parts_de_la_sonde(conf)
+    os.makedirs(args.sortie)
+    jeton = PR.nouveau_jeton()
+    procs, faits, relais, arret = {}, [], None, None
+    en_cours, partis = None, False
+    try:
+        for nom in P.PROPOSEURS:
+            p = conf["proposeurs"][nom]
+            procs[nom], _ = PR.lancer_relais(conf, nom, os.path.join(args.sortie, f"journal-relais-{nom}.jsonl"), p["dialecte"],
+                                             jeton, python=sys.executable, plafond=parts[nom], max_appels=n_appels)
+        relais = PR.exiger_relais_prets(conf, "reel", plafonds=parts, max_appels=n_appels)
+        S.consigner_lancement(args.registre_lancements, identifiants, args.sortie, debut, reprise)  # a-1, avant le premier appel
+        for nom in P.PROPOSEURS:
+            p = conf["proposeurs"][nom]
+            for quoi in S.APPELS[:n_appels]:
+                borne = p["borne_sortie_jetons"] if quoi == "borne_gelee" else s["borne_courte_jetons"]
+                en_cours, partis = (nom, quoi), True
+                PR.appeler(conf, nom, s["consignes"][quoi], S.dossier_d_un_appel(args.sortie, nom, quoi), jeton,
+                           python=sys.executable, borne=None if quoi == "borne_gelee" else borne)
+                faits.append(S.faits_depuis_les_pieces(conf, nom, quoi, args.sortie))  # a-2 : les faits sont ceux des pièces
+                en_cours = None
+    except (PR.ArretPilote, Exception) as e:  # noqa: BLE001 — tout arrêt après le premier appel laisse un relevé partiel
+        arret = f"{type(e).__name__} : {e}"
+        if en_cours is not None and os.path.isfile(os.path.join(S.dossier_d_un_appel(args.sortie, *en_cours),
+                                                                "reponse-brute.json")):
+            try:  # a-3 : l'appel parti est porté au relevé, sa dépense comptée, que l'arrêt le porte ou non
+                faits.append(S.faits_depuis_les_pieces(conf, en_cours[0], en_cours[1], args.sortie))
+            except (P.Refus, KeyError, TypeError, ValueError, OSError) as e2:
+                arret += f" ; pièces de l'appel en cours illisibles : {e2}"
