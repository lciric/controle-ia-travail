+def lire(args):
+    """C-14 : la lecture = le champ `regle` de la sortie de la mesure ; exige la pièce de `mesurer` (M-5), la sortie égale à son
+    compagnon et à la pièce, le programme, la liste **complète** des modules importés (m-13), les cartes du manifeste, le
+    manifeste égal à son compagnon et à celui de la mesure, et (D-3) les mondes mesurés égaux à ceux du manifeste."""
+    piece_f = os.path.join(args.sortie, "mesure-pilote-v70.json")
