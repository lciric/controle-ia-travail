+def mesurer(args):
+    """M-5 : la mesure **une seule fois** : `CARTES.json` égal à son compagnon et au manifeste, manifeste égal au sien (W5) ;
+    D-3 : le fichier des mondes est celui du manifeste (empreinte du fichier, empreintes des mondes) ; aucune sortie de mesure
+    déjà présente ; programme `676d5f37…` lancé sans copie ; sortie scellée ; pièce de liaison scellée (empreintes des cartes, du
+    programme, de la sortie, du manifeste)."""
+    cartes = os.path.join(args.sortie, "CARTES.json")
+    man = os.path.join(args.sortie, "manifeste-pilote-v70.json")
+    with open(man, encoding="utf-8") as f:
+        manifeste = json.load(f)
+    if manifeste.get("partiel") or not os.path.isfile(cartes) or not PR._compagnon_egal(cartes) \
+            or sha256_fichier(cartes) != manifeste.get("cartes_sha256") or not PR._compagnon_egal(man):
+        raise P.Refus("mesure : CARTES.json ≠ son compagnon ou le manifeste, manifeste ≠ son compagnon (ou relevé partiel)")
+    mondes_du_manifeste = (manifeste.get("controles") or {}).get("mondes") or {}
+    if args.mondes_sha256 != mondes_du_manifeste.get("fichier_mondes_sha256"):
+        raise P.Refus("mesure : fichier des mondes ≠ celui du manifeste (D-3)")
+    deja = [n for n in os.listdir(args.sortie) if n.startswith("sortie-mesure") or n.startswith("mesure-pilote-v70")]
+    if deja:
+        raise P.Refus(f"mesure : déjà lancée dans ce dossier ({deja}) : une seule fois")
+    if sha256_fichier(PROGRAMME_MESURE) != P.FICHIERS_MR2["pilote-v1/outils/mesure_pilote_v4.py"]:
+        raise P.Refus("mesure : programme ≠ 676d5f37…")
+    P.charger_mondes_prives(args.mondes, args.mondes_sha256, list((mondes_du_manifeste.get("mondes_sha256") or {}).values()))
+    sortie = os.path.join(args.sortie, "sortie-mesure-pilote-v70.json")
+    debut = maintenant()
+    r = subprocess.run([sys.executable, "-I", "-B", PROGRAMME_MESURE, "mesurer", args.mondes, cartes, sortie],
+                       capture_output=True, text=True, encoding="utf-8", env={"PATH": "/usr/bin:/bin", "OMP_NUM_THREADS": "2"})
+    if r.returncode != 0 or not os.path.isfile(sortie):
+        raise PR.ArretPilote(f"mesure : programme en erreur (code {r.returncode}) : {r.stderr[-300:]}")
+    with open(sortie + ".sha256", "x", encoding="utf-8") as f:
+        f.write(f"{sha256_fichier(sortie)}  {os.path.basename(sortie)}\n")
+    piece = {"version": VERSION, "debut_utc": debut, "fin_utc": maintenant(), "cartes_sha256": sha256_fichier(cartes),
+             "programme_sha256": sha256_fichier(PROGRAMME_MESURE), "sortie": os.path.basename(sortie),
+             "sortie_sha256": sha256_fichier(sortie), "manifeste_sha256": sha256_fichier(man),
+             "fichier_mondes_sha256": args.mondes_sha256}
+    imprimer(dict(piece, piece_sha256=ecrire(os.path.join(args.sortie, "mesure-pilote-v70.json"), piece)))
+    return 0
