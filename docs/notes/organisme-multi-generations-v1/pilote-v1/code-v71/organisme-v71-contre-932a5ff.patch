+REGLE_DOUBLURE = {"claude": True, "gemini": False, "astra": True}  # les règles de comptage de la configuration v11
+
+
+class Doublure:
+    """Doublure des trois fournisseurs (essais seulement), sur la boucle locale : Messages en flux, generateContent, chat
+    completions ; elle vérifie la clé de chaque requête (valeurs factices posées par l'essai) et garde ce qu'elle a reçu. Un texte
+    servi reçoit des cartes factices (« k1_plus ») ; une consigne de la sonde reçoit « OK » (borne gelée) ou un texte coupé à la
+    borne (borne courte), avec de la réflexion comptée selon la règle de la configuration."""
+
+    def __init__(self, cles):
+        import threading
+        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+        R = charger_relais_module()
+        self.recues, self.cles = [], cles
+        self.surcharge = {}  # {(dialecte, borne courte) : corps(modèle, consigne, max)} — relevés du contre-lecteur (A-1, A-2)
+        doublure = self
+
+        class G(BaseHTTPRequestHandler):
+            def log_message(self, *x):
+                pass
+
+            def do_POST(self):
+                corps = json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))))
+                if self.path == "/v1/messages":
+                    d, cle = "claude", self.headers.get("x-api-key")
+                elif self.path.endswith(":generateContent"):
+                    d, cle = "gemini", self.headers.get("x-goog-api-key")
+                else:
+                    d, cle = "astra", (self.headers.get("Authorization") or "")[len("Bearer "):]
+                modele = corps.get("model") or "gemini-4-argon"
+                consigne = corps["messages"][0]["content"] if d != "gemini" else corps["contents"][0]["parts"][0]["text"]
+                mt = corps.get("max_tokens") or corps.get("max_completion_tokens") or corps["generationConfig"]["maxOutputTokens"]
+                sonde = "```json" not in consigne
+                doublure.recues.append({"dialecte": d, "chemin": self.path, "cle_juste": cle == doublure.cles[d],
+                                        "cles_du_corps": sorted(corps), "corps": corps, "sonde": sonde, "max": mt,
+                                        "version_api": self.headers.get("anthropic-version")})
+                if cle != doublure.cles[d]:
+                    o = b'{"error": {"type": "authentication_error", "message": "organization org-ABCDEF123456"}}'
+                    self.send_response(401)
+                    self.send_header("Content-Length", str(len(o)))
+                    self.end_headers()
+                    self.wfile.write(o)
+                    return
+                if sonde and (d, mt <= 256) in doublure.surcharge:
+                    rep = doublure.surcharge[(d, mt <= 256)](modele, consigne, mt)
+                elif sonde:
+                    rep = doublure.corps_sonde(d, modele, consigne, mt)
+                else:
+                    rep = R.corps_factice(d, modele, consigne, mt, "k1_plus", REGLE_DOUBLURE[d])
+                if d == "claude":
+                    texte = rep["content"][1]["text"]
+                    evs = [{"type": "message_start", "message": {"id": "m", "type": "message", "role": "assistant", "model": modele,
+                                                                 "content": [], "stop_reason": None,
+                                                                 "usage": {"input_tokens": rep["usage"]["input_tokens"],
+                                                                           "output_tokens": 1}}},
+                           {"type": "ping"},
+                           {"type": "content_block_start", "index": 0, "content_block": {"type": "thinking", "thinking": ""}},
+                           {"type": "content_block_stop", "index": 0},
+                           {"type": "content_block_start", "index": 1, "content_block": {"type": "text", "text": ""}},
+                           {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": texte[:50]}},
+                           {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": texte[50:]}},
+                           {"type": "content_block_stop", "index": 1},
+                           {"type": "message_delta", "delta": {"stop_reason": rep["stop_reason"], "stop_sequence": None},
+                            "usage": {"output_tokens": rep["usage"]["output_tokens"]}},
+                           {"type": "message_stop"}]
+                    o = "".join(f"event: {e['type']}\ndata: {json.dumps(e)}\n\n" for e in evs).encode()
+                    typ = "text/event-stream"
+                else:
+                    o, typ = json.dumps(rep).encode(), "application/json"
+                self.send_response(200)
+                self.send_header("Content-Type", typ)
+                self.send_header("Content-Length", str(len(o)))
+                self.end_headers()
+                self.wfile.write(o)
+        self.serveur = ThreadingHTTPServer(("127.0.0.1", 0), G)
+        self.port = self.serveur.server_address[1]
+        threading.Thread(target=self.serveur.serve_forever, daemon=True).start()
+
+    @staticmethod
+    def corps_sonde(d, modele, consigne, mt):
+        """« OK » sous la borne gelée ; texte coupé à la borne courte. Réflexion : 40 jetons (borne gelée), 200 (borne courte)."""
+        courte = mt <= 256
+        entree = len(consigne.encode("utf-8")) // 3 + 5
+        visibles, pensee = (mt - 200, 200) if courte else (2, 40)
+        texte = "x " * visibles if courte else "OK"
+        if d == "claude":
+            return {"model": modele, "stop_reason": "max_tokens" if courte else "end_turn",
+                    "content": [{"type": "thinking", "thinking": ""}, {"type": "text", "text": texte}],
+                    "usage": {"input_tokens": entree, "output_tokens": visibles + pensee}}
+        if d == "gemini":  # réflexion hors de candidatesTokenCount ; totalTokenCount = prompt + candidats + pensées
+            return {"modelVersion": modele, "candidates": [{"finishReason": "MAX_TOKENS" if courte else "STOP", "content": {
+                "role": "model", "parts": [{"text": "réflexion", "thought": True}, {"text": texte}]}}],
+                    "usageMetadata": {"promptTokenCount": entree, "candidatesTokenCount": visibles, "thoughtsTokenCount": pensee,
+                                      "totalTokenCount": entree + visibles + pensee}}
+        return {"model": modele, "choices": [{"index": 0, "finish_reason": "length" if courte else "stop",
+                                              "message": {"role": "assistant", "content": texte, "refusal": None}}],
+                "usage": {"prompt_tokens": entree, "completion_tokens": visibles + pensee,
+                          "completion_tokens_details": {"reasoning_tokens": pensee}, "total_tokens": entree + visibles + pensee}}
+
+    def fermer(self):
+        self.serveur.shutdown()
+        self.serveur.server_close()
+
