+        self.assertEqual(V("gemini", {"promptTokenCount": 10, "candidatesTokenCount": 42, "thoughtsTokenCount": 40,
+                                      "totalTokenCount": 92}, 2), "contradictoire")  # le total dit ajoutée, la longueur comprise
+        self.assertEqual(V("gemini", {"promptTokenCount": 10, "candidatesTokenCount": 60, "thoughtsTokenCount": 40,
