+    def executer_doublure(self, temoin=None, brut=True, brut_sha=True, compagnon_faux=False, etat="complet", fichier_session=False,
+                          consigne=None):
+        """Une doublure de la commande (essais seulement) : écrit un corps du relais et rend une dernière ligne choisie."""
+        sha_texte = hashlib.sha256(self.texte.encode()).hexdigest()
+        consigne = sha_texte if consigne is None else consigne
+        tr = {"relais": "relais-pilote-v70-astra", "consigne_recue_sha256": sha_texte, "outils": [], "messages": 1, "systeme": None,
+              "appelant": "astra", "reglages": {}, "corps_amont_sha256": "x"}
+        tr.update(temoin or {})
+
+        def executer(cmd, **k):
+            chemin = cmd[cmd.index("--sortie-brute") + 1]
+            sha = None
+            if brut:
+                octets = b'{"corps": {}}'
+                open(chemin, "wb").write(octets)
+                sha = hashlib.sha256(octets).hexdigest()
+                open(chemin + ".sha256", "w").write(("0" * 64 if compagnon_faux else sha) + "  corps-relais.json\n")
+            if fichier_session:
+                open(os.path.join(k["cwd"], "trace.txt"), "w").write("x")
+
+            class R:
+                returncode, stderr = 0, ""
+                stdout = json.dumps({"etat": etat, "texte": "[]", "cout_usd": 0.1, "consigne_sha256": consigne,
+                                     "brut_sha256": sha if brut_sha else None, "temoin_relais": tr})
+            return R()
+        return executer
+
+    def test_sain_doublure(self):
+        a = PR.appeler(self.conf, "astra", self.texte, os.path.join(self.d, "sd", "astra"), "j", python=sys.executable,
+                       executer=self.executer_doublure())
+        self.assertEqual(a["etat"], "complet")
