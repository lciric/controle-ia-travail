+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+T = "essais/test_pilote_mr2_v71.py"
+PC, PR, AU, LA = "pole/pilote_mr2_v70.py", "pole/proposeurs_pilote_v70.py", "pole/audit_pilote_v70.py", "demonstrations/pilote_mr2_v71.py"
+SO = "pole/sonde_pilote_v71.py"
+CO, RE = "exemples/pilote-mr2-v70/commandes/commande_pilote_v70.py", "exemples/pilote-mr2-v70/commandes/relais_pilote_v70.py"
+CONF = "exemples/pilote-mr2-v70/configuration-pilote-mr2-v11.json"
+
+
+def M(ident, fichier, avant, apres, selection, attendu):
+    return {"id": ident, "fichier": fichier, "avant": avant, "apres": apres, "selection": selection, "attendu": attendu}
