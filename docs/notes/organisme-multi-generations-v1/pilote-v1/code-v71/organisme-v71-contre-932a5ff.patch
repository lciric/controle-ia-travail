+    extra = {"lanceur": VERSION, "configuration_sha256": PR.empreinte_configuration(conf), "code_sha256": empreintes_du_code(),
+             "environnement_de_calcul": environnement_de_calcul(), "go": go, "reprise": reprise, "relais": relais,
