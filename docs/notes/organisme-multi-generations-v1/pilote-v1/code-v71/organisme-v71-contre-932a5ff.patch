+        self.assertEqual(V("claude", {}, 2), "sans_champ")
+        self.assertEqual(V("astra", a(42, 40), 2), "comprise")  # « OK » et 40 jetons de réflexion comptés dans la sortie
+        self.assertEqual(V("astra", a(2, 40), 2), "non_comprise")
+        self.assertEqual(V("astra", a(3, 2), 2), "indetermine")  # E2a, appel d'un mot
+        self.assertEqual(V("astra", a(130, 126), 260), "indetermine")  # E2a, appel court : 130 jetons visibles possibles
+        self.assertEqual(V("astra", a(130, 126), 0), "comprise")  # rien de visible : la sortie compte la réflexion
+        self.assertEqual(V("astra", a(2, 0), 2), "indetermine")  # E2b
+        self.assertEqual(V("astra", a(2, 300), 2), "non_comprise")  # E2c
+        self.assertEqual(V("astra", a(256, 256), 0), "comprise")  # toute la borne courte en réflexion
+        self.assertEqual(V("astra", a(19, 17), 2), "comprise")  # 19 > 2 + 16 ≥ 2
+        self.assertEqual(V("astra", a(18, 16), 2), "indetermine")  # 18 ≤ 2 + 16 : 18 jetons visibles possibles
+        self.assertEqual(V("astra", a(300, 40), 2), "indetermine")  # 260 jetons hors réflexion pour 2 octets : ni l'une ni l'autre
+        self.assertEqual(V("astra", a(42, 40), None), "indetermine")  # texte illisible
+        self.assertEqual(V("astra", {"completion_tokens": None, "completion_tokens_details": {"reasoning_tokens": 40}}, 2),
+                         "indetermine")
+        self.assertEqual(V("astra", {"completion_tokens": 42}, 2), "indetermine")  # réflexion absente : 0 (commande)
+        g = {"promptTokenCount": 10, "candidatesTokenCount": 2, "thoughtsTokenCount": 40}
+        self.assertEqual(V("gemini", dict(g, totalTokenCount=52), 2), "non_comprise")
+        self.assertEqual(V("gemini", {"promptTokenCount": 10, "candidatesTokenCount": 2, "thoughtsTokenCount": 0,
+                                      "totalTokenCount": 12}, 2), "indetermine")  # aucune réflexion : rien à trancher
+        self.assertEqual(V("gemini", {"promptTokenCount": 10, "candidatesTokenCount": 42, "thoughtsTokenCount": 40,
