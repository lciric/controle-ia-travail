+    def test_registre_des_lancements(self):
+        """a-1, fonctions : registre hors dépôt, premier lancement, second refusé, reprise écrite une fois."""
+        d = dossier_prive()
+        try:
+            reg = os.path.join(d, "lancements.jsonl")
+            ids = ["GO-2026-11-13-04", "GO-2026-11-13-05"]
+            with self.assertRaisesRegex(P.Refus, "chemin absolu"):
+                S.exiger_premier_lancement("lancements.jsonl", ids)
+            with self.assertRaisesRegex(P.Refus, "dans l'arbre"):
+                S.exiger_premier_lancement(os.path.join(RACINE, "lancements.jsonl"), ids)
+            self.assertIsNone(S.exiger_premier_lancement(reg, ids))
+            with self.assertRaisesRegex(P.Refus, "sans lancement antérieur"):
+                S.exiger_premier_lancement(reg, ids, "R-1")
+            S.consigner_lancement(reg, ids, os.path.join(d, "s"), "debut", None)
+            with self.assertRaisesRegex(P.Refus, "déjà lancée"):
+                S.exiger_premier_lancement(reg, ids)
+            with self.assertRaisesRegex(P.Refus, "déjà lancée"):
+                S.exiger_premier_lancement(reg, ["GO-2026-11-13-09", ids[1]])
+            dec = os.path.join(d, "decisions.md")
+            open(dec, "w", encoding="utf-8").write(f"| R-1 | x | reprise de la sonde, {ids[0]}, {ids[1]} | d |\n"
+                                                   f"| R-2 | x | reprise de la sonde, {ids[0]} seul | d |\n")
+            with self.assertRaisesRegex(P.Refus, "une seule ligne"):
+                S.exiger_premier_lancement(reg, ids, "R-2", dec)
+            self.assertEqual(S.exiger_premier_lancement(reg, ids, "R-1", dec), "R-1")
+            S.consigner_lancement(reg, ids, os.path.join(d, "s2"), "debut", "R-1")
+            with self.assertRaisesRegex(P.Refus, "déjà servi"):
+                S.exiger_premier_lancement(reg, ids, "R-1", dec)
+            with open(reg, "a", encoding="utf-8") as f:
+                f.write("pas du json\n")
+            with self.assertRaisesRegex(P.Refus, "illisible"):
+                S.exiger_premier_lancement(reg, ids)
+        finally:
+            shutil.rmtree(d)
 
