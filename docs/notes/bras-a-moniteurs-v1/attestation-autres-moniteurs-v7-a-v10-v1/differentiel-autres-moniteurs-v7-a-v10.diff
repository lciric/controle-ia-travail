+    """Comptes des lectures de la sortie : pour chaque moniteur à modèle de langue et chaque condition lue, les cinq
+    clés que rend `comptes_des_lectures`, des entiers ; les tables des états de la balise et des jointures n'ont pour
+    clés que des éléments de leurs listes fermées. Aucun texte libre."""
+    if not (isinstance(c, dict) and set(c) == set(PRODUCTEURS)):
+        raise GardeArret("sortie : comptes des lectures hors format")
+    for m, par_condition in c.items():
+        if not (isinstance(par_condition, dict) and set(par_condition) == set(ROLES_LUS)):
+            raise GardeArret(f"sortie : comptes des lectures du moniteur {m} : une entrée par condition lue attendue")
+        for x in par_condition.values():
+            if not (isinstance(x, dict) and tuple(x) == CLES_COMPTES_DES_LECTURES
+                    and all(_entier(x[k]) for k in ("lectures", "masse_faible", "sans_score"))
+                    and isinstance(x["balise"], dict) and set(x["balise"]) <= set(ETATS_BALISE)
+                    and isinstance(x["jointure"], dict) and set(x["jointure"]) <= set(JOINTURES)
+                    and all(_entier(v) for v in list(x["balise"].values()) + list(x["jointure"].values()))):
+                raise GardeArret(f"sortie : comptes des lectures du moniteur {m} hors format (cinq clés, des entiers, "
+                                 "états et jointures en listes fermées)")
