+def assembler_la_sortie(plis: dict, lectures: dict, programmes_de_production: dict, permutation: str, n_perm: int,
+                        n_tirages: int, autres: dict, exclues: dict, preuve_d_ordre: dict, scores_par_unite: dict,
+                        comptes: dict) -> dict:
+    """La sortie de la lecture commune, dans l'ordre de `CLES_SORTIE`, passée par sa garde de forme."""
+    sortie = {"plis": plis, "lectures": lectures,
+              "piece_source": {"sha256": empreinte_du_module(), "production": programmes_de_production},
+              "reglages": {"n_permutations": int(n_perm), "n_tirages": int(n_tirages),
+                           "taille_de_la_famille": TAILLE_FAMILLE, "niveau": NIVEAU,
+                           "statistique_agregateur": ETIQUETTE_STATISTIQUE,
+                           "doses_de_la_famille": list(DOSES[1:]), "dose_pour_information": DOSES[0],
+                           "permutation": permutation, "unite_de_la_permutation": PERMUTATIONS[permutation]},
+              # la somme et le maximum de l'agrégateur, toujours : une aire (ou nul) par dose, sans état, sans valeur p
+              "agregateur_somme_sans_etat": autres["somme"],
+              "agregateur_maximum_sans_etat": autres["max"],
+              "exclues": exclues, "preuve_d_ordre": preuve_d_ordre, "scores_par_unite": scores_par_unite,
+              "comptes_des_lectures": comptes, "nombres_rendus": list(NOMBRES_RENDUS)}
+    exiger_sortie(sortie)
+    return sortie
