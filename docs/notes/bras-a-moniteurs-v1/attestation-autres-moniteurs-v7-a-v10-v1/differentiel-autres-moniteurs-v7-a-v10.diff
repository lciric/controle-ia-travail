+    u = sortie["scores_par_unite"]
+    if not (isinstance(u, dict) and set(u) == {"fichier", "sha256", "lignes", "champs", "forme"}
+            and u["forme"] in FORMES and (u["fichier"], tuple(u["champs"])) == FORMES[u["forme"]]
+            and _SHA.fullmatch(str(u["sha256"])) and _entier(u["lignes"])):
+        raise GardeArret("sortie : scores_par_unite hors format")
