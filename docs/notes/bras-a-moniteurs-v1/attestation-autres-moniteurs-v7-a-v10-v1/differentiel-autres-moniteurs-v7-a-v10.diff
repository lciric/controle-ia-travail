+def ecrire_la_sortie(dossier: str | Path, sortie: dict) -> dict:
+    """Écrit et scelle la sortie sous `FICHIER_SORTIE` (on n'écrase jamais), après sa garde de forme. Flottants à leur
+    écriture décimale la plus courte (sérialisation JSON de Python), sans arrondi ; la relecture rend la même sortie."""
+    exiger_sortie(sortie)
+    chemin = Path(dossier) / FICHIER_SORTIE
+    if chemin.exists() or Path(str(chemin) + ".sha256").exists():
+        raise GardeArret(f"{chemin} existe déjà : on n'écrase jamais (R12)")
+    try:
+        texte = json.dumps(sortie, ensure_ascii=False, indent=1, allow_nan=False) + "\n"
+    except ValueError:
+        raise GardeArret("sortie : un nombre non fini ne s'écrit pas : refusée") from None
+    if json.loads(texte) != sortie:
+        raise GardeArret("sortie : la relecture de son écriture ne rend pas la même sortie")
+    Path(dossier).mkdir(parents=True, exist_ok=True)
+    chemin.write_text(texte, encoding="utf-8")
+    return {"fichier": FICHIER_SORTIE, "sha256": sceller(chemin)}
 
 
