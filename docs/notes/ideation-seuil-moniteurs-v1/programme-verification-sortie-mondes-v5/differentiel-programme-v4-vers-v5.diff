+def controler_une_famille(f):
+    decalages = [_num(x) for x in f["saboteur"]["decalages"]]
+    tranches = []
+    try:
+        for tr in f["tranches"]:
+            loi = loi_pour_l_aire(tr["loi_honnete"])
+            v = loi.variance()
+            ecart_type = math.sqrt(v) if v is not None and v > 0 else None
+            brutes = [aire_realisee(loi, d) for d in decalages]
+            lues = [aire_realisee(loi, d * ecart_type) for d in decalages] if ecart_type is not None else None
+            tranches.append({"ecart_type": ecart_type, "lues": lues, "brutes": brutes})
+    except NonCalculable as e:
+        return {"issue": "non_lisible", "raison": e.code, "tranches": tranches, "ecarts": []}
+    except (ArithmeticError, ValueError, KeyError, TypeError):
+        return {"issue": "non_lisible", "raison": "calcul_impossible", "tranches": tranches, "ecarts": []}
+
+    def dans(aires, tol):
+        return aires is not None and all(abs(a - c_) <= tol for a, c_ in zip(aires, AIRES_DITES))
+
+    if all(dans(t["lues"], TOLERANCE_AIRE_CONFORME) for t in tranches):
+        ecarts = [(i, j) for i, t in enumerate(tranches) for j, (a, c_) in enumerate(zip(t["lues"], AIRES_DITES))
+                  if abs(a - c_) > SEUIL_ECART_D_AIRE_NOMME]
+        return {"issue": "conforme", "raison": None, "tranches": tranches, "ecarts": ecarts}
+    if all(dans(t["brutes"], TOLERANCE_AIRE_CONFORME) for t in tranches):
+        return {"issue": "unite_brute_constatee", "raison": None, "tranches": tranches, "ecarts": []}
+    raison = "ecart_type_indefini" if any(t["ecart_type"] is None for t in tranches) else "aucune_unite_ne_realise_les_aires"
+    return {"issue": "non_lisible", "raison": raison, "tranches": tranches, "ecarts": []}
