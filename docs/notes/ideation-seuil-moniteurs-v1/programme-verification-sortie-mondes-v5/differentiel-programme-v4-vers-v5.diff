+class NonCalculable(Exception):
+    def __init__(self, code):
+        super().__init__(code)
+        self.code = code
+
+
+def _phi(x):
+    return 0.5 * math.erfc(-x / math.sqrt(2.0))
+
+
+def _beta_reguliere(a, b, x):
+    """Fonction bêta incomplète régularisée I_x(a, b), fraction continue de Lentz."""
+    if x <= 0.0:
+        return 0.0
+    if x >= 1.0:
+        return 1.0
+    ln_avant = math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b) + a * math.log(x) + b * math.log1p(-x)
+    if x > (a + 1.0) / (a + b + 2.0):
+        return 1.0 - _beta_reguliere(b, a, 1.0 - x)
+    tiny = 1e-300
+    c, d = 1.0, 1.0 - (a + b) * x / (a + 1.0)
+    d = 1.0 / (d if abs(d) > tiny else tiny)
+    h = d
+    for m in range(1, 400):
+        m2 = 2 * m
+        aa = m * (b - m) * x / ((a + m2 - 1.0) * (a + m2))
+        d = 1.0 + aa * d
+        d = 1.0 / (d if abs(d) > tiny else tiny)
+        c = 1.0 + aa / c if abs(c) > tiny else 1.0 + aa / tiny
+        h *= d * c
+        aa = -(a + m) * (a + b + m) * x / ((a + m2) * (a + m2 + 1.0))
+        d = 1.0 + aa * d
+        d = 1.0 / (d if abs(d) > tiny else tiny)
+        c = 1.0 + aa / c if abs(c) > tiny else 1.0 + aa / tiny
+        delta = d * c
+        h *= delta
+        if abs(delta - 1.0) < 1e-15:
+            break
+    return math.exp(ln_avant) * h / a
+
+
+class LoiContinue:
+    """Loi continue pour le contrôle par l'aire : cdf, pdf, moyenne et variance (None si infinie)."""
+    reseau = False
+
+    def quantile(self, u):
+        lo, hi = -1.0, 1.0
+        while self.cdf(lo) > u:
+            lo *= 2.0
+            if lo < -1e15:
+                raise NonCalculable("calcul_impossible")
+        while self.cdf(hi) < u:
+            hi *= 2.0
+            if hi > 1e15:
+                raise NonCalculable("calcul_impossible")
+        for _ in range(200):
+            mi = 0.5 * (lo + hi)
+            if self.cdf(mi) < u:
+                lo = mi
+            else:
+                hi = mi
+            if hi - lo <= 1e-12 * max(1.0, abs(mi)):
+                break
+        return 0.5 * (lo + hi)
+
+
+class NormaleA(LoiContinue):
+    def __init__(self, mu, sigma):
+        if not sigma > 0:
+            raise NonCalculable("loi_hors_du_controle")
+        self.mu, self.sigma = mu, sigma
+
+    def cdf(self, x):
+        return _phi((x - self.mu) / self.sigma)
+
+    def pdf(self, x):
+        z = (x - self.mu) / self.sigma
+        return math.exp(-0.5 * z * z) / (self.sigma * math.sqrt(2.0 * math.pi))
+
+    def moyenne(self):
+        return self.mu
+
+    def variance(self):
+        return self.sigma ** 2
+
+
+class StudentA(LoiContinue):
+    def __init__(self, nu, mu, echelle):
+        if not (nu > 0 and echelle > 0):
+            raise NonCalculable("loi_hors_du_controle")
+        self.nu, self.mu, self.e = nu, mu, echelle
+        self.c = math.exp(math.lgamma((nu + 1) / 2.0) - math.lgamma(nu / 2.0)) / math.sqrt(nu * math.pi)
+
+    def cdf(self, x):
+        t = (x - self.mu) / self.e
+        queue = 0.5 * _beta_reguliere(self.nu / 2.0, 0.5, self.nu / (self.nu + t * t))
+        return 1.0 - queue if t > 0 else queue
+
+    def pdf(self, x):
+        t = (x - self.mu) / self.e
+        return self.c * (1.0 + t * t / self.nu) ** (-(self.nu + 1) / 2.0) / self.e
+
+    def moyenne(self):
+        return self.mu if self.nu > 1 else None
+
+    def variance(self):
+        return self.e ** 2 * self.nu / (self.nu - 2.0) if self.nu > 2 else None
+
+
+class LaplaceA(LoiContinue):
+    def __init__(self, mu, b):
+        if not b > 0:
+            raise NonCalculable("loi_hors_du_controle")
+        self.mu, self.b = mu, b
+
+    def cdf(self, x):
+        z = (x - self.mu) / self.b
+        return 0.5 * math.exp(z) if z < 0 else 1.0 - 0.5 * math.exp(-z)
+
+    def pdf(self, x):
+        return math.exp(-abs(x - self.mu) / self.b) / (2.0 * self.b)
+
+    def moyenne(self):
+        return self.mu
+
+    def variance(self):
+        return 2.0 * self.b ** 2
+
+
+class LognormaleA(LoiContinue):
+    def __init__(self, mu, sigma):
+        if not sigma > 0:
+            raise NonCalculable("loi_hors_du_controle")
+        self.mu, self.sigma = mu, sigma
+
+    def cdf(self, x):
+        return 0.0 if x <= 0 else _phi((math.log(x) - self.mu) / self.sigma)
+
+    def pdf(self, x):
+        if x <= 0:
+            return 0.0
+        z = (math.log(x) - self.mu) / self.sigma
+        return math.exp(-0.5 * z * z) / (x * self.sigma * math.sqrt(2.0 * math.pi))
+
+    def moyenne(self):
+        return math.exp(self.mu + self.sigma ** 2 / 2.0)
+
+    def variance(self):
+        return (math.exp(self.sigma ** 2) - 1.0) * math.exp(2.0 * self.mu + self.sigma ** 2)
+
+
+class MelangeA(LoiContinue):
+    def __init__(self, poids, composantes):
+        if any(c_.reseau for c_ in composantes) or abs(sum(poids) - 1.0) > 1e-9 or any(w < 0 for w in poids):
+            raise NonCalculable("loi_hors_du_controle")
+        self.w, self.c = poids, composantes
+
+    def cdf(self, x):
+        return sum(w * c_.cdf(x) for w, c_ in zip(self.w, self.c))
+
+    def pdf(self, x):
+        return sum(w * c_.pdf(x) for w, c_ in zip(self.w, self.c))
+
+    def moyenne(self):
+        ms = [c_.moyenne() for c_ in self.c]
+        return None if any(m is None for m in ms) else sum(w * m for w, m in zip(self.w, ms))
+
+    def variance(self):
+        ms, vs = [c_.moyenne() for c_ in self.c], [c_.variance() for c_ in self.c]
+        if any(v is None for v in vs) or any(m is None for m in ms):
+            return None
+        m = sum(w * mi for w, mi in zip(self.w, ms))
+        return sum(w * (vi + mi * mi) for w, vi, mi in zip(self.w, vs, ms)) - m * m
+
+
+class DecaleeA(LoiContinue):
+    def __init__(self, base, decalage):
+        self.base, self.s = base, decalage
+
+    def cdf(self, x):
+        return self.base.cdf(x - self.s)
+
+    def pdf(self, x):
+        return self.base.pdf(x - self.s)
+
+    def moyenne(self):
+        m = self.base.moyenne()
+        return None if m is None else m + self.s
+
+    def variance(self):
+        return self.base.variance()
+
+
+class ReseauA:
+    """Loi arrondie au multiple le plus proche du pas (convention déclarée)."""
+    reseau = True
+
+    def __init__(self, base, pas):
+        if base.reseau or not pas > 0:
+            raise NonCalculable("loi_hors_du_controle")
+        lo, hi = base.quantile(1e-15), base.quantile(1.0 - 1e-15)
+        kmin, kmax = int(math.floor(lo / pas)) - 1, int(math.ceil(hi / pas)) + 1
+        if kmax - kmin > POINTS_DE_RESEAU_MAX:
+            raise NonCalculable("calcul_impossible")
+        self.pas, self.kmin = pas, kmin
+        self.masses = [max(0.0, base.cdf((k + 0.5) * pas) - base.cdf((k - 0.5) * pas)) for k in range(kmin, kmax + 1)]
+        total = sum(self.masses)
+        self.masses = [m / total for m in self.masses]
+        self.cumul = []
+        s = 0.0
+        for m in self.masses:
+            s += m
+            self.cumul.append(s)
+
+    def moyenne(self):
+        return sum(m * (self.kmin + i) * self.pas for i, m in enumerate(self.masses))
+
+    def variance(self):
+        mu = self.moyenne()
+        return sum(m * ((self.kmin + i) * self.pas - mu) ** 2 for i, m in enumerate(self.masses))
+
