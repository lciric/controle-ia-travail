+AIRES_DITES = (0.69, 0.80, 0.95)
+TOLERANCE_AIRE_CONFORME = 0.005
+SEUIL_ECART_D_AIRE_NOMME = 0.001
+NOEUDS_DE_QUADRATURE = 2001
+POINTS_DE_RESEAU_MAX = 2000000
