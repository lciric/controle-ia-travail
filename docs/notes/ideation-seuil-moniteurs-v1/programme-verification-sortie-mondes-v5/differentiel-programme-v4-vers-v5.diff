+def _num(x):
+    return float(x)
+
+
+def loi_pour_l_aire(spec, profondeur=0):
+    if profondeur > 12 or not isinstance(spec, dict):
+        raise NonCalculable("loi_hors_du_controle")
+    typ, p = spec.get("type"), spec.get("parametres")
+    if not isinstance(p, dict):
+        raise NonCalculable("loi_hors_du_controle")
+    if typ == "normale":
+        return NormaleA(_num(p["mu"]), _num(p["sigma"]))
+    if typ == "student":
+        return StudentA(_num(p["nu"]), _num(p["mu"]), _num(p["echelle"]))
+    if typ == "laplace":
+        return LaplaceA(_num(p["mu"]), _num(p["echelle"]))
+    if typ == "lognormale":
+        return LognormaleA(_num(p["mu"]), _num(p["sigma"]))
+    if typ == "melange":
+        return MelangeA([_num(w) for w in p["poids"]], [loi_pour_l_aire(c_, profondeur + 1) for c_ in p["composantes"]])
+    if typ == "decalage":
+        base = loi_pour_l_aire(p["loi"], profondeur + 1)
+        v = base.variance()
+        if v is None or base.reseau:
+            raise NonCalculable("loi_hors_du_controle")
+        return DecaleeA(base, _num(p["delta_en_ecarts_types"]) * math.sqrt(v))
+    if typ == "arrondi":
+        return ReseauA(loi_pour_l_aire(p["loi"], profondeur + 1), _num(p["pas_de_grille"]))
+    if typ == "somme_de_pas":
+        pas = loi_pour_l_aire(p["loi_du_pas"], profondeur + 1)
+        if not isinstance(pas, NormaleA):
+            raise NonCalculable("loi_hors_du_controle")
+        nb, r = int(_num(p["nombre_de_pas"])), _num(p["correlation"])
+        if p["structure"] == "ar1":
+            if not -1 < r < 1:
+                raise NonCalculable("loi_hors_du_controle")
+            v = nb + 2 * sum((nb - d) * r ** d for d in range(1, nb))
+        else:
+            v = nb + nb * (nb - 1) * r
+        if not v > 0:
+            raise NonCalculable("loi_hors_du_controle")
+        return NormaleA(nb * pas.mu, pas.sigma * math.sqrt(v))
+    if typ == "effet_de_famille_plus_bruit":
+        return NormaleA(0.0, 1.0)  # CH8 : marginale lue sur la normale réduite (§ 3.2, H : variance 1)
+    raise NonCalculable("loi_hors_du_controle")  # bernoulli, couple, autre
+
