+def aire_realisee(loi, d):
+    """P(X + d > Y) + ½ P(X + d = Y), X et Y indépendants de loi `loi`."""
+    if isinstance(loi, NormaleA):
+        return _phi(d / (loi.sigma * math.sqrt(2.0)))
+    if loi.reseau:
+        v_decalage = d / loi.pas
+        total = 0.0
+        n = len(loi.masses)
+        for i, m in enumerate(loi.masses):
+            v = i + v_decalage
+            j = round(v)
+            if abs(v - j) < 1e-9:
+                inf = loi.cumul[j - 1] if 1 <= j <= n else (0.0 if j < 1 else 1.0)
+                egal = loi.masses[j] if 0 <= j < n else 0.0
+                total += m * (inf + 0.5 * egal)
+            else:
+                f = math.floor(v)
+                total += m * (loi.cumul[f] if 0 <= f < n else (0.0 if f < 0 else 1.0))
+        return total
+    centre = loi.quantile(0.5)
+    echelle = max((loi.quantile(0.75) - loi.quantile(0.25)) / 1.349, 1e-9)
+    t_lo = math.asinh((loi.quantile(1e-12) - centre) / echelle)
+    t_hi = math.asinh((loi.quantile(1.0 - 1e-12) - centre) / echelle)
+    n = NOEUDS_DE_QUADRATURE
+    h = (t_hi - t_lo) / (n - 1)
+    somme = 0.0
+    for i in range(n):
+        t = t_lo + i * h
+        x = centre + echelle * math.sinh(t)
+        g = loi.cdf(x + d) * loi.pdf(x) * echelle * math.cosh(t)
+        poids = 1 if i in (0, n - 1) else (4 if i % 2 else 2)
+        somme += poids * g
+    return somme * h / 3.0
+
