+def _cdf_exacte(n, p, kmax):
+    fr = F(p)
+    a, b = fr.numerator, fr.denominator
+    s = sum(math.comb(n, j) * a ** j * (b - a) ** (n - j) for j in range(kmax + 1))
+    return F(s, b ** n)
+
