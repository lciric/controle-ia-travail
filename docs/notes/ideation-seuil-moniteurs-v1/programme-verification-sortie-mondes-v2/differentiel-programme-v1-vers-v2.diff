+        return None
+    cles = [k for k, v in t09[CLE_VALEURS_DE_PLUS].items()
+            if est_nombre(v) and ("decalage" in normaliser(k) or "derive" in normaliser(k))]
+    return (f, t09[CLE_VALEURS_DE_PLUS][cles[0]]) if len(cles) == 1 else None
