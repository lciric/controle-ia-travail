+def lois_du_monde_m(m, t, choix):
+    if t["signal"] == "somme":  # CH3 : la lettre ne donne pas la loi du signal somme
+        raise NonConvertible("NC_SIGNAL_SOMME_SANS_LOI")
+    choix.add("CH4_POPULATIONS_DU_MONDE_M_DANS_L_ORDRE")
