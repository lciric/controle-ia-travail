+
+def exiger_guide(guide: object) -> dict:
+    """Clé `guide` de la configuration : clés fermées, identifiant, chemins et empreintes exacts. Ne touche à aucun
+    fichier (les octets sont vérifiés par `verifier_les_octets_du_guide`, sur l'instance, avant le chargement)."""
+    if not isinstance(guide, Mapping) or sorted(guide) != sorted(CLES_DU_GUIDE):
+        raise GardeArret(f"configuration : `guide` aux clés {sorted(CLES_DU_GUIDE)} exigé, aucune de plus")
+    attendu = guide_attendu()
+    if guide["identifiant"] != attendu["identifiant"]:
+        raise GardeArret(f"configuration : guide {guide['identifiant']!r} ; seul {attendu['identifiant']!r} est admis")
+    for cle in ("sha256", "index_sha256"):
+        _exiger_empreinte(guide[cle], f"empreinte `guide.{cle}`")
+    for cle in ("fichier", "sha256", "index", "index_sha256"):
+        if guide[cle] != attendu[cle]:
+            raise GardeArret(f"configuration : `guide.{cle}` {guide[cle]!r} ; {attendu[cle]!r} exigé")
+    return dict(guide)
+
