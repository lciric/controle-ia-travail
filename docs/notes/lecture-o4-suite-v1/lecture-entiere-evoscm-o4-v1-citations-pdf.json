 {
  "piece": "EVOSCM",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2609.01526/2609.01526.pdf",
  "empreinte": "4094a67b0dddba479f4fd4d3a01ad03b05e4c93a255956516130f1153296cf98",
  "page": 27,
  "citation": "The maximum population size is Kmax = 6."
