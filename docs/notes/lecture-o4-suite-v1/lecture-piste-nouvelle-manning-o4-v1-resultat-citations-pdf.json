  "empreinte": "c44f50f3fb217788fe19523e77e0818247405e581531c5ad4956037b7e2f6192",
  "page": 50,
  "citation": "With a complete dataset and the proposed SCM, the system can estimate the linear SCM without further queries to an LLM. The system uses the R package lavaan to estimate all paths in the model",
  "sha256_pdf_recalcule": "c44f50f3fb217788fe19523e77e0818247405e581531c5ad4956037b7e2f6192",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   50
  ]
 },
