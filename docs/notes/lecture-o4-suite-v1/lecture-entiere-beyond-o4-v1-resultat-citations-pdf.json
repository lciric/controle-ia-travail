  "page": 16,
  "citation": "A candidate is promoted only if it satisfies minimum statistical thresholds under the fixed protocol.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
