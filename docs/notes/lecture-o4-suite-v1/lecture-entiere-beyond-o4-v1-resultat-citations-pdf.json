   1
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 4,
  "citation": "By applying multiple hypothesis testing adjustments and evaluating out-of-sample signal decay, we demonstrate that the Agentic AI systematically resists p-hacking.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   4
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 4,
  "citation": "This confirms that the agent does not merely repackage known risk premia",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   4
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 10,
  "citation": "In each round, the system generates hypotheses, computes factor values, evaluates candidates under a fixed protocol, applies promotion gates, and updates the next search policy using accumulated evidence.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   10
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 11,
  "citation": "the agent is free to propose new ideas only within explicit scientific constraints",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   11
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 12,
  "citation": "This strict separation between language-based proposal and code-based computation prevents hidden numerical drift",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   12
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 12,
  "citation": "The third module is a unified evaluator, which computes a common metric set for every candidate; no factor receives customized scoring logic.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   12
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 12,
  "citation": "The fourth module is a transparent gatekeeper that converts evaluation outputs into explicit decisions: promote, hold for review, or retire.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   12
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 12,
  "citation": "The fifth module is memory and policy update. It reads structured logs from prior rounds and generates the next candidate set",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   12
  ]
 },
 {
  "piece": "BEYOND",
  "pdf": "docs/sources/pdf/lecture-o4-v1/arxiv-2603.14288/2603.14288v2.pdf",
  "empreinte": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "page": 12,
  "citation": "Our evaluation protocol is pre-committed before iterative search begins.",
  "sha256_pdf_recalcule": "8fe2b21770af074a0e13667048bc40b3eb85fc03ecde8f5d58938e3aa100e301",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   12
  ]
 },
 {
