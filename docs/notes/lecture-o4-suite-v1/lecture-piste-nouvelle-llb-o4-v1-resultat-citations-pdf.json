  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 2,
  "citation": "Our hypothesis is that the distribution defined in Eq. (3) is a good one.",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   2
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 3,
  "citation": "the fundamental difference between the true posterior and “flat” posterior is that the former gives more influence to models that are more consistent with the observed data",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
