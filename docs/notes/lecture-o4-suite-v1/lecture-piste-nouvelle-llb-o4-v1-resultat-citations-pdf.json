  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 5,
  "citation": "any future work in this direction should not use these problems for evaluation with any LLM with a knowledge cutoff after the date this paper was first made public",
