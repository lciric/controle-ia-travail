  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 2,
  "citation": "Denote the informal user text as t and a formal model as m.",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
