  "page": 1,
  "citation": "combines a large language model and a probabilistic programming language to define a joint distribution over formal models, latent variables, and data",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
