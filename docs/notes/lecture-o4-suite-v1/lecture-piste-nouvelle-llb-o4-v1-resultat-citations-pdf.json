   1
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 1,
  "citation": "generating many formal models from the large language model, performing approximate inference on each, and then doing a weighted average",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   1
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 1,
  "citation": "this produces sensible predictions from only data and an informal problem description, without the need to specify a formal model",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   1
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 2,
  "citation": "Given informal user text, an LLM generates a set of candidate formal models. Inference is performed on each and the posteriors are combined with weight proportional to the marginal likelihood.",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   2
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 2,
  "citation": "Note that the final posterior in Eq. (4) can be seen as an instance of Bayesian model averaging",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   2
  ]
 },
 {
  "piece": "LLB",
  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2504.14025/2504.14025v2.pdf",
  "empreinte": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "page": 2,
  "citation": "just with a prior over models that’s defined using an LLM",
  "sha256_pdf_recalcule": "7c0eee0567fc0c547ad0724ea1df385265c8f80778b3a6cfa6c46b06af2ead4a",
  "empreinte_conforme": true,
  "trouvee_sur_la_page": true,
  "pages_ou_trouvee": [
   2
  ]
 },
 {
