  "empreinte": "d338d13e08302df0f5d38c8886449eebe30ebd1a20d29390757658644ec50b7e",
  "page": 13,
  "citation": "Unlike many big data and machine learning methods, empirical Bayes has a transparent intuition.",
  "sha256_pdf_recalcule": "d338d13e08302df0f5d38c8886449eebe30ebd1a20d29390757658644ec50b7e",
