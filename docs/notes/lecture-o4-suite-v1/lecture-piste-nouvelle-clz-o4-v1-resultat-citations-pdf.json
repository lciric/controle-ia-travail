  "page": 1,
  "citation": "Mining 29,000 accounting ratios for t-statistics > 2.0 leads to cross-sectional return predictability similar to the peer review process.",
  "sha256_pdf_recalcule": "e8f061ef05e4449475ee4dbd8924e6f971f372969112dbb39f8f1cb716bbc89a",
  "empreinte_conforme": true,
