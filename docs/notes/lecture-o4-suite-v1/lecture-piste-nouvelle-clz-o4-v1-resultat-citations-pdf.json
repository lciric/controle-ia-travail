  "pdf": "docs/sources/pdf/lecture-o4-v3/arxiv-2212.10317/2212.10317v7.pdf",
  "empreinte": "e8f061ef05e4449475ee4dbd8924e6f971f372969112dbb39f8f1cb716bbc89a",
  "page": 23,
  "citation": "The alternatives come from searching the 29,000 accounting ratios for t-stats and mean returns that are within 10% and 30% of the original findings.",
  "sha256_pdf_recalcule": "e8f061ef05e4449475ee4dbd8924e6f971f372969112dbb39f8f1cb716bbc89a",
