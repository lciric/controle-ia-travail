[
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 1,
  "citation": "A Probabilistic Framework for LLM-Based Model Discovery"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 1,
  "citation": "ModelSMC represents candidate models as particles which are iteratively proposed and refined by an LLM, and weighted using likelihood-based criteria."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 2,
  "citation": "particles whose code is iteratively proposed and modified by an LLM, evaluated using likelihood-based criteria, and resampled to focus on promising (i.e., high-marginal likelihood) regions of the model space"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 2,
  "citation": "In ModelSMC, models are propagated by LLM sampling and weighted by likelihood evaluation."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 3,
  "citation": "where candidate models are evaluated via marginal likelihoods or Bayes factors"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "initial particle and weight (m0 , w0 = 1)"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "Compute surrogate likelihood"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "If the ESS is below a threshold"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "to rebalance the population by discarding low-weight particles"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "Selection among clones is handled implicitly by resampling based on likelihood weights."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 4,
  "citation": "it also contains LLM-based performance assessments of the ancestors and task-specific information"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 5,
  "citation": "Each generated model mik is assigned a weight proportional to the likelihood of the observed data"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 5,
  "citation": "Unlike explicit tempering, this annealing occurs in the proposal distribution rather than the target, and without formal variance-control guarantees."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 5,
  "citation": "We note that the trained likelihood estimation is an approximation of the true likelihood"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 5,
  "citation": "the theorem is best understood as a proof of concept"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 6,
  "citation": "Thus, once the ground-truth model is proposed by the LLM, ModelSMC reliably identifies it."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 7,
  "citation": "Taking the baseline HH model, ModelSMC is tasked with inferring additional ion-channel mechanisms that improve model specification and reduce systematic mismatch to data."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 8,
  "citation": "The unextended base model itself receives comparably low weights, reflecting its already high fidelity, but is consistently outperformed by IM extensions."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 8,
  "citation": "comparing the baseline HH model to the best model identified in the selected run"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 8,
  "citation": "We apply a three-step LLM-assisted pipeline to all 1,445 particles across 10 seeds."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 8,
  "citation": "Third, weights are compared across subtypes"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 9,
  "citation": "posterior weights rely on surrogate likelihoods, which may introduce bias under misspecification"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 9,
  "citation": "We emphasize that our primary contribution is methodological"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 9,
  "citation": "while posterior weights enable principled ranking and clustering of hypotheses"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 15,
  "citation": "Within individual discovery runs, the same language model is used for propagation and feedback generation"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 16,
  "citation": "ModelSMC omits the correction factor"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 17,
  "citation": "This assumption cannot be verified formally"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 20,
  "citation": "In a single LLM call, the system description, the simulator code, and the numerical evaluation metrics are jointly provided to the LLM"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 23,
  "citation": "Unless stated otherwise, the temperature is set to τ = 1 in all experiments."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 27,
  "citation": "which consists of 10 in-vitro recordings from a mouse cortex"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 27,
  "citation": "The dataset is originally from Dluhy et al. (1972)"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 28,
  "citation": "All 1,445 particles are classified in batches via an LLM call per batch"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 30,
  "citation": "Best-performing particles are selected according to the metric which was applied to weight particles during the discovery process."
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 31,
  "citation": "no statistically significant difference can be established from ten discovery runs per method"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 34,
  "citation": "Model performance assessed on held-out voltage recordings via these summary statistics"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 54,
  "citation": "Metrics: neg_avg_log_marginal_NLE: 35.3, neg_log_marginal_NLE: 353, timeout_evidence_estimation: 0"
 },
 {
  "piece": "WAHL",
  "pdf": "docs/sources/pdf/lecture-o4-v2/arxiv-2602.18266/2602.18266.pdf",
  "empreinte": "618c93eb4c37e65673f7119e90edac1c1893fda95dec0466947fc9ce3e695302",
  "page": 55,
  "citation": "Change E_K to -90.0 mV"
 }
]