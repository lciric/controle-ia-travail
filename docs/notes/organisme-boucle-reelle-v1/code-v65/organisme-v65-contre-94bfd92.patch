+    comptes = {"proposees": len(reels), "refusees_au_gardien": len(refusees), "jugees": len(passees), "m_e_bh": m,
+               "promues": len(promues), "testees": len(verdicts), "retenues": len(retenues), "plantees_promues": len(promues_p),
