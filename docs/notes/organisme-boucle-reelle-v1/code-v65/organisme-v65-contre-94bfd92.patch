+                           "prix_entree_kimi_usd_par_million_jetons": None, "prix_entree_argon_usd_par_million_jetons": None})()
+    return LANCEUR.L64.roles_a_blanc(ns, tempfile.mkdtemp(prefix="roles-v65-"))
