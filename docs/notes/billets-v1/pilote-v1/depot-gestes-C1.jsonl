{"codeur": "C1", "billet": "B881516", "geste": "G14", "modalite": "trois-éléments", "appui": "Vicuna 13B […] 50 truth/lie generation", "doute": false}
{"codeur": "C1", "billet": "B881516", "geste": "G15", "modalite": "aucune", "appui": "", "doute": false}
{"codeur": "C1", "billet": "B881516", "geste": "G16", "modalite": "absentes", "appui": "", "doute": false}
{"codeur": "C1", "billet": "B881516", "geste": "G17", "modalite": "section", "appui": "It probably goes without saying that the model is not perfect.", "doute": false}
{"codeur": "C1", "billet": "B881516", "geste": "G18", "modalite": "mentionnées", "appui": "It seems unlikely that a downstream classifier could reliably differentiate based on this", "doute": true}
{"codeur": "C1", "billet": "B881516", "geste": "G19", "modalite": "aucune", "appui": "", "doute": false}
{"codeur": "C1", "billet": "B881516", "geste": "G20", "modalite": "appel-aux-autres", "appui": "alignment research along these lines that was heretofore only possible in major industrial labs is now accessible to a wider group of academics and researchers", "doute": true}
