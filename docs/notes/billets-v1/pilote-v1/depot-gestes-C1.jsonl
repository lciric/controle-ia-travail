{"codeur": "C1", "billet": "B544303", "geste": "G08", "modalite": "présente-l-article", "appui": "You can read more in our ICML 2025 manuscript", "doute": false}
{"codeur": "C1", "billet": "B544303", "geste": "G09", "modalite": "organisation", "appui": "our mission is to develop a principled science of the representations and emergent behaviors of AI systems", "doute": true}
{"codeur": "C1", "billet": "B544303", "geste": "G10", "modalite": "absent", "appui": "", "doute": false}
