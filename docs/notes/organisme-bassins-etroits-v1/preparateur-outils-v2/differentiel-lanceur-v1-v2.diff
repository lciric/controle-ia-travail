+                              str(r.orchestrateur), str(dossier)], cwd=str(r.orchestrateur), env=env, stdout=fo, stderr=fe,
+                             stdin=subprocess.DEVNULL, start_new_session=True)
+    return {"pid": p.pid, "debut_proc": debut_processus(p.pid), "dossier": str(dossier),
