+class TestLanceursNeufs(CasAvecDossier):
+    """Lanceurs neufs : `--juge-externe` à étiquette répétée refusé à la lecture des arguments (code 2), rien écrit ; sinon
+    le lanceur d'origine est appelé lui-même, mêmes arguments."""
+    FICHIERS = ("ideation_v2_juges_externes_uniques_v1.py", "ideation_v1_juges_externes_uniques_v1.py")
+
+    def argv(self, sortie, *externes):
+        r = [sortie, "--bras-rapporte-differe", "--attestation-lecture-humaine", os.path.join(self.tmp, "att.json")]
+        for j in externes:
+            r += ["--juge-externe", j]
+        return r
+
+    REPETEES = (("argon-juge=gemini-4-argon", "argon-juge=gemini-x"), ("argon-juge=m", "argon-juge=m"),
+                ("gemini-4-argon", "externe-1=gemini-x"),  # étiquette par défaut externe-1 répétée
+                (" argon-juge = m1", "argon-juge=m2"))      # blancs retirés comme le lanceur les retire
+
+    def test_repetee_refusee_en_processus_sans_appel_du_lanceur(self):
+        for fichier in self.FICHIERS:
+            mod = charger_lanceur(fichier)
+            appels = []
+            mod.LANCEUR.principal = lambda argv=None: appels.append(argv) or 0
+            for externes in self.REPETEES:
+                with self.subTest(fichier=fichier, externes=externes):
+                    sortie = os.path.join(self.tmp, "sortie-absente")
+                    with self.assertRaises(SystemExit) as cm:
+                        mod.principal(self.argv(sortie, *externes))
+                    self.assertEqual(cm.exception.code, 2)
+                    self.assertEqual(appels, [])
+                    self.assertFalse(os.path.exists(sortie))
+            # étiquettes distinctes : le lanceur d'origine est appelé lui-même, mêmes arguments
+            argv = self.argv(os.path.join(self.tmp, "s"), "argon-juge=gemini-4-argon", "autre-juge=gemini-x")
+            self.assertEqual(mod.principal(argv), 0)
+            self.assertEqual(appels, [argv])
+            # le lanceur d'origine, lui, lit la liste répétée sans erreur d'argument (le défaut passait par là)
+            mod.LANCEUR.construire_analyseur().parse_args(self.argv("s", *self.REPETEES[0]))
+
+    def test_repetee_refusee_par_la_ligne_de_commande(self):
+        for fichier in self.FICHIERS:
+            with self.subTest(fichier=fichier):
+                sortie = os.path.join(self.tmp, "sortie-" + fichier[:12])
+                p = subprocess.run([sys.executable, "-I", "-B", os.path.join(ORCH, "demonstrations", fichier)]
+                                   + self.argv(sortie, *self.REPETEES[0]) + ["--commande-externe", "/bin/false"],
+                                   capture_output=True, text=True, timeout=120, env={"PATH": "/usr/bin:/bin"})
+                self.assertEqual(p.returncode, 2, p.stderr[-500:])
+                self.assertIn("étiquettes de juges externes en double", p.stderr)
+                self.assertIn("'argon-juge'", p.stderr)
+                self.assertEqual(p.stdout, "")
+                self.assertFalse(os.path.exists(sortie))
+
