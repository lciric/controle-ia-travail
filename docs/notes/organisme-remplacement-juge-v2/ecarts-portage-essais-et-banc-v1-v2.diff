+class TestGardeEtiquettesPure(unittest.TestCase):
+    def test_etiquettes_repetees(self):
+        f = brj.etiquettes_repetees
+        self.assertEqual(f([]), [])
+        self.assertEqual(f(()), [])
+        self.assertEqual(f([("a", "m", None), ("b", "m", None)]), [])
+        self.assertEqual(f([("a", "m", None), ("a", "m2", None)]), ["a"])
+        self.assertEqual(f([["a", "m", None], ("a", "m2", None)]), ["a"])
+        self.assertEqual(f([("b", 1, 2), ("a", 1, 2), ("a", 1, 2), ("b", 1, 2), ("a", 1, 2)]), ["a", "b"])
+        # formes non inspectées : objet non itérable, itérateur (non consommé), entrée hors de la forme (étiquette, modèle, x)
+        self.assertEqual(f(None), [])
+        it = iter([("a", "m", None), ("a", "m", None)])
+        self.assertEqual(f(it), [])
+        self.assertEqual(next(it), ("a", "m", None))
+        self.assertEqual(f([("a", "m"), ("a", "m")]), [])
+        self.assertEqual(f(["abc", "abc"]), [])
+
