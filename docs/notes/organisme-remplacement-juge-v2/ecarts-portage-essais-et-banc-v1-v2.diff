+        for juges in (lambda a, b: [(ETIQ, COURSE, a), (ETIQ, COURSE, b)],
+                      lambda a, b: [(ETIQ, AUTRE, a), (ETIQ, COURSE, b)],  # le modèle non déclaré d'abord, écrasé
+                      lambda a, b: [(ETIQ, COURSE, a), (ETIQ, AUTRE, b)],
+                      lambda a, b: [[ETIQ, AUTRE, a], [ETIQ, COURSE, b]],  # entrées en listes
+                      lambda a, b: [(ETIQ, COURSE, a), ("autre-juge", COURSE, b), (ETIQ, COURSE, a)]):
+            a, b = Compteur(), Compteur()
+            with self.subTest(juges=str(juges(ETIQ, ETIQ))):
+                e = self.refuse_repetee(sortie, juges(a, b))
