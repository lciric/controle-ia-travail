+def charger_lanceur(nom_fichier):
+    chemin = os.path.join(ORCH, "demonstrations", nom_fichier)
+    spec = importlib.util.spec_from_file_location(nom_fichier[:-3] + "_essai_v2", chemin)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
