+class TestEtiquetteRepeteeRefusee(Base):
+    """Le défaut : `donnes = {e: m for e, m, _ in juges_externes}` écrase une étiquette répétée dans CL35-04 ; la version 2
+    refuse toute liste à étiquette répétée, avec et sans l'option, avant toute lecture et tout appel."""
+
+    def refuse_repetee(self, sortie, juges, remplacements=None, **modifs):
+        avant = contenus(sortie) if os.path.isdir(sortie) else None
+        args = dict(attestation_lecture_humaine=modifs.pop("attestation", None) or self.attester(sortie),
+                    budgets=self.budgets(), juges_externes=juges, horodatage=HORODATAGE)
+        args.update(modifs)
+        if remplacements is not None:
+            args["remplacements_juges_externes"] = remplacements
+        with self.assertRaises(idn.CourseInterrompue) as cm:
+            brj.executer_bras_differe(sortie, **args)
+        self.assertIn(brj.MOTIF_ETIQUETTE_REPETEE, str(cm.exception))
+        self.assertIn("avant toute lecture et tout appel", str(cm.exception))
+        if avant is not None:
+            self.assertEqual({k: v for k, v in contenus(sortie).items() if not k.startswith("att-")},
+                             {k: v for k, v in avant.items() if not k.startswith("att-")})
+            self.rien_joue(sortie)
+        return cm.exception
+
+    def test_etiquette_repetee_sans_option_aucun_appel(self):
