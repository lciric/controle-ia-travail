+"""Bras différé du tour d'idéation avec remplacement déclaré du modèle d'un juge externe — **version 2** (fichier neuf, R12).
+
+Défaut corrigé (signalé par la session de relance après la contre-lecture de la version 1) : `ideation_v2.executer_bras_differe`
+(ligne 2852) comme la copie de la version 1 (`bras_remplacement_juge_v1.py`, ligne 255) construisent
+`donnes = {e: m for e, m, _ in juges_externes}`. Une étiquette de juge externe donnée deux fois est **écrasée** dans la
+comparaison CL35-04 (seul le dernier modèle donné est comparé à la course), mais **les deux juges sont joués** : un modèle non
+déclaré reçoit les fiches, une session est payée, et le bras se verrouille à la seconde réponse (`EcrasementInterdit`).
+
+Cette version refuse (`CourseInterrompue`), **avant toute lecture et tout appel**, toute liste `juges_externes` dont une
+étiquette apparaît plus d'une fois — avec **et** sans l'option `remplacements_juges_externes` :
+
+- **Sans l'option** : refus avant de déléguer à `ideation_v2.executer_bras_differe` ; sinon celle-ci est appelée elle-même,
+  avec les mêmes arguments. **C'est le seul écart au « comportement inchangé » de la version 1** : une liste à étiquette
+  répétée, que la v2 aurait jouée deux fois en ne comparant que le dernier modèle, est refusée ici ; toute autre liste
+  (étiquettes toutes distinctes, ou forme que la garde n'inspecte pas, voir `etiquettes_repetees`) suit la v2 à l'identique.
+- **Avec l'option** : refus avant la validation de l'option ; sinon `bras_remplacement_juge_v1.executer_bras_differe`
+  (version 1 contre-lue, gardée intacte, importée et non copiée) : déclaration du remplacement dans le journal, dans le
+  manifeste du bras et dans tous les manifestes de tentative (`bras-tentative-N`, `manifeste-bras-non-joue-N`,
+  `manifeste-bras-refus-taille-N`), mention dans la lecture écrite, auto-préférence recalculée au modèle joué, lecture par
+  famille descriptive, verrous de la v2.
+
+La garde ne lit aucun fichier, n'appelle aucun adaptateur et ne touche à aucun attribut des adaptateurs : elle ne regarde que
+le premier élément de chaque entrée. `refuser_etiquettes_repetees` sert aussi aux lanceurs neufs
+(`demonstrations/ideation_v2_juges_externes_uniques_v1.py`, `demonstrations/ideation_v1_juges_externes_uniques_v1.py`).
+"""
+
+from . import bras_remplacement_juge_v1 as _v1
+from . import ideation_v2 as _v2
+from .bras_remplacement_juge_v1 import (CHAMPS_REMPLACEMENT, ETIQUETTE, LONGUEUR_MAX_MOT, MENTION_REMPLACEMENT, MODELE,  # noqa: F401
+                                        MOTIF_FAMILLE, REFERENCE_GO, _vu, bloc_lecture_remplacement,
+                                        lecture_auto_preference_par_famille, valider_remplacements_juges_externes,
+                                        verifier_remplacements_contre_course)
+from .ideation_v2 import CourseInterrompue
+
+VERSION = ("bras-remplacement-juge-v2 (bras différé de ideation_v2 avec remplacement déclaré du modèle d'un juge externe ; "
+           "étiquette de juge externe répétée refusée avant toute lecture et tout appel)")
+MOTIF_ETIQUETTE_REPETEE = "étiquettes de juges externes en double"
+
+
+def etiquettes_repetees(juges_externes):
+    """Étiquettes données plus d'une fois dans `juges_externes`, dans l'ordre de leur première répétition ; liste vide sinon.
+
+    Ne lit rien et n'appelle rien : seul le premier élément de chaque entrée `(étiquette, modèle, adaptateur)` est regardé.
+    Deux étiquettes sont « la même » dès qu'elles sont égales (`==`), comme deux clés d'un dictionnaire qui s'écraseraient.
+    Formes non inspectées, passées telles quelles (la v2 les traite comme avant) : un itérateur (l'inspecter le
+    consommerait ; la v2 le refuse alors elle-même, `TypeError` sur `len`, avant tout appel) ; un objet non itérable ; une
+    entrée qui n'est pas un tuple ou une liste de trois éléments (la v2 échoue au dépaquetage, avant tout appel)."""
+    try:
+        if iter(juges_externes) is juges_externes:
+            return []
+    except TypeError:
+        return []
+    vues, repetees = [], []
+    for j in juges_externes:
+        if not isinstance(j, (tuple, list)) or len(j) != 3:
+            continue
+        e = j[0]
+        if any(e == v for v in vues):
+            if not any(e == r for r in repetees):
+                repetees.append(e)
+        else:
+            vues.append(e)
+    return repetees
+
+
+def refuser_etiquettes_repetees(juges_externes, origine="juges_externes"):
+    """`CourseInterrompue` si une étiquette de juge externe est donnée plus d'une fois (valeurs montrées caviardées)."""
+    repetees = etiquettes_repetees(juges_externes)
+    if repetees:
+        raise CourseInterrompue(
+            f"{origine} : {MOTIF_ETIQUETTE_REPETEE} {[_vu(e) for e in repetees]} : refusé avant toute lecture et tout appel "
+            "(une étiquette donnée deux fois serait écrasée dans la comparaison CL35-04 alors que les deux juges seraient "
+            "joués : un modèle non déclaré recevrait les fiches ; bras-remplacement-juge-v2)")
