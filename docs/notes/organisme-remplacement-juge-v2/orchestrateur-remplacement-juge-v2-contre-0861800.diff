+"""Lanceur de la course d'idéation, version 2 (`demonstrations/ideation_v2.py`), **avec une seule garde de plus** — fichier
+neuf (R12) ; `demonstrations/ideation_v2.py` est gardé tel quel et chargé tel quel.
+
+La garde : une étiquette de `--juge-externe` donnée plus d'une fois (après la même lecture `etiquette=modele` que le
+lanceur, défaut `externe-N`, blancs autour retirés) est refusée à la lecture des arguments — code 2 et message sur la sortie
+d'erreur, comme toute erreur d'argument du lanceur — avant toute lecture de fichier, tout appel et toute écriture. Avec
+`--bras-rapporte-differe`, le cœur (`pole/ideation_v2.py`, ligne 2852) écraserait l'étiquette répétée dans la comparaison
+CL35-04 mais jouerait les deux juges : un modèle non déclaré recevrait les fiches, une session serait payée, le bras se
+verrouillerait. La garde vaut dans tous les modes (dans la course, le cœur refuse déjà « étiquettes en double », plus tard).
+
+Tout le reste est `demonstrations/ideation_v2.py` lui-même : `principal(argv)` appelé avec les mêmes arguments, mêmes
+options, mêmes sorties, mêmes codes. Usage : celui de `demonstrations/ideation_v2.py`, en remplaçant le nom du fichier.
+"""
+
+import importlib.util
+import os
+import sys
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+RACINE = os.path.dirname(ICI)
+CIBLE = os.path.join(ICI, "ideation_v2.py")
+sys.path.insert(0, RACINE)
+
+_spec = importlib.util.spec_from_file_location("ideation_v2_lanceur_pour_juges_externes_uniques_v1", CIBLE)
+LANCEUR = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(LANCEUR)
+
+from pole.bras_remplacement_juge_v2 import MOTIF_ETIQUETTE_REPETEE, _vu, etiquettes_repetees  # noqa: E402
+
+
+def etiquettes_externes_repetees(args):
+    """Étiquettes de `--juge-externe` répétées, lues comme `roles_et_budgets` du lanceur les lit."""
+    juges_ext = [LANCEUR.paire(j, f"externe-{i + 1}") for i, j in enumerate(args.juge_externe)]
+    return etiquettes_repetees([(e, m, None) for e, m in juges_ext])
+
+
+def principal(argv=None):
+    argv = sys.argv[1:] if argv is None else list(argv)
+    a = LANCEUR.construire_analyseur()
+    args = a.parse_args(argv)
+    repetees = etiquettes_externes_repetees(args)
+    if repetees:  # juges-externes-uniques-v1 : avant toute lecture, tout appel, toute écriture
+        a.error(f"--juge-externe : {MOTIF_ETIQUETTE_REPETEE} {[_vu(e) for e in repetees]} : refusé avant toute lecture et "
+                "tout appel (une étiquette répétée serait écrasée dans la comparaison CL35-04 du bras alors que les deux "
+                "juges seraient joués)")
+    return LANCEUR.principal(argv)
+
+
+if __name__ == "__main__":
+    raise SystemExit(principal())
