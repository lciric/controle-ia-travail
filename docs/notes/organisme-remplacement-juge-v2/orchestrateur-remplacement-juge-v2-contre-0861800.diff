+    `remplacements_juges_externes`, `ideation_v2.executer_bras_differe(sortie, **reglages)` elle-même ; avec,
+    `bras_remplacement_juge_v1.executer_bras_differe` (option validée, puis bras avec remplacement déclaré)."""
+    refuser_etiquettes_repetees(reglages.get("juges_externes", ()))  # bras-remplacement-juge-v2 : avant tout, avec et sans option
+    if remplacements_juges_externes is None:
+        return _v2.executer_bras_differe(sortie, **reglages)
+    return _v1.executer_bras_differe(sortie, remplacements_juges_externes=remplacements_juges_externes, **reglages)
