+"""Banc de mutations du bras avec remplacement déclaré du modèle d'un juge externe, **version 2**
+(`pole/bras_remplacement_juge_v2.py`, qui délègue à `pole/bras_remplacement_juge_v1.py`) et des lanceurs neufs
+(`demonstrations/ideation_v2_juges_externes_uniques_v1.py`, `demonstrations/ideation_v1_juges_externes_uniques_v1.py`).
+
+Même machinerie que le banc v66 (`essais/mutations_boucle_reelle_v66.py`, chargé tel quel : copie neuve de `orchestrator/`,
+remplacements textuels présents une seule fois, essais sains d'abord, issue « tuée » seulement pour la raison attendue) ; seule la
+liste `MUTATIONS` est remplacée. Toutes les mutations sont jugées par `essais/test_bras_remplacement_juge_v2.py` :
+
+- R01-R09, R11-R18 : les mutations du banc de la version 1 (`essais/mutations_bras_remplacement_juge_v1.py`), mêmes textes,
+  même fichier muté (`pole/bras_remplacement_juge_v1.py`, que la version 2 appelle avec l'option), mêmes raisons attendues ;
+- R10 : la même garde (« sans option, la v2 elle-même ») porte désormais sur `pole/bras_remplacement_juge_v2.py`, qui ne
+  passe plus par la version 1 sans option ; le texte de la version 1 (`if False:`) y serait une mutation équivalente (la
+  version 1 sans option appelle elle aussi la v2), d'où la mutation portée : sans option, la copie avec remplacement ;
+- V01-V10 : neuves — garde des étiquettes répétées retirée, déplacée ou affaiblie ; gardes des lanceurs neufs retirées.
+
+  python3 -I -B essais/mutations_bras_remplacement_juge_v2.py [--processus 4] [--sortie RESULTAT.json] [--seulement ID,ID]
+      [--verifier-textes]
+Codes : ceux du banc v66 (0 toutes tuées pour la raison attendue ; 1 au moins une autre issue ; 2 défaut du banc).
+"""
+
+import importlib.util
+import os
+import sys
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+_spec = importlib.util.spec_from_file_location("mutations_boucle_reelle_v66_pour_remplacement_juge_v2",
+                                               os.path.join(ICI, "mutations_boucle_reelle_v66.py"))
+BANC = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(BANC)
+M = BANC.M
+
+B1, B2, T = "pole/bras_remplacement_juge_v1.py", "pole/bras_remplacement_juge_v2.py", "essais/test_bras_remplacement_juge_v2.py"
+L2, L1 = "demonstrations/ideation_v2_juges_externes_uniques_v1.py", "demonstrations/ideation_v1_juges_externes_uniques_v1.py"
+P1, NV = "banc remplacement-juge-v1 porté", "neuve remplacement-juge-v2"
+TOUS = [(T, "Test")]
+GARDE = '    refuser_etiquettes_repetees(reglages.get("juges_externes", ()))  # bras-remplacement-juge-v2 : avant tout, avec et sans option\n'
+SANS_OPTION = "    if remplacements_juges_externes is None:\n        return _v2.executer_bras_differe(sortie, **reglages)\n"
+
+MUTATIONS = [
+    # --- banc de la version 1, porté
+    M("R01-garde-cl35-04-retiree", P1, B1, ('        if r is not None and m == r["modele_joue"]:', "        if r is not None:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R02-etiquette-absente-admise", P1, B1, ("        if etiquette not in attendus:\n", "        if False:\n"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R03-modele-de-la-course-non-compare", P1, B1, ('        if r["modele_course"] != attendus[etiquette]:', "        if False:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R04-noyau-modeles-non-compare", P1, B1, ("        if modeles_par_juge_course.get(etiquette) != attendus[etiquette]:",
+                                                "        if False:"), TOUS, "TestGardePure"),
+    M("R05-etiquettes-differentes-admises", P1, B1, ("    if set(donnes) != set(attendus):", "    if False:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R06-reference-go-non-verifiee", P1, B1, ('        if not REFERENCE_GO.fullmatch(r["reference_go"]):', "        if False:"),
+      TOUS, "test_artefact_reference_de_go_vide"),
+    M("R07-mention-absente-de-la-lecture", P1, B1,
+      ("        lecture_course = dict(lecture_course, juge_externe_remplace=bloc_lecture_remplacement(remplaces))", "        pass"),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R08-auto-preference-avec-le-modele-de-la-course", P1, B1,
+      ('        modele_par_juge.update({r["etiquette"]: r["modele_joue"] for r in effectifs})\n', ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R09-manifeste-sans-remplacements", P1, B1,
+      ("            remplacements_juges_externes=remplaces,  # remplacement-juge-v1 : les deux modèles, la référence de GO, le mot\n", ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    # R10 de la version 1 (`if False:` à la place de la branche sans option) serait ici une mutation équivalente : sans la
+    # branche, la version 2 appelle la version 1 sans option, qui appelle la v2 elle-même. Mutation portée : sans option,
+    # le bras passe par la copie avec remplacement (option vide) au lieu de la v2 elle-même.
+    M("R10-sans-option-hors-de-la-v2", P1 + " (fichier de la version 2)", B2,
+      (SANS_OPTION, SANS_OPTION.replace("_v2.executer_bras_differe(sortie, **reglages)",
+                                        "_v1._executer_bras_avec_remplacement(sortie, remplacements={}, **reglages)")),
+      TOUS, "test_sans_option"),
+    M("R11-modele-joue-egal-admis", P1, B1, ('        if r["modele_joue"] == r["modele_course"]:', "        if False:"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R12-secret-admis-dans-un-champ", P1, B1, ("            if contient_secret(v):\n", "            if False:\n"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R13-refus-de-taille-sans-remplacement", P1, B1, ("cout_usd=0.0,\n                remplacements_juges_externes=remplaces))",
+                                                        "cout_usd=0.0))"), TOUS, "test_refus_de_taille_porte_le_remplacement"),
+    M("R14-famille-du-juge-remplace-absente", P1, B1,
+      ('        famille_par_juge.update({r["etiquette"]: [r["modele_course"], r["modele_joue"]] for r in effectifs})\n', ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R15-champs-en-plus-admis", P1, B1, ("set(r) != set(CHAMPS_REMPLACEMENT)", "not set(CHAMPS_REMPLACEMENT) <= set(r)"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R16-journal-sans-remplacements", P1, B1, ('               "remplacements_juges_externes": remplaces}', "               }"),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R17-refus-qui-recopie-la-valeur", P1, B1, ("    return caviarder(repr(valeur))[0][:120]", "    return repr(valeur)"),
+      TOUS, "test_secret_jamais_recopie_dans_le_refus"),
+    M("R18-etiquette-par-debut-de-chaine", P1, B1, ("not ETIQUETTE.fullmatch(etiquette)", "not ETIQUETTE.match(etiquette)"),
+      TOUS, "test_formes_par_correspondance_entiere"),
+    # --- neuves : garde des étiquettes répétées (version 2)
+    M("V01-garde-etiquettes-repetees-retiree", NV, B2, (GARDE, ""), TOUS, "test_etiquette_repetee_sans_option_aucun_appel"),
+    M("V02-garde-seulement-avec-l-option", NV, B2, (GARDE + SANS_OPTION, SANS_OPTION + GARDE),
+      TOUS, "test_etiquette_repetee_sans_option_aucun_appel"),
+    M("V03-garde-seulement-sans-l-option", NV, B2,
+      (GARDE + SANS_OPTION, SANS_OPTION.replace("        return", "    " + GARDE + "        return")),
+      TOUS, "test_etiquette_repetee_avec_option_aucun_appel"),
+    M("V04-garde-sur-l-entree-entiere", NV, B2, ("        e = j[0]\n", "        e = tuple(j)\n"),
+      TOUS, "test_etiquette_repetee_sans_option_aucun_appel"),
+    M("V05-entrees-en-listes-ignorees", NV, B2, ("isinstance(j, (tuple, list))", "isinstance(j, tuple)"),
+      TOUS, "test_etiquette_repetee_avec_option_aucun_appel"),
+    M("V06-iterateur-consomme-par-la-garde", NV, B2,
+      ("        if iter(juges_externes) is juges_externes:\n            return []\n", "        iter(juges_externes)\n"),
+      TOUS, "test_formes_non_inspectees_suivent_la_v2_sans_appel"),
+    M("V07-refus-qui-recopie-l-etiquette", NV, B2, ("{[_vu(e) for e in repetees]}", "{repetees}"),
