@@ -0,0 +1,729 @@
+"""Essais du bras différé avec remplacement déclaré du modèle d'un juge externe, **version 2**
+(`pole/bras_remplacement_juge_v2.py`) et des lanceurs neufs `demonstrations/ideation_v2_juges_externes_uniques_v1.py`,
+`demonstrations/ideation_v1_juges_externes_uniques_v1.py`.
+
+Première partie : les essais de la version 1 (`essais/test_bras_remplacement_juge_v1.py`) portés tels quels, le module
+essayé étant la version 2 (seule la ligne d'import change). Seconde partie, neuve : une étiquette de juge externe répétée
+est refusée avant toute lecture et tout appel, avec et sans l'option (adaptateur factice qui compte les appels : 0) ; témoin
+du défaut dans la v2 et la version 1 (gardées telles quelles) ; manifestes de tentative (non joué, payée, refus de taille)
+qui portent le remplacement ; lanceurs neufs. Aucun appel réseau, aucune dépense : commandes locales scriptées.
+"""
+import json
+import os
+import sys
+import unittest
+
+from essais import test_v7_ideation_v2 as T7
+from essais.aides import CasAvecDossier
+from pole import bras_remplacement_juge_v2 as brj
+from pole import ideation_v2 as idn
+from pole.adaptateurs import AdaptateurCommandeExterne
+
+ETIQ = "lx-juge"
+COURSE, JOUE, AUTRE = "lignee-x-v1", "lignee-x-v2", "lignee-x-v3"
+HORODATAGE = "2026-11-18T00:00:00Z"
+
+
+def option(etiquette=ETIQ, **modifs):
+    r = {"modele_course": COURSE, "modele_joue": JOUE, "reference_go": "GO-2026-11-18-99", "mot_verbatim": "go v2"}
+    r.update(modifs)
+    return {etiquette: r}
+
+
+def lire(chemin):
+    with open(chemin, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def contenus(dossier):
+    """Chemins relatifs et contenus de tous les fichiers d'un dossier (pour « rien écrit »)."""
+    sortie = {}
+    for racine, _, fichiers in os.walk(dossier):
+        for nom in fichiers:
+            p = os.path.join(racine, nom)
+            with open(p, "rb") as f:
+                sortie[os.path.relpath(p, dossier)] = f.read()
+    return sortie
+
+
+class Base(CasAvecDossier):
+    def setUp(self):
+        super().setUp()
+        self.c = T7.TestCourse("test_course_complete")
+        self.c.tmp = self.tmp
+
+    def commande(self, script, nom):
+        chemin = os.path.join(self.tmp, nom)
+        with open(chemin, "w", encoding="utf-8") as f:
+            f.write(script)
+        return AdaptateurCommandeExterne([sys.executable, "-I", chemin], environnement={})
+
+    def budgets(self):
+        b = dict(self.c.budgets())
+        b[("proposeur_ideation", COURSE)] = 1.0
+        b[("juge_ideation", COURSE)] = 1.0
+        b[("juge_ideation", JOUE)] = 1.0
+        b[("juge_ideation", AUTRE)] = 1.0
+        return b
+
+    def course(self, nom):
+        """Course simulée : deux proposeurs internes, un proposeur externe de la lignée x (modèle de la course) et le juge
+        externe différé de la même lignée, déclaré au modèle de la course."""
+        fiches = {"opus": [T7.fiche_brute(nom="O1"), T7.fiche_brute(nom="O2")], "fable": [T7.fiche_brute(nom="F1")]}
+        ad = T7.FauxAdaptateur(fiches, notes_par_juge={"juge-fable": self.c.notes_temoins_ok,
+                                                        "juge-opus": self.c.notes_temoins_ok})
+        prop = self.commande(T7.TestCommandeExterne.SCRIPT_OK, "proposeur.py")
+        self.c.lancer(ad, nom, budgets=self.budgets(), proposeurs_externes=[("lx", COURSE, prop)],
+                      juges_externes=[(ETIQ, COURSE)], budget_externe_usd=5.0, horodatage=HORODATAGE)
+        return os.path.join(self.tmp, nom)
+
+    def attester(self, sortie, consigne=None):
+        self.n_att = getattr(self, "n_att", 0) + 1  # une attestation neuve par appel (jamais écrasée)
+        chemin = os.path.join(self.tmp, f"att-{os.path.basename(sortie)}-{self.n_att}.json")
+        c = os.path.join(sortie, "juges-bras-rapporte", f"traces-{ETIQ}", "consigne-en-attente.md")
+        idn.ecrire_json_scelle(chemin, {"lecteur": "Lazar", "lu_le": "2026-11-18",
+                                        "fiches_validees_sha256": idn.sha256_fichier(os.path.join(sortie, "fiches-validees.json")),
+                                        "consignes_en_attente_sha256": {ETIQ: consigne or idn.sha256_fichier(c)}})
+        return chemin
+
+    def juge(self, nom="juge.py", script=None):
+        return self.commande(script or T7.TestCommandeExterne.SCRIPT_OK, nom)
+
+    def bras(self, sortie, modele, remplacements=None, adaptateur=None, **modifs):
+        args = dict(attestation_lecture_humaine=self.attester(sortie), budgets=self.budgets(),
+                    juges_externes=[(ETIQ, modele, adaptateur or self.juge())], horodatage=HORODATAGE)
