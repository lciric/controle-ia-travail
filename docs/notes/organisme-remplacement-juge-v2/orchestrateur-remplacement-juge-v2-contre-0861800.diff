+    def test_sans_option_meme_sortie_que_la_v2_cas_fixe(self):
+        """Deux courses identiques (même graine, même horodatage) : bras de la v2 sur l'une, bras v1 sans option sur l'autre ;
+        mêmes fichiers écrits, mêmes contenus (manifeste du bras compris, chemins de la sortie mis à part)."""
+        a, b = self.course("fixe-a"), self.course("fixe-b")
+        avant = set(contenus(a))
+        self.assertEqual(avant, set(contenus(b)))
+        att_a, att_b = self.attester(a), self.attester(b)
+        ra = idn.executer_bras_differe(a, attestation_lecture_humaine=att_a, budgets=self.budgets(),
+                                       juges_externes=[(ETIQ, COURSE, self.juge("ja.py"))], horodatage=HORODATAGE)
+        rb = brj.executer_bras_differe(b, attestation_lecture_humaine=att_b, budgets=self.budgets(),
+                                       juges_externes=[(ETIQ, COURSE, self.juge("jb.py"))], horodatage=HORODATAGE)
+        ca, cb = contenus(a), contenus(b)
+        self.assertEqual(set(ca), set(cb))
+        neufs = sorted(set(ca) - avant)
+        self.assertIn("lecture.json", neufs)
+        self.assertIn("manifeste-bras-rapporte.json", neufs)
+        normaliser = (lambda octets, s: octets.replace(s.encode(), b"<SORTIE>").replace(
+            os.path.join(self.tmp, "j" + s[-1] + ".py").encode(), b"<JUGE>").replace(
+            os.path.basename(s).encode(), b"<NOM>"))
+        self.assertEqual([n for n in neufs if not n.endswith(".sha256")],
+                         ["classement.json", "classements-par-juge.json", "doublons-bras-rapporte.json",
+                          f"juges-bras-rapporte/traces-{ETIQ}/reponse.md", "lecture.json", "manifeste-bras-rapporte.json",
+                          "notes-bras-rapporte.json"])
+        # le manifeste brut diffère (chemins de la sortie et de la commande) : la normalisation n'efface que cela
+        self.assertNotEqual(ca["manifeste-bras-rapporte.json"], cb["manifeste-bras-rapporte.json"])
+        for nom in neufs:
+            if nom.endswith(".sha256"):
+                continue
+            self.assertEqual(normaliser(ca[nom], a), normaliser(cb[nom], b), nom)
+        for nom in ("lecture.json", "classement.json", "notes-bras-rapporte.json", "classements-par-juge.json"):
