+      TOUS, "test_repetee_refusee_en_processus_sans_appel_du_lanceur"),
+    M("V09-lanceur-v1-garde-retiree", NV, L1, ("    if repetees:  # juges-externes-uniques-v1", "    if False:  # juges-externes-uniques-v1"),
+      TOUS, "test_repetee_refusee_par_la_ligne_de_commande"),
