+class Compteur:
+    """Adaptateur factice qui compte chaque appel (`lancer`, `description`) ; sans délégué, tout appel est une faute
+    (exception) ; avec un délégué (commande locale scriptée), il lui passe l'appel."""
+
+    def __init__(self, delegue=None, nom="factice-compteur"):
+        self.lancers, self.descriptions, self.delegue, self.nom = [], 0, delegue, nom
+
+    def lancer(self, role, consigne, dossier, budget_usd, max_tours, modele=None, **kw):
+        self.lancers.append((role, modele))
+        if self.delegue is None:
+            raise AssertionError("appel interdit : la garde devait refuser avant tout appel")
