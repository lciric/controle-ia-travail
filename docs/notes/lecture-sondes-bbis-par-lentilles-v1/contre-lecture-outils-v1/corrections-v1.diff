+    (lambda d: d["sources"]["P-S75"]["e0"].__setitem__("cellule", "P-S50"), "cellule ou pli_lu"),
+    (lambda d: d["sources"]["P-S75"]["e0"].__setitem__("pli_lu", 1), "cellule ou pli_lu"),
