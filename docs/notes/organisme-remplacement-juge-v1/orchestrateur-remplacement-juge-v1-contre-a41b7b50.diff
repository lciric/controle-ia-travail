+def lecture_auto_preference_par_famille(notes_par_auteur, famille_par_juge, modele_par_auteur):
+    """Comme `ideation_v2.lecture_auto_preference`, la famille d'un juge (liste de modèles) à la place de son modèle ;
+    témoins exclus ; marquée descriptive (`MOTIF_FAMILLE`)."""
+    par_juge = {}
+    for j, notes in notes_par_auteur.items():
+        famille = famille_par_juge[j]
+        propres, autres = [], []
+        for ident, n in notes.items():
