@@ -0,0 +1,412 @@
+"""Essais du bras différé avec remplacement déclaré du modèle d'un juge externe (`pole/bras_remplacement_juge_v1.py`).
+
+Cas sain et artefacts (R5) que demande la spécification (`demande-orchestrateur-remplacement-modele-juge-v1.md`, point 6) :
+remplacement déclaré admis ; modèle changé sans option ; option pour une autre étiquette ; modèle de la course faux dans
+l'option ; référence de GO vide. Plus : sans option, sortie identique à celle de la v2 sur un cas fixe ; option mal formée
+refusée ; modèle joué non déclaré refusé par CL35-04 ; verrous inchangés (attestation, jamais rejoué, témoins, plafond,
+repli sans bras). Les modèles sont des noms fictifs (`lignee-x-v1`, `lignee-x-v2`) ; aucun appel réseau, aucune dépense :
+le juge externe est une commande locale scriptée (celle de `test_v7_ideation_v2.TestCommandeExterne`).
+"""
+
+import json
+import os
+import sys
+import unittest
+
+from essais import test_v7_ideation_v2 as T7
+from essais.aides import CasAvecDossier
+from pole import bras_remplacement_juge_v1 as brj
+from pole import ideation_v2 as idn
+from pole.adaptateurs import AdaptateurCommandeExterne
+
+ETIQ = "lx-juge"
+COURSE, JOUE, AUTRE = "lignee-x-v1", "lignee-x-v2", "lignee-x-v3"
+HORODATAGE = "2026-11-18T00:00:00Z"
+
+
+def option(etiquette=ETIQ, **modifs):
+    r = {"modele_course": COURSE, "modele_joue": JOUE, "reference_go": "GO-2026-11-18-99", "mot_verbatim": "go v2"}
+    r.update(modifs)
+    return {etiquette: r}
+
+
+def lire(chemin):
+    with open(chemin, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def contenus(dossier):
+    """Chemins relatifs et contenus de tous les fichiers d'un dossier (pour « rien écrit »)."""
+    sortie = {}
+    for racine, _, fichiers in os.walk(dossier):
+        for nom in fichiers:
+            p = os.path.join(racine, nom)
+            with open(p, "rb") as f:
+                sortie[os.path.relpath(p, dossier)] = f.read()
+    return sortie
+
+
+class Base(CasAvecDossier):
+    def setUp(self):
+        super().setUp()
+        self.c = T7.TestCourse("test_course_complete")
+        self.c.tmp = self.tmp
+
+    def commande(self, script, nom):
+        chemin = os.path.join(self.tmp, nom)
+        with open(chemin, "w", encoding="utf-8") as f:
+            f.write(script)
+        return AdaptateurCommandeExterne([sys.executable, "-I", chemin], environnement={})
+
+    def budgets(self):
+        b = dict(self.c.budgets())
+        b[("proposeur_ideation", COURSE)] = 1.0
+        b[("juge_ideation", COURSE)] = 1.0
+        b[("juge_ideation", JOUE)] = 1.0
+        b[("juge_ideation", AUTRE)] = 1.0
+        return b
+
+    def course(self, nom):
+        """Course simulée : deux proposeurs internes, un proposeur externe de la lignée x (modèle de la course) et le juge
+        externe différé de la même lignée, déclaré au modèle de la course."""
+        fiches = {"opus": [T7.fiche_brute(nom="O1"), T7.fiche_brute(nom="O2")], "fable": [T7.fiche_brute(nom="F1")]}
+        ad = T7.FauxAdaptateur(fiches, notes_par_juge={"juge-fable": self.c.notes_temoins_ok,
+                                                        "juge-opus": self.c.notes_temoins_ok})
+        prop = self.commande(T7.TestCommandeExterne.SCRIPT_OK, "proposeur.py")
+        self.c.lancer(ad, nom, budgets=self.budgets(), proposeurs_externes=[("lx", COURSE, prop)],
+                      juges_externes=[(ETIQ, COURSE)], budget_externe_usd=5.0, horodatage=HORODATAGE)
+        return os.path.join(self.tmp, nom)
+
+    def attester(self, sortie, consigne=None):
+        self.n_att = getattr(self, "n_att", 0) + 1  # une attestation neuve par appel (jamais écrasée)
+        chemin = os.path.join(self.tmp, f"att-{os.path.basename(sortie)}-{self.n_att}.json")
+        c = os.path.join(sortie, "juges-bras-rapporte", f"traces-{ETIQ}", "consigne-en-attente.md")
+        idn.ecrire_json_scelle(chemin, {"lecteur": "Lazar", "lu_le": "2026-11-18",
+                                        "fiches_validees_sha256": idn.sha256_fichier(os.path.join(sortie, "fiches-validees.json")),
+                                        "consignes_en_attente_sha256": {ETIQ: consigne or idn.sha256_fichier(c)}})
+        return chemin
+
+    def juge(self, nom="juge.py", script=None):
+        return self.commande(script or T7.TestCommandeExterne.SCRIPT_OK, nom)
+
+    def bras(self, sortie, modele, remplacements=None, adaptateur=None, **modifs):
+        args = dict(attestation_lecture_humaine=self.attester(sortie), budgets=self.budgets(),
+                    juges_externes=[(ETIQ, modele, adaptateur or self.juge())], horodatage=HORODATAGE)
+        args.update(modifs)
+        if remplacements is not None:
+            args["remplacements_juges_externes"] = remplacements
+        return brj.executer_bras_differe(sortie, **args)
+
+    def rien_joue(self, sortie):
+        self.assertFalse(os.path.exists(os.path.join(sortie, "manifeste-bras-rapporte.json")))
+        self.assertFalse(os.path.exists(os.path.join(sortie, "bras-rapporte-controle")))
+        self.assertFalse(os.path.exists(os.path.join(sortie, "lecture.json")))
+        self.assertFalse(any(f.startswith(("manifeste-bras-", "bras-tentative-")) for f in os.listdir(sortie)))
+
+
+class TestSainRemplacementDeclare(Base):
+    def test_sain_remplacement_declare_admis(self):
+        sortie = self.course("sain")
+        res = self.bras(sortie, JOUE, option())
+        self.assertFalse(res["sans_bras"])
+        self.assertTrue(all(l["nombre_juges"] == 3 for l in res["classement"]))
+        self.assertTrue(res["lecture"]["lisible_L2_L4"])
+        self.assertTrue(res["lecture"]["temoins_juge_externe"]["temoins_ok"])
+        # l'adaptateur a été appelé avec le modèle joué (contrôle et session du juge)
+        self.assertEqual([a["modele"] for a in res["journal"]["appels"]], [JOUE])
+        attendu = [{"etiquette": ETIQ, "modele_course": COURSE, "modele_joue": JOUE, "reference_go": "GO-2026-11-18-99",
+                    "mot_verbatim": "go v2", "applique": True}]
+        self.assertEqual(res["journal"]["remplacements_juges_externes"], attendu)
+        # manifeste du bras : les deux modèles, la référence de GO, le mot, la mention
+        m = lire(os.path.join(sortie, "manifeste-bras-rapporte.json"))["reglages"]
+        self.assertEqual(m["remplacements_juges_externes"], attendu)
+        self.assertEqual(m["mention_remplacement"], brj.MENTION_REMPLACEMENT)
+        self.assertEqual(m["juges"], [[ETIQ, JOUE, "commande-externe"]])
+        self.assertEqual(m["journal"]["remplacements_juges_externes"], attendu)
+        # lecture écrite : mention visible
+        lecture = lire(os.path.join(sortie, "lecture.json"))
+        self.assertEqual(lecture["juge_externe_remplace"]["mention"],
+                         "juge externe joué avec un autre modèle que celui déclaré à la course")
+        self.assertEqual(lecture["juge_externe_remplace"]["remplacements"], attendu)
+        # auto-préférence avec le modèle joué : aucune fiche du modèle joué
+        ap = lecture["auto_preference"][ETIQ]
+        self.assertEqual((ap["modele"], ap["n_propre_modele"]), (JOUE, 0))
+        self.assertGreater(ap["n_autre_modele"], 0)
+        # lecture par famille, descriptive : les fiches de la lignée (modèle de la course) comptent comme « propres »
+        fam = lecture["auto_preference_par_famille"]
+        self.assertIs(fam["descriptive"], True)
+        self.assertIn("descriptive", fam["motif"])
+        self.assertEqual(fam["par_juge"][ETIQ]["famille"], [COURSE, JOUE])
+        n_lignee = sum(1 for f in lire(os.path.join(sortie, "fiches-validees.json")) if f["auteur"] == "lx")
+        self.assertGreater(n_lignee, 0)
+        self.assertEqual(fam["par_juge"][ETIQ]["n_propre_famille"], n_lignee)
+        self.assertEqual(fam["par_juge"][ETIQ]["n_propre_famille"] + fam["par_juge"][ETIQ]["n_autre_famille"],
+                         ap["n_propre_modele"] + ap["n_autre_modele"])
+        # juges non remplacés : famille = leur seul modèle, mêmes nombres que la lecture par modèle
+        for j in ("juge-fable", "juge-opus"):
+            self.assertEqual(fam["par_juge"][j]["famille"], [lecture["auto_preference"][j]["modele"]])
+            self.assertEqual(fam["par_juge"][j]["n_propre_famille"], lecture["auto_preference"][j]["n_propre_modele"])
+        # jamais rejoué après dépense, même avec l'option
+        with self.assertRaises(idn.CourseInterrompue):
+            self.bras(sortie, JOUE, option())
+
+    def test_sain_option_donnee_modele_de_la_course_joue(self):
+        """Point 2 : avec l'option, le modèle donné peut rester celui de la course ; déclaré, non appliqué, sans mention."""
+        sortie = self.course("course-joue")
+        res = self.bras(sortie, COURSE, option())
+        self.assertFalse(res["sans_bras"])
+        m = lire(os.path.join(sortie, "manifeste-bras-rapporte.json"))["reglages"]
+        self.assertEqual([r["applique"] for r in m["remplacements_juges_externes"]], [False])
+        self.assertIsNone(m["mention_remplacement"])
+        lecture = lire(os.path.join(sortie, "lecture.json"))
+        self.assertNotIn("juge_externe_remplace", lecture)
+        self.assertEqual(lecture["auto_preference"][ETIQ]["modele"], COURSE)
+        self.assertGreater(lecture["auto_preference"][ETIQ]["n_propre_modele"], 0)
+
+
+class TestSansOptionInchange(Base):
+    def test_sans_option_appelle_la_v2_elle_meme(self):
+        """Sans l'option, la fonction de la v2 est appelée avec exactement les mêmes arguments ; son résultat est rendu."""
+        appels = []
+        vraie = idn.executer_bras_differe
+
+        def espion(sortie, **kw):
+            appels.append((sortie, kw))
+            return {"rendu": "v2"}
+        idn.executer_bras_differe = espion
+        try:
+            r = brj.executer_bras_differe("S", attestation_lecture_humaine="A", juges_externes=[], budgets={}, horodatage="H")
+        finally:
+            idn.executer_bras_differe = vraie
+        self.assertEqual(r, {"rendu": "v2"})
+        self.assertEqual(appels, [("S", {"attestation_lecture_humaine": "A", "juges_externes": [], "budgets": {},
+                                         "horodatage": "H"})])
+
+    def test_sans_option_meme_sortie_que_la_v2_cas_fixe(self):
+        """Deux courses identiques (même graine, même horodatage) : bras de la v2 sur l'une, bras v1 sans option sur l'autre ;
+        mêmes fichiers écrits, mêmes contenus (manifeste du bras compris, chemins de la sortie mis à part)."""
+        a, b = self.course("fixe-a"), self.course("fixe-b")
+        avant = set(contenus(a))
+        self.assertEqual(avant, set(contenus(b)))
+        att_a, att_b = self.attester(a), self.attester(b)
+        ra = idn.executer_bras_differe(a, attestation_lecture_humaine=att_a, budgets=self.budgets(),
+                                       juges_externes=[(ETIQ, COURSE, self.juge("ja.py"))], horodatage=HORODATAGE)
+        rb = brj.executer_bras_differe(b, attestation_lecture_humaine=att_b, budgets=self.budgets(),
+                                       juges_externes=[(ETIQ, COURSE, self.juge("jb.py"))], horodatage=HORODATAGE)
+        ca, cb = contenus(a), contenus(b)
+        self.assertEqual(set(ca), set(cb))
+        neufs = sorted(set(ca) - avant)
+        self.assertIn("lecture.json", neufs)
+        self.assertIn("manifeste-bras-rapporte.json", neufs)
+        normaliser = (lambda octets, s: octets.replace(s.encode(), b"<SORTIE>").replace(
+            os.path.join(self.tmp, "j" + s[-1] + ".py").encode(), b"<JUGE>").replace(
+            os.path.basename(s).encode(), b"<NOM>"))
+        self.assertEqual([n for n in neufs if not n.endswith(".sha256")],
+                         ["classement.json", "classements-par-juge.json", "doublons-bras-rapporte.json",
+                          f"juges-bras-rapporte/traces-{ETIQ}/reponse.md", "lecture.json", "manifeste-bras-rapporte.json",
+                          "notes-bras-rapporte.json"])
+        # le manifeste brut diffère (chemins de la sortie et de la commande) : la normalisation n'efface que cela
+        self.assertNotEqual(ca["manifeste-bras-rapporte.json"], cb["manifeste-bras-rapporte.json"])
+        for nom in neufs:
+            if nom.endswith(".sha256"):
+                continue
+            self.assertEqual(normaliser(ca[nom], a), normaliser(cb[nom], b), nom)
+        for nom in ("lecture.json", "classement.json", "notes-bras-rapporte.json", "classements-par-juge.json"):
+            self.assertEqual(ca[nom], cb[nom], nom)  # lectures identiques octet pour octet, sans normalisation
+        self.assertNotIn("auto_preference_par_famille", rb["lecture"])
+        self.assertNotIn("juge_externe_remplace", rb["lecture"])
+        self.assertEqual(ra["lecture"]["auto_preference"], rb["lecture"]["auto_preference"])
+        self.assertEqual(ra["classement"], rb["classement"])
+
+    def test_artefact_modele_change_sans_option(self):
+        """Modèle changé sans option : refus CL35-04 de la v2, même message, rien écrit."""
+        sortie = self.course("change-sans-option")
+        avant = contenus(sortie)
+        with self.assertRaises(idn.CourseInterrompue) as v1:
+            self.bras(sortie, JOUE)
+        self.assertIn("(CL35-04)", str(v1.exception))
+        with self.assertRaises(idn.CourseInterrompue) as v2:
+            idn.executer_bras_differe(sortie, attestation_lecture_humaine=self.attester(sortie), budgets=self.budgets(),
+                                      juges_externes=[(ETIQ, JOUE, self.juge())], horodatage=HORODATAGE)
+        self.assertEqual(str(v1.exception), str(v2.exception))
+        self.assertEqual(contenus(sortie), avant)
+        self.rien_joue(sortie)
+
+
+class TestArtefacts(Base):
+    def refuse(self, sortie, modele, remplacements, motif, **modifs):
+        avant = contenus(sortie)
+        with self.assertRaises(idn.CourseInterrompue) as cm:
+            self.bras(sortie, modele, remplacements, **modifs)
+        self.assertIn(motif, str(cm.exception))
+        self.assertEqual(contenus(sortie), avant)
+        self.rien_joue(sortie)
+        return cm.exception
+
+    def test_artefacts_contre_la_course(self):
+        sortie = self.course("artefacts")
+        # option pour une autre étiquette (absente de la course) ; le juge de la course joué avec un autre modèle
+        self.refuse(sortie, JOUE, option("autre-juge"), "étiquette absente des juges externes de la course")
+        self.refuse(sortie, COURSE, option("autre-juge"), "étiquette absente des juges externes de la course")
+        # modèle de la course faux dans l'option
+        self.refuse(sortie, JOUE, option(modele_course=AUTRE), "≠ manifeste de départ")
+        # modèle joué non déclaré : CL35-04 conservée
+        e = self.refuse(sortie, AUTRE, option(), "(CL35-04)")
+        self.assertIn("ni le modèle de la course ni un remplacement déclaré", str(e))
+        # étiquettes données ≠ étiquettes de la course, même avec l'option
+        self.refuse(sortie, JOUE, option(), "étiquettes différentes",
+                    juges_externes=[(ETIQ, JOUE, self.juge()), ("autre-juge", JOUE, self.juge("j2.py"))])
+        self.refuse(sortie, JOUE, option(), "étiquettes différentes", juges_externes=[])
+        # plafond par session absent pour le modèle joué : refus avant tout appel
+        b = self.budgets()
+        del b[("juge_ideation", JOUE)]
