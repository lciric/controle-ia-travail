+from .relais import CleDansEnvironnement
+
+VERSION = "bras-remplacement-juge-v1 (bras différé de ideation_v2 avec remplacement déclaré du modèle d'un juge externe)"
+CHAMPS_REMPLACEMENT = ("modele_course", "modele_joue", "reference_go", "mot_verbatim")
+REFERENCE_GO = re.compile(r"^GO-\d{4}-\d{2}-\d{2}-\d{2,}$")
+MODELE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$")
+LONGUEUR_MAX_MOT = 2000
+MENTION_REMPLACEMENT = "juge externe joué avec un autre modèle que celui déclaré à la course"
+MOTIF_FAMILLE = ("lecture descriptive, jamais une lecture d'auto-préférence au sens du code : pour un juge remplacé, la famille "
+                 "est le modèle déclaré à la course et le modèle joué (le proposeur de la lignée garde le modèle de la course) ; "
+                 "pour les autres juges, leur seul modèle ; aucune famille de fournisseur devinée d'après les noms")
+
+
+def _vu(valeur):
+    """Valeur refusée telle que le message la montre : caviardée (un secret mis par erreur dans l'option n'est jamais
+    recopié dans une exception), tronquée à 120 caractères."""
+    return caviarder(repr(valeur))[0][:120]
+
+
+def valider_remplacements_juges_externes(option):
+    """Forme de l'option, avant tout (aucun fichier lu ni écrit) ; rend une copie normalisée. Refus (`CourseInterrompue`) :
+    autre chose qu'un dictionnaire non vide ; étiquette hors de `ETIQUETTE` ; valeur qui n'est pas un dictionnaire aux quatre
+    champs exacts ; champ qui n'est pas une chaîne non vide sans blanc autour ; modèle hors de `MODELE` ; modèle joué égal au
+    modèle de la course ; référence de GO hors de `REFERENCE_GO` ; mot verbatim trop long ou avec un caractère de
+    contrôle ; secret dans l'étiquette ou dans un champ (jamais recopié dans le message : `_vu`)."""
+    if not isinstance(option, dict) or not option:
+        raise CourseInterrompue("remplacements_juges_externes : {étiquette: {modele_course, modele_joue, reference_go, "
+                                f"mot_verbatim}} non vide attendu (reçu {type(option).__name__}) ; sans remplacement, ne pas "
+                                "donner l'option")
+    sortie = {}
+    for etiquette, r in option.items():
+        if not isinstance(etiquette, str) or not ETIQUETTE.fullmatch(etiquette) or contient_secret(etiquette):
+            raise CourseInterrompue(f"remplacements_juges_externes : étiquette invalide {_vu(etiquette)}")
+        if not isinstance(r, dict) or set(r) != set(CHAMPS_REMPLACEMENT):
+            raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}] : exactement les champs "
+                                    f"{list(CHAMPS_REMPLACEMENT)} (reçu {_vu(sorted(r)) if isinstance(r, dict) else type(r).__name__})")
+        for champ in CHAMPS_REMPLACEMENT:
+            v = r[champ]
+            if not isinstance(v, str) or not v.strip() or v != v.strip():
+                raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}][{champ!r}] : chaîne non vide, sans blanc "
+                                        f"autour (reçu {_vu(v)})")
+            if contient_secret(v):
+                raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}][{champ!r}] : un secret n'a rien à "
+                                        "faire dans l'option (refusé, jamais recopié)")
+        for champ in ("modele_course", "modele_joue"):
+            if not MODELE.fullmatch(r[champ]):
+                raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}][{champ!r}] : nom de modèle invalide "
+                                        f"{_vu(r[champ])}")
+        if r["modele_joue"] == r["modele_course"]:
+            raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}] : modèle joué égal au modèle de la course "
+                                    f"({r['modele_joue']!r}) : ce n'est pas un remplacement")
+        if not REFERENCE_GO.fullmatch(r["reference_go"]):
+            raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}][reference_go] : GO-AAAA-MM-JJ-NN attendu "
+                                    f"(reçu {_vu(r['reference_go'])})")
+        mot = r["mot_verbatim"]
+        if len(mot) > LONGUEUR_MAX_MOT or any(unicodedata.category(c) == "Cc" for c in mot):
+            raise CourseInterrompue(f"remplacements_juges_externes[{etiquette!r}][mot_verbatim] : au plus {LONGUEUR_MAX_MOT} "
+                                    "caractères, sans caractère de contrôle")
+        sortie[etiquette] = {c: r[c] for c in CHAMPS_REMPLACEMENT}
+    return copy.deepcopy(sortie)
+
+
+def verifier_remplacements_contre_course(remplacements, attendus, donnes, modeles_par_juge_course):
+    """Garde CL35-04 avec remplacement déclaré. `attendus` : {étiquette: modèle} du manifeste de départ ; `donnes` : ceux du
+    bras ; `modeles_par_juge_course` : `noyau/modeles.json["par_juge"]`. Rend la liste, triée par étiquette, des remplacements
+    déclarés `{etiquette, modele_course, modele_joue, reference_go, mot_verbatim, applique}` (`applique` : le modèle donné est
+    le modèle joué déclaré ; faux : le modèle de la course est donné). Refus (`CourseInterrompue`, message CL35-04) :
+    étiquettes données ≠ étiquettes de la course ; remplacement pour une étiquette absente de la course ; modèle de la course
+    déclaré ≠ manifeste de départ ou ≠ `noyau/modeles.json` ; modèle donné qui n'est ni celui de la course ni le modèle joué
+    déclaré pour cette étiquette."""
+    if set(donnes) != set(attendus):
+        raise CourseInterrompue(f"juges externes donnés {donnes} ≠ attendus par la course {attendus} (CL35-04) : étiquettes "
+                                "différentes, jamais admises même avec un remplacement déclaré")
+    for etiquette, r in sorted(remplacements.items()):
+        if etiquette not in attendus:
+            raise CourseInterrompue(f"remplacement déclaré pour {etiquette!r}, étiquette absente des juges externes de la "
+                                    f"course {sorted(attendus)} (CL35-04)")
+        if r["modele_course"] != attendus[etiquette]:
+            raise CourseInterrompue(f"remplacement déclaré pour {etiquette!r} : modèle de la course déclaré "
+                                    f"{r['modele_course']!r} ≠ manifeste de départ {attendus[etiquette]!r} (CL35-04)")
+        if modeles_par_juge_course.get(etiquette) != attendus[etiquette]:
+            raise CourseInterrompue(f"remplacement déclaré pour {etiquette!r} : noyau/modeles.json "
+                                    f"{modeles_par_juge_course.get(etiquette)!r} ≠ manifeste de départ "
+                                    f"{attendus[etiquette]!r} : la course n'est pas cohérente (CL35-04)")
+    remplaces = []
+    for etiquette in sorted(attendus):
+        m, r = donnes[etiquette], remplacements.get(etiquette)
+        if m == attendus[etiquette]:
+            if r is not None:
+                remplaces.append(dict(etiquette=etiquette, **r, applique=False))
+            continue
+        if r is not None and m == r["modele_joue"]:
+            remplaces.append(dict(etiquette=etiquette, **r, applique=True))
+            continue
+        raise CourseInterrompue(f"juges externes donnés {donnes} ≠ attendus par la course {attendus} (CL35-04) : "
+                                f"{etiquette!r} joué par {m!r}, ni le modèle de la course ni un remplacement déclaré")
+    return remplaces
+
