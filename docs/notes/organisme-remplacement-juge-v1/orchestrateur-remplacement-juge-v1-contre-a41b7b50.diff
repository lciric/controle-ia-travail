+def bloc_lecture_remplacement(remplaces):
+    """Ce que la lecture écrite porte quand au moins un remplacement est appliqué : la mention visible et les remplacements."""
+    return {"mention": MENTION_REMPLACEMENT, "remplacements": copy.deepcopy(remplaces)}
