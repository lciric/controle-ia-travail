+"""Banc de mutations du bras avec remplacement déclaré du modèle d'un juge externe (`pole/bras_remplacement_juge_v1.py`).
+
+Même machinerie que le banc v66 (`essais/mutations_boucle_reelle_v66.py`, chargé tel quel : copie neuve de `orchestrator/`,
+remplacements textuels présents une seule fois, essais sains d'abord, issue « tuée » seulement pour la raison attendue) ; seule la
+liste `MUTATIONS` est remplacée : chaque garde neuve retirée (ou affaiblie) doit faire échouer l'essai nommé de
+`essais/test_bras_remplacement_juge_v1.py`.
+
+  python3 -I -B essais/mutations_bras_remplacement_juge_v1.py [--processus 4] [--sortie RESULTAT.json] [--seulement ID,ID]
+      [--verifier-textes]
+Codes : ceux du banc v66 (0 toutes tuées pour la raison attendue ; 1 au moins une autre issue ; 2 défaut du banc).
+"""
+
+import importlib.util
+import os
+import sys
+
+ICI = os.path.dirname(os.path.abspath(__file__))
+_spec = importlib.util.spec_from_file_location("mutations_boucle_reelle_v66_pour_remplacement_juge_v1",
+                                               os.path.join(ICI, "mutations_boucle_reelle_v66.py"))
+BANC = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(BANC)
+M = BANC.M
+
+B, T = "pole/bras_remplacement_juge_v1.py", "essais/test_bras_remplacement_juge_v1.py"
+NV = "neuve remplacement-juge-v1"
+TOUS = [(T, "Test")]
+
+MUTATIONS = [
+    M("R01-garde-cl35-04-retiree", NV, B, ('        if r is not None and m == r["modele_joue"]:', "        if r is not None:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R02-etiquette-absente-admise", NV, B, ("        if etiquette not in attendus:\n", "        if False:\n"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R03-modele-de-la-course-non-compare", NV, B, ('        if r["modele_course"] != attendus[etiquette]:', "        if False:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R04-noyau-modeles-non-compare", NV, B, ("        if modeles_par_juge_course.get(etiquette) != attendus[etiquette]:",
+                                               "        if False:"), TOUS, "TestGardePure"),
+    M("R05-etiquettes-differentes-admises", NV, B, ("    if set(donnes) != set(attendus):", "    if False:"),
+      TOUS, "test_artefacts_contre_la_course"),
+    M("R06-reference-go-non-verifiee", NV, B, ('        if not REFERENCE_GO.fullmatch(r["reference_go"]):', "        if False:"),
+      TOUS, "test_artefact_reference_de_go_vide"),
+    M("R07-mention-absente-de-la-lecture", NV, B,
+      ("        lecture_course = dict(lecture_course, juge_externe_remplace=bloc_lecture_remplacement(remplaces))", "        pass"),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R08-auto-preference-avec-le-modele-de-la-course", NV, B,
+      ('        modele_par_juge.update({r["etiquette"]: r["modele_joue"] for r in effectifs})\n', ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R09-manifeste-sans-remplacements", NV, B,
+      ("            remplacements_juges_externes=remplaces,  # remplacement-juge-v1 : les deux modèles, la référence de GO, le mot\n", ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R10-sans-option-hors-de-la-v2", NV, B, ("    if remplacements_juges_externes is None:\n        return _v2", "    if False:\n        return _v2"),
+      TOUS, "test_sans_option"),
+    M("R11-modele-joue-egal-admis", NV, B, ('        if r["modele_joue"] == r["modele_course"]:', "        if False:"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R12-secret-admis-dans-un-champ", NV, B, ("            if contient_secret(v):\n", "            if False:\n"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R13-refus-de-taille-sans-remplacement", NV, B, ("cout_usd=0.0,\n                remplacements_juges_externes=remplaces))",
+                                                       "cout_usd=0.0))"), TOUS, "test_refus_de_taille_porte_le_remplacement"),
+    M("R14-famille-du-juge-remplace-absente", NV, B,
+      ('        famille_par_juge.update({r["etiquette"]: [r["modele_course"], r["modele_joue"]] for r in effectifs})\n', ""),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R15-champs-en-plus-admis", NV, B, ("set(r) != set(CHAMPS_REMPLACEMENT)", "not set(CHAMPS_REMPLACEMENT) <= set(r)"),
+      TOUS, "test_artefacts_option_mal_formee"),
+    M("R16-journal-sans-remplacements", NV, B, ('               "remplacements_juges_externes": remplaces}', "               }"),
+      TOUS, "test_sain_remplacement_declare_admis"),
+    M("R17-refus-qui-recopie-la-valeur", NV, B, ("    return caviarder(repr(valeur))[0][:120]", "    return repr(valeur)"),
+      TOUS, "test_secret_jamais_recopie_dans_le_refus"),
+    M("R18-etiquette-par-debut-de-chaine", NV, B, ("not ETIQUETTE.fullmatch(etiquette)", "not ETIQUETTE.match(etiquette)"),
+      TOUS, "test_formes_par_correspondance_entiere"),
+]
+
+BANC.MUTATIONS = MUTATIONS
+
+
+if __name__ == "__main__":
+    sys.exit(BANC.principal())
