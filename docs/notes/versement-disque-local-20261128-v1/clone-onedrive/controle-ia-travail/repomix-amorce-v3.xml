ETALON_AMONT_PAS="${ETALON_AMONT_PAS:-10}"
ETALON_DE="${ETALON_DE:-130}"
ETALON_A="${ETALON_A:-500}"
PAS_ETALON="${PAS_ETALON:-6}"

COMPLET_DE="${COMPLET_DE:-0}"
