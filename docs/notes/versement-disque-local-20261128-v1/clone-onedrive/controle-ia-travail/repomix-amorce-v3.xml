        syn_fusion_25 = p.fusionner(chemins_25)
        assert p._canon(syn_fusion_25) == p._canon(rap_unique_25["synthese"]), (
            "La fusion [0,10)+[10,20)+[20,25) diffère à l'octet d'un processus unique [0,25)"
