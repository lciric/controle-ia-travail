verifier_vast_instance_id_autorise() {
  local vid="${1:-}"
  if ! [[ "$vid" =~ ^[1-9][0-9]*$ ]]; then
    echo "ARRÊT SÉCURITÉ R10 VAST : identifiant Vast '${vid}' invalide (doit être composé exclusivement de chiffres, sans zéro initial)." >&2
    return 1
  fi
  if est_dans_liste_noire_vast "$vid"; then
