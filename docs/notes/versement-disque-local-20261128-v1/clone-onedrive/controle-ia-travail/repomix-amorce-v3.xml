        note_meta = {"chemin": "/opt/entree/note-des-effectifs-sondes-v2-v1.md", "sha256": SHA_NOTE_OFFICIEL}

        # --- Cas 1 (exigence explicite § 3) : repliques=25 découpé en [0,10), [10,20), [20,25) ---
        dir_25_unique = tmp_path / "r25_unique"
