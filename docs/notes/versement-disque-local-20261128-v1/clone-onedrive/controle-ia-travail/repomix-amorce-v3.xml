        rap_unique_26 = json.loads(ch_unique_26.read_text(encoding="utf-8"))

        dir_26_mixte = tmp_path / "r26_mixte"
        plages_26 = [(0, 10)] + decouper_plages_comme_amorce(10, 26, 6)
        assert plages_26 == [(0, 10), (10, 16), (16, 22), (22, 26)]
        chemins_26 = [
