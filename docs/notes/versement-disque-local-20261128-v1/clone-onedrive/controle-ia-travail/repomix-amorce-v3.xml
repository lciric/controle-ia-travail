  echo "=== FIN (rc=$rc, timeout=$TIMEOUT_DECLENCHE, fournisseur=$FOURNISSEUR_EFFECTIF) $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  if [ "$FOURNISSEUR_EFFECTIF" = "hetzner" ]; then
