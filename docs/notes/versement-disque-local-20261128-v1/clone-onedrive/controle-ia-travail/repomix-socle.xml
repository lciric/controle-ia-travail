        lu = lv1.lire_issue_mots_et_cout(racine / lignes[rg.ISSUE_MOTS_ET_COUT_T06]["chemin"],
                                         lignes[rg.ISSUE_MOTS_ET_COUT_T06]["sha256"], float(config["niveau_base_t06"]))
        aires_rec = None
