Emploi :
    python -m controle_ia.relecture_fable_api_v2 relire --piece P [--piece P2 …] --remarques R [--remarques R2 …]
        [--avant V] --consigne C --sortie DOSSIER --cle NOM_DE_VARIABLE [--espace NOM_DE_VARIABLE]
