# --- graines --------------------------------------------------------------------------------------------------------------
def racine_de(empreinte_hex: str) -> int:
    if len(empreinte_hex) != 64 or any(c not in "0123456789abcdef" for c in empreinte_hex):
        raise GardeArret(f"racine : empreinte sha256 hexadécimale attendue, reçu {empreinte_hex!r}")
