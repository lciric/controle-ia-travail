COMMANDE = "python -m controle_ia.t06.lanceur"
CONFIG_CITEE = re.compile(r"Configuration de T0\.6 \(empreinte canonique\) : `([0-9a-f]{64})`")
TACHES_CITEES = re.compile(r"Tâches d'évaluation de T0\.6 : `([0-9a-f]{64})`")
