VERSION = "sonde-hote-durable-a1-v3-v10"
GO_SONDE, MONTANT_GO_SONDE_USD = "GO-2026-11-05-01", 1.0  # v9 (b) : ligne du 5 novembre 2026, plafond 1 USD
