        if not conformes:
            print("aucune offre conforme", file=sys.stderr)
            return 2
        print(min(conformes, key=lambda x: (x["dph_total"], x["id"]))["id"])
        return 0
    env = dict(os.environ)
    return MachineSondeV8(reglages(env), env).principal()


