@dataclasses.dataclass
class Reglages:
    """Tout ce qui diffère entre la vraie machine et le jouet ; défauts = valeurs écrites par le texte v3."""

    travail: Path = Path("/root/a1-v3-troisieme-v1")
    clone_prive: Path = Path("/root/amorce-depot")
