# Champs de la spécification qui sont des constantes de forme : chacun est remplacé par la valeur de la table neuve, et
# la valeur écrite ci-dessus doit lui être égale (additif 1, « Constantes de forme » ; ligne 24 de sa liste d'arrêt).
CHAMPS_DE_FORME = ("n_taches", "episodes_par_tache", "pas_par_episode", "max_jetons_action", "lot", "conditions", "rang",
                   "alpha", "cibles", "pas_sous_echantillon_decisif", "pas_sous_echantillon_descriptif", "n15", "n7",
                   "empreinte_taches", "chemin_taches", "invite", "prefixe_phase", "nom_fichier_identifiants",
                   "fichiers_adaptateurs", "motifs_prives_ajoutes", "disque_transitoire")


def _table_en_specification(constantes: dict) -> dict:
    """Valeurs des champs de forme lues dans la table neuve (clé `constantes`)."""
    c = constantes
    invites = c["invites"]
    if not isinstance(invites, list) or len(invites) != 1 or not isinstance(invites[0], str):
        raise GardeArret("table neuve : la recette du contexte lit une seule invite ; une autre liste est un nœud")
    return {
        "n_taches": c["T"], "episodes_par_tache": c["E"], "pas_par_episode": c["A"], "max_jetons_action": c["J"],
        "lot": c["L"],
        "conditions": tuple(Condition(x["nom"], x["adaptateur"], float(x["dose"])) for x in c["conditions"]),
        "rang": c["adaptateurs"]["rang"], "alpha": float(c["adaptateurs"]["alpha"]),
        "cibles": tuple(c["adaptateurs"]["projections"]),
        "pas_sous_echantillon_decisif": c["pas_couche_decisive"], "pas_sous_echantillon_descriptif": c["pas_couches_descriptives"],
        "n15": c["n15"], "n7": c["n7"],
        "empreinte_taches": c["taches"]["sha256"], "chemin_taches": c["taches"]["chemin"], "invite": invites[0],
        "prefixe_phase": c["noms_de_fichiers"]["prefixe_phase"],
        "nom_fichier_identifiants": c["noms_de_fichiers"]["identifiants"],
        "fichiers_adaptateurs": tuple(sorted(c["noms_de_fichiers"]["adaptateurs"].items())),
        "motifs_prives_ajoutes": tuple(c["motifs_de_chemins_prives_ajoutes"]),
        # RP-7 : place libre exigée = 2 000 000 000 octets plus la plus grosse archive avant découpage
        "disque_transitoire": int(c["place_libre"]) - PLAFOND_DE_TRANSPORT,
    }


def exiger_table_neuve(table) -> dict:
    """Additif 2, M-4 et M-5 : la table neuve dit « report », porte ses constantes, et ses champs « couvert par
    l'additif 2 » sont exactement les quatre de la liste fermée ; E = 1 et aucun fichier des textes (M-1, cas couvert).
    Rend les constantes."""
    if not isinstance(table, dict) or table.get("mot_d_ensemble") != "report" or not isinstance(table.get("constantes"), dict):
        raise GardeArret("table neuve des constantes reportées : elle ne dit pas « report », ou ne porte pas de constantes "
                         "(sous le mot « nœud », rien ne tourne)")
    lignes = table.get("champs_changes")
    if not isinstance(lignes, list) or not all(isinstance(l, dict) and isinstance(l.get("champ"), str) for l in lignes):
        raise GardeArret("table neuve : champs_changes hors de sa forme")
    couverts = sorted(l["champ"] for l in lignes if l.get("statut") == STATUT_COUVERT)
    if couverts != sorted(CHAMPS_COUVERTS_ADDITIF_2):
        raise GardeArret(f"table neuve : champs « {STATUT_COUVERT} » {couverts} au lieu des quatre de la liste fermée de M-4")
    if any(l.get("statut") == "nœud" for l in lignes):
        raise GardeArret("table neuve : un champ changé est un « nœud »")
    c = table["constantes"]
    if c.get("E") != 1 or c.get("noms_de_fichiers", {}).get("textes") != "":
        raise GardeArret("table neuve : E ≠ 1 ou fichier des textes non vide : hors du cas couvert par M-1")
    return c


def specification_depuis_table(spec: Specification, table) -> Specification:
    """La spécification dont les constantes de forme sont celles de la table neuve ; refus si une valeur de `spec`
    diffère de la table (additif 1, ligne 24 : une constante de forme d'un code différente de la table)."""
    constantes = exiger_table_neuve(table)
    try:
        valeurs = _table_en_specification(constantes)
    except (KeyError, TypeError, ValueError) as e:
        raise GardeArret(f"table neuve : constantes hors de leur forme ({type(e).__name__}: {e})") from e
    ecarts = [n for n in CHAMPS_DE_FORME if getattr(spec, n) != valeurs[n]]
    if ecarts:
        raise GardeArret(f"constantes de forme du code différentes de la table neuve : {ecarts} (ligne 24 de l'additif 1)")
    return dataclasses_replace(spec, **valeurs)


