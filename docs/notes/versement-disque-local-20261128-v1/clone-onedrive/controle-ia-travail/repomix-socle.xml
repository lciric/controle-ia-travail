        except GardeArret:
            out.append(("chemin du fichier de centres de la base refusé", True))
    # retrait : tâche d'un épisode appris, comptée, sans arrêt ; étalonnage global non calculé, ligne E0 écrite
    f = fiche_factice({"sonde_c7": [["t000", "e2"]]})
