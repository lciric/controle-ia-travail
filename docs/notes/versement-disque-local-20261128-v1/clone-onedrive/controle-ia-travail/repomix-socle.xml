PARAMETRES_LR = {"max_iter": 8, "C": 25.0, "penalty": "l2", "solver": "liblinear"}     # l. 28-33, 237-238 ; HELIOS v5 p. 29
GRAINES_AUTEURS = tuple(range(10))                                                       # l. 45, 630
