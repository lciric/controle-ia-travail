        if not re.fullmatch(r"[0-9]{1,12}", ident or "") or int(ident) in PROTEGEES:
            ecrire(f"identifiant {ident!r} illisible ou protégé : aucun geste ; la minuterie et le pilote s'en chargent")
            return 4
