def seuil_hors(rng: np.random.Generator, cut_j: float) -> float:
    """Q5 : s = ±U[0,3 ; 1,0] au centième, retiré tant que |s − cut(j)| < 0,3."""
    while True:
        s = round(float(rng.choice([-1, 1]) * rng.uniform(0.3, 1.0)), 2)
        if abs(s - cut_j) >= 0.3:
            return s


@dataclass
class Ligne:
