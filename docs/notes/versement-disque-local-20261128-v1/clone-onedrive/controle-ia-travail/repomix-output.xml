MODULES = ("__init__", "constantes_v1", "entrees_v2", "montage_v1", "lecture_v1", "nuls_v1", "statistiques_v1", "audits_v1",
           "phrases_v1", "lanceur_v2")


@dataclass
class Reglages:
    """Valeurs du texte (défauts). Les essais sur jouets en remplacent certaines ; la ligne de commande n'en expose aucune."""
