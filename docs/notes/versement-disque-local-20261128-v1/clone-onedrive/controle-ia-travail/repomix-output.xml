def sous_embargo(chemin: str) -> bool:
    bas = chemin.lower()
    return any(f in bas for f in EMBARGO_FRAGMENTS) or any(_segments(chemin.split("/"), m.split("/")) for m in EMBARGO_MOTIFS)

