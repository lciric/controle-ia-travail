def _lentille_np_controlee(ctx: Contexte, spec: str) -> dict:
    """Lentille de Neuronpedia lue par le code voisin corrigé ; 31 couches contiguës (0 à 30) ; garde (e) (matrices), valeurs versées."""
    J = ctx.fv().load_lens(spec)
    couches = sorted(J)
    m = {l: J[l].float().numpy() for l in couches}
    return {"couches": couches == list(range(31)), "e": cb.garde_e_matrices(m, spec), "ecarts_identite": cb.ecarts_identite(m)}


