RUN_CONFIRMATION_T06 = "RUN-CONFIRMATION-T06"
SCELLEMENT_JEUX_JD, SCELLEMENT_JEUX_JC, SCELLEMENT_JEUX_JA = ("SCELLEMENT-JEUX-T07-JD", "SCELLEMENT-JEUX-T07-JC",
