def empreinte_octets(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def empreinte_fonction(source: str, nom: str = FONCTION) -> str | None:
    """SHA-256 du texte source exact de la fonction `nom` (None si absente)."""
