    if p1:
        raise Arret("P.1 : " + " ; ".join(p1) + " (l'ajustement ne part pas ; nœud à la mère)")
    return {"provenance_sha256": sha256(ctx.voisin / PUBLIEES["ajustement"][0]), "p1": rel,
