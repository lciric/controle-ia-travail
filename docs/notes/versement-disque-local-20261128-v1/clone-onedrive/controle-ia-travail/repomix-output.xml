             "retraits": retraits}
    (sortie / "bilan.json").write_text(json.dumps(bilan, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    print(json.dumps({k: v for k, v in bilan.items() if k != "retraits"}, ensure_ascii=False, indent=1))
