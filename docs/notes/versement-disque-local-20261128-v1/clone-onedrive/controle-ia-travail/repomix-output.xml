    r.sorties_autres_versions = ()          # v5 : l'essai à blanc ne regarde que ses propres dossiers (aucune sortie réelle)
    r.moteur, r.exiger_bac_a_sable, r.verifier_go = "simule", False, False
    if interrupteurs:                       # v10 : pièces d'essai des interrupteurs, dans un sous-dossier à part
        ajouter_essai_interrupteurs(r, dossier, interrupteurs, prereg_sha, aujourd_hui)
    return r


GO_ESSAI_INTERRUPTEURS = "GO-2026-01-01-03"


def ajouter_essai_interrupteurs(r: Reglages, dossier: Path, interrupteurs: tuple, prereg_sha: str, aujourd_hui: _dt.date) -> None:
    """v10, essai à blanc allumé : registre de GO d'essai (une ligne au montant requis, périmètre qui nomme chaque interrupteur
    allumé), additif d'essai (cite le préenregistrement, la configuration des interrupteurs, chaque interrupteur), tranche et
    liste blanche d'essai (une série de quatre lignes, index scellé). Tout est écrit sous `pieces-d-essai-interrupteurs/` ;
    rien n'est lu dans `registres/` ; aucune de ces pièces ne vaut pour une course réelle."""
    allumes = lire_interrupteurs(interrupteurs)
    ci = lire_configuration_interrupteurs(r)
    d = dossier / "pieces-d-essai-interrupteurs"
    d.mkdir()
    echeance = aujourd_hui + _dt.timedelta(days=1)
    registre = ("# Registre des GO d'ESSAI (essai à blanc du lanceur v10, aucune valeur réelle ; jamais `registres/`)\n\n"
                "| id | accordé le | type | périmètre | plafond | échéance | accordé par | référence |\n"
                "|---|---|---|---|---|---|---|---|\n"
                f"| {GO_ESSAI_INTERRUPTEURS} | {aujourd_hui.isoformat()} | calcul | ESSAI À BLANC : course d'auto-conception, "
                f"interrupteurs {', '.join(allumes)} | {ci['montant_requis_usd']} USD | {echeance.isoformat()} | Lazar | essai |\n")
    chemin_registre = d / "registre-go-d-essai.md"
    ecrire_scelle(chemin_registre, registre)
    additif = ("# Additif de préenregistrement des interrupteurs — ESSAI À BLANC (aucune valeur)\n\n"
               f"Préenregistrement : {prereg_sha}\nConfiguration des interrupteurs : {ci['sha256']}\n"
               f"Interrupteurs : {', '.join(allumes)}\n\nPièce d'essai écrite par le lanceur v10 ; l'additif réel est à venir.\n")
    chemin_additif = d / "additif-interrupteurs-d-essai.md"
    h_additif = ecrire_scelle(chemin_additif, additif)
    tranche = d / "tranche-d-essai"
    tranche.mkdir()
    serie = b"x,y\n1,2\n3,4\n5,6\n7,8\n"
    (tranche / "serie-essai.csv").write_bytes(serie)
    index = {"fichiers": [{"chemin": "serie-essai.csv", "titre": "Série d'essai", "resume": "essai à blanc, aucune donnée réelle",
                           "sha256": sha256_octets(serie)}]}
    h_index = ecrire_scelle(tranche / "index.json", index)
    chemin_liste = d / "liste-blanche-d-essai.json"
    ecrire_scelle(chemin_liste, {os.path.realpath(tranche / "index.json"): h_index})
    r.interrupteurs = allumes
    r.registre_interrupteurs = chemin_registre
    r.additif_interrupteurs = (chemin_additif, h_additif)
    r.tranche_essai = {"tranche": tranche, "liste_blanche": chemin_liste}


def decouper_vers(matiere: Path, dossier: Path) -> int:
    if dossier.exists():
        raise Refus(f"{dossier} existe déjà (R12)")
    octets = matiere.read_bytes()
    lots = decouper_matiere(octets, sha256_octets(octets))
    dossier.mkdir(parents=True)
    h = ecrire_scelle(dossier / "lots-matiere.json", lots)
    print(json.dumps({"lots": str(dossier / "lots-matiere.json"), "sha256": h, "matiere_sha256": lots["matiere_sha256"],
                      "nombre": len(lots["lots"]), "commun_octets": lots["commun"]["octets"],
                      "octets_avec_commun": {l["nom"]: l["octets_avec_commun"] for l in lots["lots"]}}, ensure_ascii=False))
    return 0


def principal(argv: list | None = None, reglages: Reglages | None = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    try:
        allumes = []                        # v10 : interrupteurs nommés, en tête, éteints par défaut
        while argv and argv[0] in OPTIONS_INTERRUPTEURS:
            allumes.append(OPTIONS_INTERRUPTEURS[argv.pop(0)])
        if argv and argv[0] == "--a-blanc" and len(argv) == 2:
            reglages = reglages or reglages_a_blanc(Path(argv[1]).resolve(), lire_interrupteurs(allumes))
        elif argv and argv[0] == "--decouper" and len(argv) == 3 and not allumes:
            return decouper_vers(Path(argv[1]).resolve(), Path(argv[2]).resolve())
        elif argv:
            print(json.dumps({"refus": f"arguments non admis (reçu {argv!r}) ; « [--allumer-…] --a-blanc DOSSIER » ou « --decouper "
                                       "MATIERE DOSSIER »"}, ensure_ascii=False), file=sys.stderr)
            return 2
        reglages = reglages or Reglages.production()
        if allumes:
            reglages.interrupteurs = lire_interrupteurs(allumes)
        return executer(reglages)
    except AlerteCredit as e:
        print(json.dumps({"alerte_credit": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 3
    except Refus as e:
        print(json.dumps({"refus": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2
    except Exception as e:  # noqa: BLE001
        print(json.dumps({"erreur": f"{type(e).__name__}: {e}"}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(principal())
