def base_des_sessions(sortie: Path) -> str | None:
    """La base des dossiers de sessions de l'orchestrateur, lue dans son manifeste de fin (`sessions.base`), si elle y est."""
    m = sortie / "generation-1" / "manifeste-fin.json"
    try:
        d = json.loads(m.read_text(encoding="utf-8")) if m.is_file() else {}
    except (OSError, ValueError):
        return None
    base = (d.get("sessions") or {}).get("base") if isinstance(d, dict) else None
    return base if isinstance(base, str) and base else None


def inventorier(parties: dict) -> dict:
    """v9 : inventaire (chemin relatif, taille, SHA-256) de chaque partie (dossier parcouru sans suivre les liens, ou fichier) ;
    un lien est noté (cible), jamais suivi ; une lecture impossible est notée (jamais tue) ; rien n'est déplacé ni supprimé."""
    out = {}
    for nom, racine in parties.items():
        if racine is None:
            out[nom] = {"racine": None, "present": False, "fichiers": [], "liens": [], "erreurs": [], "nombre": 0, "octets_total": 0}
            continue
        racine = Path(racine)
        fichiers, liens, erreurs = [], [], []
        if racine.is_symlink():
            liens.append({"chemin": racine.name, "cible": os.readlink(racine)})
            chemins = []
        elif racine.is_file():
            chemins = [(racine, racine.name)]
        elif racine.is_dir():
            chemins = []
            for d, sous, noms in os.walk(racine, followlinks=False):
                for s in sorted(sous):
                    p = Path(d) / s
                    if p.is_symlink():
                        liens.append({"chemin": str(p.relative_to(racine)), "cible": os.readlink(p)})
                sous.sort()
                for n in sorted(noms):
                    p = Path(d) / n
                    if p.is_symlink():
                        liens.append({"chemin": str(p.relative_to(racine)), "cible": os.readlink(p)})
                    else:
                        chemins.append((p, str(p.relative_to(racine))))
        else:
            out[nom] = {"racine": str(racine), "present": False, "fichiers": [], "liens": [], "erreurs": [], "nombre": 0,
                        "octets_total": 0}
            continue
        for p, rel in chemins:
            try:
                h, n = hashlib.sha256(), 0
                with open(p, "rb") as f:
                    for bloc in iter(lambda: f.read(1 << 20), b""):
                        h.update(bloc)
                        n += len(bloc)
                fichiers.append({"chemin": rel, "octets": n, "sha256": h.hexdigest()})
            except OSError as e:
                erreurs.append({"chemin": rel, "erreur": f"{type(e).__name__}: {e}"})
        out[nom] = {"racine": str(racine), "present": True, "fichiers": fichiers, "liens": liens, "erreurs": erreurs,
                    "nombre": len(fichiers), "octets_total": sum(x["octets"] for x in fichiers)}
    return {"version": VERSION, "regle": "R-3661 : tout ce qui est récupérable est gardé ; rien n'est supprimé",
            "parties": out, "rien_supprime": True}


def _depot_git(r: Reglages) -> dict:
    try:
        return {"commit": _git(r.depot, "rev-parse", "HEAD").strip(),
                "arbre_modifie": bool(_git(r.depot, "status", "--porcelain", "--untracked-files=no").strip())}
    except Refus as e:
        return {"commit": None, "erreur": str(e)}


def _versions(r: Reglages, orch: Path, env: dict) -> dict:
    p = subprocess.run([r.python, "-I", "-B", "-c", "import numpy, platform; print(numpy.__version__, platform.python_version())"],
                       cwd=str(orch), env=env, capture_output=True, text=True, timeout=60)
    morceaux = p.stdout.split()
    return {"python": morceaux[1] if len(morceaux) == 2 else None, "numpy": morceaux[0] if len(morceaux) == 2 else None,
            "executable": r.python}


# --- v10 : interrupteurs du branchement (éteints par défaut ; rien ci-dessous n'est appelé quand ils sont éteints) ---------------


def lire_interrupteurs(demandes) -> tuple:
    """Noms connus seulement, chacun une fois ; rendus dans l'ordre canonique de `INTERRUPTEURS`."""
    demandes = list(demandes or ())
    inconnus = [d for d in demandes if d not in INTERRUPTEURS]
    if inconnus:
        raise Refus(f"interrupteurs inconnus : {inconnus} (connus : {list(INTERRUPTEURS)})")
    if len(set(demandes)) != len(demandes):
        raise Refus(f"interrupteur nommé deux fois : {demandes}")
    return tuple(n for n in INTERRUPTEURS if n in demandes)


def verifier_combinaison(allumes: tuple) -> None:
    """La lecture exige les tests de mort (la sélection lue est celle de l'étage ; la course v59 refuse plus d'une génération sans
    étage). Les tests de mort seuls sont refusés : l'orchestrateur épinglé ne joue l'étage qu'entre deux générations (jamais
    après la dernière) et toute deuxième génération lit un héritage (classement des juges en v56, sélection en v59)."""
    if INTERRUPTEUR_LECTURE in allumes and INTERRUPTEUR_TESTS_DE_MORT not in allumes:
        raise Refus(f"{INTERRUPTEUR_LECTURE} sans {INTERRUPTEUR_TESTS_DE_MORT} : la sélection lue par la génération suivante est "
                    "celle de l'étage de tests de mort ; sans étage, aucune sélection (aucun repli sur le classement des juges)")
    if allumes == (INTERRUPTEUR_TESTS_DE_MORT,):
        raise Refus(f"{INTERRUPTEUR_TESTS_DE_MORT} seul : l'orchestrateur a41b7b50 ne joue l'étage qu'entre deux générations, et la "
                    "deuxième génération lit toujours un héritage — des tests de mort sans rien servir exigent une version "
                    "d'orchestrateur (étage après la dernière génération) ; refus")


def lire_configuration_interrupteurs(r: Reglages) -> dict:
    """La configuration des interrupteurs, à son empreinte épinglée, scellée ; N ≥ 2 générations, portée « par_generation »,
    étage complet ; montant requis N × S17 + (N − 1) × plafond de l'étage (`configuration_v54.montant_requis`)."""
    chemin, attendu = r.configuration_interrupteurs
    if not _epingle(attendu):
        raise Refus("configuration des interrupteurs : empreinte non posée dans le lanceur")
    chemin = Path(chemin)
    if not chemin.is_file():
        raise Refus(f"configuration des interrupteurs absente : {chemin}")
    lu = sha256_fichier(chemin)
    if lu != attendu:
        raise Refus(f"configuration des interrupteurs d'empreinte {lu}, {attendu} épinglée")
    if not scelle(chemin):
        raise Refus("configuration des interrupteurs non scellée (compagnon .sha256 absent ou faux)")
    o = json.loads(chemin.read_text(encoding="utf-8"))
    n = o.get("generations")
    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
        raise Refus(f"configuration des interrupteurs : generations {n!r} ; un entier ≥ 2 exigé (la lecture se fait d'une génération "
                    "à la suivante)")
    if (o.get("budget") or {}).get("portee_plafond") != "par_generation":
        raise Refus("configuration des interrupteurs : budget.portee_plafond « par_generation » exigé (chaque génération de "
                    "l'orchestrateur repart d'un budget neuf : la portée « course » sous-compterait la ligne de GO)")
    orch = o.get("orchestrateur") or {}
    if orch.get("lanceur_allume") != LANCEUR_ORCHESTRATEUR_ALLUME or orch.get("commit") != COMMIT_ORCHESTRATEUR:
        raise Refus(f"configuration des interrupteurs : orchestrateur {orch!r} ; {LANCEUR_ORCHESTRATEUR_ALLUME} au commit "
                    f"{COMMIT_ORCHESTRATEUR} exigé")
    e = o.get("etage_tests_de_mort")
    if not isinstance(e, dict) or set(CLES_ETAGE) - set(e):
        raise Refus(f"configuration des interrupteurs : etage_tests_de_mort incomplet (manquent "
                    f"{sorted(set(CLES_ETAGE) - set(e or {}))}, aucun défaut)")
    corr = e["correspondance"]
    if not isinstance(corr, dict) or set(corr) != set(CHAMPS_CORRESPONDANCE) or not all(isinstance(v, str) and v for v in corr.values()):
        raise Refus(f"configuration des interrupteurs : correspondance = exactement {CHAMPS_CORRESPONDANCE}")
    plafond = e["plafond_etage_usd"]
    if not (_reel_positif(plafond) and plafond > 0):
        raise Refus("configuration des interrupteurs : plafond_etage_usd > 0 exigé")
    if isinstance(e["nombre"], bool) or not isinstance(e["nombre"], int) or e["nombre"] < 1:
        raise Refus("configuration des interrupteurs : etage_tests_de_mort.nombre entier ≥ 1 exigé")
    permis = e["environnement_permis"]
    if not isinstance(permis, list) or not all(isinstance(x, str) and NOM_DE_VARIABLE.match(x) for x in permis) \
            or any(MOTIF_NOM_DE_CLE.search(x) or x in NOMS_DE_CLE for x in permis):
        raise Refus("configuration des interrupteurs : environnement_permis = noms exacts de variables, aucun nom de clé")
    montant = round(n * PLAFOND_ARRET_USD + (n - 1) * float(plafond), 6)
    return {"chemin": str(chemin), "sha256": lu, "generations": n, "montant_requis_usd": montant, "etage": dict(e),
            "lanceur_orchestrateur": LANCEUR_ORCHESTRATEUR_ALLUME,
            "regle_montant": f"{n} × {PLAFOND_ARRET_USD} + {n - 1} × {float(plafond)} (portée par génération)"}


def verifier_additif_interrupteurs(r: Reglages, allumes: tuple, prereg_sha: str, configuration_sha: str) -> dict:
    """Additif de préenregistrement des interrupteurs : empreinte épinglée dans le lanceur (à venir : refus tant qu'elle n'y est
    pas), fichier présent à cette empreinte, scellé, qui cite en entier l'empreinte du préenregistrement et celle de la
    configuration des interrupteurs, et nomme chaque interrupteur allumé."""
    chemin, attendu = r.additif_interrupteurs
    if chemin is None or not _epingle(attendu):
        raise Refus("additif de préenregistrement des interrupteurs non épinglé (à venir) : aucun interrupteur ne s'allume sans lui")
    chemin = Path(chemin)
    if not chemin.is_file():
        raise Refus(f"additif des interrupteurs absent : {chemin}")
    lu = sha256_fichier(chemin)
    if lu != attendu:
        raise Refus(f"additif des interrupteurs d'empreinte {lu}, {attendu} épinglée")
    if not scelle(chemin):
        raise Refus("additif des interrupteurs non scellé (compagnon .sha256 absent ou faux)")
    texte = chemin.read_text(encoding="utf-8")
    manques = [x for x in (prereg_sha, configuration_sha) + tuple(allumes) if x not in texte]
    if manques:
        raise Refus(f"additif des interrupteurs : ne cite pas {manques} (empreintes en entier, nom de chaque interrupteur allumé)")
    return {"chemin": str(chemin), "sha256": lu}


def garder_interrupteurs(r: Reglages, depart: dict, aujourd_hui: _dt.date, reel: bool) -> dict:
    """Interrupteurs allumés : combinaison, configuration des interrupteurs, ligne de GO qui nomme chaque interrupteur allumé au
    montant requis, additif épinglé ; moteur réel refusé par construction (v10). Appelée seulement si un interrupteur est allumé,
    juste après la pièce de départ, avant toute autre garde, tout appel et toute écriture."""
    allumes = lire_interrupteurs(r.interrupteurs)
    if not allumes:
        raise Refus("garde des interrupteurs appelée sans interrupteur allumé (erreur du lanceur)")
    verifier_combinaison(allumes)
    ci = lire_configuration_interrupteurs(r)
    go_id = depart.get("go_interrupteurs")
    if not (isinstance(go_id, str) and GO_FORME.match(go_id)):
        raise Refus("interrupteurs allumés sans ligne de GO : pièce de départ sans go_interrupteurs (GO-AAAA-MM-JJ-NN)")
    if go_id in LIGNES_GO_CONSOMMEES or go_id == depart.get("go_epreuve"):
        raise Refus(f"go_interrupteurs {go_id} : ligne consommée ou ligne de l'épreuve des témoins — une ligne neuve est exigée")
    if reel:
        registre = lire_registre(r)
        source = {"registre": "registres/go.md", "commit": registre["commit"], "sha256": registre["sha256"]}
    else:
        if r.registre_interrupteurs is None or not scelle(Path(r.registre_interrupteurs)):
            raise Refus("interrupteurs allumés en moteur simulé sans registre de GO d'essai scellé (essai à blanc seulement)")
        registre = {"texte": Path(r.registre_interrupteurs).read_text(encoding="utf-8")}
        source = {"registre": str(r.registre_interrupteurs), "sha256": sha256_fichier(Path(r.registre_interrupteurs)),
                  "nature": "registre d'essai écrit par l'essai à blanc (jamais `registres/`)"}
    go = verifier_go(registre["texte"], aujourd_hui, go_id, ci["montant_requis_usd"], MOTS_GO_INTERRUPTEURS + allumes)
    if not _epingle(r.prereg[1]):
        raise Refus("empreinte du préenregistrement non posée : l'additif des interrupteurs ne peut être vérifié")
    additif = verifier_additif_interrupteurs(r, allumes, r.prereg[1], ci["sha256"])
    if reel:
        raise Refus("moteur réel, interrupteurs allumés : refusé par construction dans la v10 — " + " ; ".join(BLOCAGES_REELS_V10))
    return {"allumes": list(allumes), "etat": "allumés, moteur simulé (essai à blanc) : rien de payé, exécuteur factice",
            "configuration": {k: v for k, v in ci.items() if k != "etage"}, "etage_configure": ci["etage"],
            "go": dict(go, source=source), "mots_exiges_au_perimetre": list(MOTS_GO_INTERRUPTEURS + allumes),
            "additif": additif, "blocages_reels_v10": list(BLOCAGES_REELS_V10)}


def verifier_empreintes_allume(r: Reglages, orch_dir: Path) -> dict:
    """Allumé : les fichiers propres au lanceur v59 de l'orchestrateur (course v59, étage v57, étage de tests de mort v5…), à leurs
    empreintes épinglées, en plus de celles de la v9 (`verifier_orchestrateur`)."""
    ecarts = {rel: (sha256_fichier(orch_dir / rel) if (orch_dir / rel).is_file() else None) for rel in r.empreintes_orchestrateur_allume}
    ecarts = {k: v for k, v in ecarts.items() if v != r.empreintes_orchestrateur_allume[k]}
    if ecarts:
        raise Refus(f"orchestrateur (allumé) : empreintes différentes ou fichiers absents : {ecarts}")
    return {"lanceur": LANCEUR_ORCHESTRATEUR_ALLUME, "empreintes": dict(r.empreintes_orchestrateur_allume)}


def appliquer_interrupteurs(conf: dict, garde: dict, fixe: dict, r: Reglages) -> tuple:
    """La configuration assemblée (v5, comme la v9), plus la portée par génération et l'étage de tests de mort ; la tranche et la
    liste blanche de l'essai à blanc remplacent « À REMPLIR » (refus sinon). Dit si les fiches de la course portent les champs
    que l'étage lit (sinon chaque fiche est refusée à l'étage : aucun champ n'est inventé)."""
    e = dict(garde["etage_configure"])
    if r.tranche_essai:
        e["tranche"], e["liste_blanche"] = str(r.tranche_essai["tranche"]), str(r.tranche_essai["liste_blanche"])
    if MARQUEUR_A_REMPLIR in (e["tranche"], e["liste_blanche"]):
        raise Refus("étage : tranche ou liste blanche « À REMPLIR » (aucune tranche réelle pour cette course)")
    if e["fournisseur"] not in conf["fournisseurs"]:
        raise Refus(f"étage : fournisseur {e['fournisseur']!r} sans relais déclaré")
    conf = dict(conf, budget=dict(conf["budget"], portee_plafond="par_generation"), etage_tests_de_mort=e)
    champs = list(fixe.get("champs_fiche") or [])
    absents = sorted(k for k, v in e["correspondance"].items() if v.split(".")[0] not in champs)
    return conf, {"tranche": e["tranche"], "liste_blanche": e["liste_blanche"], "fiches_testables": not absents,
                  "champs_de_correspondance_absents_des_fiches": absents,
                  "consequence": ("chaque fiche de la course est refusée à l'étage (« fiche sans champ test_de_mort ») : aucun test, "
                                  "sélection vide" if absents else "fiches projetables sur les champs de l'étage")}


def couts_generation(sortie: Path, k: int) -> dict:
    """Coût d'une génération (fichier `generation-k/consommations.json`), même lecture que `couts_reels` (génération 1)."""
    chemin = sortie / f"generation-{k}" / "consommations.json"
    if not chemin.is_file():
        return {"lisible": False, "motif": f"{chemin} absent"}
    donnees = json.loads(chemin.read_text(encoding="utf-8")).get("consommations") or []
    total = sum(float(x.get("cout_usd") or 0.0) for x in donnees
                if x.get("role") not in ("plafond-relais", "coupure") and not x.get("coupure"))
    return {"lisible": True, "fichier_sha256": sha256_fichier(chemin), "total_usd": round(total, 6), "lignes": len(donnees)}


def bilan_allume(sortie: Path, interrupteurs: dict) -> dict:
    """Allumé : coûts de toutes les générations, comparés au montant requis ; bilan de la course de l'orchestrateur relu par
    comptes seulement (générations jouées, nœud, arrêt, étage : candidates, refusées, retenues ; empreinte de la sélection servie) —
    aucun verdict, aucun contenu de fiche."""
    n = interrupteurs["configuration"]["generations"]
    par_gen = {k: couts_generation(sortie, k) for k in range(1, n + 1)}
    total = round(sum(v["total_usd"] for v in par_gen.values() if v.get("lisible")), 6)
    out = {"couts_par_generation": par_gen, "total_generations_usd": total,
           "montant_requis_usd": interrupteurs["configuration"]["montant_requis_usd"],
           "depasse": total > interrupteurs["configuration"]["montant_requis_usd"] + 1e-9}
    chemin = sortie / "bilan-course.json"
    if not chemin.is_file():
        out["bilan_orchestrateur"] = {"lisible": False, "motif": f"{chemin} absent"}
        return out
    b = json.loads(chemin.read_text(encoding="utf-8"))
    lignes = []
    for g in b.get("generations") or []:
        et = g.get("etage") or {}
        par_fiche = et.get("par_fiche") or []
        sel = et.get("selection") or {}
        lignes.append({"generation": g.get("generation"), "fiches_classees": g.get("fiches_classees"), "noeud": g.get("noeud"),
                       "etage_joue": bool(et), "candidates": len(et.get("candidates") or []),
                       "refusees_a_l_etage": sum(1 for p in par_fiche if p.get("statut") == "refusée à l'étage"),
                       "testees": sum(1 for p in par_fiche if p.get("statut") == "testée"),
                       "retenues": len(sel.get("retenues") or []), "selection_sha256": sel.get("sha256"),
                       "heritage_servi_a_la_suivante": bool(g.get("heritage_servi_a_la_suivante"))})
    out["bilan_orchestrateur"] = {"lisible": True, "sha256": sha256_fichier(chemin), "scelle": scelle(chemin),
                                  "version": b.get("version"), "generations_jouees": len(lignes), "lignes": lignes,
                                  "noeud": b.get("noeud"), "arret": b.get("arret")}
    return out


# --- exécution ------------------------------------------------------------------------------------------------------------------


def executer(r: Reglages) -> int:
    env_lu = dict(os.environ) if r.environnement is None else dict(r.environnement)
    aujourd_hui = r.aujourd_hui or _dt.datetime.now(_dt.timezone.utc).date()
    reel = r.moteur == "reel"

    depart = verifier_piece_de_depart(r)                                    # v5 : avant la garde, qui lit son mot de reprise
    allume = bool(r.interrupteurs)                                          # v10 : éteints par défaut ; éteints, rien ne change
    interrupteurs = garder_interrupteurs(r, depart, aujourd_hui, reel) if allume else dict(ETAT_ETEINT)
    une_seule = verifier_course_jamais_lancee_ou_closes_admises(r, depart)  # v7 : courses v4 et v6 closes admises sur mot de reprise
    cle_claude = depart["variable_cle_claude"]
    cle_presente = bool(env_lu.get(cle_claude))  # nom présent et valeur non vide ; la valeur n'est jamais lue ni écrite
    if reel and not cle_presente:
        raise Refus(f"variable {cle_claude} absente ou vide dans l'environnement du lanceur : arrêt au départ")
    registre = lire_registre(r) if (reel and r.verifier_go) else None
    go = verifier_go(registre["texte"], aujourd_hui, depart["go_course"], PLAFOND_ARRET_USD, ("autoconception",)) if registre \
        else {"go": "sans objet (moteur simulé, aucune dépense)"}
    # v5 : le mot de reprise (ligne de la course, « tentative neuve ») au registre de main, que la v4 close soit vue ou non
    reprise = verifier_mot_de_reprise(registre["texte"], aujourd_hui, depart) if registre \
        else {"mot_de_reprise": depart["tentative_neuve"]["mot_de_reprise"], "registre": "non lu (moteur simulé)"}
    lanceur_sha = sha256_fichier(r.lanceur)
    prereg = verifier_preenregistrement(r)
    pieces = verifier_pieces(r)
    additif = verifier_additif(r, prereg["sha256"], pieces)                 # v7 : additif v2g
    cl = verifier_contre_lecture(r, additif["sha256"], lanceur_sha)         # v7 : cite l'additif v2g et ce lanceur
    fixe = json.loads(Path(pieces["configuration"]["absolu"]).read_text(encoding="utf-8"))
    garde_configuration_fixe(fixe)
    seuils = garde_seuils_au_haut(fixe)                                     # v9 : les juges lancés au haut du devis v2i
    matiere = verifier_matiere(r)
    lots = decouper_matiere(matiere["octets"], matiere["sha256"])
    epreuve = verifier_epreuve_reelle(r, pieces, fixe, depart, aujourd_hui, lanceur_sha) if reel \
        else {"exigee": False, "motif": "moteur simulé : l'épreuve hors ligne des témoins suffit à l'essai à blanc"}
    sonde_astra = verifier_sonde_astra(r, depart, aujourd_hui)              # v5 : sonde d'Astra du jour (les deux moteurs)
    decl_brute, decl_sha = lire_json_scelle(r.declaration, "déclaration des relais")
    decl = verifier_declaration(decl_brute, fixe, depart)
    composition = verifier_composition_tenue(depart, decl)                  # v5 : aucune espèce déclarée omise
    carbon = controler_reglage_carbon(decl_brute["fournisseurs"]["carbon"], pieces, depart) if "carbon" in decl["fournisseurs"] \
        else {"declare": False}                                            # v7 : Carbon synchrone, réglage figé par l'enveloppe
    argon = controler_reglage_argon(decl_brute["fournisseurs"]["argon"], pieces)   # v8 : Argon proposeur sans troncature, juge v5
    releve_brut, releve_sha = lire_json_scelle(r.releve, "relevé des crédits")
    horodatage = r.horodatage()
    ident = nouvel_ident(r)
    dossier_run = r.dossier_runs / ident
    consigne = Path(pieces["consigne_proposeur"]["absolu"]).read_bytes()
    if RESTES_INTERDITS.search(consigne.decode("utf-8")):
        raise Refus("consigne du proposeur : nom du directeur ou identifiant de session non expurgé (constat 9)")
    entree_max = entree_max_octets(consigne, lots)
    entree_servie = plus_grande_entree(consigne.decode("utf-8"), lots)     # v7 : la plus grande consigne servie à un proposeur
    plafond_proposeur = float(fixe["plafonds_session"]["proposeur"])
    if carbon.get("declare") is not False:                                 # v8 : sortie maximale aux deux comptes, sous 6,05 USD
        carbon = dict(carbon, pire_cas=pire_cas_sans_troncature(carbon, entree_servie, plafond_proposeur, "Carbon"))
    argon = dict(argon, pire_cas=pire_cas_sans_troncature(argon, entree_servie, plafond_proposeur, "Argon proposeur"))   # v8
    sonde_carbon = verifier_sonde_carbon(r, depart, aujourd_hui, pieces, entree_servie, carbon)   # v7 : les deux moteurs
    parts = parts_au_pire(fixe, len(lots["lots"]), entree_max, decl)
    credits = verifier_credits(releve_brut, decl["cles"], aujourd_hui,
                               r.dossier_runs / (ident.replace(SUFFIXE_RUN, "") + "-alerte-credits-auto-conception-v10"), parts, depart)
    appels_argon = appels_argon_au_pire(fixe, len(lots["lots"]), decl["especes_actives"], fixe["cartes_max_comptees"])
    appels_relais_argon = appels_relais_gemini_requis(appels_argon)       # v4 : 2 appels de relais par appel d'Argon, + 2
    procedure = verifier_procedure_relais(r, decl, pieces, fixe, appels_relais_argon, appels_externes=len(lots["lots"])) if reel \
        else {"exigee": False, "motif": "moteur simulé : aucun relais réel"}
    prix = verifier_releve_prix(r.releve_prix, fixe, aujourd_hui) if reel else {"exige": False, "motif": "moteur simulé"}
    orch = verifier_orchestrateur(r)
    orch_dir = Path(orch["chemin"])
    if allume:                                                             # v10 : fichiers propres au lanceur v59, épinglés
        interrupteurs["orchestrateur_allume"] = verifier_empreintes_allume(r, orch_dir)

    dossier_sortie = r.dossier_sorties / ident
    sortie = dossier_sortie / "sortie"
    if dossier_run.exists() or dossier_sortie.exists():
        raise Refus(f"{dossier_run} ou {dossier_sortie} existe déjà (R12)")
    env, retires, hors_liste = environnement_filtre(env_lu, dossier_sortie, depart["go_course"])
    if allume:                    # v10 : jamais en moteur réel (refusé par `garder_interrupteurs`) ; déclaration d'essai seulement
        if reel:
            raise Refus("interrupteurs allumés en moteur réel : refusé (v10)")
        env[VARIABLE_MACHINE_JETABLE] = "1"
        interrupteurs["machine_jetable"] = {"variable": VARIABLE_MACHINE_JETABLE, "nature": "déclaration d'essai posée par le "
                                            "lanceur en moteur simulé (exécuteur factice : aucun code de carte exécuté) ; "
                                            "jamais posée en moteur réel"}
    bac = sonder_bac_a_sable(r, orch_dir, env) if reel else {"exige": False, "motif": "moteur simulé : aucun agent réel"}

    # Dossier du run (n'empêche pas une nouvelle tentative : la garde « une seule course » lit le manifeste de départ).
    dossier_run.mkdir(parents=True)
    h_lots = ecrire_scelle(dossier_run / "lots-matiere.json", lots)
    dossier_arrets = dossier_sortie / "arrets-credit"   # chemin seulement : la sortie est créée après la porte à blanc
    dossier_conservation = dossier_sortie / DOSSIER_CONSERVATION_NOM   # v9 (R-3661) : chemin seulement, créé avec la sortie
    decl = envelopper_commandes(decl, r.python, Path(pieces["garde_credit"]["absolu"]), dossier_arrets,
                                Path(pieces["enveloppe_conservation"]["absolu"]), dossier_conservation)
    h_acte = ecrire_scelle(dossier_run / "acte-de-gel.md", acte_de_gel(prereg, cl, lanceur_sha, horodatage, matiere, h_lots, additif))
    spec = {"preenregistrement": {"chemin": str(dossier_run / "acte-de-gel.md"), "sha256": h_acte},
            "contre_lecture": {"chemin": cl["chemin"], "sha256": cl["sha256"]}}
    conf = assembler_configuration(fixe, lots, pieces, decl, spec)
    if allume:                                                             # v10 : portée par génération, étage de tests de mort
        conf, interrupteurs["etage"] = appliquer_interrupteurs(conf, interrupteurs, fixe, r)
    chemin_conf = dossier_run / "configuration-orchestrateur.json"
    h_conf = ecrire_scelle(chemin_conf, conf)
    lanceur_orch, n_gen = (LANCEUR_ORCHESTRATEUR_ALLUME, interrupteurs["configuration"]["generations"]) if allume \
        else (LANCEUR_ORCHESTRATEUR, 1)
    montant_attendu = interrupteurs["configuration"]["montant_requis_usd"] if allume else PLAFOND_ARRET_USD
    base = [r.python, "-I", "-B", lanceur_orch, "--course-2", str(chemin_conf), str(sortie), "--generations", str(n_gen)]
    derive = ecrire_registre_derive(registre, dossier_run / "registre-go-derive.md", depart["go_course"]) if registre \
        else {"motif": "moteur simulé"}
    moteur = ["--moteur", "reel", "--confirmer-moteur-reel", "--registre-go", derive["derive"]] if reel else ["--moteur", "simule"]
    env_verif = dict(env, HOME=str(dossier_run))
    verif = subprocess.run(base + ["--verifier-seulement"] + (moteur if reel else []),
                           cwd=str(orch_dir), env=env_verif, capture_output=True, text=True, timeout=600)
    try:
        verif_json = json.loads(verif.stdout) if verif.returncode == 0 else None
    except ValueError:
        verif_json = None
    if verif_json is None or verif_json.get("montant_requis_go_usd") != montant_attendu:
        raise Refus(f"vérification de l'orchestrateur refusée (code {verif.returncode}) : "
                    f"{(verif.stderr or verif.stdout).strip()[-800:]!r}")
    if verif_json.get("specification", {}).get("conforme") is not True:
        raise Refus(f"spécification refusée par l'orchestrateur : {verif_json.get('specification')}")
    portes = porte_a_blanc(decl) if reel else {"exige": False, "motif": "moteur simulé : portes tenues par le noyau"}
    dossier_sortie.mkdir(parents=True)   # constat 1 : seulement après la porte à blanc et toutes les gardes
    dossier_arrets.mkdir()
    dossier_conservation.mkdir()         # v9 (R-3661) : tenu par le lanceur ; l'enveloppe de conservation ne le crée jamais
    argv = base + moteur
    especes = [e["etiquette"] for e in decl["especes_actives"]]
    depart_manifeste = {
        "lanceur": {"version": VERSION, "chemin": str(r.lanceur), "sha256": lanceur_sha}, "moteur": r.moteur,
        "horodatage_canonique": horodatage, "id": ident, "go": go, "plafond_arret_usd": PLAFOND_ARRET_USD,
        "piece_de_depart": {k: v for k, v in depart.items()}, "preenregistrement": prereg, "additif_v2i": additif,
        "additifs_cites": {"v2c": {"chemin": ADDITIF_V2C[0], "sha256": ADDITIF_V2C[1]},
                           "v2d": {"chemin": ADDITIF_V2D[0], "sha256": ADDITIF_V2D[1]},
                           "v2e": {"chemin": ADDITIF_V2E[0], "sha256": ADDITIF_V2E[1]},
                           "v2f": {"chemin": ADDITIF_V2F[0], "sha256": ADDITIF_V2F[1]},
                           "v2g": {"chemin": ADDITIF_V2G[0], "sha256": ADDITIF_V2G[1]},
                           "v2h": {"chemin": ADDITIF_V2H[0], "sha256": ADDITIF_V2H[1]}},
        "seuils_internes_au_haut": seuils,                                   # v9
        "interrupteurs_v10": interrupteurs,                                  # v10 : « éteints » par défaut
        "conservation": {"dossier": str(dossier_conservation), "enveloppe": pieces["enveloppe_conservation"],   # v9 (R-3661)
                         "transcriptions_claude": str(dossier_sortie / DOSSIER_TRANSCRIPTIONS_CLAUDE),
                         "inventaire_de_fin": str(dossier_run / "inventaire-conservation.json"),
                         "regle": "copie octet pour octet de chaque réponse rendue par une commande externe, avant de la "
                                  "rendre ; inventaire de fin quelle que soit l'issue ; rien n'est supprimé"},
        "une_seule_course": une_seule, "mot_de_reprise": reprise, "sonde_astra_du_jour": sonde_astra,
        "composition": composition, "carbon_regle": carbon, "argon_regle": argon, "sonde_carbon_du_jour": sonde_carbon,
        "plus_grande_entree_servie": {k: v for k, v in entree_servie.items() if k != "texte"},
        "contre_lecture": cl,
        "acte_de_gel_sha256": h_acte, "pieces": pieces,
        "matiere": {k: v for k, v in matiere.items() if k != "octets"},
        "lots": {"sha256": h_lots, "nombre": len(lots["lots"]), "commun_octets": lots["commun"]["octets"],
                 "octets_par_lot": {l["nom"]: l["octets"] for l in lots["lots"]},
                 "masques": lots["commun"]["masques"] + sum(l["masques"] for l in lots["lots"]), "entree_max_octets": entree_max},
        "epreuve_reelle_des_temoins": epreuve,
        "declaration_relais": {"chemin": str(r.declaration), "sha256": decl_sha},
        "especes_actives": especes, "especes_absentes": decl["especes_absentes"], "cles_employees": decl["cles"],
        "cle_par_espece": {e["etiquette"]: decl["cles"][e["fournisseur"]] for e in decl["especes_actives"]},
        "cle_par_role_interne": {"aiguilleur": decl["cles"][fixe["aiguilleur"]["fournisseur"]],
