                         processus=args.processus, cartes_E1=cartes_E1, controles=controles, garde=garde, journal=journal)
    except BaseException as e:
        print(f"ARRÊT : {X.consigner_arret(dossier, e, run_id, sha_m, journal)}", file=sys.stderr)
        raise
    t1 = time.time()
