        r["etat"] = S.etat_duel(r["bas"], r["haut"], r["n_scenarios"], False, nu, tau)
        r["qualificatifs"] = S.qualificatifs(r["delta"], delta_sep, ja["au_dessus_du_plancher"], r["bande"], r["etat"])
        r["phrase"] = S.phrase_duel(r["etat"], r["qualificatifs"], nu)
        r.pop("contributions")

