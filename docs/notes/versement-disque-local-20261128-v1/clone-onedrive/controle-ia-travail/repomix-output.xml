def _socle(g: int, temps: str, ident: str, go: dict, sortie: Path, horodatage: str) -> dict:
    return {"lanceur": {"version": VERSION, "chemin": str(Path(__file__).resolve()), "sha256": sha256_fichier(Path(__file__))},
