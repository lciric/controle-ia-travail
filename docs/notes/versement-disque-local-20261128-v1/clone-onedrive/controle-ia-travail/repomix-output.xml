           "OMP_NUM_THREADS": "1", "OPENBLAS_NUM_THREADS": "1", "MKL_NUM_THREADS": "1"}
    t0 = time.time()
    r = subprocess.run([sys.executable, "-I", "-B", "-c", RUNNER, str(vue), str(sortie), *filtre], cwd=str(vue), env=env,
                       capture_output=True, text=True)
    duree = time.time() - t0
