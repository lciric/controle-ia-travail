                          "commande": {"chemin": str(cmds["astra"]), "sha256": COMMANDES_MAIN_A_BLANC["astra"][1]}})
    # v7 : sonde de Carbon d'essai, sur la plus grande entrée servie (recalculée ici comme le lanceur la recalcule)
