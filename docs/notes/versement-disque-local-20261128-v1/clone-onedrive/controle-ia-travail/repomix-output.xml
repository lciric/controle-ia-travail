        raise RefusRegistre(f"registre {REGISTRE} absent du dépôt (liste d'arrêt n° 3)")
    trouvees = {CLE_SCELLEMENT: [], CLE_CODE: []}
    fautes = []
    for ligne in registre.read_text(encoding="utf-8").splitlines():
