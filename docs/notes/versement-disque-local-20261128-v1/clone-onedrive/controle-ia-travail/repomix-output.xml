import datetime
import hashlib
import json
import os
import sys
from pathlib import Path

NOM_OUTIL = "remplacer_texte_exact_v1"
SUFFIXE_SHA = ".sha256"
SUFFIXE_JOURNAL = ".journal-remplacements-v1.json"
CODE_REFUS = 2
