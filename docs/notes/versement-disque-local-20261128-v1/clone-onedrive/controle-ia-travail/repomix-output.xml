                                   "le superviseur"}, ensure_ascii=False), file=sys.stderr, flush=True)
        return 5
    print(json.dumps({"generation": 1, "etat": "lancée, détachée", "pid_superviseur": sup["pid"], "arret": sup["arret"],
                      "manifeste_depart_sha256": h, "sortie": str(sortie), "go": go["id"]}, ensure_ascii=False), flush=True)
    return 0


def principal(argv: list | None = None, reglages: Reglages | None = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    if argv != [ARGUMENT]:
        print(json.dumps({"refus": f"un seul argument admis, « {ARGUMENT} » (reçu {argv!r})"}, ensure_ascii=False),
              file=sys.stderr)
        return 2
    r = reglages or Reglages.production()
    fd = None
    try:
        soi = verifier_soi(r)
        fd = prendre_verrou(r)
        return executer(r, soi)
    except Refus as e:
        print(json.dumps({"refus": str(e)}, ensure_ascii=False), file=sys.stderr)
        return 2
    finally:
        if fd is not None:
            os.close(fd)


if __name__ == "__main__":
    raise SystemExit(principal())
