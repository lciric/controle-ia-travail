def _aller_retour_banc(ctx: Contexte) -> dict:
    """L'aller-retour entier de Drowse (export par `04_export_rlens.py`, chargement par `load_lens`, garde (o)), essayé dans la copie
    du banc sur l'ajustement de trois documents, **avant** l'ajustement payant (contre-lecture, M-3 ; arrêt ajouté dans le sens sévère,
    déclaré dans la commande). Rend {"problemes": [...]}."""
    b = ctx.banc_voisin
    fr = b / "data" / "fits" / cb.FIT_NOMS["R"]
    s = ctx.executer([sys.executable, "scripts/04_export_rlens.py", str(fr), "--name", "banc-aller-retour"], b, env_enfant(b, True),
                     ctx.journal("banc"), 1800)
    if s["code"] != 0:
        return {"problemes": [f"04_export_rlens.py en échec dans la copie du banc (code {s['code']})"]}
    env = env_enfant(b, True) | {"PYTHONPATH": f"{b}{os.pathsep}{ctx.racine / 'src'}"}
    s = ctx.executer([sys.executable, "-c", ALLER_RETOUR, str(fr), str(b)], b, env, ctx.journal("banc"), 1800)
    ligne = next((l for l in reversed(s["fin"]) if l.startswith("ALLER-RETOUR ")), None)
    if s["code"] != 0 or ligne is None:
        return {"problemes": [f"aller-retour illisible (code {s['code']})"]}
    return {"problemes": json.loads(ligne.removeprefix("ALLER-RETOUR "))}


def _ajustement(ctx: Contexte, lentille: str) -> dict:
    f = ctx.voisin / "data" / "fits" / cb.FIT_NOMS[lentille]
    journal = ctx.journal(f"ajustement-{lentille}")
    if not journal.exists():  # premier lancement : aucun fichier `-T128` de cette lentille (ni, pour R, de S) dans l'arbre
        presents = [x for x in ([cb.FIT_NOMS["R"], cb.FIT_NOMS["S"]] if lentille == "R" else [cb.FIT_NOMS["S"]])
                    if (ctx.voisin / "data" / "fits" / x).exists()]
        exiger(q=cb.garde_q_avant(presents))
    elif f.exists():  # relance : le point de sauvegarde porte l'empreinte des lignes, full_length, la lentille et le modèle
        exiger(q=cb.garde_q_relance(charger_fit(f)["meta"], lentille))
    s = ctx.executer(_commande_fit(lentille), ctx.voisin, env_enfant(ctx.voisin, True), journal, 10 * 3600)
    if s["code"] != 0 or not f.exists():
        raise Arret(f"ajustement {lentille} en échec (code {s['code']})")
    saved = charger_fit(f)
    r = resume_fit(saved)
    r["diffs_recopie"] = r["diffs"]  # recopie numpy, versée pour mémoire (contre-lecture, m-7)
    r["diffs"] = ctx.fv().split_half(saved)  # `Accumulator.split_half` du dépôt lui-même : la valeur lue pour les seuils
    rows = ctx.fv().lens_docs_ajustement()[0]
    g = cb.garde_g_fit(r["meta"], r["next_doc"], r["n_docs"], cb.longueurs_point(r["meta"], rows), r["diffs"], r["finies"], lentille)
    h = cb.garde_h(r["premiere_dim"], lentille)
    exiger(g=g, h=h)
    return {"fichier": f.name, "sha256": sha256(f), "taille": f.stat().st_size} | {k: v for k, v in r.items() if k != "meta"} | {
        "meta": {k: v for k, v in r["meta"].items()}, "longueurs": sorted(set(cb.longueurs_point(r["meta"], rows)))}


