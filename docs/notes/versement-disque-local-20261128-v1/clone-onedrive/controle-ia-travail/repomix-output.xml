                 "lignes": {"BA-L0": {"s_applique": True, "phrase": PHRASES_BA["BA-L0"].replace("<motif>", motif)}},
                 "note": f"aucune ligne {CLES_LIGNES['issue']} n'est inscrite sur cette tentative ; la discrétion est « non lue »"}
        try:
