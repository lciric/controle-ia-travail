def _serie_repere(ctx: Contexte) -> list:
    j = json.loads((ctx.racine / SERIE_REPERE).read_text(encoding="utf-8"))
    s = j["targets"]["steer 1x"]["npR"]
    if list(s["layer"]) != list(range(32)):
        raise Arret("série repère : couches inattendues")
    return list(s["r_med"])


def problemes_gardes(ctx: Contexte) -> dict:
    """Gardes constatées sur la machine, pour le code des verdicts. (d), (f), (i) et l'identité sont **relues** des résultats scellés
    de B0, de la fumée et du corpus d'activations ; les autres lettres sont posées tenues **parce que** l'étape qui les exige a rendu un
    résultat (une garde manquée écrit le verdict « chaîne en défaut » et arrête) : (g), (h) aux ajustements ; (e), (h), (n), (o) à
    l'export ; (q) aux ajustements ; (k) à la fumée, la passe, les pilotes, les lectures ; (p) aux pilotes et à `measure` ; (r) aux
    étapes qui lisent `kept()` ; (s) aux lectures (contre-lecture, m-14)."""
    pb = {g: [] for g in cb.GARDES_MACHINE}
    b0 = ctx.lire("b0")
    d = cb.garde_d(b0["essais"])
    pb["d"] = [p for p in d if "essai-transport-llama-miniature" not in p] + cb.garde_d({"fumee": {"code": ctx.lire("fumee")["code"]}})
    pb["f"] = [p for p in d if "essai-transport-llama-miniature" in p]
    pb["identite"] = [p for x in b0["lentilles_np"].values() for p in x["e"]]
    pb["i"] = ctx.lire("corpus-activations")["garde_i"]
    return pb


def entrees(ctx: Contexte):
    from controle_ia.neuron_lens import verdicts_b_beta_v4 as vb
    r, s = ctx.lire("ajustement-R"), ctx.lire("ajustement-S")
    reads = json.loads((ctx.racine / ctx.lire("reads")["sortie"]).read_text(encoding="utf-8"))
    read_s, silent = cb.reads_depuis_sortie(reads)
    accord = {int(k): v for k, v in ctx.lire("lens-compare")["accord"].items()}
    return vb.Entrees(score=_table_score(ctx, TAG, SPECS), n=ctx.lire("grandeurs")["n"], repere_npR=_serie_repere(ctx),
                      stabilite={("R", "out"): r["diffs"]["out"], ("R", "mid"): r["diffs"]["mid"],
                                 ("S", "mid"): s["diffs"]["mid"], ("S", "out"): s["diffs"]["out"]},
                      accord=accord, read_S=read_s, silent=silent, gardes=cb.gardes_booleennes(problemes_gardes(ctx)))


def etape_declencheurs(ctx: Contexte) -> dict:
    from controle_ia.neuron_lens import verdicts_b_beta_v4 as vb
    e = entrees(ctx)
    defauts = vb.defauts_chaine(e)
    if defauts:  # rang 1 : chaîne en défaut (a) à (c), (e), (j) ou constatée ; aucun audit
        raise ChaineEnDefaut({"a-c-e-j-et-machine": defauts})
    return {"declenches": vb.declencheurs(e), "debut_audits": ctx.horloge()}


def _temps_restant(ctx: Contexte) -> float:
    return TEMPS_AUDITS_S - (ctx.horloge() - ctx.lire("declencheurs")["debut_audits"])


def etape_audit_relance(ctx: Contexte) -> dict:
    """A1 et A5 : contrôles (1) et (2) sur la graine 0 ; une seule relance de `measure` et `score` à la graine 1 (lentilles logit, npR,
    notre R ; étiquette `b-beta-graine1`) ; n de la graine 1. Temps réservé épuisé = « non joué »."""
    g0 = ctx.lire("grandeurs")
    reste = _temps_restant(ctx)
    if reste <= 0:
        return {"resultat": "non joué", "motif": "temps réservé épuisé avant la relance"}
    t0 = ctx.horloge()
    m = _measure(ctx, 1, "audit-relance", timeout_s=reste)
    if m.get("code") == 124:
        return {"resultat": "non joué", "motif": "temps réservé épuisé pendant measure"}
    s = _score(ctx, 1, TAG_G1, SPECS_GRAINE1, "audit-relance", timeout_s=max(1.0, reste - (ctx.horloge() - t0)))
    if s.get("code") == 124:
        return {"resultat": "non joué", "motif": "temps réservé épuisé pendant score"}
    g1 = _grandeurs(ctx, 1, TAG_G1, SPECS_GRAINE1, "grandeurs-par-pole-b-beta-graine1-v1.json")
    if _temps_restant(ctx) <= 0:  # la relance n'a pas fini dans l'heure (contre-lecture, M-5)
        return {"resultat": "non joué", "motif": "temps réservé épuisé pendant les grandeurs de la graine 1", "grandeurs": g1}
    # contrôles (1) et (2) sur la graine 0, comme le texte les écrit ; ceux de la graine 1 versés à côté (m-10) ; (2) est lu comme
    # « dose de pilotage strictement positive » pour chaque pôle retenu (déclaré)
    return {"resultat": "joué", "measure": m, "score": s, "grandeurs": g1,
            "temoin_distinct": bool(g0["temoin_distinct"]), "normes_non_nulles": bool(g0["normes_non_nulles"]),
            "graine_1": {"temoin_distinct": g1["temoin_distinct"], "normes_non_nulles": g1["normes_non_nulles"]}}


def etape_audits_controles(ctx: Contexte) -> dict:
    """A2, A3 (moitiés distinctes, documents) et A4 (permutation, fichier de la lentille S) : relus des résultats et des fichiers."""
    req = audits_requis(ctx)
    if _temps_restant(ctx) <= 0:
        return {"audits": {a: "non joué" for a in ("A2", "A3", "A4") if a in req}, "motif": "temps réservé épuisé"}
    out = {}
    r, s = ctx.lire("ajustement-R"), ctx.lire("ajustement-S")
    p1 = ctx.lire("corpus-ajustement")["p1"]
    ecarts = {f"R|{t}": v for t, v in r["ecarts_sommes"].items()} | {f"S|{t}": v for t, v in s["ecarts_sommes"].items()}
    emp_moities = {int(l): tuple(v) for l, v in ctx.lire("export")["matrices_moities"].items()}
    for a in ("A2", "A3"):
        if a in req:
            ok, pb = cb.controles_a2_a3({"R": r["n_docs"], "S": s["n_docs"]}, p1["rows_sha256_moities"], ecarts, emp_moities,
                                        longueurs=r["longueurs"] + s["longueurs"],
                                        full_length=bool(r["meta"].get("full_length") is True and s["meta"].get("full_length") is True),
                                        avec_a3=(a == "A3"))
            out[a] = {"controles_ok": bool(ok), "problemes": pb}
    if "A4" in req:
        pf = cb.points_fixes_permutation()
        lien_s = ctx.voisin / "data" / "fits" / cb.FIT_NOMS_ARCH["S"]
        out["A4"] = cb.controle_a4(pf, sha256(lien_s), s["sha256"]) | {"points_fixes": pf}
    if _temps_restant(ctx) <= 0:
        return {"audits": {a: "non joué" for a in out}, "motif": "temps réservé épuisé pendant les contrôles", "calcules": out}
    return {"audits": out}


def etape_verdicts(ctx: Contexte) -> dict:
    from controle_ia.manifeste import generateur, lire_manifeste
    from controle_ia.neuron_lens import verdicts_b_beta_v4 as vb
    e = entrees(ctx)
    req = ctx.lire("declencheurs")["declenches"]
    audits = {}
    if {"A1", "A5"} & set(req):
        rel = ctx.lire("audit-relance")
        if rel["resultat"] != "joué":
            res = vb.NON_JOUE
        else:
            res = {"temoin_distinct": rel["temoin_distinct"], "normes_non_nulles": rel["normes_non_nulles"],
                   "score": _table_score(ctx, TAG_G1, SPECS_GRAINE1), "n": rel["grandeurs"]["n"]}
        for a in ("A1", "A5"):
            if a in req:
                audits[a] = res
    if {"A2", "A3", "A4"} & set(req):
        ac = ctx.lire("audits-controles")["audits"]
        for a in ("A2", "A3"):
            if a in req:
                audits[a] = vb.NON_JOUE if ac[a] == "non joué" else {"controles_ok": bool(ac[a]["controles_ok"])}
        if "A4" in req:
            audits["A4"] = vb.NON_JOUE if ac["A4"] == "non joué" else {
                "permutation_ok": bool(ac["A4"]["permutation_ok"]), "lentille_S_ok": bool(ac["A4"]["lentille_S_ok"])}
    v = vb.verdict(e, audits)
    contenu = {"verdict": asdict(v), "audits_declenches": req,
               "audits_joues": {a: ("non joué" if audits[a] == vb.NON_JOUE else "joué") for a in audits},
               "intervalles": "fichier à part : intervalles-b-beta-v1.json (rapportés, sans critère)",
               "note": "fichier de verdicts unique (P.3, étape 7) ; lu plus tard par un lecteur neuf (P.7)"}
    chemin = ecrire_verdicts(ctx, contenu)  # le verdict d'abord : une erreur des intervalles ne peut pas l'empêcher (m-13)
    from controle_ia.scellement import sceller
    fi = ctx.diag / "intervalles-b-beta-v1.json"
    try:
        man, _ = lire_manifeste(ctx.manifeste)
        gens = {t: generateur(man["graines"][t]) for t in cb.TACHES_INTERVALLES}
        poles = json.loads((ctx.racine / ctx.lire("grandeurs")["grandeurs"]).read_text(encoding="utf-8"))["poles"]
        iv = cb.intervalles(poles, gens)
    except Exception as ex:  # noqa: BLE001 — consigné dans le fichier des intervalles, sans toucher au verdict
        iv = {"erreur": f"{type(ex).__name__}: {ex}"[:1000]}
    if not fi.exists():
        fi.write_text(json.dumps(iv, ensure_ascii=False, sort_keys=True) + "\n", encoding="utf-8")
    return {"fichier_verdicts": str(chemin.relative_to(ctx.racine)), "intervalles": str(fi.relative_to(ctx.racine)),
            "intervalles_sha256": sceller(fi)}


# ------------------------------------------------------------------------------------------------ v4 : matériel, copies, croquis, inventaire

def _sortie_commande(cmd, timeout=60) -> dict:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        return {"code": r.returncode, "sortie": r.stdout.strip()[:3000]}
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"code": None, "sortie": "", "erreur": f"{type(e).__name__}: {e}"[:300]}


def _premiere_valeur(chemin: str, cle: str) -> str | None:
    try:
        for l in Path(chemin).read_text(encoding="utf-8", errors="replace").splitlines():
            if l.startswith(cle):
                return l.split(":", 1)[1].strip()
    except OSError:
        return None
    return None


CHAMPS_SMI = ("modele_carte", "pilote", "vbios", "memoire", "capacite_calcul", "pci_device_id")


def lire_materiel(commande=_sortie_commande) -> dict:
    """(g) Modèle de carte, version du pilote et versions de la machine (non consignés le 18 ; contrôle K3 du critère v8). Tout ce
    qui ne se lit pas est noté dans `erreurs` ; rien n'est levé."""
    out = {"erreurs": []}
    q = commande(["nvidia-smi", "--query-gpu=" + ",".join(("name", "driver_version", "vbios_version", "memory.total",
                                                           "compute_cap", "pci.device_id")), "--format=csv,noheader"])
    lignes = [l for l in q.get("sortie", "").splitlines() if l.strip()] if q.get("code") == 0 else []
    if lignes:
        out |= dict(zip(CHAMPS_SMI, (c.strip() for c in lignes[0].split(","))))
        out["n_cartes_smi"] = len(lignes)
    else:
        out["erreurs"].append(f"nvidia-smi : requête illisible ({q.get('code')}, {q.get('erreur', '')})")
    m = re.search(r"CUDA Version:\s*([0-9.]+)", commande(["nvidia-smi"]).get("sortie", ""))
    out["cuda_du_pilote"] = m.group(1) if m else None
    try:
        import torch
        t = {"version": torch.__version__, "cuda": torch.version.cuda, "cudnn": torch.backends.cudnn.version(),
             "disponible": bool(torch.cuda.is_available())}
        if t["disponible"]:
            t |= {"carte": torch.cuda.get_device_name(0), "capacite": list(torch.cuda.get_device_capability(0)),
                  "n_cartes": torch.cuda.device_count()}
        out["torch"] = t
    except Exception as e:  # noqa: BLE001 — noté, jamais levé
        out["erreurs"].append(f"torch : {type(e).__name__}: {e}"[:300])
    out["machine"] = {"plateforme": platform.platform(), "noyau": platform.release(), "libc": list(platform.libc_ver()),
                      "processeur": _premiere_valeur("/proc/cpuinfo", "model name"),
                      "memoire": _premiere_valeur("/proc/meminfo", "MemTotal"), "n_coeurs": os.cpu_count(),
                      "python": platform.python_version()}
    out["versions"] = versions()
    out["paquets_nvidia_et_xet"] = sorted(f"{d.metadata['Name']}=={d.version}" for d in importlib.metadata.distributions()
                                          if (d.metadata["Name"] or "").lower().startswith(("nvidia-", "hf-xet", "hf_xet")))
    return out


def etape_materiel(ctx: Contexte, lire=lire_materiel) -> dict:
    """(g) La pièce du matériel, à part, poussée avec les résultats ; le champ `versions` du manifeste n'est pas touché."""
    return {"materiel": lire(), "note": "pièce du matériel (devis v9, § 5, point 5 g ; critère v8, contrôle K3) ; sans vis-à-vis au 18"}


def _fichiers_a_copier(ctx: Contexte, lentille: str) -> list[dict]:
    """(d) Le fichier d'ajustement de la lentille et, pour R, les trois exports : chemins locaux, chemins au dépôt, empreintes que
    portent les résultats de leurs étapes (l'envoi les recalcule et les exige égales)."""
    r = ctx.lire(f"ajustement-{lentille}")
    f = ctx.voisin / "data" / "fits" / cb.FIT_NOMS[lentille]
    liste = [{"local": f, "depot": f"{lentille}/{f.name}", "sha256": r["sha256"], "taille": r["taille"]}]
    if lentille == "R" and ctx.fait("export"):
        ex = ctx.lire("export")["exports"]
        for spec, (nom, _) in EXPORTS.items():
            for rel, h in sorted(ex[spec].items()):
                p = ctx.voisin / "data" / "lenses" / nom / rel
                liste.append({"local": p, "depot": f"R/exports/{nom}/{rel}", "sha256": h,
                              "taille": p.stat().st_size if p.exists() else -1})
    return liste


def _copie(ctx: Contexte, lentille: str) -> dict:
    """(d) Copie vérifiée ; un échec est consigné et n'arrête pas la course (la clôture reprend ce qui reste, dans la limite de
    deux reprises par fichier ; l'inventaire le dit ; la table de destruction de la commande v9 en tire « pas sans la mère »)."""
    fichiers = _fichiers_a_copier(ctx, lentille)
    res = rg.envoyer_verifie(ctx.rangement(), ctx.depot_rangement, fichiers, f"lentille {lentille}, course {ctx.run_id}",
                             attendre=ctx.attendre)  # v5 (C-1)
    return {"lentille": lentille, "copie_faite": bool(res["toutes_faites"]), "copie": json.loads(json.dumps(res, default=str))}


def etape_copie_r(ctx: Contexte) -> dict:
    return _copie(ctx, "R")


def etape_copie_s(ctx: Contexte) -> dict:
    return _copie(ctx, "S")


ENTROPIE_CROQUIS = 20261122  # (m) graine fixée (R9 : `SeedSequence`) ; la même pour tout réajustement futur
K_CROQUIS = 32
LIMITE_CROQUIS_S = 900  # (m) décision 7 : borné à 15 minutes
METHODE_CROQUIS = ("par matrice M (moyenne des sommes d'une cible, entière ou d'une moitié, à une couche ; double précision, sur le "
                   "processeur) : norme de Frobenius et u_i^T M v_i pour i < 32, u_i et v_i gaussiens tirés de "
                   "SeedSequence(20261122, spawn_key=(lignes, colonnes)) par numpy.random.default_rng, U puis V")


def vecteurs_croquis(lignes: int, colonnes: int, k: int = K_CROQUIS):
    import numpy as np
    rng = np.random.default_rng(np.random.SeedSequence(ENTROPIE_CROQUIS, spawn_key=(int(lignes), int(colonnes))))
    return rng.standard_normal((k, lignes)), rng.standard_normal((k, colonnes))


def croquis_fit(saved: dict, sortie: dict, vecteurs: dict, au_dela) -> None:
    """(m) Remplit `sortie` (« cible|entiere|paire|impaire » → couche → norme et projections) ; `au_dela()` vrai arrête (TimeoutError)
    en gardant ce qui est fait. La moitié paire est la moitié 0 (export `--half 0`), comme `EXPORTS`."""
    import hashlib as hl

    import torch
    st = saved["state"]
    for t in sorted({t for t, _ in st["sums"]}):
        for nom, moities in (("entiere", (0, 1)), ("paire", (0,)), ("impaire", (1,))):
            n = sum(st["n_docs"][h] for h in moities)
            couches = sortie.setdefault(f"{t}|{nom}", {})
            for l in range(st["sums"][(t, 0)].shape[0]):
                if au_dela():
                    raise TimeoutError("croquis : borne de temps atteinte")
                m = sum(st["sums"][(t, h)][l].double() for h in moities) / n
                m2 = m.reshape(-1, m.shape[-1]) if m.dim() >= 2 else m.reshape(1, -1)
                forme = tuple(m2.shape)
                if forme not in vecteurs:
                    u, v = vecteurs_croquis(*forme)
                    vecteurs[forme] = (torch.from_numpy(u), torch.from_numpy(v),
                                       hl.sha256(u.tobytes()).hexdigest(), hl.sha256(v.tobytes()).hexdigest())
                u, v = vecteurs[forme][:2]
                couches[str(l)] = {"norme": float(torch.linalg.norm(m2)), "projections": [float(x) for x in ((u @ m2) * v).sum(1)]}


def etape_croquis(ctx: Contexte, limite_s: float = LIMITE_CROQUIS_S) -> dict:
    """(m) Croquis numérique de chaque matrice de chaque lentille, après les copies ; un échec ou un dépassement est noté dans le
    résultat et n'arrête rien. Le fichier est d'abord vérifié par son empreinte (celle du résultat de son ajustement)."""
    debut = ctx.horloge()
    res = {"methode": METHODE_CROQUIS, "entropie": ENTROPIE_CROQUIS, "k": K_CROQUIS, "limite_s": limite_s, "lentilles": {},
           "erreurs": [], "depassement": False}
    vecteurs = {}
    for le in ("R", "S"):
        part = res["lentilles"].setdefault(le, {})
        try:
            f = ctx.voisin / "data" / "fits" / cb.FIT_NOMS[le]
            if sha256(f) != ctx.lire(f"ajustement-{le}")["sha256"]:
                raise ValueError("fichier d'ajustement changé depuis son résultat")
            croquis_fit(charger_fit(f), part, vecteurs, lambda: ctx.horloge() - debut > limite_s)
        except TimeoutError:
            res["depassement"] = True
            break
        except Exception as e:  # noqa: BLE001 — (m) noté, n'arrête rien
            res["erreurs"].append(f"{le} : {type(e).__name__}: {e}"[:500])
    res["vecteurs_sha256"] = {f"{a}x{b}": {"u": x[2], "v": x[3]} for (a, b), x in vecteurs.items()}
    res["duree_s"] = round(ctx.horloge() - debut, 1)
    res["croquis_fait"] = not res["erreurs"] and not res["depassement"]
    return res


LIMITE_POUSSEE = 95 * 1024 * 1024  # même borne que l'amorce : au-delà, le fichier reste sur la machine


def etat_copies(ctx: Contexte) -> dict:
    """(l) Par lentille : l'état de chaque fichier copié (étape de copie, puis clôtures successives, la dernière l'emportant)."""
    from controle_ia.manifeste import verifier_resultat
    out = {}
    for etape, le in COPIES.items():
        if ctx.resultat(etape).exists():
            c = ctx.lire(etape)["copie"]
            out[le] = {"depot": c["depot"], "fichiers": dict(c["fichiers"]), "origine": [etape]}
    for p in sorted(ctx.diag.glob("cloture-*.json"), key=lambda x: int(x.stem.split("-")[1])):
        for le, c in verifier_resultat(ctx.racine, p)["resultat"]["copies"].items():
            o = out.setdefault(le, {"depot": c["depot"], "fichiers": {}, "origine": []})
            o["fichiers"].update(c["fichiers"])
            o["origine"].append(p.stem)
    return out


def _prevus(ctx: Contexte) -> dict:
    """(l) Les gros fichiers à ranger qui existent pour de bon : ceux des étapes faites (ajustement, et pour R l'export)."""
    out = {}
    for le in ("R", "S"):
        if ctx.resultat(f"ajustement-{le}").exists():
            out[le] = [f["depot"] for f in _fichiers_a_copier(ctx, le)]
    return out


def inventaire(ctx: Contexte, clos: bool = False, note: str = "") -> Path:
    """(l) Inventaire des sorties (devis v9, § 5, point 3 ; règle « récupérer ce qui est récupérable », R-3661) : noms, tailles,
    empreintes de `voisin/data` et du dossier de résultats ; pour chaque gros fichier à ranger, copié ou non et révision du dépôt.
    Écrit **à neuf** à chaque appel (`inventaire/inventaire-NNN.json`, scellé ; R12 : jamais écrasé) ; empreintes reprises de
    l'inventaire précédent quand taille et date de modification sont inchangées. Sans manifeste (préparation non faite), rien n'est
    écrit et `None` est rendu : un dossier de résultats né avant le manifeste salirait l'arbre d'une relance de la préparation."""
    from controle_ia.scellement import sceller
    if not ctx.manifeste.exists():
        return None
    d = ctx.diag / "inventaire"
    d.mkdir(parents=True, exist_ok=True)
    precedents = sorted(d.glob("inventaire-*.json"))
    cache = {}
    if precedents:
        try:
            cache = {f["chemin"]: f for f in json.loads(precedents[-1].read_text(encoding="utf-8"))["fichiers"]}
        except (OSError, ValueError, KeyError, TypeError):
            cache = {}
    fichiers = []
    for base in (ctx.voisin / "data", ctx.diag):
        if not base.exists():
            continue
        for p in sorted(base.rglob("*")):
            if not p.is_file() or d in p.parents:
                continue
            s = p.stat()
            rel = str(p.relative_to(ctx.racine))
            c = cache.get(rel)
            h = c["sha256"] if c and c.get("taille") == s.st_size and c.get("mtime_ns") == s.st_mtime_ns else sha256(p)
            fichiers.append({"chemin": rel, "taille": s.st_size, "mtime_ns": s.st_mtime_ns, "sha256": h,
                             "gros": s.st_size > LIMITE_POUSSEE})
    erreurs = []
    try:
        copies, prevus = etat_copies(ctx), _prevus(ctx)
    except Exception as e:  # noqa: BLE001 — l'inventaire s'écrit quand même ; l'erreur y est
        copies, prevus = {}, {}
        erreurs.append(f"{type(e).__name__}: {e}"[:500])
    non_copies = sorted(f for le, liste in prevus.items() for f in liste
                        if not copies.get(le, {}).get("fichiers", {}).get(f, {}).get("copie_faite"))
    lentilles = {le: ("non réajustée" if le not in prevus else
                      "copiée" if not [f for f in non_copies if f.startswith(f"{le}/")] else "non copiée")
                 for le in ("R", "S")}
    n = len(precedents) + 1
    contenu = {"run_id": ctx.run_id, "numero": n, "heure_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "clos": clos,
               "note": note, "variante": ctx.variante, "fichiers": fichiers, "copies": copies, "prevus": prevus,
               "non_copies": non_copies, "lentilles": lentilles, "erreurs": erreurs,
               "etapes_faites": [e for e in ETAPES if ctx.resultat(e).exists()]}
    chemin = d / f"inventaire-{n:03d}.json"
    with open(chemin, "x", encoding="utf-8") as fh:
        fh.write(json.dumps(contenu, ensure_ascii=False, sort_keys=True, indent=1) + "\n")
    sceller(chemin)
    return chemin


def cloture(ctx: Contexte) -> int:
    """(l) Fin de course, sur la machine (devis v9, § 5, point 3, temps (1) puis (0)) : copie de ce qui ne l'est pas encore (fichiers
    des étapes faites seulement, empreinte égale à leur résultat, deux reprises au plus par fichier sur toute la course), puis
    inventaire **clos**. Rend 0 si rien ne reste à copier, 3 sinon (l'amorce écrit alors « COPIE EN ECHEC »)."""
    from controle_ia.manifeste import ecrire_resultat
    if ctx.manifeste.exists():
        etat = etat_copies(ctx)
        copies = {}
        for le in ("R", "S"):
            if not ctx.resultat(f"ajustement-{le}").exists():
                continue
            faits = etat.get(le, {}).get("fichiers", {})
            reste = [f for f in _fichiers_a_copier(ctx, le) if not faits.get(f["depot"], {}).get("copie_faite")]
            if reste:
                deja = {c: int(x.get("essais", 0)) for c, x in faits.items()}
                copies[le] = rg.envoyer_verifie(ctx.rangement(), ctx.depot_rangement, reste,
                                                f"lentille {le}, course {ctx.run_id} (clôture)", deja=deja,
                                                attendre=ctx.attendre)  # v5 (C-1)
        if copies:
            n = 1
            while (ctx.diag / f"cloture-{n}.json").exists():
                n += 1
            ecrire_resultat(ctx.racine, ctx.manifeste, f"cloture-{n}", {"copies": json.loads(json.dumps(copies, default=str))})
    chemin = inventaire(ctx, clos=True, note="clôture")
    if chemin is None:  # course non lancée : rien à ranger
        return 0
    return 3 if json.loads(chemin.read_text(encoding="utf-8"))["non_copies"] else 0


ETAPE_FONCTIONS = {e: globals()["etape_" + e.replace("-", "_").lower()] for e in ETAPES}
assert tuple(ETAPE_FONCTIONS) == ETAPES


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("commande", choices=("suite", "jouer") + tuple(sorted(COMMANDES_HORS_ETAPES)))
    p.add_argument("--etape", choices=ETAPES)
    p.add_argument("--racine", type=Path, default=Path.cwd())
    p.add_argument("--run-id", required=True)
    a = p.parse_args(argv)
    ctx = Contexte(a.racine.resolve(), a.run_id, Path(os.environ.get("HF_HOME", "/workspace/hf")),
                   depot_rangement=os.environ.get(rg.VARIABLE_DEPOT, ""), go_id=os.environ.get("GO_ID", ""),
                   variante=os.environ.get("VARIANTE", ""))
    if a.commande in COMMANDES_HORS_ETAPES:  # (l) v4 : inventaire au fil de l'eau ; clôture (copies restantes, inventaire clos)
        pb = verifier_environnement(a.commande, os.environ)
        if pb:
            raise SystemExit("environnement non conforme : " + " ; ".join(pb))
        if a.commande == "inventaire":
            i = inventaire(ctx)
            print(json.dumps({"inventaire": None if i is None else str(i)}, ensure_ascii=False))
            return
        code = cloture(ctx)
        print(json.dumps({"cloture": code}, ensure_ascii=False))
        sys.exit(code)
    if a.commande == "suite":
        e = suite(ctx) if ctx.manifeste.exists() else "preparer"
        print("fin" if e is None else f"{e} {'jeton' if e in JETON else 'sans-jeton'} {'en-ligne' if e in EN_LIGNE else 'hors-ligne'}")
        return
    if not a.etape:
        p.error("--etape exigé avec jouer")
    print(json.dumps({"etape": a.etape, "resultat": str(jouer(ctx, a.etape))}, ensure_ascii=False))


if __name__ == "__main__":
    main()
