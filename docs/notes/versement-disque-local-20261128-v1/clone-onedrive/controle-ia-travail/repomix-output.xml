            print("aucune offre conforme", file=sys.stderr)
            return 2
        print(min(conformes, key=lambda x: (x["dph_total"], x["id"]))["id"])
        return 0
    if args.mode == "inventaire":  # champs filtrés : jamais l'environnement des machines
        try:
            print(json.dumps([h.champs_filtres(i) for i in ClientPiloteV2(dict(os.environ)).instances()],
                             ensure_ascii=False, indent=1))
            return 0
        except h.Refus as e:
            print(f"REFUS : {e}", file=sys.stderr)
            return 2
    return MachineV2(reglages(), dict(os.environ)).principal()


if __name__ == "__main__":
    sys.exit(principal())
