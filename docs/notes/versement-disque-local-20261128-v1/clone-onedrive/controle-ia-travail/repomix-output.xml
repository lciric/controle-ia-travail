            "cache_d_octets": {"prefixe": str(prefixe_pycache), "option": f"-X pycache_prefix={prefixe_pycache}"}})
        h_pre = ecrire_scelle(dossier_run / "manifeste-lanceur-pre-depart.json", pre)
