VERSION = "sonde-hote-durable-a1-v3-v1"
GO_SONDE = "GO-2026-11-04-09"      # GO de la machine (mot de Lazar, 4 novembre 08:41 UTC) ; GO-2026-11-04-06 : Argon seul
MONTANT_GO_SONDE_USD = 35.0
