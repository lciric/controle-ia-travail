from controle_ia.t07 import code_t07_v1 as ct
from controle_ia.t07 import registre_v1 as rg

CLE = rg.CODE_T07
CHEMIN_RECOPIABLE = re.compile(r"[A-Za-z0-9._/-]+")        # motif de l'awk du script de l'instance (v4, l. 182) : sinon non recopié
