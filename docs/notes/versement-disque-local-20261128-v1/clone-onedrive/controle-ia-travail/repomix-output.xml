def _git(*args: str, cwd: Path | None = None, env: dict | None = None, entree: bytes | None = None) -> bytes:
    return subprocess.run(["git", *args], cwd=cwd or RACINE, env=env, input=entree, capture_output=True,
                          check=True).stdout


