    print(json.dumps({"generation": g, "temps": "bras", "numero": k, "etat": "lancé, détaché", "pid_superviseur": sup["pid"],
                      "arret": sup["arret"], "manifeste_depart_sha256": h}, ensure_ascii=False), flush=True)
