EXPORTS = {NOTRE_R: ("dclm-llama", None), MOITIES_R[0]: ("dclm-llama-even", 0), MOITIES_R[1]: ("dclm-llama-odd", 1)}


def _empreintes_home(home: Path) -> dict:
