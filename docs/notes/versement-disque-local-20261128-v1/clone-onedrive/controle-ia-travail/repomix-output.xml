    def client_vast(self):
        return h.ClientVastJouet(self.r.vast_jouet) if self.r.jouet else h.ClientVast(self.secrets["CONTAINER_API_KEY"])

    def _ecrire_sans_echec(self, m: str) -> None:
        try:
