    morceaux = l7.ecrire_morceaux(tableaux, ctx.sortie / "donnees" / ctx.run / PREFIXE_LECTURES)
    tables = {
        "run": ctx.run, "texte": dict(TEXTE), "addendum": dict(ADDENDUM), "passe": "seconde", "tete": tete,
