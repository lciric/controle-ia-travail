MOTIF_SESSION = re.compile(r"session[_\-][0-9A-Za-z]{20,}", re.IGNORECASE)
MOTIF_UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)
