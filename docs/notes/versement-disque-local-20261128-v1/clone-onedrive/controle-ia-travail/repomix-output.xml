from controle_ia.organisme_idees_juge import execution_idee_1_1_v1 as X  # noqa: E402

SORTIE_DEFAUT = "docs/notes/organisme-idees-juge-v1/code-idee-1-1-v1/etape0-v1/etape0-idee-1-1-v1.json"


def main(argv=None) -> int:
    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    a.add_argument("--travail")
