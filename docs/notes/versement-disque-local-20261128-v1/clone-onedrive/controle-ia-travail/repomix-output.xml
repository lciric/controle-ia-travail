            except h.Refus:
                continue
        if not conformes:
            print("aucune offre conforme", file=sys.stderr)
            return 2
        print(min(conformes, key=lambda x: (x["dph_total"], x["id"]))["id"])
        return 0
    env = dict(os.environ)
    return MachineSondeV3(reglages(env), env).principal()


if __name__ == "__main__":
    sys.exit(principal())
