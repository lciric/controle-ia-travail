    else:
        print(f"REMPLACÉE : ligne n° {rap['ligne_numero']} ; registre {rap['sha256_avant']} → {rap['sha256_apres']} ; "
              f"heure {rap['heure']} ; trace {rap['trace']} ({rap['trace_sha256']})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
