        print(f"ARRÊT : {X.consigner_arret(dossier, e, run_id, sha_m, journal)}", file=sys.stderr)
        raise
    print(json.dumps({"manifeste": str(chemin_m.relative_to(RACINE_DEPOT)), **res}, ensure_ascii=False, indent=1))
