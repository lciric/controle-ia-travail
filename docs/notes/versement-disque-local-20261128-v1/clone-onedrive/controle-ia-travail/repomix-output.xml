        raise GardeArret("deux processus au plus")
    if args.miniature:
        if not args.sortie:
            raise GardeArret("--sortie exigée pour la répétition miniature")
        return repetition_miniature(args)
    return jeu_decisif(args)


if __name__ == "__main__":
