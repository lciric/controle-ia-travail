def _exiger(d, chemin: tuple, contexte: str):
    x = d
    vus = []
    for k in chemin:
        vus.append(str(k))
        if not isinstance(x, dict) or k not in x:
            raise CleAbsente(f"clé absente : {contexte} → {'.'.join(vus)} (jamais lue comme zéro)")
        x = x[k]
    return x


