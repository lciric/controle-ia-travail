ETIQUETTES_F = {"F1": "non qualifiée", "F1b": "non qualifiée", "F2": "non qualifiée", "F3": "sans effet établi",
                "F4": "flagrante", "F5": "non tranchée", "F6": "non tranchée", "F7": "diffuse réalisée",
                "F8": "intermédiaire"}
RESERVES = {
