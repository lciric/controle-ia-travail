           "DUREE_MAX_S": str(duree_s), "DEPOT_URL": h.DEPOT_PRIVE, "GH_TOKEN": gh_token,
           "ECHEANCE_UTC_S": str(echeance_utc_s), "TIR_MINUTERIE": "1" if tir else "0"}
