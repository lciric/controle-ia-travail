def corps(commit_prive: str, offre: dict, duree_s: int, gh_token: str, echeance_utc_s: int, tir: bool = False) -> dict:
    if not gh_token:
        raise h.Refus("GH_TOKEN absent : la sonde ne pourrait pas verser")
