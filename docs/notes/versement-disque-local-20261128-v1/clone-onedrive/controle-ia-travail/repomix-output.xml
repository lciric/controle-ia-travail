                     ctx.journal("corpus-activations"), 2 * 3600)
    if s["code"] != 0:
        raise Arret(f"05_act_corpus.py en échec (code {s['code']})")
    d = ctx.voisin / "data" / "corpus"
    corpus = {f: sha256(d / f) for f in cb.CORPUS_ACT_SHA256}
