# Champs exigés de chaque enregistrement (écrits par `banc_idee_1_1_v2.Repetition.evaluer`) ; les groupes que la règle de
# réduction peut retirer ne sont exigés que sur un préfixe des répétitions (une fois absents, absents jusqu'au bout).
CHAMPS_SANS_MEMOIRE = {"J8": ("promue", "max"), "J9": ("promue", "max"), "J9+": ("promue", "max"), "La": ("promue", "max"),
                       "Ld": ("promue", "max"), "A1": ("promue", "max"), "A2": ("promue", "log_w_200"),
                       "ecart_residuel_J9": None, "ecart_residuel_La": None, "ecart_residuel_Ld": None}
CHAMPS_REDUCTIBLES = {"J9-D40": ("promue", "max_40"), "J9-D": ("promue",), "J9-P": ("promue", "max"),
                      "La-P": ("promue", "max"), "journal_J9-P": ("c_moins_1_max",)}
CHAMPS_H = {"J9-P-refus": ("refusee", "promue"), "J9-P-nu": ("terme_projete", "complet", "lineaire_seul"),
            "J9-P-gel": ("terme_projete", "complet")}
CHAMPS_H_JUGE = {"J9": ("promue", "max"), "J9-D40": ("promue", "max_40"), "J9-D": ("promue",)}


BORNES_REDUCTION = {
    # première répétition où un groupe réductible peut manquer, d'après la règle écrite (« Coût et durée ») : jumeau des
    # lignes V à 250 (cran 3) ou 500 (cran 2) ; La-P des lignes V à 500 (cran 5) ; bras à projection de Q9a, Q9b à 500 (cran 4)
    "V": {"J9-D40": (250, 500), "J9-D": (250, 500), "J9-Dc": (250, 500), "La-P": (500,), "journal_La-P": (500,)},
    "Q9": {"J9-P": (500,), "La-P": (500,), "journal_J9-P": (500,), "journal_La-P": (500,)},
}
GROUPES_REDUCTIBLES = {"jumeau": ("J9-D40", "J9-D", "J9-Dc"), "La-P": ("La-P", "journal_La-P"),
                       "J9-P": ("J9-P", "journal_J9-P")}
CHAMPS_TOUJOURS_SANS_MEMOIRE = {"J9-D40": ("promue", "max_40"), "J9-D": ("promue",), "J9-Dc": ("promue",),
                                "J9-P": ("promue", "max"), "La-P": ("promue", "max"), "journal_J9-P": ("c_moins_1_max",),
                                "journal_La-P": ("c_moins_1_max",)}
NUMERIQUES = ("max", "max_40", "log_w_200", "quantite_fatale", "c_moins_1_max")
BOOLEENS = ("promue", "refusee")


def _arret(l, k, quoi):
    raise GardeArret(f"format : ligne {l}, répétition {k} : {quoi} : lecture refusée")


def _types(l, k, cle, d) -> None:
    """n7 : `promue` et `refusee` booléens stricts ; valeurs lues numériques (ni booléen, ni NaN)."""
    if not isinstance(d, dict):
        _arret(l, k, f"« {cle} » n'est pas un dictionnaire")
    for s, v in d.items():
        if s in BOOLEENS and not (v is True or v is False):
            _arret(l, k, f"« {cle}.{s} » n'est pas un booléen ({v!r})")
        if s in NUMERIQUES and (isinstance(v, bool) or not isinstance(v, (int, float)) or v != v):
            _arret(l, k, f"« {cle}.{s} » n'est pas un nombre ({v!r})")
        if s in ("terme_projete", "complet", "lineaire_seul"):
            if not isinstance(v, dict) or not {"promue", "max"} <= set(v):
                _arret(l, k, f"« {cle}.{s} » incomplet")
            _types(l, k, f"{cle}.{s}", v)


def verifier_format(donnees: dict) -> None:
    """Toute différence de format entre le banc et la lecture arrête avec un message (jamais une trace) : lignes, ordre
    des répétitions, champs et sous-champs lus, types (n7), et absences de groupes réductibles conformes à la règle de
    réduction (première absence à une borne de la règle, groupes absents ensemble, jamais de réapparition : C1, n6)."""
    if not isinstance(donnees, dict) or set(donnees) != set(B.NOMS):
        raise GardeArret("format : lignes absentes ou en trop : lecture refusée")
    for l, recs in donnees.items():
        if not isinstance(recs, list) or not recs:
            raise GardeArret(f"format : ligne {l} sans répétition : lecture refusée")
        sorte = "V" if l in V else ("Q9" if l in ("Q9a", "Q9b") else None)
        bornes = BORNES_REDUCTION.get(sorte, {})
        if l in B.LIGNES_H:
            exiges = dict(CHAMPS_H, **({} if l == "H7" else CHAMPS_H_JUGE))
            exiges["temoin_lambda"] = ("promue", "max")
            possibles = {}
        else:
            exiges = dict(CHAMPS_SANS_MEMOIRE)
            possibles = dict(CHAMPS_TOUJOURS_SANS_MEMOIRE)
            if l in FATALES_HOLM or l in FATALES_HORS_HOLM:
                possibles["J9-D"] = ("promue", "quantite_fatale")
            for cle in list(possibles):
                if cle not in bornes:
                    exiges[cle] = possibles.pop(cle)
        absents_depuis = {}
        for k, r in enumerate(recs):
            if not isinstance(r, dict) or "r" not in r or r["r"] != k:
                _arret(l, k, "enregistrement illisible, sans « r » ou hors d'ordre")
            for cle, sous in exiges.items():
                if cle not in r:
                    _arret(l, k, f"champ « {cle} » absent")
                for s in (sous or ()):
                    if s not in r[cle]:
                        _arret(l, k, f"champ « {cle}.{s} » absent")
                if sous is None:
                    if not isinstance(r[cle], list) or not all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in r[cle]):
                        _arret(l, k, f"« {cle} » n'est pas une liste de nombres")
                else:
                    _types(l, k, cle, r[cle])
            for cle, sous in possibles.items():
                if cle in r:
                    if cle in absents_depuis:
                        raise GardeArret(f"format : ligne {l} : « {cle} » réapparaît après une réduction : lecture refusée")
                    for s in sous:
                        if s not in r[cle]:
                            _arret(l, k, f"champ « {cle}.{s} » absent")
                    _types(l, k, cle, r[cle])
                else:
                    absents_depuis.setdefault(cle, k)
            if "strate_sans_log" in r:
                for b, d in r["strate_sans_log"].items():
                    _types(l, k, f"strate_sans_log.{b}", d)
                    if "promue" not in d:
                        _arret(l, k, f"« strate_sans_log.{b}.promue » absent")
        for cle, k in absents_depuis.items():
            if k not in bornes.get(cle, ()):
                raise GardeArret(f"format : ligne {l} : « {cle} » absent dès la répétition {k}, hors des bornes de la règle "
                                 f"de réduction {bornes.get(cle, ())} : lecture refusée")
        for nom, membres in GROUPES_REDUCTIBLES.items():
            debuts = {absents_depuis.get(c) for c in membres if c in possibles}
            if len(debuts) > 1:
                raise GardeArret(f"format : ligne {l} : groupe « {nom} » retiré en partie seulement : lecture refusée")
        # C1 : une ligne V porte toujours le jumeau et La-P à sa première répétition (la règle en garde au moins 250 et 500)
        if l in V and ({"J9-D40", "J9-D", "La-P"} - set(recs[0])):
            raise GardeArret(f"format : ligne {l} sans engagement jumeau ou sans La-P : lecture refusée")


def lire_v3(donnees: dict, racine: int, *, B_: int = REECHANTILLONS) -> dict:
    """Lecture gelée v3 : format vérifié d'abord ; puis `lire_v2` (verdicts inchangés) ; ρ⁺ des trois primaires rapporté
    (n5) ; lectures déclarées jointes. Une erreur de format qui échapperait à `verifier_format` est rendue en `GardeArret`
    avec son message, jamais en trace."""
    verifier_format(donnees)
    try:
        res = lire_v2(donnees, racine, B_=B_)
        if res.get("etage_1") == "franchi" and res.get("etage_2") == "franchi" and not res["rho"].get("sans_objet"):
            res["rho_plus_primaires"] = lire_rho(racine, donnees, ["J9-P", "La", "Ld"], plus=True, B_=B_)
    except GardeArret:
        raise
    except (KeyError, TypeError, IndexError, ValueError, AttributeError) as e:
        raise GardeArret(f"lecture : format ou valeur inattendus ({type(e).__name__} : {e}) : lecture refusée") from e
    res["lectures_declarees"] = dict(LECTURES_DECLAREES)
    res["version_lecture"] = 4
    return res
