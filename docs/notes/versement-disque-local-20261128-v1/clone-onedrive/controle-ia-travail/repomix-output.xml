SCELLEMENT_CONCEPTS_T07 = "SCELLEMENT-CONCEPTS-T07"
GO_ETAPE_A_T07, GO_LECTURE_T07 = "GO-ETAPE-A-T07", "GO-LECTURE-T07"
SCORES_T07, SONDES_T07 = "SCORES-T07", "SONDES-T07"
