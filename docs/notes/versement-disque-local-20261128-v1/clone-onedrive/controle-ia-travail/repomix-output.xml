        vide, ou aucune offre conforme : code 1 et le motif de chaque refus (les trois premiers).
    autres sous-commandes : celles de `session_v3`.
Code 0 ; 1 avec un motif ; 2 sur un usage faux.
"""
from __future__ import annotations

import json
import sys

from . import session_v2 as s2
from . import session_v3 as s3
from .session import GardeSession

CUDA_MAX_GOOD_MIN = 13.0  # R-1686 : le pilote de l'offre doit porter CUDA 13,0 au moins (torch 2.14.1+cu130) ; E2 : offre à 12,2 → « driver too old (12020) », carte invisible
INET_DOWN_MIN_MBPS = 500  # R-1677 : garde bon marché contre une machine qui annonce un débit qu'elle n'a pas (E2 : 861 Mb/s annoncés, ≈ 10 reçus)
FIABILITE_MIN_OFFRE = 0.98  # R-1660 : la création filtre comme la lecture (E2-1) ; une seule source, lue par le générateur des ordres


def filtre_recherche(config: dict, carte: str) -> str:
    if carte not in ("course", "relance"):
        raise GardeSession("carte : « course » ou « relance »")
    c, b = config["carte"][carte], config["offre"]
    nom = str(c["nom_offre"]).replace(" ", "_")
    ram_go = int(-(-b["memoire_vive_min_mo"] // 1000))
    return (f"num_gpus=1 rentable=true gpu_name={nom} reliability>={FIABILITE_MIN_OFFRE} inet_down>={INET_DOWN_MIN_MBPS} cuda_max_good>={CUDA_MAX_GOOD_MIN} cpu_ram>={ram_go} cpu_cores_effective>={b['coeurs_effectifs_min']} "
            f"disk_space>={b['disque_min_go']} dph_total<={c['prix_max_usd_h']}")


def instance_presente(inventaire, ident: str):
    """Vrai si l'instance `ident` figure dans l'inventaire ; Faux si l'inventaire est NON vide et ne la contient pas ; None si l'inventaire est vide ou
    `null` (R-1683 : une liste vide n'est pas une absence, la présence n'est pas établie). Inventaire illisible : GardeSession."""
    if isinstance(inventaire, dict) and "instances" in inventaire:
        inventaire = inventaire["instances"]
    if inventaire is None or inventaire == []:
        return None
    if not isinstance(inventaire, list):
        raise GardeSession("inventaire des instances illisible")
    for i in inventaire:
        if not isinstance(i, dict):
            raise GardeSession("inventaire : entrée illisible")
    return any(str(i.get("id")) == str(ident) for i in inventaire)


MOTIFS_INTROUVABLE = ("not found", "no such", "does not exist", "introuvable", "404")


def instance_seule(texte: str, ident: str) -> bool:
    """Réponse de `vastai show instance <ID> --raw` : Vrai si l'instance répond, Faux si elle est introuvable (objet ou liste sans cet identifiant, objet vide,
    `null`, ou texte d'introuvable) ; GardeSession si la réponse est illisible (ni JSON, ni texte d'introuvable)."""
    brut = texte.strip()
    try:
        v = json.loads(brut)
    except ValueError:
        if any(m in brut.lower() for m in MOTIFS_INTROUVABLE):
            return False
        raise GardeSession("réponse de show instance illisible")
    if isinstance(v, dict) and "instances" in v:
        v = v["instances"]
    if v is None or v == {} or v == []:
        return False
    if isinstance(v, dict):
        v = [v]
    if not isinstance(v, list) or not all(isinstance(i, dict) for i in v):
        raise GardeSession("réponse de show instance illisible")
    return any(str(i.get("id")) == str(ident) for i in v)


def choisir_offre(offres, config: dict, carte: str, machines_exclues=()) -> dict:
    if isinstance(offres, dict) and "offers" in offres:
        offres = offres["offers"]
    if not isinstance(offres, list):
        raise GardeSession("liste d'offres illisible")
    if not offres:
        raise GardeSession("recherche filtrée : liste VIDE (aucune offre ne respecte le filtre)")
    exclues = {str(m) for m in machines_exclues}

    def cle(o):
        try:
            return (float(o.get("dph_total", 1e9)) + float(o.get("storage_total_cost", 0.0)), int(o.get("id", 0)))
        except (TypeError, ValueError):
            return (1e18, 0)
    refus = []
    for rang, o in enumerate(sorted((o for o in offres if isinstance(o, dict)), key=cle), 1):
        if str(o.get("machine_id")) in exclues:
            refus.append(f"rang {rang} : machine {o.get('machine_id')} déjà refusée")
            continue
        try:                                                       # garde locale (R-1686) : clé `cuda_max_good` lue sur l'offre, jamais devinée
            cuda = float(o["cuda_max_good"])
        except (KeyError, TypeError, ValueError):
            refus.append(f"rang {rang} : cuda_max_good absent ou illisible (garde locale)")
            continue
        if cuda < CUDA_MAX_GOOD_MIN:
            refus.append(f"rang {rang} : cuda_max_good {cuda} < {CUDA_MAX_GOOD_MIN} (pilote trop ancien pour torch cu130)")
            continue
        try:
            r = s2.verifier_offre([o], config, carte)
        except GardeSession as e:
            refus.append(f"rang {rang} : {e}")
            continue
        r["rang"] = rang
        r["cuda_max_good"] = cuda
        return r
    raise GardeSession(f"aucune offre conforme sur {len(offres)} : " + " ; ".join(refus[:3]))


def main(argv: list[str]) -> int:
    try:
        if len(argv) == 3 and argv[0] == "filtre":
            print(filtre_recherche(s2._lire_json(argv[1]), argv[2]))
        elif len(argv) in (4, 5) and argv[0] == "choisir":
            r = choisir_offre(s2._lire_json(argv[1]), s2._lire_json(argv[2]), argv[3], argv[4].split(",") if len(argv) == 5 and argv[4] else ())
            print(f"id={r['id']} rang={r['rang']} machine={r['machine_id']} prix_carte={r['prix_carte']:.4f} prix_stockage={r['prix_stockage']:.4f} "
                  f"telechargement={r['telechargement']:.4f} telechargement_forfait={r['telechargement_forfait_usd']:.4f} cuda_max_good={r['cuda_max_good']} carte={r['carte']}")
        elif len(argv) == 3 and argv[0] == "presente":
            p = instance_presente(s2._lire_json(argv[1]), argv[2])
            if p is None:
                print(f"inventaire VIDE : présence de l'instance {argv[2]} non établie")
                return 3
            if p:
                print(f"instance {argv[2]} présente")
            else:
                print(f"instance {argv[2]} ABSENTE d'un inventaire non vide")
                return 1
        elif len(argv) == 3 and argv[0] == "seule":
            try:
                texte = open(argv[1], encoding="utf-8", errors="replace").read()
            except OSError as e:
                raise GardeSession(f"réponse de show instance illisible ({e.__class__.__name__})")
            if instance_seule(texte, argv[2]):
                print(f"instance {argv[2]} répond")
            else:
                print(f"instance {argv[2]} INTROUVABLE")
                return 4
        else:
            return s3.main(argv)
    except GardeSession as e:
        print(str(e))
        return 2 if (len(argv) == 3 and argv[0] in ("presente", "seule")) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
