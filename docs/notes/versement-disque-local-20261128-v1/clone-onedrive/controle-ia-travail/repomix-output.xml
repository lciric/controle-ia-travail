# de documentation ou de résolveurs publics). Chemins : arrêt sur tout dossier personnel hors des comptes techniques.
COURRIEL = re.compile(rb"[A-Za-z0-9._%+\-]+@[A-Za-z0-9\-]+(?:\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,}")
