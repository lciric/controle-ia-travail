VERSION = "versant_honnete_preparation_v3"
JUGES = (("J8r", "juge_J8_raisonnement"), ("J8p", "juge_J8_une_passe"), ("J3r", "juge_J3_raisonnement"),
         ("J3p", "juge_J3_une_passe"))
JUGE_PRINCIPAL = "J8r"
CONDITION_JUGE_ETALONNAGE = "etalonnage"
