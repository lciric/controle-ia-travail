    return h.hexdigest()


def date_u() -> str:
    """L'équivalent de `"$(date -u)"` de la commande canonique."""
    r = subprocess.run(["date", "-u"], capture_output=True, text=True, timeout=10)
    if r.returncode != 0 or not r.stdout.strip():
