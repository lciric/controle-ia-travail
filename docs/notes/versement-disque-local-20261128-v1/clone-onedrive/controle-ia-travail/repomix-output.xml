    ecrire(f"ESSAI DIFFÉRENTIEL DE FERMETURE : {'CONFORME' if conforme else 'NON CONFORME'}")
    sortie.write_text("\n".join(lignes) + "\n", encoding="utf-8")
    return {"conforme": conforme, "lignes": lignes, "base": base}


