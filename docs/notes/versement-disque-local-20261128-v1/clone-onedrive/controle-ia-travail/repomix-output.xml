def partitions_La(archive: dict) -> list:
    jA, sA, sB = archive["jA"], archive["sA"], archive["sB"]
    return [{"nom": f"seuil_fixe:z{jA}:{sA}", "partition": {"type": "seuil_fixe", "indice": jA, "seuil": sA}},
