def _commande_audit(args, cadre: Cadre) -> int:
    racine = Path(args.racine)
    ouvert = ouvrir_le_code(racine, args.registre, (CLE_CODE_PASSE, CLE_LIVRAISON, CLE_ETATS, CLE_LECTURE), cadre)
