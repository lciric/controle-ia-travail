                        "porte_une_phrase": list(ph.PORTE_UNE_PHRASE), "reste_en_table": list(ph.RESTE_EN_TABLE)}}
    sha_tables = l7._ecrire_ferme(ctx.sortie / "diag" / ctx.run / NOM_TABLES, tables)
    chemins = en.chemins_permis(entrees.course.run)
