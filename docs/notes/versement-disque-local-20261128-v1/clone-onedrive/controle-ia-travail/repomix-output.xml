    return f'''set -u
R="${{RACINE_SONDE:-/root}}"; case "$R" in /*) ;; *) R=/root;; esac
API="${{API_VAST:-{h.API_VAST}}}"; case "$API" in https://*) ;; *) API={h.API_VAST};; esac
