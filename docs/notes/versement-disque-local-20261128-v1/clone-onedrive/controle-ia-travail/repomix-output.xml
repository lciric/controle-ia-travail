# absolus ; code 1 si la répétition n'est pas conforme.
# Usage : repetition_finale_p3_v1.sh RACINE_NEUVE C
set -uo pipefail
[ $# -eq 2 ] || { echo "usage : repetition_finale_p3_v1.sh RACINE_NEUVE C"; exit 2; }
E=$(realpath -m "$1"); C=$2; SOI=$(realpath "$0")
