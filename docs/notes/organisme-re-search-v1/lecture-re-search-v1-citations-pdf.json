 },
 {
  "id": "RS-12",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "with a panel of three LLM judges (Gemma-4-31B, Qwen3.6, and GPT-OSS-120B)"
 },
 {
  "id": "RS-13",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "Each judge sees the research problem p, hidden solution s, and idea card ct , and rates on a 1-10 scale how much of s the card recovers"
 },
 {
  "id": "RS-14",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "their pairwise Spearman correlations range from 0.85 to 0.88"
 },
 {
  "id": "RS-15",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "leaving out the judge from an inquisitor's own model family changes the gain from naming the idea by at most 0.08 points"
 },
 {
  "id": "RS-16",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "by comparing 498 pairs of idea cards; for each pair, they choose the card closer to the hidden solution, or mark a tie. Their labels agree well, with a Fleiss' κ of 0.83. In 91.2% of pairs, the LLM judges agree with the annotator majority on which card is closer, or that the two are tied."
 },
 {
  "id": "RS-17",
  "piece": "Re-Search, arXiv 2611.14487v1",
  "pdf": "docs/sources/pdf/organisme-re-search-v1/arxiv-2611.14487/2611.14487v1.pdf",
  "empreinte": "ae848c68e65c4a779d0df6725e4189ad80c351fe2e9402930be14db2ddfa7ccc",
  "page": 4,
  "citation": "when both sides prefer one card, they choose the same card in 97.8% of pairs"
 },
