+def exiger_principale_sous_addendum(rp: dict, sha_addendum: str, reception: dict | None) -> dict:
+    """K3 (mode décisif) : le résultat de la principale vient du code v8 sous l'addendum unique scellé et a reçu le
+    même rejeu que cette lecture (ce qui exclut la sortie de la course v3 et toute principale sous un autre code ou un
+    autre addendum)."""
+    if rp.get("version") != K8.VERSION:
+        raise GardeArret(f"résultat de la principale : version « {rp.get('version')} » ≠ « {K8.VERSION} » (K3)")
+    lien = rp.get("lien_au_preenregistrement") or {}
+    sha_p = (lien.get("addendum") or {}).get("sha256")
+    if sha_p != sha_addendum:
+        raise GardeArret("résultat de la principale non lié à l'addendum unique scellé (lien_au_preenregistrement."
+                         "addendum.sha256 ≠ empreinte de l'addendum) (K3)")
+    run_p = (rp.get("reception_v4") or {}).get("run_rejeu")
+    run_e = (reception or {}).get("run_rejeu")
+    if run_p != run_e:
+        raise GardeArret(f"rejeu reçu par la principale ({run_p}) ≠ rejeu reçu par cette lecture ({run_e}) (K3)")
+    return {"version": rp["version"], "addendum_sha256": sha_p, "run_rejeu": run_p}
