+masquer() { python3 -c '
+import os, sys
+t = sys.stdin.read()
+for k in ("HF_TOKEN", "CONTROLE_IA_GITHUB_TOKEN", "CONTROLE_IA_GITHUB_TOKEN_2", "GH_TOKEN", "VAST_API_KEY"):
+    v = os.environ.get(k)
