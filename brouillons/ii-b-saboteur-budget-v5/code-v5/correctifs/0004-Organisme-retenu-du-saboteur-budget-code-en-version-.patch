+def test_gardes_d_entree_de_l_epreuve():
+    par = _etal(3)
+    with pytest.raises(GardeArret, match="contexte de l'agent"):
+        ec.epreuve_du_centrage("P", par[("N", "etalonnage-honnete")])
+    with pytest.raises(GardeArret, match="exigées"):
