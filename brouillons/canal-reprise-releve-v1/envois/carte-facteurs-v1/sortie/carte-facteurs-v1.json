 "conventions": {
  "lignes": "numéros 1..n des fichiers au commit 7ea3270, bornes comprises ; fichier relatif à organisme/",
  "fonction": "fonction la plus intérieure qui contient toute la plage (analyse ast, python3 -I) ; « <module> » hors de toute fonction ; « (fichier entier) » pour un fichier entier ; null hors Python",
  "colonnes": "positions de caractères 1..n sur la ligne, bornes comprises ; seulement pour un segment",
  "sha256_segment": "empreinte SHA-256 du texte exact du segment (UTF-8), pour le vérifier sans le recopier ; « texte » n'est donné que pour du code, jamais pour un texte d'appel",
  "appartenance": "une ligne entière appartient à un facteur au plus et jamais à la fois à un facteur et à une zone interdite ; une ligne partagée n'appartient en entier à aucun facteur : chaque segment appartient à son facteur, le reste de la ligne à personne",
  "modification": "un bloc qui modifie une ligne appartient au facteur qui la possède en entier ; sur une ligne partagée, au facteur dont les segments contiennent tous les caractères changés ; il ne touche jamais un segment interdit (zones) ni un point hors boucle",
  "insertion (proposition)": "des lignes insérées entre les lignes n et n+1 appartiennent au facteur X si n et n+1 sont à X en entier, ou si l'une est à X en entier et l'autre libre (ni facteur, ni segment, ni zone) ; en tête ou en fin de fichier, la seule voisine compte ; sinon le bloc est refusé",
  "un facteur à la fois": "un périmètre ne couvre qu'un facteur ; pour F04 un seul élément, pour F07 une seule borne",
  "valeurs": "une valeur numérique ne désigne jamais un facteur : les mêmes valeurs reparaissent ailleurs pour d'autres grandeurs",
  "zones": "voir zones-interdites-v1.json ; une zone l'emporte toujours ; lignes de zone et lignes de facteur sont disjointes, sauf les segments interdits déclarés ici"
 },
