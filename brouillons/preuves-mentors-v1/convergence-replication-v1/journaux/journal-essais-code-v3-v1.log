+++ v3 ('def', 'deriver_racines_regle_D')
@@ -0,0 +1,6 @@
+def deriver_racines_regle_D(empreinte_hex: str) -> tuple[int, int]:
+    """Racines de la réplication (ρ, ρ_t) dérivées de l'empreinte H du texte scellé, gardes de la règle D comprises.
+    N'est appelée en course que par `autoriser_decision_regles`, sur l'empreinte vérifiée du texte scellé."""
+    r, rt = etat_regle_D(empreinte_hex)
+    exiger_racines_regle_D(r, rt)
+    return r, rt

