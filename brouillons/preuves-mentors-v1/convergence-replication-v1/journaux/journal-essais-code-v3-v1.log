===== C4 — ('def', 'etat_regle_D') : 10 lignes changées =====
--- v2 ('def', 'etat_regle_D')
+++ v3 ('def', 'etat_regle_D')
@@ -0,0 +1,10 @@
+def etat_regle_D(empreinte_hex: str) -> tuple[int, int]:
+    """Règle D, calcul seul, sans les gardes : (w₀, w₁) = les deux premiers mots de 64 bits non signés de l'état
+    engendré par `SeedSequence(entropy=int(H, 16))` (aucune clé de descendance). Sert aux vecteurs d'essai ; toute
+    racine de course passe par `deriver_racines_regle_D`. Garde : H en 64 chiffres hexadécimaux minuscules."""
+    h = str(empreinte_hex)
+    if not re.fullmatch(r"[0-9a-f]{64}", h):
+        raise GardeArret(f"règle D : empreinte SHA-256 en 64 chiffres hexadécimaux minuscules exigée (reçu {h!r})")
+    exiger_numpy_minimal()
+    w = np.random.SeedSequence(entropy=int(h, 16)).generate_state(2, dtype=np.uint64)
+    return int(w[0]), int(w[1])

===== C4 — ('def', 'exiger_racines_regle_D') : 13 lignes changées =====
--- v2 ('def', 'exiger_racines_regle_D')
+++ v3 ('def', 'exiger_racines_regle_D')
@@ -0,0 +1,13 @@
+def exiger_racines_regle_D(racine: int, racine_tenue: int) -> None:
+    """Gardes de la règle D (spécification § 4, point 6 ; chacune : arrêt, aucun repli, aucune autre dérivation) :
+    racines distinctes ; aucune dans l'ensemble interdit F (dont les racines de la course originale) ; aucune égale à
+    un des six entiers des vecteurs d'essai."""
+    r, rt = int(racine), int(racine_tenue)
+    if r == rt:
+        raise GardeArret(f"règle D : racine principale égale à la racine des lois tenues ({r}) : arrêt")
+    for x in (r, rt):
+        if x in RACINES_INTERDITES_REGLE_D or PLAGE_INTERDITE_REGLE_D[0] <= x <= PLAGE_INTERDITE_REGLE_D[1]:
+            raise GardeArret(f"règle D : racine {x} dans l'ensemble interdit F (racines et plages déjà nommées par les "
+                             "arènes v1 à v4 et les règles de défense v1 et v2, course originale comprise) : arrêt")
+        if x in _RACINES_VECTEURS_ESSAI:
+            raise GardeArret(f"règle D : racine {x} égale à un vecteur d'essai de la spécification : arrêt")

===== C4 — ('def', 'deriver_racines_regle_D') : 6 lignes changées =====
