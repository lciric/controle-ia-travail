+def serialiser_moniteur(mon, poids) -> dict:
+    """C10 (sortie seulement) : un moniteur de la défense finale — paramètres W et b, seuil t, échelle e — et son
+    poids dans la défense ; lecture seule des attributs, aucun calcul, aucun tirage."""
+    return {"W": [[float(x) for x in ligne] for ligne in np.asarray(mon.W, float)],
+            "b": [float(x) for x in np.asarray(mon.b, float)], "t": float(mon.t), "e": float(mon.e),
+            "poids": float(poids)}

