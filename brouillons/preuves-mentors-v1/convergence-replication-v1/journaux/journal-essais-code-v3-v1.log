+def serialiser_variante(etat: dict, attaques_finales) -> dict:
+    """C10 (sortie seulement) : défense finale d'une variante (ses moniteurs sérialisés, dans l'ordre de la défense,
+    poids nuls compris), attaques passées de sa trajectoire (`etat["attaques"][1:]`, meilleures réponses des tours 1
+    à T, soit l'argument `passes` de `attaquant_independant` du v4 ; la cible, tour 0, est sous `loi_cible` de la tâche)
+    et ses deux attaques finales (standard puis renforcée, rendues par `phase_finale`). Permet d'opposer plus tard un
+    autre attaquant aux défenses finales sans rejouer la course."""
+    a_fin, a_renf = attaques_finales
+    return {"defense_finale": [serialiser_moniteur(m, w) for m, w in etat["defense_finale"]],
+            "attaques_passees": [[float(x) for x in a] for a in etat["attaques"][1:]],
+            "attaques_finales": {"standard": [float(x) for x in a_fin], "renforce": [float(x) for x in a_renf]}}

