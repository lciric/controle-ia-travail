=== 2026-11-18T18:03:06Z /workspace/depot/.venv/bin/python -c 
import json, sys, torch
sys.path.insert(0, sys.argv[2])
from controle_ia.neuron_lens import controles_b_beta_v2 as cb
from neuron_lens.lenses import load_lens
saved = torch.load(sys.argv[1], weights_only=False, map_location="cpu")
st = saved["state"]
moy = (st["sums"][("out", 0)] + st["sums"][("out", 1)]).float() / sum(st["n_docs"])
try:
    J = load_lens("R:banc-aller-retour", saved["meta"]["model"])
    ch = {l: (None if m is None else m.float().numpy()) for l, m in J.items()}
    pb = cb.garde_o(ch, {l: moy[l].numpy() for l in range(moy.shape[0])}, "R:banc-aller-retour")
except Exception as e:
    pb = cb.garde_o(None, {}, "R:banc-aller-retour", erreur=f"{type(e).__name__}: {e}")
print("ALLER-RETOUR " + json.dumps(pb, ensure_ascii=False))
