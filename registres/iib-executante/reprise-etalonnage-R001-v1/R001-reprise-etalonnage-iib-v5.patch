+def test_preparation_de_la_reprise_recupere_les_lots_du_commit_source_et_ecrit_l_ordre(coupe27, tmp_path):
+    """`scripts/preparer_reprise_iib_v5.sh` contre une origine nue locale : une branche d'essai porte l'étalonnage coupé ; le
+    clone de code (sans le run) récupère manifeste, lots et identifiants à l'octet, puis écrit l'ordre ; rien n'est committé ni
+    poussé. Artefacts : commit source qui n'est pas la tête de la branche ; fichier inattendu du run dans le commit source."""
+    import os
+    import subprocess
+
+    def git(rep, *a, ok=True):
+        return subprocess.run(["git", "-C", str(rep), *a], check=ok, capture_output=True, text=True)
+    origine, essai, code = tmp_path / "o.git", tmp_path / "essai", tmp_path / "code"
+    subprocess.run(["git", "init", "-q", "--bare", str(origine)], check=True)
+    shutil.copytree(coupe27["racine"], essai)
+    (essai / "runs" / RUN).mkdir(parents=True)
+    (essai / "runs" / RUN / "manifeste.json").write_text('{"jouet": 1}\n', encoding="utf-8")
+    sceller(essai / "runs" / RUN / "manifeste.json")
+    for a in (("init", "-q", "-b", "essai/iib-explo-v6"), ("config", "user.email", "t@x.invalid"), ("config", "user.name", "t"),
+              ("add", "-A"), ("commit", "-q", "-m", "essai"), ("remote", "add", "origin", str(origine)), ("push", "-q", "origin", "essai/iib-explo-v6")):
+        git(essai, *a)
+    tete = git(essai, "rev-parse", "HEAD").stdout.strip()
+    shutil.copytree(coupe27["racine"], code, ignore=shutil.ignore_patterns("diag", "donnees"))
+    for a in (("init", "-q", "-b", "prep/reprise"), ("config", "user.email", "t@x.invalid"), ("config", "user.name", "t"),
+              ("add", "-A"), ("commit", "-q", "-m", "code"), ("remote", "add", "origin", str(origine))):
+        git(code, *a)
+    import sys
+    env = {**os.environ, "PYTHONPATH": str(DEPOT / "src"), "PYTHON": sys.executable}
+    script = str(DEPOT / "scripts" / "preparer_reprise_iib_v5.sh")
+    faux = subprocess.run(["bash", script, RUN, "essai/iib-explo-v6", "0" * 40, "61875617", "16.0", GO], cwd=code, env=env, capture_output=True, text=True)
+    assert faux.returncode == 2 and "≠ commit nommé" in faux.stderr and not (code / "diag").exists()
+    r = subprocess.run(["bash", script, RUN, "essai/iib-explo-v6", tete, "61875617", "16.0", GO], cwd=code, env=env, capture_output=True, text=True)
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "27 lots" in r.stdout and (code / "diag" / RUN / rr.ORDRE).is_file()
+    ordre, _ = rr.lire_ordre(code, RUN, "jouet")
+    assert ordre["source"] == {"branche": "essai/iib-explo-v6", "commit": tete} and len(ordre["fichiers"]) == 1 + 27 * 2
+    assert git(code, "log", "--oneline").stdout.count("\n") == 1                 # rien n'est committé
+    (essai / "diag" / RUN / "arret.json").write_text("{}", encoding="utf-8")       # fichier inattendu du run dans le commit source
+    git(essai, "add", "-A")
+    git(essai, "commit", "-q", "-m", "arret")
+    git(essai, "push", "-q", "origin", "essai/iib-explo-v6")
+    code2 = tmp_path / "code2"
+    shutil.copytree(coupe27["racine"], code2, ignore=shutil.ignore_patterns("diag", "donnees"))
+    for a in (("init", "-q", "-b", "prep/reprise"), ("config", "user.email", "t@x.invalid"), ("config", "user.name", "t"),
+              ("add", "-A"), ("commit", "-q", "-m", "code"), ("remote", "add", "origin", str(origine))):
+        git(code2, *a)
+    t2 = git(essai, "rev-parse", "HEAD").stdout.strip()
+    r2 = subprocess.run(["bash", script, RUN, "essai/iib-explo-v6", t2, "61875617", "16.0", GO], cwd=code2, env=env, capture_output=True, text=True)
+    assert r2.returncode == 2 and "autres fichiers du run" in r2.stderr
