+"""Reprise de l'étalonnage de l'organisme retenu, v5 (correctif de reprise R001 ; écart au texte scellé, section 15, accepté par
+Lazar : GO-2026-11-22-71). EXPLORATOIRE, NON OPPOSABLE (R-522).
+
+Un étalonnage coupé laisse sur la branche d'essai des lots scellés (`diag/<run>/lots/`, `donnees/<run>/lots/`) et le manifeste
+du run. Ce module lit ces lots **par le code seulement** et vérifie, avant tout calcul :
+
+- l'**ordre de reprise** (`diag/<run>/ordre-reprise-iib-v5.json`, scellé, écrit par la session qui a récupéré les lots de la
+  branche d'essai) : run, branche et commit d'origine, machine des lots versés, dépense antérieure déclarée, ligne de GO de
+  l'écart, et l'empreinte de chaque fichier récupéré ; chaque empreinte est relue sur le disque (R11) ;
+- que les lots présents sont **exactement** un début du plan scellé (`lanceur_v5.lots_prevus` : même ordre des tâches, mêmes
+  phases, même taille de lot, mêmes épisodes et mêmes tâches), sans lot manquant, en trop, ni fichier inconnu, et que seuls
+  des lots de la dernière phase (flagrants) manquent ;
+- que les graines sont celles de la configuration : chaque δ consigné par les lots régénérés et plantés est **retiré** sous sa
+  clé (`iib/regenere/…`, `iib/plante/…`) et doit être égal au δ consigné ; un seul écart est un refus ;
+- qu'aucune reprise n'a déjà été engagée ni finie (témoin `reprise-engagee-iib-v5.json`, fichiers de fin, résumé).
+
+Il rend aussi les **clés de graines** qu'un lot a employées, reconstruites de ses sorties (clés de génération du plan, suites
+des jumeaux là où la coupe est conforme, couplage de l'oracle à contexte réécrit, multiplications consignées) : le fichier des
+graines de fin porte ainsi les clés des lots versés sans les rejouer ; la reconstruction est vérifiée sur les lots joués par la
+reprise elle-même (clés reconstruites = clés employées, sinon arrêt). Aucun texte n'est lu ni écrit.
+"""
+from __future__ import annotations
+
+import json
+import math
+import re
+from pathlib import Path
+
+from ..gardes import GardeArret
+from ..scellement import sceller, verifier
+from . import configuration_v5 as cf
+from . import jumeau_v5 as jm
+from . import oracle_v5 as ov
+from .plante_v5 import cle_du_plante
+from .regenere_v5 import cle_du_regenere, tirer_delta
+from .regle_v5 import CLES_ORACLE
+
+SCHEMA_ORDRE = "ordre-reprise-iib-v5"
+ORDRE = "ordre-reprise-iib-v5.json"
+TEMOIN = "reprise-engagee-iib-v5.json"
+CHAMPS_ORDRE = frozenset({"schema", "avertissement", "run_partiel", "source", "machine_anterieure", "depense_anterieure_usd", "go_ecart",
+                          "fichiers"})
+H, R, P, F = "etalonnage-honnete", "etalonnage-regenere", "etalonnage-plante", "etalonnage-flagrant"
+ORACLES_DE = {H: ("P", "N"), R: ("P", "N"), P: ("N",), F: ("P", "N")}
+_LOT = re.compile(r"lot-([0-9]{3})-(etalonnage-[a-z]+)\.json")
+_IDS = re.compile(r"ids-lot-([0-9]{3})-(etalonnage-[a-z]+)\.json")
+_GO = re.compile(r"GO-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}")
+_COMMIT = re.compile(r"[0-9a-f]{40}")
+_RUN = re.compile(r"[0-9]{8}-[0-9]{6}-iib-[a-z0-9-]+")
+
+
+def nom_du_lot(numero: int, phase: str) -> str:
+    return f"lot-{numero:03d}-{phase}.json"
+
+
+# ------------------------------------------------------------------------------------------------------------------------------
+# Ordre de reprise
+# ------------------------------------------------------------------------------------------------------------------------------
+def fichiers_recuperes(racine, run: str) -> dict:
+    """Fichiers d'un étalonnage coupé, relatifs à `racine` : manifeste du run (s'il est là), lots et identifiants (sans les
+    sceaux compagnons) ; chacun avec l'empreinte que son sceau vérifie (R11)."""
+    racine = Path(racine)
+    chemins = [racine / "runs" / run / "manifeste.json"] if (racine / "runs" / run / "manifeste.json").is_file() else []
+    chemins += sorted((racine / "diag" / run / "lots").glob("lot-*.json")) + sorted((racine / "donnees" / run / "lots").glob("ids-lot-*.json"))
+    return {str(c.relative_to(racine)): verifier(c) for c in chemins}
+
+
+def ecrire_ordre(racine, run: str, source_branche: str, source_commit: str, machine_anterieure: int, depense_anterieure_usd: float,
+                 go_ecart: str) -> str:
+    """Écrit et scelle l'ordre de reprise, après que la session a récupéré les fichiers du run depuis la branche d'essai (elle
+    vérifie, hors de ce module, que chaque fichier est égal à l'octet à celui du commit d'origine). Rend l'empreinte."""
+    racine = Path(racine)
+    ordre = {"schema": SCHEMA_ORDRE, "avertissement": cf.AVERTISSEMENT, "run_partiel": run,
+             "source": {"branche": source_branche, "commit": source_commit}, "machine_anterieure": machine_anterieure,
+             "depense_anterieure_usd": depense_anterieure_usd, "go_ecart": go_ecart, "fichiers": fichiers_recuperes(racine, run)}
+    exiger_forme_de_l_ordre(ordre, run)
+    chemin = racine / "diag" / run / ORDRE
+    if chemin.exists():
+        raise GardeArret(f"{chemin} existe déjà : R12 interdit d'écraser")
+    chemin.write_text(json.dumps(ordre, indent=1, ensure_ascii=False, sort_keys=True) + "\n", encoding="utf-8")
+    return sceller(chemin)
+
+
+def exiger_forme_de_l_ordre(ordre: dict, run: str) -> None:
+    if not isinstance(ordre, dict) or set(ordre) != CHAMPS_ORDRE or ordre["schema"] != SCHEMA_ORDRE:
+        raise GardeArret(f"ordre de reprise : champs {sorted(ordre) if isinstance(ordre, dict) else ordre!r} ≠ {sorted(CHAMPS_ORDRE)} (refus)")
+    if ordre["run_partiel"] != run or not _RUN.fullmatch(str(run)):
+        raise GardeArret(f"ordre de reprise : run {ordre['run_partiel']!r} ≠ run repris {run!r} (refus)")
+    s = ordre["source"]
+    if not isinstance(s, dict) or set(s) != {"branche", "commit"} or not str(s["branche"]).startswith("essai/") or not _COMMIT.fullmatch(str(s["commit"])):
+        raise GardeArret(f"ordre de reprise : source {s!r} illisible (branche essai/…, commit en 40 caractères) (refus)")
+    m = ordre["machine_anterieure"]
+    if isinstance(m, bool) or not isinstance(m, int) or m <= 0:
+        raise GardeArret(f"ordre de reprise : machine des lots versés {m!r} : identifiant entier attendu (refus)")
+    d = ordre["depense_anterieure_usd"]
+    if isinstance(d, bool) or not isinstance(d, (int, float)) or not math.isfinite(d) or d < 0:
+        raise GardeArret(f"ordre de reprise : dépense antérieure {d!r} : nombre positif ou nul attendu, déclaré par la session (refus)")
+    if not isinstance(ordre["go_ecart"], str) or not _GO.fullmatch(ordre["go_ecart"]):
+        raise GardeArret(f"ordre de reprise : ligne de GO de l'écart {ordre['go_ecart']!r} illisible (GO-AAAA-MM-JJ-NN) (refus)")
+    f = ordre["fichiers"]
+    if not isinstance(f, dict) or not f or not all(isinstance(v, str) and re.fullmatch(r"[0-9a-f]{64}", v) for v in f.values()):
+        raise GardeArret("ordre de reprise : liste des fichiers récupérés vide ou illisible (refus)")
+
+
+def lire_ordre(racine, run: str, mode: str) -> tuple[dict, str]:
+    """Ordre de reprise relu (sceau, forme) ; chaque fichier qu'il cite a encore son empreinte, et l'ensemble des lots et des
+    identifiants sur le disque est exactement celui qu'il cite. En mode réel, la ligne de GO de l'écart figure dans
+    `registres/go.md` du commit joué. Rend l'ordre et son empreinte."""
+    racine = Path(racine)
+    chemin = racine / "diag" / run / ORDRE
+    if not chemin.is_file():
+        raise GardeArret(f"reprise : ordre de reprise {chemin} absent (la session l'écrit après avoir récupéré les lots) : refus")
+    sha = verifier(chemin)
+    ordre = json.loads(chemin.read_text(encoding="utf-8"))
+    exiger_forme_de_l_ordre(ordre, run)
+    vus = fichiers_recuperes(racine, run)
+    lots_vus = {k for k in vus if not k.endswith("manifeste.json")}
+    lots_cites = {k for k in ordre["fichiers"] if not k.endswith("manifeste.json")}
+    if lots_vus != lots_cites:
+        raise GardeArret(f"reprise : lots sur le disque ≠ lots de l'ordre (en trop : {sorted(lots_vus - lots_cites)[:3]} ; manquants : "
+                         f"{sorted(lots_cites - lots_vus)[:3]}) : refus")
+    for nom, attendu in ordre["fichiers"].items():
+        if vus.get(nom) != attendu:
+            raise GardeArret(f"reprise : {nom} : empreinte sur le disque ≠ empreinte de l'ordre de reprise (R11) : refus")
+    if mode == "reel":
+        go = racine / "registres" / "go.md"
+        if not go.is_file() or not re.search(rf"(?<![0-9A-Za-z-]){re.escape(ordre['go_ecart'])}(?![0-9])", go.read_text(encoding="utf-8")):
+            raise GardeArret(f"reprise : ligne {ordre['go_ecart']} absente de registres/go.md du commit joué : aucune reprise sans le mot de Lazar (refus)")
+    return ordre, sha
+
+
+# ------------------------------------------------------------------------------------------------------------------------------
+# État de l'étalonnage coupé
+# ------------------------------------------------------------------------------------------------------------------------------
+def _lire_scelle(chemin: Path) -> dict:
+    if not chemin.is_file():
+        raise GardeArret(f"reprise : {chemin.name} absent (lot manquant) : refus")
+    try:
+        verifier(chemin)
+    except GardeArret as e:
+        raise GardeArret(f"reprise : sceau de {chemin.name} faux ou absent ({e}) : refus") from None
+    return json.loads(chemin.read_text(encoding="utf-8"))
+
+
+def _repertorier(dossier: Path, motif: re.Pattern, autre: re.Pattern | None) -> dict[int, str]:
+    """Numéro → nom des fichiers de lot ; refus sur tout fichier inconnu, tout sceau orphelin, tout numéro en double."""
+    vus: dict[int, str] = {}
+    if not dossier.is_dir():
+        return vus
+    for f in sorted(dossier.iterdir()):
+        nom = f.name[:-len(".sha256")] if f.name.endswith(".sha256") else f.name
+        m = motif.fullmatch(nom)
+        if m is None and autre is not None and autre.fullmatch(nom):
+            continue                                       # même dossier pour les lots et les identifiants (essais)
+        if m is None or not f.is_file():
+            raise GardeArret(f"reprise : fichier inconnu {f.name} dans {dossier} : refus")
+        if f.name.endswith(".sha256"):
+            if not (dossier / nom).is_file():
+                raise GardeArret(f"reprise : sceau {f.name} sans son fichier : refus")
+            continue
+        n = int(m.group(1))
+        if n in vus:
+            raise GardeArret(f"reprise : deux lots de numéro {n} ({vus[n]}, {nom}) : refus")
+        vus[n] = nom
+    return vus
+
+
+def exiger_aucune_reprise(dossier) -> None:
+    """Ni témoin de reprise (reprise engagée, finie ou interrompue), ni fichier de fin, ni résumé dans le dossier du run coupé."""
+    dossier = Path(dossier)
+    for nom in (TEMOIN, "etalonnage-oracles-iib-v5.json", "rapportes-etalonnage-iib-v5.json", "graines-etalonnage-iib-v5.json", "resume.json"):
+        if (dossier / nom).exists() or (dossier / (nom + ".sha256")).exists():
+            raise GardeArret(f"reprise : {nom} existe déjà dans {dossier} : second passage de la reprise refusé (refus)")
+
+
+def etat_partiel(config: dict, dossier, donnees, prevus: list[dict]) -> dict:
+    """Vérifie les lots présents contre le plan scellé (`prevus` = `lanceur_v5.lots_prevus`) et rend
+    {"existants": [{numero, phase, plan, lignes, taches, ids, multiplications, noms}], "manquants": [lots prévus non joués]}."""
+    dossier, donnees = Path(dossier), Path(donnees)
+    exiger_aucune_reprise(dossier)
+    meme = dossier / "lots" == donnees / "lots"
+    lots = _repertorier(dossier / "lots", _LOT, _IDS if meme else None)
+    ids = _repertorier(donnees / "lots", _IDS, _LOT if meme else None)
+    total = len(prevus)
+    n = len(lots)
+    if not lots:
+        raise GardeArret("reprise : aucun lot versé : ce n'est pas une reprise (refus)")
+    if max(lots) > total or n > total:
+        raise GardeArret(f"reprise : lot en trop ({max(lots)} pour {total} lots prévus) : refus")
+    if sorted(lots) != list(range(1, n + 1)):
+        manque = sorted(set(range(1, max(lots) + 1)) - set(lots))
+        raise GardeArret(f"reprise : lot(s) manquant(s) au milieu des lots versés : {manque} : refus")
+    if sorted(ids) != sorted(lots) or any(ids[k] != "ids-" + lots[k] for k in lots):
+        raise GardeArret("reprise : fichiers d'identifiants ≠ lots versés (manquant, en trop ou d'une autre phase) : refus")
+    if n == total:
+        raise GardeArret(f"reprise : les {total} lots sont déjà versés : rien à reprendre (second passage ?) : refus")
+    manquants = prevus[n:]
+    if any(lot["phase"] != F for lot in manquants):
+        raise GardeArret(f"reprise : il manque des lots d'une phase autre que la dernière ({sorted({l['phase'] for l in manquants})}) : seule "
+                         "la phase des flagrants peut être reprise (refus)")
+    existants = []
+    for lot in prevus[:n]:
+        k, phase, plan = lot["numero"], lot["phase"], lot["plan"]
+        attendu = nom_du_lot(k, phase)
+        if lots[k] != attendu:
+            raise GardeArret(f"reprise : lot {k} : {lots[k]} ≠ {attendu} du plan scellé (phase ou ordre différent) : refus")
+        contenu, idc = _lire_scelle(dossier / "lots" / attendu), _lire_scelle(donnees / "lots" / f"ids-{attendu}")
+        existants.append(exiger_lot_conforme(config, k, phase, plan, contenu, idc))
+    return {"existants": existants, "manquants": manquants, "total": total}
+
+
+def exiger_lot_conforme(config: dict, numero: int, phase: str, plan: list[dict], contenu: dict, idc: dict) -> dict:
+    """Un lot versé est celui du plan : mêmes épisodes, dans le même ordre, mêmes tâches, oracles de sa phase, une sortie par
+    action et par oracle (pas 0, 1, …), schéma des sorties, aucun texte ; identifiants et multiplications cohérents."""
+    quoi = f"reprise : lot {numero} ({phase})"
+    if set(contenu) != {"avertissement", "lignes", "taches"} or set(idc) != {"avertissement", "ids", "multiplications"}:
+        raise GardeArret(f"{quoi} : champs du lot ou des identifiants hors de la forme versée : refus")
+    episodes = [p["episode"] for p in plan]
+    if contenu["taches"] != {p["episode"]: p["tache"] for p in plan}:
+        raise GardeArret(f"{quoi} : épisodes ou tâches ≠ plan scellé (ordre des tâches, taille de lot) : refus")
+    lignes = contenu["lignes"]
+    ov.exiger_aucun_texte(lignes)
+    oracles = ORACLES_DE[phase]
+    ordre_vu, par = [], {}
+    for l in lignes:
+        if not isinstance(l, dict) or set(l) != CLES_ORACLE or l["schema"] != cf.SCHEMA_ORACLE or l["phase"] != phase or l["oracle"] not in oracles:
+            raise GardeArret(f"{quoi} : sortie hors du schéma, d'une autre phase ou d'un autre oracle : refus")
+        if not ordre_vu or ordre_vu[-1] != l["episode"]:
+            ordre_vu.append(l["episode"])
+        par.setdefault((l["episode"], l["oracle"]), []).append(int(l["pas"]))
+    if ordre_vu != episodes:
+        raise GardeArret(f"{quoi} : ordre des épisodes des sorties ≠ plan scellé : refus")
+    cles_ids = {f"{phase}/{e}" for e in episodes}
+    if set(idc["ids"]) != cles_ids:
+        raise GardeArret(f"{quoi} : identifiants d'actions ≠ épisodes du plan : refus")
+    for e in episodes:
+        n_actions = len(idc["ids"][f"{phase}/{e}"])
+        if n_actions == 0:
+            raise GardeArret(f"{quoi} : épisode {e} sans action : refus")
+        for o in oracles:
+            if par.get((e, o)) != list(range(n_actions)):
+                raise GardeArret(f"{quoi} : épisode {e}, oracle {o} : sorties ≠ une par action, dans l'ordre : refus")
+    mult = idc["multiplications"]
+    if phase in (R, P):
+        if set(mult) != cles_ids or any(len(mult[f"{phase}/{e}"]) != len(idc["ids"][f"{phase}/{e}"]) for e in episodes):
+            raise GardeArret(f"{quoi} : multiplications consignées ≠ une par action de chaque épisode : refus")
+    elif mult:
+        raise GardeArret(f"{quoi} : multiplications consignées dans une phase qui n'en a pas : refus")
+    return {"numero": numero, "phase": phase, "plan": plan, "lignes": lignes, "taches": contenu["taches"], "ids": idc["ids"],
+            "multiplications": mult, "nom": nom_du_lot(numero, phase)}
+
+
+# ------------------------------------------------------------------------------------------------------------------------------
+# Graines
+# ------------------------------------------------------------------------------------------------------------------------------
+def _multiplications(phase: str, multiplications: dict):
+    for cle, notes in multiplications.items():
+        episode = cle.split("/", 1)[1]
+        for t, n in enumerate(notes):
+            if t >= 1 and n is not None and n.get("delta") is not None:
+                yield (cle_du_regenere(episode, t) if phase == R else cle_du_plante(episode, t)), float(n["delta"])
+
+
+def cles_d_un_lot(phase: str, plan: list[dict], lignes: list[dict], multiplications: dict) -> set[str]:
+    """Clés (sans préfixe) qu'un lot a employées, reconstruites de ses sorties : génération (plan, honnêtes et flagrants ; les
+    régénérés reprennent les graines d'actions de l'honnête) ; suites des jumeaux là où la coupe est conforme (`cle_du_jumeau` :
+    aux pas 0 et 1, la clé de l'oracle au contexte de l'agent) ; couplage de l'oracle à contexte réécrit (pas ≥ 1, coupe
+    conforme) ; multiplications consignées (δ non vide, pas ≥ 1)."""
+    cles = {p["cle"] for p in plan} if phase in (H, F) else set()
+    for l in lignes:
+        if l["coupe_conforme"]:
+            cles.add(jm.cle_du_jumeau(l["oracle"], l["phase"], l["episode"], int(l["pas"])))
+            if l["oracle"] == "N" and int(l["pas"]) >= 1:
+                cles.add(ov.cle_du_couplage(l["phase"], l["episode"], int(l["pas"])))
+    cles |= {k for k, _ in _multiplications(phase, multiplications)}
+    return cles
+
+
+def exiger_graines_des_lots(config: dict, existants: list[dict]) -> int:
+    """Chaque δ consigné par les lots régénérés et plantés, retiré à nouveau sous sa clé avec l'entropie et le préfixe de la
+    configuration, est égal au δ consigné ; sinon refus (graines différentes). Rend le nombre de δ vérifiés (zéro : refus,
+    graines invérifiables)."""
+    verif, loi, n = jm.Graines(config["entropie"], config["prefixe_graines"]), config["organisme"]["loi"], 0
+    for lot in existants:
+        if lot["phase"] not in (R, P):
+            continue
+        for cle, delta in _multiplications(lot["phase"], lot["multiplications"]):
+            if tirer_delta(verif.generateur(cle), loi) != delta:
+                raise GardeArret(f"reprise : lot {lot['numero']} : δ consigné sous {cle} ≠ δ retiré sous les graines de la configuration "
+                                 "(entropie ou préfixe différents) : refus")
+            n += 1
+    if n == 0:
+        raise GardeArret("reprise : aucun δ consigné dans les lots versés : graines invérifiables (refus)")
+    return n
+
+
+# ------------------------------------------------------------------------------------------------------------------------------
+# Point d'entrée de la session : `python -m controle_ia.iib.reprise_v5 ordre RUN BRANCHE COMMIT MACHINE DEPENSE_USD GO` (après
+# `scripts/preparer_reprise_iib_v5.sh`, qui récupère les fichiers et les compare à l'octet au commit d'origine)
+# ------------------------------------------------------------------------------------------------------------------------------
+def _main(argv: list[str]) -> int:
+    import sys
+
+    if len(argv) != 7 or argv[0] != "ordre":
+        print("usage : python -m controle_ia.iib.reprise_v5 ordre RUN BRANCHE COMMIT MACHINE DEPENSE_ANTERIEURE_USD GO_ECART", file=sys.stderr)
+        return 2
+    try:
+        _, run, branche, commit, machine, depense, go = argv
+        if not re.fullmatch(r"[0-9]+", machine) or not re.fullmatch(r"[0-9]+([.][0-9]+)?", depense):
+            raise GardeArret(f"machine {machine!r} ou dépense {depense!r} illisibles (entier ; nombre positif en USD)")
+        sha = ecrire_ordre(Path("."), run, branche, commit, int(machine), float(depense), go)
+    except GardeArret as e:
+        print(f"REFUS : {e}", file=sys.stderr)
+        return 1
+    print(f"ordre de reprise écrit et scellé : diag/{run}/{ORDRE} {sha}")
+    return 0
+
+
+if __name__ == "__main__":
+    import sys
+
+    sys.exit(_main(sys.argv[1:]))
