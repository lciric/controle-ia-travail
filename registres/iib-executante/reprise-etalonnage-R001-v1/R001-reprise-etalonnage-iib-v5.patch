+def test_amorce_de_la_reprise_engagement_unique(tmp_path):
+    import re
+    import subprocess
+
+    texte = (DEPOT / "scripts" / "amorce_instance_iib_reprise_v5.sh").read_text(encoding="utf-8")
+    bloc = re.search(r"# --- \(p3\) engagement de la reprise\n(.*?)# --- fin \(p3\)\n", texte, re.S).group(1)
+    origine, d = tmp_path / "o.git", tmp_path / "d"
+    subprocess.run(["git", "init", "-q", "--bare", str(origine)], check=True)
+    subprocess.run(["git", "init", "-q", str(d)], check=True)
+    for a in (("config", "user.email", "t@x.invalid"), ("config", "user.name", "t"), ("commit", "-q", "--allow-empty", "-m", "c"),
+              ("remote", "add", "origin", str(origine))):
+        subprocess.run(["git", "-C", str(d), *a], check=True, capture_output=True)
+    script = tmp_path / "e.sh"
+    script.write_text("T=$1; cd $2\nrefus() { echo \"REFUS : $1\"; exit 2; }\njournal() { echo \"$*\"; }\n" + bloc +
+                      f'engager_reprise "refs/heads/essai/iib-reprise-engagee-{RUN}"\necho FIN\n', encoding="utf-8")
+    sain = subprocess.run(["bash", str(script), str(tmp_path), str(d)], capture_output=True, text=True, timeout=120)
+    assert sain.returncode == 0 and "reprise engagée" in sain.stdout and "FIN" in sain.stdout, sain.stdout + sain.stderr
+    deux = subprocess.run(["bash", str(script), str(tmp_path), str(d)], capture_output=True, text=True, timeout=120)
+    assert deux.returncode == 2 and "reprise déjà engagée" in deux.stdout and "FIN" not in deux.stdout
+
