+class _Lots:
+    """Lots versés d'un étalonnage : écriture et sceau de chaque lot (`lots/`), poussée, marque de progrès ; garde les sorties
+    d'oracle de chaque lot (dans l'ordre) pour l'écriture de fin. La reprise y charge d'abord les lots déjà versés."""
+
+    def __init__(self, dossier: Path, donnees: Path, modele, chrono: dict, versement):
+        self.dossier, self.donnees, self.modele, self.chrono, self.versement = dossier, donnees, modele, chrono, versement
+        self.sorties, self.lignes, self.taches, self.n, self.episodes = {}, [], {}, 0, 0
+
+    def charger(self, lot: dict) -> None:
+        """Lot déjà versé (reprise) : relu, jamais réécrit."""
+        if lot["numero"] != self.n + 1:
+            raise GardeArret("reprise : lots chargés hors de l'ordre (défaut de code)")
+        self.n = lot["numero"]
+        self.sorties[f"lots/{lot['nom']}"] = verifier(self.dossier / "lots" / lot["nom"])
+        self.sorties[f"lots/ids-{lot['nom']}"] = verifier(self.donnees / "lots" / f"ids-{lot['nom']}")
+        self.lignes.append(list(lot["lignes"]))
+        self.taches.update(lot["taches"])
+        self.episodes += len(lot["plan"])
+
+    def verser(self, phase: str, episodes: list[dict]) -> None:
+        """Lot scellé : sorties d'oracle par épisode (aucun texte) et identifiants des actions ; puis marque de progrès."""
+        self.n += 1
+        nom = f"lot-{self.n:03d}-{phase}.json"
+        lignes = [l for ep in episodes for o in ("P", "N") for l in ep["oracle"].get(o, [])]
+        ov.exiger_aucun_texte(lignes)
+        self.sorties[f"lots/{nom}"] = _ecrire(self.dossier / "lots", nom, {"lignes": lignes, "taches": {ep["episode"]: ep["tache"] for ep in episodes}})
+        self.sorties[f"lots/ids-{nom}"] = _ecrire(self.donnees / "lots", f"ids-{nom}", {
+            "ids": _ids(episodes), "multiplications": {f"{ep['phase']}/{ep['episode']}": ep["consignes"] for ep in episodes if "consignes" in ep}})
+        self.lignes.append(lignes)
+        self.taches.update({ep["episode"]: ep["tache"] for ep in episodes})
+        self.episodes += len(episodes)
+        progres(etape="etalonnage", phase=phase, lot=self.n, episodes=self.episodes, actions_oracle=self.chrono.get("actions_oracle", 0),
+                replis=len(replis_de(self.modele)))
+        if self.versement is not None:                      # correctif 0014 : le lot scellé part sur la branche, aussitôt
+            self.versement(f"lot {self.n:03d} {phase}", [p for f in (self.dossier / "lots" / nom, self.donnees / "lots" / f"ids-{nom}")
+                                                         for p in (f, Path(str(f) + ".sha256"))])
+
