+def test_amorce_de_la_reprise_differences_bornees_a_celle_de_la_course_et_choix_par_le_lanceur_de_session(tmp_path):
+    import difflib
+    import hashlib
+    import os
+    import subprocess
+
+    s = DEPOT / "scripts"
+    c, p = (s / "amorce_instance_iib_course_v5.sh").read_text(encoding="utf-8"), (s / "amorce_instance_iib_reprise_v5.sh").read_text(encoding="utf-8")
+    for f in ("amorce_instance_iib_reprise_v5.sh", "preparer_reprise_iib_v5.sh", "lancer_iib_v3.sh"):
+        assert subprocess.run(["bash", "-n", str(s / f)], capture_output=True).returncode == 0, f
+    d = [l for l in difflib.unified_diff(c.splitlines(), p.splitlines(), n=0, lineterm="") if l[:1] in "+-" and not l.startswith(("+++", "---"))]
+    code = [l for l in d if not l[1:].lstrip().startswith("#")]
+    moins, plus = [l[1:] for l in code if l[0] == "-"], [l[1:] for l in code if l[0] == "+"]
+    assert len(moins) == len(plus) == 13, (moins, plus)                       # p1 à p6 : lignes remplacées une pour une, aucune ajoutée
+    vivantes = [l for l in p.splitlines() if "controle_ia.iib.lanceur_v5 --phase" in l and not l.lstrip().startswith("#")]
+    assert len(vivantes) == 1 and '--phase reprise_etalonnage --config "$CONFIG" --run-id "$RUN" --etalonnage-partiel "$RUN_ETAL"' in vivantes[0]
+    assert 'ENGAGEE="refs/heads/essai/iib-reprise-engagee-$RUN_ETAL"' in p and 'engager_reprise "$ENGAGEE"' in p and "engager_course" not in p
+    assert "diag/*-iib-*/ordre-reprise-iib-v5.json" in p and 'ajouter "runs/$RUN" "diag/$RUN" "diag/$RUN_ETAL"' in p
+    liste = s / "tests-cibles-iib-reprise-v5-v1.txt"
+    assert liste.read_text(encoding="utf-8").split() == sorted((s / "tests-cibles-iib-v5-v6.txt").read_text(encoding="utf-8").split()
+                                                              + ["tests/test_iib_reprise_v5_r001.py"])
+    assert f'LISTE_TESTS="scripts/{liste.name}"; LISTE_SHA256="{hashlib.sha256(liste.read_bytes()).hexdigest()}"' in p
+    lue = subprocess.run(["bash", "-c", "grep -v '^[[:space:]]*#' \"$1\" | sed -n 's/.*controle_ia\\.iib\\.lanceur_v5 --phase \\([a-z_]*\\) .*/\\1/p' | sort -u",
+                          "_", str(s / "amorce_instance_iib_reprise_v5.sh")], capture_output=True, text=True).stdout.split()
+    assert lue == ["reprise_etalonnage"]                                      # la phase que la surveillance lit, et que session_v5 connaît
+    env = {"PATH": os.environ["PATH"], "HOME": str(tmp_path), "IIB_DEPOT": str(DEPOT)}
+    r = subprocess.run(["bash", str(s / "lancer_iib_v3.sh"), "outil"], env={**env, "IIB_AMORCE": "scripts/amorce_instance_iib_v1.sh"},
+                       capture_output=True, text=True, timeout=60)
+    assert r.returncode == 2 and "ni celle de la reprise" in r.stdout + r.stderr
+    assert "scripts/amorce_instance_iib_reprise_v5.sh) A=\"$IIB_AMORCE\"" in (s / "lancer_iib_v3.sh").read_text(encoding="utf-8")
