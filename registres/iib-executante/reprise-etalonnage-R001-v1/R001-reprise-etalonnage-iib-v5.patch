+#!/usr/bin/env bash
+# Préparation, par la session, du commit de la REPRISE de l'étalonnage de l'organisme retenu, v5 (correctif de reprise R001 ;
+# GO-2026-11-22-71). Sur un clone de travail propre, à la tête de la branche de code de la reprise (prep/…). Ne pousse rien,
+# ne committe rien, ne supprime rien : récupère depuis la branche d'essai de l'étalonnage coupé, à son commit nommé, le manifeste
+# du run, les lots et leurs identifiants (et eux seuls), vérifie qu'ils sont égaux à l'octet à ce commit et que leurs sceaux
+# tiennent, puis écrit et scelle l'ordre de reprise (`diag/<run>/ordre-reprise-iib-v5.json`). La session relit, committe et
+# pousse la branche de code ; l'amorce de la reprise trouve l'ordre dans le commit cloné.
+# Variables : PYTHON (interpréteur, défaut python), PYTHONPATH (ajouté après src).
+# Usage : bash scripts/preparer_reprise_iib_v5.sh RUN BRANCHE_SOURCE COMMIT_SOURCE MACHINE_ANTERIEURE DEPENSE_ANTERIEURE_USD GO_ECART
+#   ex. : … 20261121-234254-iib-reel essai/iib-explo-v6 f4bf68bb7f5ffc4a30d07a4fc949ab02832e904b 61875617 <USD du registre> GO-2026-11-22-71
+set -euo pipefail
+RUN="${1:?run coupé}"; SRC_B="${2:?branche source essai/…}"; SRC_C="${3:?commit source (40 caractères)}"; MACH="${4:?machine des lots versés}"
+DEP="${5:?dépense antérieure en USD (registre des dépenses)}"; GO="${6:?ligne de GO (ecart au texte scelle)}"
+refus() { echo "REFUS : $1 : rien n'est écrit de plus" >&2; exit 2; }
+[[ "$RUN" =~ ^[0-9]{8}-[0-9]{6}-iib-[a-z0-9-]+$ ]] || refus "run $RUN illisible"
+[[ "$SRC_B" =~ ^essai/ ]] || refus "branche source $SRC_B : essai/… attendue"
+[[ "$SRC_C" =~ ^[0-9a-f]{40}$ ]] || refus "commit source : 40 caractères hexadécimaux"
+[ -z "$(git status --porcelain)" ] || refus "clone de travail non propre"
+git fetch -q origin "refs/heads/$SRC_B" || refus "branche $SRC_B introuvable sur le dépôt distant"
+[ "$(git rev-parse FETCH_HEAD)" = "$SRC_C" ] || refus "tête de $SRC_B ($(git rev-parse FETCH_HEAD)) ≠ commit nommé $SRC_C"
+CHEMINS=("runs/$RUN" "diag/$RUN/lots" "donnees/$RUN/lots")
+for c in "${CHEMINS[@]}"; do [ ! -e "$c" ] || refus "$c existe déjà dans le clone (R12)"; done
+AUTRES=$(git ls-tree -r --name-only "$SRC_C" -- "runs/$RUN" "diag/$RUN" "donnees/$RUN" | grep -vE "^(runs/$RUN/manifeste\.json(\.sha256)?|diag/$RUN/lots/lot-[0-9]{3}-etalonnage-[a-z]+\.json(\.sha256)?|donnees/$RUN/lots/ids-lot-[0-9]{3}-etalonnage-[a-z]+\.json(\.sha256)?)$" || true)
+[ -z "$AUTRES" ] || refus "le commit source porte d'autres fichiers du run ($(printf '%s' "$AUTRES" | head -n 3 | tr '\n' ' ')) : à trancher par la session"
+git checkout -q "$SRC_C" -- "${CHEMINS[@]}" || refus "récupération des fichiers du run impossible"
+git diff --quiet "$SRC_C" -- "${CHEMINS[@]}" || refus "fichiers récupérés ≠ commit source à l'octet"
+N=$(ls -1 "diag/$RUN/lots"/lot-*.json | wc -l); NI=$(ls -1 "donnees/$RUN/lots"/ids-lot-*.json | wc -l)
+PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}" "${PYTHON:-python}" -m controle_ia.scellement verifier "runs/$RUN/manifeste.json" "diag/$RUN/lots"/lot-*.json "donnees/$RUN/lots"/ids-lot-*.json >/dev/null \
+    || refus "un sceau ne tient pas"
+PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}" "${PYTHON:-python}" -m controle_ia.iib.reprise_v5 ordre "$RUN" "$SRC_B" "$SRC_C" "$MACH" "$DEP" "$GO"
+echo "récupérés de $SRC_B@$SRC_C : manifeste, $N lots, $NI fichiers d'identifiants ; à relire, committer et pousser par la session (rien n'est poussé ici)"
