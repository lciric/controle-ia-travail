+# ---- gardes (R5 : le cas sain est l'essai central) --------------------------------------------------------------------------
+def _reseller(chemin: Path, contenu) -> None:
+    for c in (chemin, Path(str(chemin) + ".sha256")):
+        if c.exists():
+            c.unlink()
+    chemin.write_text(json.dumps(contenu, indent=1, ensure_ascii=False, sort_keys=True) + "\n", encoding="utf-8")
+    sceller(chemin)
+
+
+def _supprimer_lot(racine: Path, nom: str) -> None:
+    for d, n in (("diag", nom), ("donnees", f"ids-{nom}")):
+        for suffixe in ("", ".sha256"):
+            (racine / d / RUN / "lots" / (n + suffixe)).unlink()
