+    assert rc["resultat"]["manifeste_de_la_reprise"]["chemin"] == f"runs/{rep}/manifeste.json"
+    m = _json(tmp_path / "runs" / rep / "manifeste.json")
+    assert marque in m["reserves"] and any(GO in x and "deux machines" in x for x in m["reserves"]) and "--phase reprise_etalonnage" in m["commande"]
+    assert _json(tmp_path / "diag" / rep / "resume.json")["resultat"]["reprise"]["marque"] == marque
+    for nom, sha in rc["resultat"]["empreintes"].items():
+        f = tmp_path / ("donnees" if nom.startswith("lots/ids-") else "diag") / run / nom
+        assert verifier(f) == sha, nom
+    assert la.exiger_identifiants_de_l_etalonnage(tmp_path, run, "reel")                 # la course compterait 28 lots
+    c = subprocess.run(base + ["--run-id", run, "--phase", "conditions"], cwd=tmp_path, env=env, capture_output=True, text=True, timeout=120)
+    assert c.returncode == 0, c.stderr[-800:]
+    deux = subprocess.run(base + ["--run-id", "20991231-000202-iib-reprise-jouet", "--phase", "reprise_etalonnage", "--etalonnage-partiel", run],
