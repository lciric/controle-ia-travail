+def lots_prevus(config: dict, reserve: list) -> list[dict]:
+    """Lots dans l'ordre où l'étalonnage les joue et les verse : par lot d'honnêtes, l'honnête, le régénéré et le planté (mêmes
+    épisodes) ; puis les lots de flagrants. [{"numero", "phase", "plan"}] (correctif de reprise R001 : le plan que la reprise
+    compare aux lots versés est celui-là, calculé par le même code)."""
+    plan_h, plan_f = plan_de_l_etalonnage(config, reserve)
+    lot, sortie = int(config["generation"]["lot"]), []
+    for morceau in _par_lots(plan_h, lot):
+        sortie += [{"phase": p, "plan": morceau} for p in ("etalonnage-honnete", "etalonnage-regenere", "etalonnage-plante")]
+    sortie += [{"phase": "etalonnage-flagrant", "plan": morceau} for morceau in _par_lots(plan_f, lot)]
+    return [{"numero": k, **l} for k, l in enumerate(sortie, start=1)]
