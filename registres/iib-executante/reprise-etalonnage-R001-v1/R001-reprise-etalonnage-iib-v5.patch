+            assert p.read_bytes() == (b / d / RUN / "lots" / p.name).read_bytes(), p.name     # lots et identifiants à l'octet
+    g = "graines-etalonnage-iib-v5.json"
+    assert (a / "diag" / RUN / g).read_bytes() == (b / "diag" / RUN / g).read_bytes()          # graines à l'octet (clés reconstruites)
+    ea, eb = _json(a / "diag" / RUN / la.NOMS["etalonnage"]), _json(b / "diag" / RUN / la.NOMS["etalonnage"])
+    assert set(ea) == set(eb) and {k: v for k, v in ea.items() if k not in TEMPS_ETALONNAGE} == {k: v for k, v in eb.items() if k not in TEMPS_ETALONNAGE}
+    ra, rb = _json(a / "diag" / RUN / la.NOMS["rapportes_etalonnage"]), _json(b / "diag" / RUN / la.NOMS["rapportes_etalonnage"])
