diff --git a/tests/test_iib_reprise_v5_r001.py b/tests/test_iib_reprise_v5_r001.py
new file mode 100644
index 000000000..80926b87d
--- /dev/null
+++ b/tests/test_iib_reprise_v5_r001.py
@@ -0,0 +1,509 @@
+"""Reprise de l'étalonnage de l'organisme retenu, v5 (correctif de reprise R001 ; GO-2026-11-22-71) : essai central (un
+étalonnage jouet coupé après N lots puis repris rend les mêmes fichiers de fin qu'un étalonnage complet, mêmes graines), gardes
+(cas sain et artefacts, R5), point d'entrée, amorce et surveillance. Aucune sortie réelle n'est lue : tout est jouet."""
+import json
+import shutil
+from pathlib import Path
+
+import pytest
+from test_iib_lanceur_v5 import _depot_jouet, _monde
+
+from controle_ia.gardes import GardeArret
+from controle_ia.iib import lanceur_v5 as la
+from controle_ia.iib import reprise_v5 as rr
+from controle_ia.iib.jouet_v5 import ModeleJouetDeLangue, TokeniseurJouet
+from controle_ia.scellement import sceller, verifier
+
+DEPOT = Path(__file__).resolve().parents[1]
+RUN = "20991231-000100-iib-jouet"
+COMMIT = "f4bf68bb7f5ffc4a30d07a4fc949ab02832e904b"
+GO = "GO-2026-11-22-71"
+TEMPS_RAPPORTES = {"durees", "duree_d_une_action_d_oracle_par_oracle_h", "chrono", "depense", "reprise"}   # mesurés : diffèrent d'une course à l'autre
+TEMPS_ETALONNAGE = {"durees", "depense_etalonnage_usd"}
+
+
+class Coupure(Exception):
+    pass
+
+
+def _coupe_apres(n: int):
+    """Versement factice qui coupe l'étalonnage juste après le n-ième lot scellé (la machine qui s'arrête)."""
+    vus = []
+
+    def versement(motif, fichiers):
+        vus.append(motif)
+        if len(vus) == n:
+            raise Coupure(motif)
+    return versement
+
+
+def _modele(vocabulaire=None):
+    """Modèle jouet ; `vocabulaire` : tokeniseur au vocabulaire fixé d'avance. Le tokeniseur jouet par défaut numérote chaque
+    caractère à sa première rencontre : ses identifiants dépendent de tout ce qu'il a déjà lu, si bien qu'une machine neuve
+    (qui n'a pas lu les lots 1 à 27) numéroterait autrement. Un tokeniseur réel a un vocabulaire fixe ; l'essai central fixe
+    donc le vocabulaire jouet, et vérifie qu'aucun caractère neuf n'a été numéroté en cours de route."""
+    return ModeleJouetDeLangue() if vocabulaire is None else ModeleJouetDeLangue(tok=TokeniseurJouet(vocabulaire))
+
+
+def _jouer_complet(racine: Path, config: dict, modele=None) -> dict:
+    return la.phase_etalonnage(config, racine, racine / "diag" / RUN, modele or _modele(), la.MondeJouet(), donnees=racine / "donnees" / RUN,
+                               carte=False)
+
+
+def _jouer_coupe(racine: Path, config: dict, n: int, modele=None) -> None:
+    with pytest.raises(Coupure):
+        la.phase_etalonnage(config, racine, racine / "diag" / RUN, modele or _modele(), la.MondeJouet(), donnees=racine / "donnees" / RUN,
+                            carte=False, versement=_coupe_apres(n))
+
+
+def _ordre(racine: Path, depense: float = 16.0) -> tuple[dict, str]:
+    chemin = racine / "diag" / RUN / rr.ORDRE
+    for c in (chemin, Path(str(chemin) + ".sha256")):
+        if c.exists():
+            c.unlink()
+    rr.ecrire_ordre(racine, RUN, "essai/iib-explo-v6", COMMIT, 61875617, depense, GO)
+    return rr.lire_ordre(racine, RUN, "jouet")
+
+
+def _reprendre(racine: Path, config: dict, monde=None, **kw) -> dict:
+    ordre, sha = _ordre(racine) if "ordre" not in kw else (kw.pop("ordre"), kw.pop("sha"))
+    return la.phase_reprise_etalonnage(config, racine, RUN, kw.pop("modele", None) or _modele(), monde or la.MondeJouet(), ordre, sha, carte=False,
+                                       machine_neuve=kw.pop("machine_neuve", "99"), **kw)
+
+
+def _json(chemin: Path) -> dict:
+    return json.loads(chemin.read_text(encoding="utf-8"))
+
+
+@pytest.fixture(scope="module")
+def vocabulaire(tmp_path_factory):
+    """Caractères qu'un étalonnage jouet complet fait lire au tokeniseur jouet (vocabulaire fixé des essais d'égalité)."""
