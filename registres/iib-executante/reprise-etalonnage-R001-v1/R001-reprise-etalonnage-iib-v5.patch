+        la.executer("etalonnage", config, tmp_path, run, ModeleJouetDeLangue(), MondeCoupe(), {}, carte=False)
+
+    def git(*a):
+        subprocess.run(["git", "-C", str(tmp_path), *a], check=True, capture_output=True)
+    git("add", "-A")
+    git("commit", "-q", "-m", "étalonnage coupé versé")
+    rr.ecrire_ordre(tmp_path, run, "essai/iib-explo-v6", COMMIT, 61875617, 16.0, GO)
+    git("add", "-A")
+    git("commit", "-q", "-m", "ordre de reprise")
+    env = environnement_sans_carte(tmp_path_factory.mktemp("poste-sans-carte-reprise"), os.environ)
+    env["PYTHONPATH"] = str(DEPOT / "src")
+    env.pop("CONTAINER_ID", None)
+    base = [sys.executable, "-m", "controle_ia.iib.lanceur_v5", "--config", "entrees/config-iib-v5-jouet.json"]
+    rep = "20991231-000201-iib-reprise-jouet"
