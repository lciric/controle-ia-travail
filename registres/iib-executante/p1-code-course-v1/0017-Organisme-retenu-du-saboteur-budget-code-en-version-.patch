+LISTE_TESTS="scripts/tests-cibles-iib-course-v5-v1.txt"; LISTE_SHA256="7c4757fa17c0b059cf5bb071a0b557e0aeba789af396cafb4d0d6776bbbea2bc"; FICHIERS_TESTS=""
