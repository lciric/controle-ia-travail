+    [ "$(sha256sum "$LISTE_TESTS" | cut -d' ' -f1)" = "$LISTE_SHA256" ] || liste_refus "empreinte de $LISTE_TESTS ≠ celle de l'amorce ($LISTE_SHA256)"
