+[ ! -s "$R/iib-fichiers-trop-gros.txt" ] || { journal "ERREUR DE CHAÎNE (C-V4-1) : fichier(s) trop gros retiré(s) du commit, restés sur l'instance : $(head -n 3 "$R/iib-fichiers-trop-gros.txt" | tr '\n' ';')"; ECHEC=1; }
