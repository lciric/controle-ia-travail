+# -- (3) loi des jetons tirés -------------------------------------------------------------------------------------------------
+def _khi_deux(tirages, p):
+    n = len(tirages)
+    obs = torch.bincount(tirages, minlength=len(p)).double()
+    return scipy_stats.chisquare(obs.numpy(), (n * p).numpy()).pvalue
+
