+def _d(x: Decimal) -> str:
+    """Écriture décimale sans exposant ni zéro final (60.0 → 60, 50.350 → 50.35)."""
+    s = f"{x:f}"
+    return s.rstrip("0").rstrip(".") if "." in s else s
+
