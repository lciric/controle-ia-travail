+def neuronpedia_lens(filename: str) -> dict:
+    """A Neuronpedia lens file's Jacobians by layer, refused unless its sha256 is the recorded one (when recorded) and
+    it is ``{"J": {0..n-1: [d, d]}}``: a missing or shifted layer would otherwise fall back to the logit lens in
+    ``score`` without a word. Prints the layers and the payload's other keys."""
+    path = hf_hub_download(NEURONPEDIA_REPO, filename)
+    want = NEURONPEDIA_SHA256.get(filename)
+    if want is not None:
+        h = hashlib.sha256()
+        with open(path, "rb") as fh:
+            for b in iter(lambda: fh.read(1 << 24), b""):
+                h.update(b)
+        if h.hexdigest() != want:
+            raise ValueError(f"{filename}: sha256 {h.hexdigest()}, expected {want}")
+    payload = torch.load(path, map_location="cpu", weights_only=True)
+    J = payload.get("J") if isinstance(payload, dict) else None
+    ok = isinstance(J, dict) and bool(J) and all(
+        type(l) is int and isinstance(m, torch.Tensor) and m.ndim == 2 and m.shape[0] == m.shape[1] for l, m in J.items())
+    if not ok or sorted(J) != list(range(len(J))) or len({tuple(m.shape) for m in J.values()}) != 1:
+        keys = sorted(map(str, payload)) if isinstance(payload, dict) else type(payload).__name__
+        raise ValueError(f"{filename}: not a J-lens layout ({keys})")
+    print(f"{filename}: layers 0-{len(J) - 1}, d {next(iter(J.values())).shape[0]}, "
+          f"other keys {sorted(str(k) for k in payload if k != 'J')}", flush=True)
+    return J
 
 
